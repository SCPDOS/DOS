   825                              <1> initDriver:
   826                              <1> ;Initialises one driver and adjusts the DOS data appropriately
   827                              <1> ;If on return CF=CY then the driver didnt want to be loaded
   828                              <1> ;Preserves rbx (initReqPkt), rbp (DOSSEG ptr), rsi (driver pointer)
   829                              <1> ;initReqPkt.optptr must be set before calling this function if cmdline
   830                              <1> ; arguments are to be passed to the driver
   831                              <1> ;Input: rsi -> driver pointer
   832                              <1> ;       rbx -> sysinit request pointer
   833                              <1> ;       rbp -> DOSSEG pointer
   834 000009CD C6031F              <1>     mov byte [rbx + initReqPkt.hdrlen], initReqPkt_size
   835 000009D0 C6430200            <1>     mov byte [rbx + initReqPkt.cmdcde], drvINIT
   836 000009D4 66C743030000        <1>     mov word [rbx + initReqPkt.status], 0
   837 000009DA 8A85[00000000]      <1>     mov al, byte [rbp + numPhysVol]    ;Get current num of physical volumes
   838 000009E0 88431E              <1>     mov byte [rbx + initReqPkt.drvnum], al
   839                              <1>     ;Protect the important registers. All others trashable
   840 000009E3 53                  <1>     push rbx
   841 000009E4 56                  <1>     push rsi
   842 000009E5 55                  <1>     push rbp
   843 000009E6 FF560A              <1>     call qword [rsi + drvHdr.strPtr]
   844 000009E9 FF5612              <1>     call qword [rsi + drvHdr.intPtr]
   845 000009EC 5D                  <1>     pop rbp
   846 000009ED 5E                  <1>     pop rsi
   847 000009EE 5B                  <1>     pop rbx
   848                              <1>     ;Check if a driver wants to not load.
   849                              <1>     ;If a kernel driver wants to stop, halt boot.
   850 000009EF 66F743030080        <1>     test word [rbx + initReqPkt.status], drvErrStatus
   851 000009F5 750C                <1>     jnz short .errExit
   852 000009F7 807B0D00            <1>     cmp byte [rbx + initReqPkt.numunt], 0
   853 000009FB 7508                <1>     jne short .notHalt
   854 000009FD 4839730E            <1>     cmp qword [rbx + initReqPkt.endptr], rsi    ;If endptr -> header, abort
   855 00000A01 7502                <1>     jne short .notHalt
   856                              <1> .errExit:
   857 00000A03 F9                  <1>     stc
   858 00000A04 C3                  <1>     ret
   859                              <1> .notHalt:
   860                              <1>     ;Now check if the drivers were con/clock before exiting
   861 00000A05 668B4608            <1>     mov ax, word [rsi + drvHdr.attrib]
   862 00000A09 66250300            <1>     and ax, devDrvConIn | devDrvConOut
   863 00000A0D 740D                <1>     jz short .checkClock    ;If neither one of these bits are set, jmp
   864 00000A0F 663D0300            <1>     cmp ax, devDrvConIn | devDrvConOut
   865 00000A13 7507                <1>     jne short .checkClock
   866 00000A15 4889B5[00000000]    <1>     mov qword [rbp + vConPtr], rsi  ;Store the header ptr here
   867                              <1> .checkClock:
   868 00000A1C 66F746080800        <1>     test word [rsi + drvHdr.attrib], devDrvClockDev
   869 00000A22 7407                <1>     jz short .notClock
   870 00000A24 4889B5[00000000]    <1>     mov qword [rbp + clockPtr], rsi
   871                              <1> .notClock:
   872                              <1> ;Now test if MSD driver. If so, store the number of units in the name field
   873 00000A2B 66F746080080        <1>     test word [rsi + drvHdr.attrib], devDrvChar
   874                              <1>     retnz   ;Return if this is a char device
    45                              <2> cret nz
