   743                              <1> .drvGetDrvFilename:
   744                              <1> ;Gets a ptr to the driver filename string. May not be null terminated.
   745                              <1> ;This is the ``first'' character past the ``='' sign in CONFIG.SYS
   746                              <1> ;Input: rbp -> cfgFrame
   747                              <1> ;Output: rsi -> Filename
   748 000012B6 488B75B0            <1>     mov rsi, qword [rbp - cfgFrame.linePtr] ;Get the pointer to the 
