   693                              <1> 
   694                              <1> addDriverMarkers:
   695                              <1> ;Traverses the MCB chain after a driver init to add the correct subsytem 
   696                              <1> ; information and owner to each memory block. Used for drivers that allocate
   697                              <1> ; their own memory using ALLOC.
   698                              <1> ;All drivers (kernel and config) initialise using sysinit's own PSP. Thus
   699                              <1> ; any allocations made during this time result in arenas with owner 
   700                              <1> ; of qword [currentPSP]. We replace each such owner with mcbOwnerDOS and
   701                              <1> ; set the subsytem mark to driver extra. This works because in config.sys
   702                              <1> ; we load the driver into its own arena first and modify the MCB manually.
   703                              <1> ;Kernel drivers dont have a separate allocation so any allocation after 
   704                              <1> ; init must be an extra block.
   705                              <1> ;Input: Nothing
   706                              <1> ;Output: Sets all MCBs with currentPSP owner to mcbOwnerDOS and mcbSubDrvExtra
   707 000008B7 50                  <1>     push rax
   708 000008B8 56                  <1>     push rsi
   709 000008B9 57                  <1>     push rdi
   710 000008BA 488BBD[00000000]    <1>     mov rdi, qword [rbp + currentPSP]
   711 000008C1 488BB5[00000000]    <1>     mov rsi, qword [rbp + mcbChainPtr] ;Points to the kernel allocation
   712 000008C8 EB0E                <1>     jmp short .gotoNextBlock    ;Skip the first alloc (the kernel)
   713                              <1> .checkSubsystem:
   714 000008CA 48397E01            <1>     cmp qword [rsi + mcb.owner], rdi
   715 000008CE 7508                <1>     jne short .gotoNextBlock
   716                              <1> ;Twiddle this newly allocated block!
   717 000008D0 C6460D4C            <1>     mov byte [rsi + mcb.subSysMark], mcbSubDrvExtra
   718 000008D4 C6460108            <1>     mov byte [rsi + mcb.owner], mcbOwnerDOS
   719                              <1> .gotoNextBlock:
   720 000008D8 803E5A              <1>     cmp byte [rsi + mcb.marker], mcbMarkEnd
   721 000008DB 7413                <1>     je short .exit
   722 000008DD 8B4609              <1>     mov eax, dword [rsi + mcb.blockSize]
   723 000008E0 48C1E004            <1>     shl rax, 4
   724 000008E4 4881C610000000      <1>     add rsi, mcb.program    
   725 000008EB 4801C6              <1>     add rsi, rax
   726 000008EE EBDA                <1>     jmp short .checkSubsystem
   727                              <1> .exit:
   728 000008F0 5F                  <1>     pop rdi
   729 000008F1 5E                  <1>     pop rsi
   730 000008F2 58                  <1>     pop rax
   731                              <1>     return
    13                              <2> %%_ret:
    14 000008F3 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
