   946                              <1> setupInterruptBlock:
   947                              <1> ;Sets up a block of interrupts with pointers provided in a table
   948                              <1> ;Input:
   949                              <1> ; al = Start interrupt
   950                              <1> ; rdi -> Start of pointer table
   951                              <1> ; cl = Last interrupt + 1
   952                              <1> ;Assumes rbp points to DOSSEG
   953 00000ACA 0FB6C0              <1>     movzx eax, al
   954 00000ACD 0FB6C9              <1>     movzx ecx, cl
   955                              <1> .lp:
   956 00000AD0 488B1F              <1>     mov rbx, qword [rdi]    ;Get address pointed to by rdi
   957 00000AD3 4801EB              <1>     add rbx, rbp            ;Add the relocated base to rbx
   958 00000AD6 E80E000000          <1>     call writeIDTEntry
   959 00000ADB 4881C708000000      <1>     add rdi, 8  ;Goto next interrupt handler
   960 00000AE2 FFC0                <1>     inc eax     ;Goto next interrupt number
   961 00000AE4 39C8                <1>     cmp eax, ecx
   962 00000AE6 75E8                <1>     jne .lp
   963                              <1>     return
    13                              <2> %%_ret:
    14 00000AE8 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   964                              <1> 
   965                              <1> writeIDTEntry:
   966                              <1> ;Writes the interrupt in the right place in the table
   967                              <1>     ;al = Interrupt number
   968                              <1>     ;rbx -> Handler to install
   969 00000AE9 50                  <1>     push rax
   970 00000AEA 53                  <1>     push rbx
   971 00000AEB 0FB6C0              <1>     movzx eax, al
   972 00000AEE 4893                <1>     xchg rbx, rax
   973 00000AF0 48C1E304            <1>     shl rbx, 4h     ;Multiply IDT entry number by 16
   974 00000AF4 48031D(BA010000)    <1>     add rbx, qword [localIDTpointer.Base]    ;rsx points to IDT entry
   975 00000AFB 668903              <1>     mov word [rbx], ax  ;Get low word into offset 15...0
   976 00000AFE 48C1E810            <1>     shr rax, 10h    ;Bring next word low
   977 00000B02 66894306            <1>     mov word [rbx + 6], ax  ;Get low word into offset 31...16
   978 00000B06 48C1E810            <1>     shr rax, 10h    ;Bring last dword low
   979 00000B0A 894308              <1>     mov dword [rbx + 8], eax
   980 00000B0D 5B                  <1>     pop rbx
   981 00000B0E 58                  <1>     pop rax
   982 00000B0F C3                  <1>     ret
    21                                  %include "./src/dos/Sysinit/cfginit.asm"
     1                              <1> ;------------------------------------------------;
     2                              <1> ;              Process CONFIG.SYS                ;
     3                              <1> ;------------------------------------------------;
     4                              <1> ;Create a stack frame with the following order.
     5                              <1> ;Values greater than max are set to max. Values less than min are set to min.
     6                              <1> ; New Buffers value.        Default = 30, Min = 1, Max = 99
     7                              <1> ; New SFT value.            Default = 20, Min = 8, Max = 254
     8                              <1> ; New FCBS value.           Default = 4,  Min = 4, Max = 254
     9                              <1> ; New protected FCBS value. Default = 0,  Min = 0, Max = New FCBS value
    10                              <1> ; New CDS value.            Default = 5,  Min = 5, Max = 26
    11                              <1> ;
    12                              <1> ;Remember to maintain the base of occupied memory on stack (endPtr)
    13                              <1> ;-------------------------------------------------------------------------;
    14                              <1> ; CONFIG.SYS processing pseudocode:-
    15                              <1> ;
    16                              <1> ; _START:
    17                              <1> ; Read file one byte at a time a until a EOF or CR encountered.
    18                              <1> ; If (EOF encountered)
    19                              <1> ;   Insert a terminating ^Z to the end of the line. 
    20                              <1> ;   Close handle.
    21                              <1> ; Parse the line from beginning looking for a DOS terminating char.
    22                              <1> ;   If (CR or EOF encoutered before terminating char)
    23                              <1> ;       Bad line error msg. 
    24                              <1> ;       If (CR encountered)
    25                              <1> ;           Goto _START
    26                              <1> ;       Else
    27                              <1> ;           Goto _EXIT
    28                              <1> ;   Else 
    29                              <1> ;       If (Keyword AND not DEVICE) 
    30                              <1> ;           Store it's value on stack or change internal variable value
    31                              <1> ;       If (DEVICE)
    32                              <1> ;           Move endPtr after end of line and try load the driver.
    33                              <1> ;           If (driver doesn't exist or fails to init)
    34                              <1> ;               print bad driver error msg.
    35                              <1> ;       Else 
    36                              <1> ;           Bad line error msg
    37                              <1> ;       If (line terminated by CR)
    38                              <1> ;           Goto _START
    39                              <1> ; _EXIT:
    40                              <1> ;-------------------------------------------------------------------------;
    41                              <1> ; Note:
    42                              <1> ; If driver a Block Device Driver, build all the DPB's for it (up until max)
    43                              <1> ;   directly after the driver pointer as returned by the driver. Then, 
    44                              <1> ;   adjust the memory pointer and start loading next line.
    45                              <1> ; Once EOF has been reached, we jmp to noCfg which configures the other
    46                              <1> ;   data structures according to the values on the stack frame.
    47                              <1> ;-------------------------------------------------------------------------;
    48                              <1> ;Start CONFIG.SYS parsing here
    49                              <1> configParse:
    50 00000B10 488945C0            <1>     mov qword [rbp - cfgFrame.cfgHandle], rax
    51 00000B14 48C745B800000000    <1>     mov qword [rbp - cfgFrame.lastLine], 0
    52 00000B1C 48C745B0FFFFFFFF    <1>     mov qword [rbp - cfgFrame.linePtr], -1   ;Default buffer
    53 00000B24 B800480000          <1>     mov eax, 4800h
    54 00000B29 BB10000000          <1>     mov ebx, 10h    ;Request 16 paragraphs (256 bytes)
    55 00000B2E CD21                <1>     int 21h
    56 00000B30 0F825D010000        <1>     jc .stopProcessError
    57 00000B36 488945B0            <1>     mov qword [rbp - cfgFrame.linePtr], rax
    58 00000B3A 4889C2              <1>     mov rdx, rax    ;Move the pointer to rdx
    59 00000B3D 482D10000000        <1>     sub rax, mcb_size 
    60 00000B43 48C7400108000000    <1>     mov qword [rax + mcb.owner], mcbOwnerDOS    ;Set owner to DOS
    61 00000B4B 31C0                <1>     xor eax, eax
    62                              <1> .nextChar:
    63 00000B4D 488B5DC0            <1>     mov rbx, qword [rbp - cfgFrame.cfgHandle]   ;Move the handle into ebx
    64 00000B51 6681FBFFFF          <1>     cmp bx, -1
    65 00000B56 0F8437010000        <1>     je .stopProcessError
    66 00000B5C B8003F0000          <1>     mov eax, 3F00h  ;Read handle
    67 00000B61 B901000000          <1>     mov ecx, 1  ;Read one byte
    68 00000B66 CD21                <1>     int 21h
    69 00000B68 0F8225010000        <1>     jc .stopProcessError
    70 00000B6E 85C0                <1>     test eax, eax	;If this is zero, EOF reached, take command
    71 00000B70 741B                <1>     jz .endOfFile
    72                              <1> .notEOF:
    73 00000B72 0FB602              <1>     movzx eax, byte [rdx]
    74 00000B75 3C0D                <1>     cmp al, CR
    75 00000B77 741F                <1>     je short .endOfLine
    76 00000B79 3C0A                <1>     cmp al, LF
    77 00000B7B 7418                <1>     je short .endOfLineChange   ;Continue, but replace with standard EOL char (CR)
    78 00000B7D 3C1A                <1>     cmp al, EOF
    79 00000B7F 740C                <1>     je short .endOfFile
    80 00000B81 E8F9090000          <1>     call .ucChar    ;Uppercase the char
    81 00000B86 8802                <1>     mov byte [rdx], al  ;Replace the char with the capitalised form
    82                              <1> .notChar:
    83 00000B88 48FFC2              <1>     inc rdx ;Now move our local pointer to the next byte
    84 00000B8B EBC0                <1>     jmp short .nextChar
    85                              <1> .endOfFile:
    86 00000B8D 48C745B8FFFFFFFF    <1>     mov qword [rbp - cfgFrame.lastLine], -1	;Mark EOF and End of line
    87                              <1> .endOfLineChange:
    88 00000B95 C6020D              <1>     mov byte [rdx], CR  ;Store a terminating char at the end of the command
    89                              <1> .endOfLine:
