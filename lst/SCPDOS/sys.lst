   880                              <1> buildKernDPBs:
   881                              <1> ;This is a wrapper for the below to be used ONLY FOR LOADING KERNEL DRIVERS. 
   882                              <1> ; If at boot time a FAT32 partition is detected, this otherwise would cause 
   883                              <1> ; the system to crash as build dpb requires at least one buffer in the buffer
   884                              <1> ; chain. So here we allocate one 4Kb buffer and place it in the chain. Once we 
   885                              <1> ; are done, we free this buffer.
   886 00000A3C 50                  <1>     push rax
   887 00000A3D 4150                <1>     push r8
   888 00000A3F B800480000          <1>     mov eax, 4800h  ;ALLOC, get ptr in rax
   889 00000A44 53                  <1>     push rbx
   890                              <1> ;100h for 4Kb + space for a buffer header!
   891 00000A45 BB02010000          <1>     mov ebx, 100h + ((bufferHdr_size + 0Fh) >> 4)
   892 00000A4A CD21                <1>     int 21h
   893 00000A4C 5B                  <1>     pop rbx
   894 00000A4D 7235                <1>     jc .exit
   895 00000A4F 4989C0              <1>     mov r8, rax
   896                              <1>     ;Setup MCB metadata
   897 00000A52 41C640FD42          <1>     mov byte [r8 + mcb.subSysMark - mcb_size], mcbSubBuffers
   898                              <1>     ;Setup Buffer
   899 00000A57 49C700FFFFFFFF      <1>     mov qword [r8 + bufferHdr.nextBufPtr], -1
   900 00000A5E 49C74008FF000000    <1>     mov qword [r8 + bufferHdr.wDrvNumFlg], freeBuffer
   901 00000A66 4C8985[00000000]    <1>     mov qword [rbp + bufHeadPtr], r8
   902 00000A6D E816000000          <1>     call buildDPBs  ;Call function
   903 00000A72 48C785[00000000]FF- <1>     mov qword [rbp + bufHeadPtr], -1    ;Now empty the buffer pointer
   903 00000A7A FFFFFF              <1>
   904 00000A7D B800490000          <1>     mov eax, 4900h  ;Free the ptr in r8
   905 00000A82 CD21                <1>     int 21h
   906                              <1> .exit:
   907 00000A84 4158                <1>     pop r8
   908 00000A86 58                  <1>     pop rax
   909                              <1>     return
    13                              <2> %%_ret:
    14 00000A87 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   910                              <1> buildDPBs:
   911                              <1>     ;Here we specially handle MSD drivers, building DPBs
   912                              <1>     ;If return with CF=CY, fail. Else, all done and setup
   913                              <1>     ;Input: rbx -> Points to sysinit request packet
   914                              <1>     ;       rsi -> Driver header
   915                              <1>     ;       rbp -> DOSSEG pointer
   916                              <1>     ;Preserves those registers
   917 00000A88 53                  <1>     push rbx
   918 00000A89 55                  <1>     push rbp
   919 00000A8A 56                  <1>     push rsi
   920 00000A8B 57                  <1>     push rdi
   921 00000A8C 4889F7              <1>     mov rdi, rsi    ;SAVE THE DRIVER HEADER!
   922 00000A8F 0FB64E1A            <1>     movzx ecx, byte [rsi + drvHdr.drvUnt]  ;Get # of units reported by driver
   923 00000A93 488B7316            <1>     mov rsi, qword [rbx + initReqPkt.optptr]
   924 00000A97 B835000000          <1>     mov eax, dpb_size
   925 00000A9C F7E1                <1>     mul ecx         ;Get the number of bytes for all the dpb's into eax
   926 00000A9E 050F000000          <1>     add eax, 0Fh    ;Round up if not precisely on para boundry
   927 00000AA3 C1E804              <1>     shr eax, 4      ;Convert to paragraphs
   928 00000AA6 89C3                <1>     mov ebx, eax
   929 00000AA8 B800480000          <1>     mov eax, 4800h  ;ALLOC (marked as owned by DOS for now)
   930 00000AAD CD21                <1>     int 21h
   931 00000AAF 7214                <1>     jc short .exit
   932 00000AB1 4889C5              <1>     mov rbp, rax    
   933 00000AB4 C640FD50            <1>     mov byte [rax + mcb.subSysMark - mcb_size], mcbSubDrvDPB  ;Set DPB marker
   934 00000AB8 48C740F108000000    <1>     mov qword [rax + mcb.owner - mcb_size], mcbOwnerDOS    ;Set DOS owner
   935                              <1>     ;rsi -> Ptr to BPB array
   936                              <1> 	;rbp -> Ptr to buffer to hold first DPB
   937                              <1>     ;rdi -> Ptr to the driver header
   938 00000AC0 E82FFEFFFF          <1>     call convertBPBArray    ;Returns rbp -> past last DPB
   939                              <1> .exit:
   940 00000AC5 5F                  <1>     pop rdi
   941 00000AC6 5E                  <1>     pop rsi
   942 00000AC7 5D                  <1>     pop rbp
   943 00000AC8 5B                  <1>     pop rbx
   944                              <1>     return
    13                              <2> %%_ret:
    14 00000AC9 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
