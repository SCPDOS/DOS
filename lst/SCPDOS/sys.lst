   762 000012C6 53                  <1>     push rbx    ;File handle
   763 000012C7 51                  <1>     push rcx    ;Size of file allocation
   764 000012C8 56                  <1>     push rsi    ;Section alignement requirement
   765 000012C9 57                  <1>     push rdi    ;Ptr to memory block with imageFileOptionalHeader
   766 000012CA 4150                <1>     push r8     ;Save the input memory block ptr
   767                              <1> ;Get the filesize and return the fileptr back to the the start of the file
   768 000012CC 31C9                <1>     xor ecx, ecx    ;Go to end of file (preserved across these calls)
   769 000012CE 31D2                <1>     xor edx, edx
   770 000012D0 B802420000          <1>     mov eax, 4202h  ;LSEEK from end of file to get the size
   771 000012D5 CD21                <1>     int 21h
   772 000012D7 0F82B4000000        <1>     jc .dpdcBad
   773 000012DD 50                  <1>     push rax        ;Only saving eax as this contains the file size.
   774 000012DE 31D2                <1>     xor edx, edx
   775 000012E0 B800420000          <1>     mov eax, 4200h  ;Move file pointer back to the start of the file
   776 000012E5 CD21                <1>     int 21h
   777 000012E7 0F82A4000000        <1>     jc .dpdcBad
   778 000012ED 59                  <1>     pop rcx         ;Get the file size in ecx
   779 000012EE 87D9                <1>     xchg ebx, ecx   ;Swap the handle in rbx with the filesize
   780 000012F0 81C30F000000        <1>     add ebx, 0Fh    ;Ensure ebx is paragraph aligned
   781 000012F6 C1EB04              <1>     shr ebx, 4      ;Get number of paragraphs to now be 
   782 000012F9 B800480000          <1>     mov eax, 4800h  ;Now we allocate a new block to contain the whole file.
   783 000012FE CD21                <1>     int 21h         ;Allocate as realloc might not have enough space...
   784 00001300 0F828B000000        <1>     jc .dpdcBad
   785 00001306 4989C0              <1>     mov r8, rax
   786 00001309 C1E304              <1>     shl ebx, 4      ;Turn back into bytes
   787 0000130C 87D9                <1>     xchg ebx, ecx   ;Swap back the file handle and file size
   788 0000130E B8003F0000          <1>     mov eax, 3F00h  ;Read
   789 00001313 4C89C2              <1>     mov rdx, r8     ;Point to the buffer in rdi (same as r8)
   790 00001316 CD21                <1>     int 21h
   791 00001318 7270                <1>     jc .dpdcBadFree
   792 0000131A 39C8                <1>     cmp eax, ecx    ;Was the count the same?
   793 0000131C 756C                <1>     jne .dpdcBadFree
   794                              <1> ;Now point rdi to to the checksum variable in the header space
   795 0000131E 4C89C6              <1>     mov rsi, r8    ;Point rsi as the source of bytes
   796 00001321 410FB7403C          <1>     movzx eax, word [r8 + imageDosHdr.e_lfanew]
   797 00001326 498D7C0058          <1>     lea rdi, qword [r8 + rax + coffHdr_size + imageFileOptionalHeader.dCheckSum]
   798                              <1> ;Now we do the computation sequentially. Use edx as the accumulator.
   799 0000132B 51                  <1>     push rcx    ;Save the filesize count. 
   800 0000132C 31D2                <1>     xor edx, edx    ;Clear the accumulator
   801                              <1> .dpdcLp:
   802 0000132E 4839FE              <1>     cmp rsi, rdi    ;Are we at the checksum in the header?
   803 00001331 750F                <1>     jne .dpdcNotEq
   804                              <1> ;Here we do the checksum adjustment.
   805 00001333 4881C604000000      <1>     add rsi, 4
   806 0000133A 81E904000000        <1>     sub ecx, 4
   807 00001340 EB19                <1>     jmp short .dpdcOvflowChk
   808                              <1> .dpdcNotEq:
