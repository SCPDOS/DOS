   750 000012C1 E9B5F9FFFF          <1>     jmp .skipSeparators ;Return through this function.
   751                              <1> .drvPeDoChksum:
   752                              <1> ;Compute PE checksum of the file before loading and compare 
   753                              <1> ; against checksum in header. If not equal, skip loading it.
   754                              <1> ;Input: ebx = File handle to read
   755                              <1> ;       ecx = Size of allocation for executable file
   756                              <1> ;       esi = Section alignment 
   757                              <1> ;       rdi -> Ptr to memory block with imageFileOptionalHeader
   758                              <1> ;       rbp -> Cfg frame
   759                              <1> ;       r8 -> Memory block ptr
