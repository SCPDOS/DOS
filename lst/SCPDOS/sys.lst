   919                              <1> .sftHandlerMul:
   920                              <1> ;Input:
   921                              <1> ;al = digit to add to result (ASCII digit)
   922                              <1> ;ecx = whether al is a unit (0), ten (1) or hundred (2)
   923                              <1> ;rdx = Accumulated sum
   924                              <1> ;Output:
   925                              <1> ;rdx = Accumulated sum with al added
   926                              <1> ;eax is destroyed
   927                              <1> ;All other registers preserved
   928 00001478 51                  <1>     push rcx
   929 00001479 52                  <1>     push rdx
   930 0000147A 0FB6C0              <1>     movzx eax, al
   931 0000147D 2D30000000          <1>     sub eax, '0' ;Convert to a binary digit
   932 00001482 BA01000000          <1>     mov edx, 1    ;Get 1 in edx (multiplicative unit)
   933 00001487 39D1                <1>     cmp ecx, edx  ;Was cl a ten?
   934 00001489 BB0A000000          <1>     mov ebx, 10     ;Default base offset to 10
   935 0000148E B964000000          <1>     mov ecx, 100
   936 00001493 0F42DA              <1>     cmovb ebx, edx  ;If below, it was a unit
   937 00001496 0F47D9              <1>     cmova ebx, ecx  ;If above, it was a hundred
   938 00001499 F7E3                <1>     mul ebx    ;Multiply the base offset to eax
   939 0000149B 5A                  <1>     pop rdx ;Get the accumulated value back
   940 0000149C 01C2                <1>     add edx, eax    ;Add this result over
   941 0000149E 59                  <1>     pop rcx
   942                              <1>     return
    13                              <2> %%_ret:
    14 0000149F C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
