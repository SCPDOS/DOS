   867                              <1> .sftHandler:
   868                              <1> ;This reads the line to set the number of FILE to between 1 and 254
   869 000013F4 488B75B0            <1>     mov rsi, qword [rbp - cfgFrame.linePtr]
   870 000013F8 4881C605000000      <1>     add rsi, 5  ;Go past FILES=
   871 000013FF E877F8FFFF          <1>     call .skipSeparators
   872                              <1>     ;This must be at most three digits, anything else is a failure
   873 00001404 4889F7              <1>     mov rdi, rsi    ;Save the start in rdi
   874 00001407 31C9                <1>     xor ecx, ecx
   875 00001409 AC                  <1>     lodsb   ;Get the first char. Must be between ASCII '0' and '9'
   876 0000140A 3C30                <1>     cmp al, "0"
   877 0000140C 0F828E000000        <1>     jb .sftHandlerErr
   878 00001412 3C39                <1>     cmp al, "9"
   879 00001414 0F8786000000        <1>     ja .sftHandlerErr
   880 0000141A FFC1                <1>     inc ecx ;Increment char counter
   881 0000141C AC                  <1>     lodsb   ;Get second char
   882 0000141D E869010000          <1>     call .termCheck
   883 00001422 7424                <1>     je .sftHandlerProcess   ;If it is a terminating char, exit
   884 00001424 3C30                <1>     cmp al, "0"
   885 00001426 7278                <1>     jb .sftHandlerErr
   886 00001428 3C39                <1>     cmp al, "9"
   887 0000142A 7774                <1>     ja .sftHandlerErr
   888 0000142C FFC1                <1>     inc ecx ;Increment char counter
   889 0000142E AC                  <1>     lodsb   ;Get third char
   890 0000142F E857010000          <1>     call .termCheck
   891 00001434 7412                <1>     je .sftHandlerProcess   ;If it is a terminating char, exit
   892 00001436 3C30                <1>     cmp al, "0"
   893 00001438 7266                <1>     jb .sftHandlerErr
   894 0000143A 3C39                <1>     cmp al, "9"
   895 0000143C 7762                <1>     ja .sftHandlerErr
   896 0000143E AC                  <1>     lodsb   ;Check no more chars!
   897 0000143F E847010000          <1>     call .termCheck
   898 00001444 755A                <1>     jne .sftHandlerErr
   899 00001446 FFC1                <1>     inc ecx ;Increment char counter
   900                              <1> .sftHandlerProcess:
   901 00001448 31D2                <1>     xor edx, edx    ;Accumulate value in edx
   902 0000144A 4889FE              <1>     mov rsi, rdi    ;Go back to the first number
   903                              <1> .sftHandlerLp:
   904 0000144D FFC9                <1>     dec ecx
   905 0000144F AC                  <1>     lodsb   ;Get the digit
