    34                              <1> ;----------------------------
    35                              <1> ;   EXE header structures   :
    36                              <1> ;----------------------------
    37                              <1> 
    38                              <1> ;PE Headers have the following structure:
    39                              <1> ; 1) MZ Header
    40                              <1> ; 2) MZ executable
    41                              <1> ; 3) COFF Header
    42                              <1> ; 4) COFF Optional Header, if COFF Header.wSizeOfOptionalHdr ! = 0
    43                              <1> ; 5) Data directories, if COFF Optional Header.wSizeOfOptionalHdr ! = 0
    44                              <1> ; 6) Section Table, if COFF Header.wNumberOfSections != 0
    45                              <1> ; 7) Padding, if COFF Optional Header(.dSizeOfHeaders != .dSectionAlignment)
    46                              <1> 
    47                              <1> ;The COFF headers + the data directories form the magical ``PE'' header.
    48                              <1> 
    49                              <1> ;DOS MZ .EXE header. Functionally useless except for e_magic and e_lfanew
    50                              <1> dosMagicSignature   equ "MZ"
    51                              <1> dosMagicSignature2  equ "ZM"
    52                              <1> struc imageDosHdr
    53 00000000 ????                <1>     .e_magic    dw ?            ;Magic number
    54 00000002 ????                <1>     .e_cblp     dw ?            ;Bytes on last page of file
    55 00000004 ????                <1>     .e_cp       dw ?            ;Pages in file (page = 512 bytes in MSDOS)
    56 00000006 ????                <1>     .e_crlc     dw ?            ;Relocations
    57 00000008 ????                <1>     .e_cparhdr  dw ?            ;Size of header in paragraphs
    58 0000000A ????                <1>     .e_minalloc dw ?            ;Minimum extra paragraphs needed
    59 0000000C ????                <1>     .e_maxalloc dw ?            ;Maximum extra paragraphs needed
    60 0000000E ????                <1>     .e_ss       dw ?            ;Initial (relative) SS value
    61 00000010 ????                <1>     .e_sp       dw ?            ;Initial SP value
    62 00000012 ????                <1>     .e_csum     dw ?            ;Checksum
    63 00000014 ????                <1>     .e_ip       dw ?            ;Initial IP value
    64 00000016 ????                <1>     .e_cs       dw ?            ;Initial (relative) CS value
    65 00000018 ????                <1>     .e_lfarlc   dw ?            ;File address of relocation table
    66 0000001A ????                <1>     .e_ovno     dw ?            ;Overlay number
    67 0000001C ????????????????    <1>     .e_res      dw 4 dup (?)    ;Reserved words
    68 00000024 ????                <1>     .e_oemid    dw ?            ;OEM identifier (for e_oeminfo)
    69 00000026 ????                <1>     .e_oeminfo  dw ?            ;OEM information; e_oemid specific
    70 00000028 <res 14h>           <1>     .e_res2     dw 10 dup (?)   ;Reserved words
    71 0000003C ????????            <1>     .e_lfanew   dd ?            ;File address of new exe header
    72                              <1> endstruc
    73                              <1> 
    74                              <1> ;Possible signatures pointed to by e_lfanew
    75                              <1> imageDosSignature   equ 05A4Dh      ;MZ, REJECT
    76                              <1> imageOS2Signature   equ 0454Eh      ;NE, REJECT
    77                              <1> imageOS2SignatureLE equ 0454Ch      ;LE, REJECT
    78                              <1> imagePESignature    equ 00004550h   ;PE00, ACCEPT
    79                              <1> 
    80                              <1> ;COFF File header @ [e_lfanew]
    81                              <1> 
    82                              <1> struc imageFileHeader
    83 00000000 ????????            <1>     .dPESignature        dd ?   ;PESignature, must be PE00
    84 00000004 ????                <1>     .wMachineType        dw ?   ;Machine Type, must be imageFileMachineAMD64
    85 00000006 ????                <1>     .wNumberOfSections   dw ?   ;Number of sections in file
    86 00000008 ????????            <1>     .dTimeDateStamp      dd ?   ;Unix datestamp,                 NOT USED
    87 0000000C ????????            <1>     .dPtrToSymbolTbl     dd ?   ;Pointer to the symbol table,    NOT USED
    88 00000010 ????????            <1>     .dNumberOfSymbols    dd ?   ;Number of symbols in the table, NOT USED
    89 00000014 ????                <1>     .wSizeOfOptionalHdr  dw ?   ;Size of the optional header
    90 00000016 ????                <1>     .wCharacteristics    dw ?   ;Bitfield characteristics
    91                              <1> endstruc
    92                              <1> coffHdr_size equ imageFileHeader_size
    93                              <1> ;The only valid values in the .machineType field
    94                              <1> imageFileMachineUnknown equ 0
    95                              <1> imageFileMachineAMD64   equ 08664h 
    96                              <1> 
    97                              <1> ;Characteristics to check for
    98                              <1> imageFileRelocsStripped equ 0001h   ;If set, base addr MUST equal load addr
    99                              <1> imageFileExecutable     equ 0002h   ;Must always be set else badfmterr
   100                              <1> 
   101                              <1> ;COFF Optional header
   102                              <1> 
   103                              <1> struc imageFileOptionalHeader
   104 00000000 ????                <1> 	.wMagic                     dw ?    ;peMagicNumber (must be 020Bh).
   105 00000002 ??                  <1> 	.bMajorLinkerVersion        db ?    ;Not used.
   106 00000003 ??                  <1> 	.bMinorLinkerVersion        db ?    ;Not used.
   107 00000004 ????????            <1> 	.dSizeOfCode                dd ?    ;Size of Code.
   108 00000008 ????????            <1> 	.dSizeOfInitializedData     dd ?    ;Size of DATA.
   109 0000000C ????????            <1> 	.dSizeOfUninitializedData   dd ?    ;Size of BSS.
   110 00000010 ????????            <1> 	.dAddressOfEntryPoint       dd ?    ;Relative address of code EP.
   111 00000014 ????????            <1> 	.dBaseOfCode                dd ?    ;Distance from qImageBase to code seg.
   112 00000018 ????????????????    <1>     .qImageBase                 dq ?    ;Preferred load address.
   113 00000020 ????????            <1> 	.dSectionAlignment          dd ?    ;Alignment of start of segs in mem.
   114 00000024 ????????            <1> 	.dFileAlignment             dd ?    ;Alignment of start of segs in file.
   115 00000028 ????                <1> 	.wMajOSVer                  dw ?    ;Not used.
   116 0000002A ????                <1> 	.wMinOSVer                  dw ?    ;Not used.
   117 0000002C ????                <1> 	.wMajorImageVersion         dw ?    ;Not used.
   118 0000002E ????                <1> 	.wMinorImageVersion         dw ?    ;Not used.
   119 00000030 ????                <1> 	.wMajorSubsystemVersion     dw ?    ;Not used.
   120 00000032 ????                <1> 	.wMinorSubsystemVersion     dw ?    ;Not used.
   121 00000034 ????????            <1> 	.dWin32VersionValue         dd ?    ;Not used.
   122 00000038 ????????            <1> 	.dSizeOfImage               dd ?    ;Total aligned in memory alloc size.
   123 0000003C ????????            <1> 	.dSizeOfHeaders             dd ?    ;Rounded to file alignment.
   124 00000040 ????????            <1> 	.dCheckSum                  dd ?    ;Checked on PE driver loads.
   125 00000044 ????                <1> 	.wSubsystem                 dw ?    ;Not used. For VMEMD.
   126 00000046 ????                <1> 	.wDllCharacteristics        dw ?
   127 00000048 ????????????????    <1> 	.qSizeOfStackReserve        dq ?    ;Not used by default. For VMEMD.
   128 00000050 ????????????????    <1> 	.qSizeOfStackCommit         dq ?    ;Default stack allocation is 256Kb
   129 00000058 ????????????????    <1> 	.qSizeOfHeapReserve         dq ?    ;Not used by default. For VMEMD.
   130 00000060 ????????????????    <1> 	.qSizeOfHeapCommit          dq ?    ;Not used by default. For VMEMD.
   131 00000068 ????????            <1> 	.dLoaderFlags               dd ?
   132 0000006C ????????            <1> 	.dNumberOfRvaAndSizes       dd ?    ;Number of data dirs entries in header
   133                              <1> endstruc
   134                              <1> 
   135                              <1> optCoffHdr_size equ imageFileOptionalHeader_size
   136                              <1> coffHdrs_size equ coffHdr_size + optCoffHdr_size
   137                              <1> 
   138                              <1> romMagicNum     equ 0107h
   139                              <1> pe32MagicNum    equ 010Bh
   140                              <1> pe64MagicNum    equ 020Bh
   141                              <1> 
   142                              <1> ;Data directory header structure
   143                              <1> struc imageDataDirectory
   144 00000000 ????????            <1>     .dVAddr dd ?
   145 00000004 ????????            <1>     .dSize  dd ?    ;Directory size
   146                              <1> endstruc
   147                              <1> 
   148                              <1> dataDir_eData   equ 1   ;Export Table directory entry
   149                              <1> dataDir_iData   equ 2   ;Import Table directory entry
   150                              <1> dataDir_rsrc    equ 3   ;Resource Table directory entry
   151                              <1> dataDir_pData   equ 4   ;Exception Table directory entry
   152                              <1> dataDir_reloc   equ 6   ;Base relocation Table directory entry
   153                              <1> dataDir_debug   equ 7   ;Debug Table directory entry
   154                              <1> 
   155                              <1> struc baseRelocBlock    
   156                              <1> ;Struct for entries in the base reloc table. 
   157                              <1> ; Each table entry points to a word. 
   158                              <1> ; High 4 bits are type of reloc (all must be 0Ah)
   159 00000000 ????????            <1>     .dPageRVA   dd ?    ;Offset from the load address
   160 00000004 ????????            <1>     .dSize      dd ?    ;Number of bytes in this block
   161                              <1> endstruc
   162                              <1> 
   163                              <1> ;Section headers that form the Section Table after the data dir tables.
   164                              <1> ;There are wNumberOfSections many entries in this table.
   165                              <1> ;Each entry is one imageSectionHdr
   166                              <1> struc imageSectionHdr       ;size 40 bytes
   167 00000000 ????????????????    <1>     .qName                  db 8 dup (?)
   168 00000008 ????????            <1> 	.dVirtualSize           dd ?    ;Size of data in section
   169 0000000C ????????            <1> 	.dVirtualAddress        dd ?    ;Offset of section from load address
   170 00000010 ????????            <1> 	.dSizeOfRawData         dd ?    ;Size of section in image (File Aligned)
   171 00000014 ????????            <1> 	.dPointerToRawData      dd ?    ;Offset of section from head of image
   172 00000018 ????????            <1> 	.dPointerToRelocations  dd ?
   173 0000001C ????????            <1> 	.dPointerToLinenumbers  dd ?
   174 00000020 ????                <1> 	.wNumberOfRelocations   dw ?
   175 00000022 ????                <1> 	.wNumberOfLinenumbers   dw ?
   176 00000024 ????????            <1> 	.dCharacteristics       dd ?
   177                              <1> endstruc
   178                              <1> 
   179                              <1> ;Section Hdr characteristics flags 
   180                              <1> imgScnCntCode   equ 20h     ;The section contains executable code.
   181                              <1> imgScnCntData   equ 40h     ;The section contains initialized data.
   182                              <1> imgScnCntBSS    equ 80h     ;The section contains uninitialized data.
   183                              <1> imgScnMemDiscrd equ 2000000h    ;Section marked discardable
