     1                              <1> ;DOS Error codes
     2                              <1> ;Where new codes are needed, we base them on Windows error codes
     3                              <1> ;----------------------------------------------
     4                              <1> ;             Extended Error Codes
     5                              <1> ;----------------------------------------------
     6                              <1> errInvFnc   equ 1   ;Invalid function number
     7                              <1> errFnf      equ 2   ;File not found
     8                              <1> errPnf      equ 3   ;Path not found
     9                              <1> errNhl      equ 4   ;Too many open handles, no handles left
    10                              <1> errAccDen   equ 5   ;Access denied (to resource)
    11                              <1> errBadHdl   equ 6   ;Invalid handle
    12                              <1> errMCBbad   equ 7   ;MCB's destroyed
    13                              <1> errNoMem    equ 8   ;Insufficient memory
    14                              <1> errMemAddr  equ 9   ;Invalid Memory Block Address
    15                              <1> errBadEnv   equ 10  ;Invalid environment
    16                              <1> errBadFmt   equ 11  ;Invalid format (path etc)
    17                              <1> errAccCde   equ 12  ;Invalid Access Code (bad file share mode or attribute)
    18                              <1> errInvDat   equ 13  ;Invalid data
    19                              <1> ;           equ 14  ;Reserved
    20                              <1> errBadDrv   equ 15  ;Invalid drive specified
    21                              <1> errDelCD    equ 16  ;Attempt to delete the current directory
    22                              <1> errDevUnk   equ 17  ;Not the same device (Device Unknown)
    23                              <1> errNoFil    equ 18  ;No more files, no match found
    24                              <1> ;The following are Driver error codes + 19
    25                              <1> drvErrShft  equ 19  ;Used to shift Driver error codes to extended error codes
    26                              <1> errWpd      equ 19  ;Attempt to write on write protected disk
    27                              <1> errUnkUnt   equ 20  ;Unknown Unit
    28                              <1> errDrvNR    equ 21  ;Drive not ready
    29                              <1> errUnkCmd   equ 22  ;Unknown Command
    30                              <1> errCRCerr   equ 23  ;Data (CRC) error
    31                              <1> errBadRLn   equ 24  ;Bad request structure length
    32                              <1> errSekErr   equ 25  ;Seek error
    33                              <1> errUnkMed   equ 26  ;Unknown media type
    34                              <1> errSecNF    equ 27  ;Sector not Found
    35                              <1> errNoPap    equ 28  ;Printer out of paper
    36                              <1> errWF       equ 29  ;Write fault
    37                              <1> errRF       equ 30  ;Read fault
    38                              <1> errGF       equ 31  ;General fault
    39                              <1> ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    40                              <1> ;The following two go inbetween the reserved disk errors
    41                              <1> errShrVio   equ 32  ;Sharing violations
    42                              <1> errLokVio   equ 33  ;File Lock violation
    43                              <1> ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    44                              <1> errIDC      equ 34  ;Driver code, Invalid Disk Change, settable by share
    45                              <1> errNoFCB    equ 35  ;FCB unavailable
    46                              <1> errShrFul   equ 36  ;Sharing buffer full
    47                              <1> ;The next two errors occur because an redir handle has the bit set to do this.
    48                              <1> ;We do not move the SFT in either case so that one can safely examine the
    49                              <1> ; state of the system before the call was made. In the second case,
    50                              <1> ; the user should do a 0 byte write at filesize before anything else to truncate
    51                              <1> ; any pre-allocated clusters.
    52                              <1> errHdlEOF   equ 38  ;Handle will EOF if read proceeds or at EOF. 
    53                              <1> errDskFul   equ 39  ;Disk will fill up if write proceeds or full. 
    54                              <1> ;----------------------------------------------
    55                              <1> ;             Network error codes
    56                              <1> ;----------------------------------------------
    57                              <1> errNetGeneric       equ 50  ;Network request not supported, generic net fail
    58                              <1> errNetRemNotList    equ 51  ;Cannot find the network path
    59                              <1> errNetDupName       equ 52  ;Duplicate name exists on the network
    60                              <1> errNetBadNetpath    equ 53  ;Network path not found
    61                              <1> errNetBusy          equ 54  ;Network is busy
    62                              <1> errNetDevNoExist    equ 55  ;Specified net resource or dev not available
    63                              <1> errNetBIOSCmdLimit  equ 56  ;Net BIOS command limit reached
    64                              <1> errNetAdapHdwErr    equ 57  ;Network adapter hardware error
    65                              <1> errNetBadResp       equ 58  ;Server cannot perform requested operation
    66                              <1> errNetUnexp         equ 59  ;Unexpected Network error
    67                              <1> errNetBadAdap       equ 60  ;Bad remote network adapter
    68                              <1> errPrintQueueFull   equ 61  ;Printer queue is full
    69                              <1> errNoSpool          equ 62  ;No space to store file to be printed on print srv
    70                              <1> errPrintAbort       equ 63  ;File waiting to be printed was deleted
    71                              <1> errNetNameDel       equ 64  ;Network name is no longer available
    72                              <1> errNetAccDen        equ 65  ;Network Access denied
    73                              <1> errNetBadDevType    equ 66  ;Network resource type is not correct
    74                              <1> errNetBadNetName    equ 67  ;The network name cannot be found
    75                              <1> errNetTooManyNames  equ 68  ;Name limit for local network card exceeded 
    76                              <1> errNetTooManySess   equ 69  ;The Network (NETBIOS) session limit was exceeded
    77                              <1> errNetSharingPaused equ 70  ;Remote server is paused
    78                              <1> errNetReqNotAccep   equ 71  ;Remote computer too busy to accept connections
    79                              <1> errNetRedirPaused   equ 72  ;Specified redir device has been paused
