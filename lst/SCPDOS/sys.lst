   787                              <1> ejectKernelInit:
   788                              <1> ;Reallocates the space allocated to the driver file after 
   789                              <1> ; init was called.
   790                              <1> ;Input: rbx -> Pointer to the original end of the allocation (para aligned)
   791                              <1> ;       r8 -> Points to the mcb header for reallocation
   792                              <1> ;Uses the sysinit init drive block. 
   793                              <1> ;rax, rbx, rflags trashed
   794                              <1> ;If returns CF=CY, error in reallocation.
   795 0000097B 53                  <1>     push rbx
   796 0000097C 488D1D(E3010000)    <1>     lea rbx, initDrvBlk
   797 00000983 488B430E            <1>     mov rax, qword [rbx + initReqPkt.endptr]
   798 00000987 5B                  <1>     pop rbx
   799                              <1>     ;If this endptr is zero or -1 ignore it. 
   800                              <1>     ;If this endptr is greater than the end of alloc, ignore it.
   801 00000988 4885C0              <1>     test rax, rax
   802                              <1>     retz
