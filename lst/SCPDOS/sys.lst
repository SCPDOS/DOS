   733                              <1> convertBPBArray:
   734                              <1> ;rsi -> BPB array
   735                              <1> ;rbp -> Space for cl consecutive DPB's
   736                              <1> ;rdi -> Driver header
   737                              <1> ;cl = Number of BPBs to process
   738                              <1> ;If ZF=NZ on entry, link the end of the last DPB array 
   739 000008F4 E855000000          <1>     call .findLastDPB
   740 000008F9 0FB6C9              <1>     movzx ecx, cl   ;Use ch as the unit number counter
   741                              <1> .buildNext:
   742 000008FC 640FB60425-         <1>     movzx eax, byte fs:[numPhysVol] ;Get current # drives
   742 00000901 [00000000]          <1>
   743 00000905 884500              <1>     mov byte [rbp + dpb.bDriveNumber], al   ;Set it as drvnum
   744 00000908 64FE0425[00000000]  <1>     inc byte fs:[numPhysVol]    ;One more physical volume present!
   745 00000910 886D01              <1>     mov byte [rbp + dpb.bUnitNumber], ch    ;Set unit number
   746 00000913 48897D1B            <1>     mov qword [rbp + dpb.qDriverHeaderPtr], rdi ;Store ptr to driver
   747                              <1> 
   748 00000917 56                  <1>     push rsi
   749 00000918 488B36              <1>     mov rsi, qword [rsi]    ;Get the BPB pointer from the BPB array
   750 0000091B B800530000          <1>     mov eax, 5300h ;Build DPB
   751 00000920 CD21                <1>     int 21h
   752 00000922 5E                  <1>     pop rsi
   753                              <1> 
   754 00000923 FEC5                <1>     inc ch  ;Goto next unit number
   755 00000925 38E9                <1>     cmp cl, ch  ;When equal, exit!
   756 00000927 7414                <1>     jz short .exit
   757 00000929 488D4535            <1>     lea rax, qword [rbp + dpb_size]
   758 0000092D 48894525            <1>     mov qword [rbp + dpb.qNextDPBPtr], rax
   759 00000931 4889C5              <1>     mov rbp, rax    ;Advance rbp by that amount
   760 00000934 4881C608000000      <1>     add rsi, 8 ;Go to the next BPB in the BPB array
   761 0000093B EBBF                <1>     jmp short .buildNext
   762                              <1> .exit:
   763                              <1>     ;Now set next DPB as -1 i.e end of chain!
   764 0000093D 31C0                <1>     xor eax, eax
   765 0000093F 48FFC8              <1>     dec rax
   766 00000942 48894525            <1>     mov qword [rbp + dpb.qNextDPBPtr], rax
   767 00000946 4881C535000000      <1>     add rbp, dpb_size   ;Point rbp past the next DPB
   768 0000094D C3                  <1>     ret
   769                              <1> .findLastDPB:
   770                              <1> ;Finds the last DPB and links the next DPB to it
   771 0000094E 64488B0425-         <1>     mov rax, qword fs:[dpbHeadPtr]
   771 00000953 [00000000]          <1>
   772 00000957 4885C0              <1>     test rax, rax
   773 0000095A 7415                <1>     jz short .first 
   774                              <1> .lp:
   775 0000095C 48817825FFFFFFFF    <1>     cmp qword [rax + dpb.qNextDPBPtr], -1   ;End of chain?
   776 00000964 7406                <1>     je short .lastFound
   777 00000966 488B4025            <1>     mov rax, qword [rax + dpb.qNextDPBPtr]  ;Get this pointer in rax
   778 0000096A EBF0                <1>     jmp short .lp   ;And go again
   779                              <1> .lastFound:
   780 0000096C 48896825            <1>     mov qword [rax + dpb.qNextDPBPtr], rbp  ;The next dpb will go here
   781 00000970 C3                  <1>     ret
   782                              <1> .first:
   783                              <1> ;If this is the first DPB array, set the dpbHeadPtr
   784 00000971 6448892C25-         <1>     mov qword fs:[dpbHeadPtr], rbp
   784 00000976 [00000000]          <1>
   785 0000097A C3                  <1>     ret
