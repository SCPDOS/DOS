   826 0000136A C1EA10              <1>     shr edx, 16     ;Shift high word low here
   827 0000136D 01C2                <1>     add edx, eax    ;Add them
   828                              <1> .dpdcCheckEnd:
   829 0000136F 85C9                <1>     test ecx, ecx
   830 00001371 75BB                <1>     jnz .dpdcLp
   831                              <1> .dpdcDone:
   832 00001373 59                  <1>     pop rcx
   833 00001374 01CA                <1>     add edx, ecx            ;And add the filesize to edx
   834 00001376 8B0F                <1>     mov ecx, dword [rdi]    ;Finally, read the checksum byte into ecx
   835 00001378 B800490000          <1>     mov eax, 4900h          ;And free the memory block in r8
   836 0000137D CD21                <1>     int 21h
   837 0000137F 39D1                <1>     cmp ecx, edx            ;If checksum bad, fail...
   838 00001381 7544                <1>     jne .dpdcBadCsum
   839                              <1> .dpdcExit:
