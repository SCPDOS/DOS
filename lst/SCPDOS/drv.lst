  1137                              <1> .bioSetupRegs:
  1138                              <1> ;Sets up sector to read and buffer ptr for block IO call.
  1139                              <1> ;If returns ZF=ZE then xfr 0 sectors, exit immediately
  1140                              <1> ;Input: rbp -> drvBlk
  1141                              <1> ;Output: rdi -> ioReqPkt
  1142                              <1> ;        rbp -> drvBlk
  1143                              <1> ;        rbx -> Transfer buffer
  1144                              <1> ;        rcx = Sector to transfer
  1145                              <1> ;        dl  = BIOS Drive number
  1146                              <1> ;        dword [rdi + ioReqPkt.tfrlen] set to 0
  1147                              <1> ;        esi = Number of sectors to transfer
  1148                              <1> ;        ZF=ZE if esi is 0. Else ZF=NZ.
  1149 00000AF1 488B3D(98010000)    <1>     mov rdi, qword [reqPktPtr]  ;Get ioreqpktptr in rdi
  1150 00000AF8 8B4D1B              <1>     mov ecx, dword [rbp + drvBlk.dHiddSec]  ;Goto start of volume
  1151 00000AFB 48034F1A            <1>     add rcx, qword [rdi + ioReqPkt.strtsc]  ;Get sector in volume
  1152 00000AFF 488B5F0E            <1>     mov rbx, qword [rdi + ioReqPkt.bufptr]  ;Get Memory Buffer
  1153 00000B03 0FB65508            <1>     movzx edx, byte [rbp + drvBlk.bBIOSNum] ;Get BIOS drive number
  1154 00000B07 31F6                <1>     xor esi, esi   ;Setup esi to 0 to init tfrlen to 0
  1155 00000B09 877716              <1>     xchg esi, dword [rdi + ioReqPkt.tfrlen]  ;Get the tfrlen into esi
  1156 00000B0C 85F6                <1>     test esi, esi   ;If esi is still 0, avoid doing IO
  1157                              <1>     return
    13                              <2> %%_ret:
    14 00000B0E C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
