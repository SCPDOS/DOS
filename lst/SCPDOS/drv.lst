  2299                              <1> .i2fAddTbl:
  2300                              <1> ;Adds a new entry to the drive chain and updates the multiownership bits
  2301                              <1> ; as it does :)
  2302                              <1> ;Input: rdi -> New drvBlk to link to table (can be multiple!)
  2303                              <1> ;Destroy rax, rbx and rsi
  2304 0000136D 488D35A0120000      <1>     lea rsi, .drvBlkTbl
  2305 00001374 0FB64708            <1>     movzx eax, byte [rdi + drvBlk.bBIOSNum]
  2306                              <1> .i2fATLp:
  2307 00001378 384608              <1>     cmp byte [rsi + drvBlk.bBIOSNum], al
  2308 0000137B 7526                <1>     jne .i2fATNext
  2309                              <1> ;Set that the two disks are multi owned. New cannot own the drive
  2310                              <1> ; and make sure that the new drive has the accurate changeline bit set
  2311 0000137D 66814E371000        <1>     or word [rsi + drvBlk.wDevFlgs], devMulti       ;Both drives now multi!
  2312 00001383 66814F371000        <1>     or word [rdi + drvBlk.wDevFlgs], devMulti
  2313 00001389 66816737DFFF        <1>     and word [rdi + drvBlk.wDevFlgs], ~devOwnDrv    ;New cant own drv
  2314                              <1> ;Changeline check.
  2315 0000138F 66816737FDFF        <1>     and word [rdi + drvBlk.wDevFlgs], ~devChgLine   ;Assume no changeline
  2316 00001395 66F746370200        <1>     test word [rsi + drvBlk.wDevFlgs], devChgLine   ;Do we really have cline?
  2317 0000139B 7406                <1>     jz .i2fATNext   ;Skip adding the bit if not
  2318 0000139D 66814F370200        <1>     or word [rdi + drvBlk.wDevFlgs], devChgLine     ;Add if we do 
  2319                              <1> .i2fATNext:
  2320 000013A3 48813EFFFFFFFF      <1>     cmp qword [rsi + drvBlk.pLink], -1  ;Check if we @ end of table
  2321 000013AA 480F4536            <1>     cmovne rsi, qword [rsi + drvBlk.pLink] ;Walk if not
  2322 000013AE 75C8                <1>     jne .i2fATLp    ;And go again if not
  2323 000013B0 48893E              <1>     mov qword [rsi + drvBlk.pLink], rdi ;Else, link rdi onto the end
  2324 000013B3 48C707FFFFFFFF      <1>     mov qword [rdi + drvBlk.pLink], -1  ;And terminate list @ rdi now :)
  2325 000013BA 48CF                <1>     iretq
  2326                              <1> .i2fExec:
  2327                              <1> ;We make a small change in that we clean up the flags from the stack
  2328                              <1> ; as opposed to DOS which leaves them on the stack. Doing so is fine 
  2329                              <1> ; as no useful information is ever passed in the flags from a driver
  2330                              <1> ; so by doing so, any ported applications which do an additional pop
  2331                              <1> ; from the stack to balance the stack will not be harmed by this.
