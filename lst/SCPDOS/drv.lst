  1351 00000C7F E992FAFFFF          <1>     jmp .errorExit
  1352                              <1> ;---------------------------------------------------------------------------
  1353                              <1> ;               Set Device parameters in CHS and LBA here
  1354                              <1> ;---------------------------------------------------------------------------
  1355                              <1> .ioSetDevParams:
  1356                              <1>     ;breakpoint
  1357 00000C84 9C                  <1>     pushfq
  1358                              <1> ;If the parameters are swapped, set the flags and indicate the media 
  1359                              <1> ; was swapped (even if not).
  1360 00000C85 66814D374001        <1>     or word [rbp + drvBlk.wDevFlgs], devNewParms | devChgd
  1361 00000C8B 9D                  <1>     popfq
  1362 00000C8C 0F85D3000000        <1>     jnz .lbaSetParams
  1363                              <1> ;Here we set CHS params. 
  1364                              <1> ;Before we trust the table, we check that indeed
  1365                              <1> ; no sector index is past the max sector count and that if the caller
  1366                              <1> ; claimed that all the sectors are of the same size, they really are.   
  1367                              <1> 
  1368                              <1> ;TEMP: IF THE INCOMING PACKET DOES NOT REPORT ALL SECTORS OF A TRACK 
  1369                              <1> ;      AS BEING OF THE SAME SIZE, WE FAIL THE REQUEST!
  1370 00000C92 F60204              <1>     test byte [rdx + chsParamsBlock.bSpecFuncs], specFuncSec
  1371 00000C95 0F8476FAFFFF        <1>     jz .genErrExit
  1372                              <1> ;END TEMP 
  1373                              <1> ;Now we set the sector size bit.
  1374 00000C9B 66816537F7FF        <1>     and word [rbp + drvBlk.wDevFlgs], ~devSameSec    ;Clear bit first
  1375 00000CA1 F60204              <1>     test byte [rdx + chsParamsBlock.bSpecFuncs], specFuncSec
  1376 00000CA4 7406                <1>     jz .iosdpNoSetTrackBit
  1377 00000CA6 66814D370800        <1>     or word [rbp + drvBlk.wDevFlgs], devSameSec
  1378                              <1> .iosdpNoSetTrackBit:
  1379                              <1> ;Start by copying the table directly as sector numbers may be purposefully
  1380                              <1> ; interleaved. NO SORTING!! 
  1381                              <1> ;------------------------- NOTE -------------------------
  1382                              <1> ;For now we don't use the track table for anything as our 
  1383                              <1> ; removable devices MUST all have all sectors on a 
  1384                              <1> ; ``track'' with the same size. This information is 
  1385                              <1> ; superfluous and effectively undocumented to keep it 
  1386                              <1> ; just to us. We will likely remove this logic.
  1387                              <1> ;--------------------------------------------------------
  1388 00000CAC 488D723C            <1>     lea rsi, qword [rdx + chsParamsBlock.TrackLayout]
  1389 00000CB0 31C0                <1>     xor eax, eax
  1390 00000CB2 66AD                <1>     lodsw           ;Get the new table length word and adv rsi to table itsef
  1391 00000CB4 0FB7C8              <1>     movzx ecx, ax
  1392 00000CB7 67E331              <1>     jecxz .iosdpTrkDone ;If ecx is zero, there is no table and we ignore it!
  1393 00000CBA 81F93F000000        <1>     cmp ecx, maxTrackTblSz
  1394 00000CC0 0F874BFAFFFF        <1>     ja .genErrExit
  1395 00000CC6 488D3D7D070000      <1>     lea rdi, .ioTrackTbl    
  1396 00000CCD 31C0                <1>     xor eax, eax
  1397                              <1> .iosdpTrkLp:
  1398 00000CCF 48FFC7              <1>     inc rdi ;Go past "track" number
  1399 00000CD2 48FFC7              <1>     inc rdi ;Go past "head" number
  1400 00000CD5 66AD                <1>     lodsw   ;Get the sector number (a byte)
  1401 00000CD7 50                  <1>     push rax
  1402 00000CD8 66AD                <1>     lodsw   ;Get the sector size
  1403 00000CDA E866000000          <1>     call .iosdpSetTblEntry  ;Return in al the sector code
  1404 00000CDF 5B                  <1>     pop rbx
  1405 00000CE0 C1E308              <1>     shl ebx, 8  ;Move low byte high
  1406 00000CE3 09D8                <1>     or eax, ebx
  1407 00000CE5 66AB                <1>     stosw   ;Store this packed word
  1408 00000CE7 FFC9                <1>     dec ecx
  1409 00000CE9 75E4                <1>     jnz .iosdpTrkLp
  1410                              <1> .iosdpTrkDone:
  1411 00000CEB F60202              <1>     test byte [rdx + chsParamsBlock.bSpecFuncs], specFuncTrk    ;Just tracks?
  1412                              <1>     retnz   ;Return if bit set!
