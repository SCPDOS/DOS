   576                              <1> ;If the changeline says no change, check that we were the last disk to access
   577                              <1> ; If we were not, we do a time check do time/last access check. If more than
   578                              <1> ; two seconds, have passed, we do a volume check. Else, since the changeline
   579                              <1> ; said no change, we assume that no change!
   580 00000797 8A059C0D0000        <1>     mov al, byte [.bLastDsk]
   581 0000079D 384509              <1>     cmp byte [rbp + drvBlk.bDOSNum], al
   582 000007A0 7421                <1>     je .mmcNoChange
   583 000007A2 E8350C0000          <1>     call .checkTime ;Returns CF=CY if unsure. If unsure, do BPB check
   584 000007A7 72D6                <1>     jc .mmcVolCheck
   585 000007A9 EB18                <1>     jmp short .mmcNoChange    ;Else, we say no change!
   586                              <1> .mmcNoChangeLine:
