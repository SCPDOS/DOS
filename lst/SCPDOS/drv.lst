  1471 00000D50 53                  <1>     push rbx
  1472 00000D51 3D04000000          <1>     cmp eax, 4  ;Was this 1024?
  1473 00000D56 B803000000          <1>     mov eax, 3  ;Set to index if so
  1474 00000D5B BB05000000          <1>     mov ebx, 5  ;Default to 4096 if not
  1475 00000D60 0F45C3              <1>     cmovne eax, ebx
  1476 00000D63 5B                  <1>     pop rbx
  1477                              <1>     return
    13                              <2> %%_ret:
    14 00000D64 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1478                              <1> .lbaSetParams:
  1479                              <1> ;This only sets the sector size and number of sectors in drvBlk.bpb.
  1480                              <1>     ;Set start sector of partition
  1481 00000D65 8B4A18              <1>     mov ecx, dword [rdx + lbaParamsBlock.qStartSector]
  1482 00000D68 894D1B              <1>     mov dword [rbp + drvBlk.dHiddSec], ecx
  1483                              <1>     ;Set sector size
  1484 00000D6B 8B4A08              <1>     mov ecx, dword [rdx + lbaParamsBlock.qSectorSize]
  1485 00000D6E 66894D0A            <1>     mov word [rbp + drvBlk.wBpS], cx
  1486                              <1>     ;Set same device flags as in CHS.
  1487 00000D72 0FB64A02            <1>     movzx ecx, byte [rdx + lbaParamsBlock.wDevFlgs]
  1488 00000D76 6681E10300          <1>     and cx, devFixed | devChgLine
  1489 00000D7B 66094D37            <1>     or word [rbp + drvBlk.wDevFlgs], cx
  1490                              <1>     ;Set sector information.
  1491 00000D7F 8B4A10              <1>     mov ecx, dword [rdx + lbaParamsBlock.qNumSectors]
  1492 00000D82 81F9FFFF0000        <1>     cmp ecx, 0FFFFh
  1493 00000D88 7605                <1>     jna .lbaSetSmall
  1494 00000D8A 894D1F              <1>     mov dword [rbp + drvBlk.dTotSec32], ecx
  1495 00000D8D 31C9                <1>     xor ecx, ecx
  1496                              <1> .lbaSetSmall:
  1497 00000D8F 66894D12            <1>     mov word [rbp + drvBlk.wTotSec16], cx
  1498                              <1>     return
    13                              <2> %%_ret:
    14 00000D93 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1499                              <1> ;---------------------------------------------------------------------------
  1500                              <1> ;               Get Device parameters in CHS and LBA here
  1501                              <1> ;---------------------------------------------------------------------------
  1502                              <1> .ioGetDevParams:
  1503 00000D94 7561                <1>     jnz .lbaGetParams
  1504                              <1> ;Here we get CHS params. 
  1505 00000D96 488D750A            <1>     lea rsi, qword [rbp + drvBlk.bpb]
  1506 00000D9A F60201              <1>     test byte [rdx + chsParamsBlock.bSpecFuncs], specFuncBPB
  1507 00000D9D 751F                <1>     jnz .iogdpBkup  ;If set, return the bpb data as is.
  1508 00000D9F 66F745370100        <1>     test word [rbp + drvBlk.wDevFlgs], devFixed
  1509 00000DA5 7517                <1>     jnz .iogdpBkup  ;If it is fixed, return the BPB as is too
  1510 00000DA7 E8D3FAFFFF          <1>     call .updateBpb ;Else, gets the BPB from the disk.
  1511 00000DAC 0F821DFDFFFF        <1>     jc .ioDoErr ;Errors returned as if from block IO handler
  1512 00000DB2 E8DEFBFFFF          <1>     call .moveVolIds    ;Move the volume ID's into the drvBlk if they exist.
  1513 00000DB7 488D3599070000      <1>     lea rsi, qword [.inBuffer + 11]
  1514                              <1> .iogdpBkup:
  1515                              <1> ;The caller block in memory must have a bpb32_size'ed space for the BPB
  1516                              <1> ; even if it is a FAT16/12 drive. The caller has to assertain the 
  1517                              <1> ; type of BPB it is based information in the common part of the BPB.
  1518 00000DBE 488D7A07            <1>     lea rdi, qword [rdx + chsParamsBlock.deviceBPB]
  1519 00000DC2 B935000000          <1>     mov ecx, bpb32_size
  1520 00000DC7 F3A4                <1>     rep movsb
  1521 00000DC9 B805000000          <1>     mov eax, typeHard
  1522 00000DCE B907000000          <1>     mov ecx, typeGenRem
  1523 00000DD3 F6453701            <1>     test byte [rbp + drvBlk.wDevFlgs], devFixed
  1524 00000DD7 0F44C1              <1>     cmovz eax, ecx  ;eax is set to 7 if the dev is removable
  1525 00000DDA 884201              <1>     mov byte [rdx + chsParamsBlock.bDevType], al
  1526 00000DDD 0FB74537            <1>     movzx eax, word [rbp + drvBlk.wDevFlgs]
  1527 00000DE1 2503000000          <1>     and eax, devFixed | devChgLine
  1528 00000DE6 66894202            <1>     mov word [rdx + chsParamsBlock.wDevFlgs], ax
  1529 00000DEA C6420600            <1>     mov byte [rdx + chsParamsBlock.bMedTyp], 0
  1530 00000DEE 0FB74539            <1>     movzx eax, word [rbp + drvBlk.wNumCyl]
  1531 00000DF2 66894204            <1>     mov word [rdx + chsParamsBlock.wNumCyl], ax
  1532                              <1>     return
    13                              <2> %%_ret:
    14 00000DF6 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1533                              <1> 
  1534                              <1> .lbaGetParams:
  1535                              <1> ;Gets more "updated" information on partitions.
  1536                              <1> ;The data returned will always be the partition maximum! For remdevs
  1537                              <1> ; this means up to the whole media size and for fixed disks we are still 
  1538                              <1> ; restricted to the partition size.
  1539 00000DF7 B805000000          <1>     mov eax, drvBadDrvReq
  1540 00000DFC 803A20              <1>     cmp byte [rdx + lbaParamsBlock.bSize], lbaParamsBlock_size
  1541 00000DFF 0F8511F9FFFF        <1>     jne .errorExit
  1542 00000E05 4889D7              <1>     mov rdi, rdx    ;Store the params block ptr in rdi
  1543 00000E08 807F0102            <1>     cmp byte [rdi + lbaParamsBlock.bSpecFuncs], 2   ;Check get phys call.
  1544 00000E0C 0F8704F9FFFF        <1>     ja .errorExit   ;If above 2, error with bad request!
  1545 00000E12 7425                <1>     je .lgpbpbGetPhys
  1546 00000E14 F6470101            <1>     test byte [rdi + lbaParamsBlock.bSpecFuncs], 1  ;Check if we update BPB.
  1547 00000E18 7539                <1>     jnz .lgpbpbok
  1548 00000E1A 66F745370100        <1>     test word [rbp + drvBlk.wDevFlgs], devFixed
  1549 00000E20 7531                <1>     jnz .lgpbpbok  ;If it is fixed, return the BPB as is too
  1550 00000E22 57                  <1>     push rdi    ;Push the param block onto the stack
  1551 00000E23 E857FAFFFF          <1>     call .updateBpb
  1552 00000E28 7208                <1>     jc .lgpbpbnotok ;Even if just bad BPB, keep changed bit on!
  1553 00000E2A E866FBFFFF          <1>     call .moveVolIds    ;Move the volume ID's into the drvBlk if they exist.
  1554 00000E2F 5F                  <1>     pop rdi     ;Pop param block
  1555 00000E30 EB21                <1>     jmp short .lgpbpbok
  1556                              <1> .lgpbpbnotok:
  1557                              <1> ;If no valid BPB found, and the device removable, return BIOS params for the 
  1558                              <1> ; whole device. We never come here for fixed disks as updateBpb always passes.
  1559 00000E32 5F                  <1>     pop rdi
  1560 00000E33 0F8449F8FFFF        <1>     jz .errorXlat   ;If update returned CF=CY and ZF=ZE, xlat the BIOS code
  1561                              <1> ;We only fall here if on an unformatted removable disk.
  1562                              <1> ;Unformatted means with an unrecognisable BPB.
  1563                              <1> .lgpbpbGetPhys:
  1564 00000E39 0FB65508            <1>     movzx edx, byte [rbp + drvBlk.bBIOSNum]
  1565 00000E3D B800880000          <1>     mov eax, 8800h  ;Read LBA Device Parameters
  1566 00000E42 CD33                <1>     int 33h         ;Need a naked call as params returned in regs!
  1567 00000E44 0F8238F8FFFF        <1>     jc .errorXlat
  1568 00000E4A 48FFC1              <1>     inc rcx         ;Turn into an absolute count of sectors
  1569 00000E4D 31D2                <1>     xor edx, edx    ;0 Hidden sectors on remdevs/unformatted media
  1570                              <1> ;eax = 0 since either not formatted or values may not be ok for CHS calls
  1571 00000E4F 89D0                <1>     mov eax, edx     
  1572 00000E51 EB1F                <1>     jmp short .lgpStor
  1573                              <1> .lgpbpbok:
  1574 00000E53 31C0                <1>     xor eax, eax
  1575 00000E55 89C3                <1>     mov ebx, eax
  1576 00000E57 FFC3                <1>     inc ebx
  1577                              <1> ;Here eax=0 and ebx=1.
  1578 00000E59 F6450FFF            <1>     test byte [rbp + drvBlk.bNumFAT], -1    ;If 0 FATs, the FAT is invalid!
  1579 00000E5D 0F45C3              <1>     cmovnz eax, ebx                         ;Set if we have a FAT
  1580 00000E60 8B551B              <1>     mov edx, dword [rbp + drvBlk.dHiddSec]
  1581 00000E63 0FB75D0A            <1>     movzx ebx, word [rbp + drvBlk.wBpS]
  1582 00000E67 0FB74D12            <1>     movzx ecx, word [rbp + drvBlk.wTotSec16]
  1583 00000E6B 85C9                <1>     test ecx, ecx
  1584 00000E6D 7503                <1>     jnz .lgpStor
  1585 00000E6F 8B4D1F              <1>     mov ecx, dword [rbp + drvBlk.dTotSec32]
  1586                              <1> .lgpStor:
  1587                              <1> ;Enter with:
  1588                              <1> ;ax = 0 if unformatted, 1 if any FAT type (means can call CHS function)
  1589                              <1> ;rbx = Sector size in bytes
  1590                              <1> ;rcx = Last LBA block address + 1 (Count of sectors)
  1591                              <1> ;rdx = Hidden sectors
  1592 00000E72 66894704            <1>     mov word [rdi + lbaParamsBlock.wFSType], ax
  1593 00000E76 48895F08            <1>     mov qword [rdi + lbaParamsBlock.qSectorSize], rbx
  1594 00000E7A 48894F10            <1>     mov qword [rdi + lbaParamsBlock.qNumSectors], rcx
  1595 00000E7E 48895718            <1>     mov qword [rdi + lbaParamsBlock.qStartSector], rdx
  1596 00000E82 0FB74537            <1>     movzx eax, word [rbp + drvBlk.wDevFlgs]
  1597 00000E86 2503000000          <1>     and eax, devFixed | devChgLine
  1598 00000E8B 66894702            <1>     mov word [rdi + lbaParamsBlock.wDevFlgs], ax
  1599                              <1>     return 
    13                              <2> %%_ret:
    14 00000E8F C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1600                              <1> ;---------------------------------------------------------------------------
  1601                              <1> ;                    CHS IO requests are structured here
  1602                              <1> ;---------------------------------------------------------------------------
  1603                              <1> .ioWrite:
  1604 00000E90 0F85C2000000        <1>     jnz .lbaWrite
  1605                              <1> ;Here for CHS write tracks. 
  1606 00000E96 BB00830000          <1>     mov ebx, 8300h  ;Write sectors
  1607                              <1> .iochsRW:
  1608 00000E9B E876000000          <1>     call .ioChsToLba
  1609 00000EA0 E85A000000          <1>     call .ioChsSanity
  1610 00000EA5 0FB74705            <1>     movzx eax, word [rdi + chsIOBlock.wStartSector]
  1611 00000EA9 01C1                <1>     add ecx, eax    ;Add the zero based sector number to start of "track"
  1612 00000EAB 0FB77707            <1>     movzx esi, word [rdi + chsIOBlock.wNumSectors]  ;How many sectors to IO on
  1613                              <1> .iochsCmn:
  1614 00000EAF 89D8                <1>     mov eax, ebx    ;Move the function number to eax
  1615 00000EB1 488B5F09            <1>     mov rbx, qword [rdi + chsIOBlock.pXferBuffer]   ;And get buffer ptr in rbx
  1616 00000EB5 E9BE000000          <1>     jmp .ioEp
  1617                              <1> .ioRead:
  1618 00000EBA 0F8591000000        <1>     jnz .lbaRead
  1619                              <1> ;Here for CHS read tracks.
  1620 00000EC0 BB00820000          <1>     mov ebx, 8200h  ;Read sectors
  1621 00000EC5 EBD4                <1>     jmp short .iochsRW
  1622                              <1> .ioFormat:
  1623                              <1> ;DASD TEMP DASD TEMP DASD TEMP DASD TEMP DASD TEMP DASD TEMP DASD TEMP 
  1624                              <1> ;
  1625                              <1> ;We start by setting DASD parameters but for now we do nothing so just
  1626                              <1> ; clear the flag.
  1627 00000EC7 9C                  <1>     pushfq
  1628 00000EC8 668165377FFF        <1>     and word [rbp + drvBlk.wDevFlgs], ~devSetDASD
  1629 00000ECE 9D                  <1>     popfq
  1630                              <1> ;DASD TEMP DASD TEMP DASD TEMP DASD TEMP DASD TEMP DASD TEMP DASD TEMP 
  1631 00000ECF 7576                <1>     jnz .lbaFmt
  1632                              <1> ;Here for CHS format track.
  1633 00000ED1 BB00850000          <1>     mov ebx, 8500h  ;Format sectors
  1634 00000ED6 F60201              <1>     test byte [rdx + chsFormatBlock.bSpecFuncs], 1  ;If this bit clear do format
  1635 00000ED9 7404                <1>     jz .iochsFmtCmn
  1636                              <1> ;Else we should respond if the sector table is valid. Since our BIOS is crap
  1637                              <1> ; we always return OK and let the format call fail. This would possibly be
  1638                              <1> ; dangerous but its not since the BIOS CHS emulation is very meh.
  1639 00000EDB C60200              <1>     mov byte [rdx + chsFormatBlock.bSpecFuncs], 0   ;All ok!
  1640                              <1>     return
    13                              <2> %%_ret:
    14 00000EDE C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1641                              <1> .iochsFmtCmn:
  1642 00000EDF E832000000          <1>     call .ioChsToLba    ;Get the LBA of the first sector of the track in ecx
  1643 00000EE4 0FB77517            <1>     movzx esi, word [rbp + drvBlk.wSecPerTrk]   ;Fmt/Verify this many sectors
  1644 00000EE8 89D8                <1>     mov eax, ebx    ;Move the function number to eax
  1645 00000EEA 488D1D59050000      <1>     lea rbx, .ioTrackTbl    ;rbx is meaningless for verify so its ok.
  1646 00000EF1 E982000000          <1>     jmp .ioEp
  1647                              <1> .ioVerify:
  1648 00000EF6 7548                <1>     jnz .lbaVerify
  1649                              <1> ;Here for CHS verify track.
  1650 00000EF8 BB00840000          <1>     mov ebx, 8400h
  1651 00000EFD EBE0                <1>     jmp short .iochsFmtCmn
  1652                              <1> 
  1653                              <1> .ioChsSanity:
  1654                              <1> ;Checks that the read/write will be on one track and makes sense.
  1655                              <1> ;Input: ebx = BIOS function to call. Preserved.
  1656                              <1> ;       ecx = LBA of start sector.
  1657                              <1> ;       rdi -> chsIOBlock
  1658                              <1> ;       rbp -> Drive block ptr
  1659 00000EFF 0FB74705            <1>     movzx eax, word [rdi + chsIOBlock.wStartSector] ;Zero based
  1660 00000F03 FFC0                <1>     inc eax         ;Make it 1 based for the comparison
  1661 00000F05 66034707            <1>     add ax, word [rdi + chsIOBlock.wNumSectors]
  1662 00000F09 663B4517            <1>     cmp ax, word [rbp + drvBlk.wSecPerTrk]  ;Does this surpass num sect/trck?
  1663                              <1>     retna
    77                              <2> cret na
