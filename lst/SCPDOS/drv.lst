  1712                              <1> .ioGetSetSetup:
  1713                              <1> ;Reads a bootsector in for us and checks it's the right kind of thing
  1714                              <1> ; for us to do this op on. All failures set up the return information
  1715                              <1> ; for us.
  1716                              <1> ;Sets up the BIOS/DOS error translation on hard error for us.
  1717 00000FE1 E852000000          <1>     call .ioIdCheckChange   ;Do this to ensure no fail in the read below
  1718 00000FE6 E84EFAFFFF          <1>     call .bbpbReadBS        ;Read BS for the drive in rbp. sets rbx to buffer
  1719 00000FEB 7244                <1>     jc .iogssHardErr        ;This returns CF=CY and ZF=ZE
  1720                              <1> ;Just do a quick jump check here too to make sure we're a decent BPB.
  1721 00000FED 803B69              <1>     cmp byte [rbx + oemHeader.jump], 069h       ;Direct jump has no NOP
  1722 00000FF0 7410                <1>     je .iogssOk
  1723 00000FF2 803BE9              <1>     cmp byte [rbx + oemHeader.jump], 0E9h       ;Near jump has no NOP
  1724 00000FF5 740B                <1>     je .iogssOk
  1725 00000FF7 803BEB              <1>     cmp byte [rbx + oemHeader.jump], 0EBh       ;Short jump has a NOP
  1726 00000FFA 752E                <1>     jne .iogssBadBS
  1727 00000FFC 807B0290            <1>     cmp byte [rbx + oemHeader.jump + 2], 090h   ;NOP should be here
  1728 00001000 7528                <1>     jne .iogssBadBS
  1729                              <1> .iogssOk:
  1730 00001002 4881C30B000000      <1>     add rbx, oemHeader_size ;Point rbx to the bpb itself
  1731 00001009 E8BCF9FFFF          <1>     call .getFATType    ;Get in dl if we are FAT32 or CF=CY if bad
  1732 0000100E 721A                <1>     jc .iogssBadBS
  1733 00001010 80FA20              <1>     cmp dl, bpbFat32    ;Did we get a FAT32 disk?
  1734 00001013 B819000000          <1>     mov eax, bpb_size
  1735 00001018 B935000000          <1>     mov ecx, bpb32_size
  1736 0000101D 0F45C8              <1>     cmovne ecx, eax     ;If not FAT32, replace move count
  1737 00001020 4801CB              <1>     add rbx, rcx        ;Move rbx to point to the extended signature
  1738 00001023 807B0229            <1>     cmp byte [rbx + extBs.bootSig], extBsSig    ;Check ext boot sig?
  1739                              <1>     rete
    49                              <2> cret e
