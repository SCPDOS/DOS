   514                              <1> ;MISC ASCII control chars
   515                              <1> NUL equ 00h ;^@         | ASCII Null
   516                              <1> ETX equ 03h ;^C         | ASCII Break (End of Text) 
   517                              <1> ACK equ 06h ;^F         | ASCII Acknowledgement
   518                              <1> BEL equ 07h ;^G         | ASCII Bell
   519                              <1> BSP equ 08h ;^H         | ASCII Backspace
   520                              <1> TAB equ 09h ;^I         | ASCII Horizontal Tab
   521                              <1> LF  equ 0Ah ;^J         | ASCII Line Feed
   522                              <1> CR  equ 0Dh ;^M         | ASCII Carriage Return
   523                              <1> DLE equ 10h ;^P         | ASCII Data Link End (Toggle Print Echo)
   524                              <1> DC3 equ 13h ;^S         | ASCII Device Control 3 (Toggle Scroll Lock)
   525                              <1> DC4 equ 14h ;^T         | ASCII Device Control 4
   526                              <1> NAK equ 15h ;^U         | ASCII Negative Acknowledgement
   527                              <1> ETB equ 17h ;^W         | ASCII End of Transmission Block
   528                              <1> EOF equ 1Ah ;^Z         | ASCII Substitute character (End of File)
   529                              <1> ESC equ 1Bh ;           | ASCII Escape char, used for ANSI.SYS
   530                              <1> SPC equ 20h ;Printable  | ASCII Space
   531                              <1> ;This last one is NEVER printed with a caret as it is a console control char
   532                              <1> DEL equ 7Fh ;^?         | ASCII Rubout (Del char and dec cursor)
   533                              <1> 
   534                              <1> asciiCaret  equ 20h ;Used to check which chars need to be printed with caret
   535                              <1> ;Extended Ascii Codes
   536                              <1> eF1     equ 3Bh ;F1 second byte
   537                              <1> eF2     equ 3Ch ;F2 second byte
   538                              <1> eF3     equ 3Dh ;F3 second byte
   539                              <1> eF4     equ 3Eh ;F4 second byte
   540                              <1> eF5     equ 3Fh ;F5 second byte
   541                              <1> eF6     equ 40h ;F6 second byte
   542                              <1> eF7     equ 41h ;F7 second byte
   543                              <1> eCursL  equ 4Bh ;Cursor Left second byte
   544                              <1> eCursR  equ 4Dh ;Cursor Right second byte
   545                              <1> eIns    equ 52h ;Insert second byte
   546                              <1> eDel    equ 53h ;DEL second byte (not necessarily delete key)
