  1092                              <1> .ioDoErr:
  1093                              <1> ;Come here if after an error in block IO handler.
  1094                              <1> ;If ZF=ZE, disk error occured, the error needs translation so do it.
  1095                              <1> ;Else just return the error code in al
  1096 00000ACF 0F84ADFBFFFF        <1>     jz .errorXlat
  1097 00000AD5 E93CFCFFFF          <1>     jmp .errorExit
  1098                              <1> 
  1099                              <1> .ioAdvIOCTL:
  1100                              <1> ;Increments the count of sectors transferred in LBA IOCTL operations
  1101                              <1> ;Input/Output: As below except for rdi -> lbaFormatBlock (or lbaIOBlock)
  1102                              <1> ;               Remember, lbaIOBlock is a superset of lbaFormatBlock 
  1103 00000ADA FE4701              <1>     inc byte [rdi + lbaIOBlock.numSectors]
  1104 00000ADD EB03                <1>     jmp short .ioAdvCmn
  1105                              <1> .ioAdv:
  1106                              <1> ;Increments the count of sectors transferred in normal read/writes
  1107                              <1> ;Input/Output: As below except for rdi -> ioReqPkt only
  1108 00000ADF FF4716              <1>     inc dword [rdi + ioReqPkt.tfrlen]    ;One more sector xfred ok!
  1109                              <1> .ioAdvCmn:
  1110                              <1> ;Advances the buffers on successful IO.
  1111                              <1> ;If returns ZF=ZE, we have completed all the IO for the request.
  1112                              <1> ;Input: 
  1113                              <1> ;       rbx -> Where we just IO'ed to
  1114                              <1> ;       rcx = LBA sector we just xfred
  1115                              <1> ;       dh  = BIOS function number
  1116                              <1> ;       dl  = BIOS drive number
  1117                              <1> ;       rdi -> ioReqPkt / lbaFormatBlock / lbaIOBlock
  1118                              <1> ;       rbp -> drvBlk
  1119                              <1> ;       esi = Number of sectors to xfr
  1120                              <1> ;Output:
  1121                              <1> ;       rbx -> Where to IO next sector to/from
  1122                              <1> ;       rcx = LBA of next sector to xfer
  1123                              <1> ;       dh  = BIOS function number
  1124                              <1> ;       dl  = BIOS drive number
  1125                              <1> ;       rdi -> ioReqPkt / lbaFormatBlock / lbaIOBlock
  1126                              <1> ;       rbp -> drvBlk
  1127                              <1> ;       esi = Sectors left to xfr.
  1128                              <1> ;       ZF=ZE if esi is 0. Else ZF=NZ.
  1129 00000AE2 50                  <1>     push rax
  1130 00000AE3 48FFC1              <1>     inc rcx     ;Goto next sector
  1131 00000AE6 0FB7450A            <1>     movzx eax, word [rbp + drvBlk.wBpS] 
  1132 00000AEA 4801C3              <1>     add rbx, rax  ;Advance the buffer pointer by 1 sector
  1133 00000AED FFCE                <1>     dec esi     ;Once this hits 0, we stop the xfr
  1134 00000AEF 58                  <1>     pop rax
  1135                              <1>     return
    13                              <2> %%_ret:
    14 00000AF0 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
