    24 00003488 50                  <1>     push rax
    25 00003489 53                  <1>     push rbx    ;Save the pointer to the request packet on the stack
    26 0000348A 51                  <1>     push rcx
    27 0000348B 52                  <1>     push rdx
    28 0000348C 488D15DFCCFFFF      <1>     lea rdx, qword [fastOutput]
    29 00003493 B829000000          <1>     mov eax, 29h
