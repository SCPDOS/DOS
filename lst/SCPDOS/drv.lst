  2220                              <1> .checkTime:
  2221                              <1> ;Does the time/access count check :)
  2222                              <1> ;Returns: CF=CY if unknown, CF=NC if no change
  2223 000012EC E8C5FFFFFF          <1>     call .getTime   ;Returns in ecx the current time
  2224 000012F1 85C9                <1>     test ecx, ecx   ;If this is 0 for some reason, use the accesses count  
  2225 000012F3 7517                <1>     jnz .ctOk
  2226 000012F5 FE054D010000        <1>     inc byte [.bAccCnt]
  2227 000012FB 803D4601000005      <1>     cmp byte [.bAccCnt], maxAcc ;If below, we say ok!
  2228 00001302 7217                <1>     jb .ctNoChange
  2229 00001304 FE0D3E010000        <1>     dec byte [.bAccCnt] ;Else drop the inc and say unsure
  2230 0000130A EB0D                <1>     jmp short .ctMaybeCh
  2231                              <1> .ctOk:
  2232 0000130C 8B5570              <1>     mov edx, dword [rbp + drvBlk.dAccTime]  ;Get last disk access time
  2233                              <1> ;ecx = time of current check, adjusted for day rollovers 
  2234 0000130F 29D1                <1>     sub ecx, edx    
  2235 00001311 81F924000000        <1>     cmp ecx, 36 ;Is this leq 36? 36 ticks at 55ms is approx 2 seconds.
  2236 00001317 7602                <1>     jbe .ctNoChange
  2237                              <1> .ctMaybeCh:
  2238 00001319 F9                  <1>     stc
  2239                              <1>     return
