   840 0000096D E858000000          <1>     call .getFATType    ;Fat type is given in edx
   841 00000972 72B8                <1>     jc .ubpbErr ;Only happens if crucial BPB fields are zero 
   842 00000974 885533              <1>     mov byte [rbp + drvBlk.bBpbType], dl    ;Save the FAT type
   843                              <1> ;Get the correct length to correctly position rsi over the extended bs struct
   844                              <1> ; if it is present
   845 00000977 B819000000          <1>     mov eax, bpb_size
