  2283 0000143E 7412                <1>     jz .i2fCheck
  2284 00001440 3C01                <1>     cmp al, 01  ;AL=01, Add block device
  2285 00001442 7412                <1>     je .i2fAddTbl
  2286 00001444 3C02                <1>     cmp al, 02  ;AL=02, Execute blk drv request
  2287 00001446 745D                <1>     je .i2fExec
