   413                              <1> struc psp
   414 00000000 ????                <1>     .return     db 2 dup (?)  ;Should always be CDh 20h, same place as DOS
   415 00000002 ????????            <1>     .allocSize  dd ?  ;Number of paras in init alloc or when exiting as TSR.
   416 00000006 ????????            <1>                 dd ?  ;Reserved 4 bytes
   417 0000000A ????????????????    <1>     .oldInt22h  dq ?  ;Int 22h pointer on overlay load
   418 00000012 ????????????????    <1>     .oldInt23h  dq ?  ;Int 23h pointer on overlay load
   419 0000001A ????????????????    <1>     .oldInt24h  dq ?  ;Int 24h pointer on overlay load
   420 00000022 ????????????????    <1>     .parentPtr  dq ?  ;Pointer to parent process PSP
   421                              <1> ;If jftSize > 20, then the QWORD at .jobFileTbl becomes a pointer
   422                              <1> ; to the actual in use JFT and the other 12 bytes are left undefined.
   423                              <1> ;If jftSize < 20 (DOS will never set it so), then it is considered as 20
   424                              <1> ;If the user tries to reduce handle count to 20 or less, then the PSP JFT is 
   425                              <1> ; always used and jftSize.
   426                              <1>     .externalJFTPtr:    ;Ptr to external JFT array (first byte AFTER MCB)
   427 0000002A <res 14h>           <1>     .jobFileTbl db dfltJFTsize dup (?) ;Main File handle array, JFT
   428 0000003E ????????????????    <1>     .envPtr     dq ?  ;Pointer to the environment
   429 00000046 ????????????????    <1>     .rspPtr     dq ?  ;Pointer to rsp on entry to Int 21h
   430 0000004E ????                <1>     .jftSize    dw ?  ;JFT array size, 20 => PSP JFT in use
   431 00000050 ??????              <1>     .unixEntry  db 3 dup (?)  ;Must always be CDh 21h CBh, same place as DOS
   432 00000053 ????????????????    <1>     .prevPSP    dq ?  ;Pointer to the previous PSP in chain (used by SHARE)
   433 0000005B ??                  <1>                 db ?  ;Reserved byte
   434                              <1> ;The below are in the same place as in DOS.
   435                              <1>     .cmdLineArgPtr: ;Symbol for future use
   436 0000005C <res 10h>           <1>     .fcb1       db 16 dup (?)  ;First FCB 
   437 0000006C <res 14h>           <1>     .fcb2       db 20 dup (?)  ;Second FCB
   438                              <1>     .dta:   ;Pointer to the default DTA in the PSP
   439 00000080 ??                  <1>     .parmList   db ?   ;Number of characters in command tail
   440 00000081 <res 7Fh>           <1>     .progTail   db 127 dup (?) ;Default DTA/Program tail
   441                              <1> endstruc
