  2266                              <1> .checkTime:
  2267                              <1> ;Does the time/access count check :)
  2268                              <1> ;Returns: CF=CY if unknown, CF=NC if no change
  2269 000013D8 E8C5FFFFFF          <1>     call .getTime   ;Returns in ecx the current time
