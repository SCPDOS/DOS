  1161                              <1> .bioError:
  1162                              <1> ;Jumped to with ah = BIOS error code
  1163 00000B5D E8A7060000          <1>     call .checkSwapIO
  1164                              <1> ;Reset the drive. WARNING: CRASHES BOCHS. Does E9h check. 
  1165 00000B62 E807000000          <1>     call .bioReset  ;Resets .bLastDsk to -1
  1166 00000B67 FFCE                <1>     dec esi
  1167 00000B69 75C6                <1>     jnz .biolp
  1168 00000B6B 5E                  <1>     pop rsi ;Pop the sector count off the stack
  1169                              <1>     ;ZF=ZE set now as esi counted down
  1170 00000B6C F9                  <1>     stc
  1171                              <1>     return
    13                              <2> %%_ret:
    14 00000B6D C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1172                              <1> .bioReset:
  1173                              <1> ;Resets the drive system for the drive in dl
  1174 00000B6E 50                  <1>     push rax
  1175                              <1>     ;in al, 0E9h ;Catches if we are in BOCHS and avoids issuing a buggy reset
  1176                              <1>     ;cmp al, 0E9h
  1177                              <1>     ;je .bioResetSkip
  1178 00000B6F 31C0                <1>     xor eax, eax    ;Do reset
  1179 00000B71 E890080000          <1>     call .callI33h  ;Ignore any errors
  1180                              <1> .bioResetSkip:
  1181 00000B76 C605B5090000FF      <1>     mov byte [.bLastDsk], -1    ;Reset the last disk accessed
  1182 00000B7D 58                  <1>     pop rax
  1183                              <1>     return
    13                              <2> %%_ret:
    14 00000B7E C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1184                              <1> .bioSanity:
  1185                              <1> ;Input: ecx = Sector we will transact on. rbp -> DrvBlk
  1186                              <1> ;Output: CF=NC, sector ok to xact on
  1187                              <1> ;        CF=CY, doesnt return, fails the call. ZF=ZE always (have DOS code)
  1188                              <1> ;        If the sector fails check, we return from the top level with ZF=ZE
  1189                              <1> ;           to indicate a DOS error code in eax.
  1190 00000B7F A9FF000000          <1>     test eax, 0FFh  ;If the bottom byte is set, it is a IOCTL call.
  1191                              <1>     retnz           ;BIOS checks these for us as IOCTL bypasses partitions.
