  1592                              <1> .ioctlerr:
  1593 00000EFB 5B                  <1>     pop rbx ;Pop the ret addr off the stack and tail to the bad media
  1594 00000EFC E976FDFFFF          <1>     jmp .iobadMed
  1595                              <1> .ioChsToLba:
  1596                              <1> ;Gets the first sector of the track selected by this call.
  1597                              <1> ;Works with the values set in the bpb of drvBlk which isn't ideal...
  1598                              <1> ;LBA = (( C x HPC ) + H ) x SPT + S - 1
  1599                              <1> ;Input: ebx = BIOS Function to call. Preserved.
  1600                              <1> ;Output: ecx = eax = LBA address for the first sector of the track
  1601                              <1> ;        rdi -> chsFormatBlock or IOBlock
  1602 00000F01 4889D7              <1>     mov rdi, rdx
  1603 00000F04 0FB74519            <1>     movzx eax, word [rbp + drvBlk.wNumHeads]
  1604 00000F08 0FB74F03            <1>     movzx ecx, word [rdi + chsFormatBlock.wStartCyl]
  1605 00000F0C 663B4D39            <1>     cmp cx, word [rbp + drvBlk.wNumCyl]
  1606 00000F10 73E9                <1>     jae .ioctlerr
  1607 00000F12 FFC1                <1>     inc ecx ;Inc as we get it as a zero based number
  1608 00000F14 F7E1                <1>     mul ecx
  1609 00000F16 0FB74F01            <1>     movzx ecx, word [rdi + chsFormatBlock.wStartHead]
  1610 00000F1A 663B4D19            <1>     cmp cx, word [rbp + drvBlk.wNumHeads]
  1611 00000F1E 73DB                <1>     jae .ioctlerr 
  1612 00000F20 01C8                <1>     add eax, ecx
  1613 00000F22 0FB74D17            <1>     movzx ecx, word [rbp + drvBlk.wSecPerTrk]
  1614 00000F26 F7E1                <1>     mul ecx
  1615 00000F28 89C1                <1>     mov ecx, eax
  1616                              <1>     return
    13                              <2> %%_ret:
    14 00000F2A C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1617                              <1> ;---------------------------------------------------------------------------
  1618                              <1> ;                    LBA IO requests are structured here
  1619                              <1> ;---------------------------------------------------------------------------
  1620                              <1> .lbaVerify:
  1621 00000F2B B800840000          <1>     mov eax, 8400h  ;Verify sectors
  1622 00000F30 EB05                <1>     jmp short .lbaFmtCmn
  1623                              <1> .lbaFmt:
  1624 00000F32 B800850000          <1>     mov eax, 8500h  ;Format sectors
  1625                              <1> .lbaFmtCmn:
  1626 00000F37 803A10              <1>     cmp byte [rdx + lbaIOBlock.size], lbaFormatBlock_size
  1627 00000F3A EB13                <1>     jmp short .lbaCmn
  1628                              <1> .lbaRead:
  1629 00000F3C B800820000          <1>     mov eax, 8200h  ;Read sectors
  1630 00000F41 EB05                <1>     jmp short .lbaRWCmn
  1631                              <1> .lbaWrite:
  1632 00000F43 B800830000          <1>     mov eax, 8300h  ;Write sectors
  1633                              <1> .lbaRWCmn:
  1634 00000F48 488B5A10            <1>     mov rbx, qword [rdx + lbaIOBlock.xferBuffer]
  1635 00000F4C 803A18              <1>     cmp byte [rdx + lbaIOBlock.size], lbaIOBlock_size
  1636                              <1> .lbaCmn:
  1637 00000F4F 0F8518FDFFFF        <1>     jne .iobadCmdLen
  1638                              <1> ;Setup the vars for block IO
  1639 00000F55 4889D7              <1>     mov rdi, rdx
  1640                              <1> ;Formally numSectors is a byte and will only be treated as a byte but
  1641                              <1> ; we reserve the following three bytes for future updates to allow
  1642                              <1> ; up to a dword of contiguous sectors to be written in one go.
  1643 00000F58 31F6                <1>     xor esi, esi
  1644 00000F5A 877701              <1>     xchg esi, dword [rdi + lbaFormatBlock.numSectors]
  1645 00000F5D 8B4F08              <1>     mov ecx, dword [rdi + lbaFormatBlock.startSector]
  1646 00000F60 034D1B              <1>     add ecx, dword [rbp + drvBlk.dHiddSec]  ;Point to sector in partition
  1647                              <1> .ioEp:
  1648 00000F63 89C2                <1>     mov edx, eax    ;Move the function number into dh (and zero dl)
  1649 00000F65 8A5508              <1>     mov dl, byte [rbp + drvBlk.bBIOSNum]    ;Get BIOS number for device
  1650                              <1> .ioLp:
  1651 00000F68 E89FFBFFFF          <1>     call .blkIODirect
  1652 00000F6D 0F8259FBFFFF        <1>     jc .ioDoErr
  1653 00000F73 E85FFBFFFF          <1>     call .ioAdvIOCTL
  1654 00000F78 75EE                <1>     jnz .ioLp
  1655                              <1>     return
