   345 00000020 ????????????????    <1>     .rsi    dq ?
   346 00000028 ????????????????    <1>     .rdi    dq ?
   347 00000030 ????????????????    <1>     .rbp    dq ?
   348 00000038 ????????????????    <1>     .r8     dq ?  ;To be removed if truly not needed
   349 00000040 ????????????????    <1>     .r9     dq ?
   350                              <1> ;Pushed by Processor when invoked via Interrupt
