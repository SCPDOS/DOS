  1581                              <1> .ioChsSanity:
  1582                              <1> ;Checks that the read/write will be on one track and makes sense.
  1583                              <1> ;Input: ebx = BIOS function to call. Preserved.
  1584                              <1> ;       ecx = LBA of start sector.
  1585                              <1> ;       rdi -> chsIOBlock
  1586                              <1> ;       rbp -> Drive block ptr
  1587 00000EEA 0FB74705            <1>     movzx eax, word [rdi + chsIOBlock.wStartSector] ;Zero based
  1588 00000EEE FFC0                <1>     inc eax         ;Make it 1 based for the comparison
  1589 00000EF0 66034707            <1>     add ax, word [rdi + chsIOBlock.wNumSectors]
  1590 00000EF4 663B4517            <1>     cmp ax, word [rbp + drvBlk.wSecPerTrk]  ;Does this surpass num sect/trck?
  1591                              <1>     retna
