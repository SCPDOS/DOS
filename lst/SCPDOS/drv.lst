  1201                              <1> .bioNoIO:
  1202 00000B58 FFCE                <1>     dec esi ;Decrement the retry counter
  1203 00000B5A 75D8                <1>     jnz .biolp  ;and try again if we still have retries to do
  1204 00000B5C 5E                  <1>     pop rsi ;Now rebalance the stack
  1205                              <1> ;Here we return as if our request was successful but we set esi to zero
  1206                              <1> ; to stop IO processing as the operation isn't reading/writing the sector
  1207                              <1> ; for no erroring reason (should never actually happen as the sanity check 
  1208                              <1> ; should handle this case but _just in case_ ).
  1209 00000B5D 31F6                <1>     xor esi, esi
  1210                              <1>     return
