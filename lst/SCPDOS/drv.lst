  1237                              <1> .IOCTL:    ;Function 19
  1238                              <1> ;Implements LBA versions of the CHS functions by setting the high bit
  1239                              <1> ; in the minor code.
  1240 00000BE9 B803000000          <1>     mov eax, drvBadCmd
  1241 00000BEE 0FB74B0D            <1>     movzx ecx, word [rbx + ioctlReqPkt.majfun]  ;Get CH and CL in one read
  1242 00000BF2 80FD08              <1>     cmp ch, 08h     ;Disk Drive Major Code?
  1243 00000BF5 0F8518FBFFFF        <1>     jne .errorExit  ;If not, exit bad
  1244                              <1> ;Disk Drive IOCTL here
  1245 00000BFB F6C118              <1>     test cl, 18h    ;If either bits 3 or 4 set, fail the call
  1246 00000BFE 0F850FFBFFFF        <1>     jnz .errorExit
  1247 00000C04 F6C160              <1>     test cl, 60h    ;One of these two bits MUST be set (bits 5 and 6)
  1248 00000C07 0F8406FBFFFF        <1>     jz .errorExit
  1249 00000C0D 0FB6D1              <1>     movzx edx, cl
  1250 00000C10 81E207FFFFFF        <1>     and edx, ~0F8h   ;Clear bits 3-7 to get table offset
  1251 00000C16 488D3D21000000      <1>     lea rdi, .ioctlTbl
  1252 00000C1D 57                  <1>     push rdi
  1253 00000C1E 488D3C97            <1>     lea rdi, qword [rdi + 4*rdx]
  1254 00000C22 F6C120              <1>     test cl, 20h
  1255 00000C25 7407                <1>     jz .ioctlNoRead
  1256 00000C27 4881C702000000      <1>     add rdi, 2  ;If we are doing the read function, goto the next instruction
  1257                              <1> .ioctlNoRead:
  1258 00000C2E 0FB717              <1>     movzx edx, word [rdi]   ;Read the word offset
  1259 00000C31 5F                  <1>     pop rdi
  1260 00000C32 4801D7              <1>     add rdi, rdx    ;Add the table base
  1261 00000C35 488B531F            <1>     mov rdx, qword [rbx + ioctlReqPkt.ctlptr]
  1262 00000C39 F6C180              <1>     test cl, 80h    ;Now set the flag for if CHS (ZF=ZE) or LBA (ZF=NZ)
  1263 00000C3C FFE7                <1>     jmp rdi ;And enter the function with the ptr to the ctrl block in rdx
  1264                              <1> .ioctlTbl:
  1265                              <1> ;Note: For the CHS IO functions, we translate the CHS requests into LBA
  1266                              <1> ; requests and then recycle the LBA request code. We do this using the 
  1267                              <1> ; track table. If the sector size of any table entry is neq the 
  1268                              <1> ; device sector size, we fail the request. This is because these requests
  1269                              <1> ; work on a track by track basis.
  1270 00000C3E 4300                <1>     dw .ioSetDevParams - .ioctlTbl  ;CL = 40h or CL = C0h, Write IOCTL
  1271 00000C40 4801                <1>     dw .ioGetDevParams - .ioctlTbl  ;CL = 60h or CL = E0h, Read IOCTL
  1272 00000C42 4402                <1>     dw .ioWrite - .ioctlTbl         ;CL = 41h or CL = C1h, Write IOCTL
  1273 00000C44 6E02                <1>     dw .ioRead - .ioctlTbl          ;CL = 61h or CL = E1h, Read IOCTL
  1274 00000C46 7B02                <1>     dw .ioFormat - .ioctlTbl        ;CL = 42h or CL = C2h, Write IOCTL
  1275 00000C48 A302                <1>     dw .ioVerify - .ioctlTbl        ;CL = 62h or CL = E2h, Read IOCTL
  1276 00000C4A 2500                <1>     dw .iobadCmd - .ioctlTbl        ;CL = 43h or CL = C3h, error
  1277 00000C4C 2500                <1>     dw .iobadCmd - .ioctlTbl        ;CL = 63h or CL = E3h, error
  1278 00000C4E 2500                <1>     dw .iobadCmd - .ioctlTbl        ;CL = 44h or CL = C4h, error
  1279 00000C50 2500                <1>     dw .iobadCmd - .ioctlTbl        ;CL = 64h or CL = E4h, error
  1280 00000C52 2500                <1>     dw .iobadCmd - .ioctlTbl        ;CL = 45h or CL = C5h, error
  1281 00000C54 2500                <1>     dw .iobadCmd - .ioctlTbl        ;CL = 65h or CL = E5h, error
  1282 00000C56 3D03                <1>     dw .ioSetIds - .ioctlTbl        ;CL = 46h or CL = C6h, Set vol Ids
  1283 00000C58 8903                <1>     dw .ioGetIds - .ioctlTbl        ;CL = 66h or CL = E6h, Get vol Ids
  1284 00000C5A 1B04                <1>     dw .ioSetAccessFlag - .ioctlTbl ;CL = 47h or CL = C7h, Write IOCTL
  1285 00000C5C 2F04                <1>     dw .ioGetAccessFlag - .ioctlTbl ;CL = 67h or CL = E7h, Read IOCTL
  1286                              <1> .ioctlQTbl:
  1287                              <1> ;Table of Read functions for IOCTL query. We homogenise the minor code 
  1288                              <1> ; value into a CHS level read request and then search for it (by clearing
  1289                              <1> ; bits 7 and 5 from the byte, both optionally set bits).
  1290                              <1> ;If we add a new function, add it to this table pls :)
  1291 00000C5E 4041424647          <1>     db 40h, 41h, 42h, 46h, 47h
  1292                              <1> ioctlQTblL equ $ - .ioctlQTbl
  1293                              <1> .iobadCmd:
  1294 00000C63 B803000000          <1>     mov eax, drvBadCmd
  1295 00000C68 E9A6FAFFFF          <1>     jmp .errorExit
  1296                              <1> .iobadCmdLen:
  1297 00000C6D B805000000          <1>     mov eax, drvBadDrvReq
  1298 00000C72 E99CFAFFFF          <1>     jmp .errorExit
  1299                              <1> .iobadMed:
  1300 00000C77 B807000000          <1>     mov eax, drvBadMed
  1301 00000C7C E992FAFFFF          <1>     jmp .errorExit
  1302                              <1> ;---------------------------------------------------------------------------
  1303                              <1> ;               Set Device parameters in CHS and LBA here
  1304                              <1> ;---------------------------------------------------------------------------
  1305                              <1> .ioSetDevParams:
  1306 00000C81 9C                  <1>     pushfq
  1307                              <1> ;If the parameters are swapped, set the flags and indicate the media 
  1308                              <1> ; was swapped (even if not).
  1309 00000C82 66814D374001        <1>     or word [rbp + drvBlk.wDevFlgs], devNewParms | devChgd
  1310 00000C88 9D                  <1>     popfq
  1311 00000C89 0F85C8000000        <1>     jnz .lbaSetParams
  1312                              <1> ;Here we set CHS params. 
  1313                              <1> ;Before we trust the table, we check that indeed
  1314                              <1> ; no sector index is past the max sector count and that if the caller
  1315                              <1> ; claimed that all the sectors are of the same size, they really are.    
  1316 00000C8F 488D723C            <1>     lea rsi, qword [rdx + chsParamsBlock.TrackLayout]
  1317 00000C93 4889F7              <1>     mov rdi, rsi    ;Save the pointer in rdi
  1318 00000C96 66AD                <1>     lodsw           ;Get the lead word and adv rsi by 2
  1319 00000C98 0FB7C8              <1>     movzx ecx, ax   ;Get the lead table entry into ax
  1320 00000C9B 81F93F000000        <1>     cmp ecx, maxTrackTblSz
  1321 00000CA1 7460                <1>     jz .iosdpNoTrack   ;Don't touch the tracks bit in this case!
  1322 00000CA3 0F8765FAFFFF        <1>     ja .genErrExit
  1323 00000CA9 66813E3F00          <1>     cmp word [rsi], maxTrackTblSz   ;Check the first entry is ok!
  1324 00000CAE 0F875AFAFFFF        <1>     ja .genErrExit
  1325                              <1> .iosdpTblCheckLp:
  1326 00000CB4 AD                  <1>     lodsd   ;Go to next entry
  1327 00000CB5 FFC9                <1>     dec ecx ;And remove from the count
  1328 00000CB7 7420                <1>     jz .iosdpTblCheckEnd
  1329 00000CB9 66813E3F00          <1>     cmp word [rsi], maxTrackTblSz   ;Ensure no entry above the max entry value
  1330 00000CBE 0F874AFAFFFF        <1>     ja .genErrExit
  1331 00000CC4 F60204              <1>     test byte [rdx + chsParamsBlock.bSpecFuncs], specFuncSec ;All same size?
  1332 00000CC7 74EB                <1>     jz .iosdpTblCheckLp ;If not, skip this check (always check 1=<i<=n)
  1333 00000CC9 668B4602            <1>     mov ax, word [rsi + 2]  ;Else get sector size
  1334 00000CCD 663946FE            <1>     cmp word [rsi - 2], ax  ;And compare with the previous sector size
  1335 00000CD1 0F8537FAFFFF        <1>     jne .genErrExit
  1336 00000CD7 EBDB                <1>     jmp short .iosdpTblCheckLp
  1337                              <1> .iosdpTblCheckEnd:
  1338                              <1> ;Now we set the sector size bit if all tracks same size check was passed.
  1339                              <1> ;If all sectors have the same size but the caller didn't specify this
  1340                              <1> ; bit, we also don't specify this bit.
  1341 00000CD9 66816537F7FF        <1>     and word [rbp + drvBlk.wDevFlgs], ~devSameSec    ;Clear bit first
  1342 00000CDF F60204              <1>     test byte [rdx + chsParamsBlock.bSpecFuncs], specFuncSec
  1343 00000CE2 7406                <1>     jz .iosdpNoSetTrackBit
  1344                              <1> ;The only way we got here if the bit was set is that the check passed.
  1345                              <1> ; Set the bit in the device block.
  1346 00000CE4 66814D370800        <1>     or word [rbp + drvBlk.wDevFlgs], devSameSec
  1347                              <1> .iosdpNoSetTrackBit:
  1348                              <1> ;Now we copy the table directly as sector numbers may be purposefully
  1349                              <1> ; interleaved. NO SORTING!!
  1350 00000CEA 4889FE              <1>     mov rsi, rdi    ;Get back the track layout pointer 
  1351 00000CED 488D3D8A030000      <1>     lea rdi, .ioTrackTbl    ;We overwrite our internal track table
  1352 00000CF4 66AD                <1>     lodsw   ;Get the table length
  1353 00000CF6 0FB7C8              <1>     movzx ecx, ax   ;This many entries
  1354 00000CF9 66AB                <1>     stosw
  1355 00000CFB F3A5                <1>     rep movsd       ;Move the dword entries over
  1356 00000CFD F60202              <1>     test byte [rdx + chsParamsBlock.bSpecFuncs], specFuncTrk    ;Just tracks?
  1357                              <1>     retnz   ;Return if bit set!
    45                              <2> cret nz
