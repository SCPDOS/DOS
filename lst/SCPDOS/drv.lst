  1566                              <1> ; we always return OK and let the format call fail. This would possibly be
  1567                              <1> ; dangerous but its not since the BIOS CHS emulation is very meh.
  1568 00000ECD C60200              <1>     mov byte [rdx + chsFormatBlock.bSpecFuncs], 0   ;All ok!
  1569                              <1>     return
