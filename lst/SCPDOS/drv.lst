   752                              <1> ;Entered with: 
   753                              <1> ;   rbp -> drvBlk for this drive
   754                              <1> ;------------------------------------------------------
   755                              <1> ;Exited with:
   756                              <1> ;   If CF=NC:
   757                              <1> ;       rbx -> The start of the BPB
   758                              <1> ;       rsi -> End of the BPB. Points to the extSig
   759                              <1> ;               if present.
   760                              <1> ;   Else:
   761                              <1> ;       If ZF=NZ: 
   762                              <1> ;           eax = DOS error code (Invalid BPB detected)
   763                              <1> ;       Else:
   764                              <1> ;           eax = BIOS error code
   765                              <1> ;------------------------------------------------------
   766 0000087F 66F745370500        <1>     test word [rbp + drvBlk.wDevFlgs], devFixed | devLockBpb
