  2272 000013E1 FE054D010000        <1>     inc byte [.bAccCnt]
  2273 000013E7 803D4601000005      <1>     cmp byte [.bAccCnt], maxAcc ;If below, we say ok!
  2274 000013EE 7217                <1>     jb .ctNoChange
  2275 000013F0 FE0D3E010000        <1>     dec byte [.bAccCnt] ;Else drop the inc and say unsure
  2276 000013F6 EB0D                <1>     jmp short .ctMaybeCh
  2277                              <1> .ctOk:
