    64                              <1> clockInit:
    65 000034E3 53                  <1>     push rbx    ;Push the pointer to the request header here
    66                              <1> ;CH - Hours, in BCD
    67                              <1> ;CL - Minutes, in BCD
    68                              <1> ;DH - Seconds, in BCD
    69 000034E4 B402                <1>     mov ah, 02  ;Read RTC Time
    70 000034E6 CD3A                <1>     int 3Ah
    71 000034E8 7271                <1>     jc .clkEnd  ;if error, just exit
    72                              <1>     ;Now set the driver time. Convert From BCD to Decimal
    73 000034EA 0FB6C5              <1>     movzx eax, ch   ;Hours
    74 000034ED E84D000000          <1>     call .bcd2Bin
    75 000034F2 88C5                <1>     mov ch, al
    76 000034F4 0FB6C1              <1>     movzx eax, cl     ;Mins
    77 000034F7 E843000000          <1>     call .bcd2Bin
    78 000034FC 88C1                <1>     mov cl, al
    79 000034FE 0FB6C6              <1>     movzx eax, dh   ;Seconds
    80 00003501 E839000000          <1>     call .bcd2Bin
    81 00003506 86E0                <1>     xchg ah, al ;Move seconds to ah, and 0 to al (hseconds)
    82 00003508 89C2                <1>     mov edx, eax
    83 0000350A B42D                <1>     mov ah, 2Dh ;DOS Set Time
    84 0000350C CD21                <1>     int 21h
    85                              <1> ;Now get the date from RTC
    86                              <1> ;CL - Year, in BCD
    87                              <1> ;DH - Month, in BCD
    88                              <1> ;DL - Day, in BCD
    89 0000350E B404                <1>     mov ah, 04  ;Read RTC Date
    90 00003510 CD3A                <1>     int 3Ah
    91 00003512 7247                <1>     jc .clkEnd
    92                              <1> ;Year from RTC is assumed to be after 2000 (coz, you know... its 2022)
    93 00003514 0FB6C1              <1>     movzx eax, cl   ;Convert Year to Binary
    94 00003517 E823000000          <1>     call .bcd2Bin
    95 0000351C 0FB6C8              <1>     movzx ecx, al   ;Zero extend to ecx (because ch needs to be 0)
    96 0000351F 81C1D0070000        <1>     add ecx, 2000   ;ecx is from 2000
    97 00003525 0FB6C6              <1>     movzx eax, dh   ;Get Months
    98 00003528 E812000000          <1>     call .bcd2Bin
    99 0000352D 88C6                <1>     mov dh, al  
