   779                              <1> .ubpbCheckMedOk:
   780 000008A5 8A4315              <1>     mov al, byte [rbx + oemHeader_size + bpb.media] ;Get medbyte from BPB
   781 000008A8 E83A000000          <1>     call .checkMedByt   ;Check if it is 0F0h or geq 0F8h
   782 000008AD 7545                <1>     jnz .ubpbOldDisk    ;If it is not, don't trust the BPB. Read the FAT sector
   783                              <1> ;Now we do the pre DOS 3.2 single sided check and kludge.
   784 000008AF A801                <1>     test al, 1  ;Double sided bit set on media byte?
   785 000008B1 0F85B2000000        <1>     jnz .ubpbNormalDisk ;If set, proceed as normal.
   786                              <1> ;Here if we have a "single-sided" formatted media.
   787                              <1> ;Check the OEM string. We filter out SCPDOS disks first.
   788 000008B7 817B0353435044      <1>     cmp dword [rbx + oemHeader.oemString], "SCPD"
   789 000008BE 750C                <1>     jne .ubpbNotSCP
   790 000008C0 66817B074F53        <1>     cmp word [rbx + oemHeader.oemString + 4], "OS"
   791 000008C6 0F849D000000        <1>     je .ubpbNormalDisk
   792                              <1> .ubpbNotSCP:
   793                              <1> ;Now blind check version numbers for 16-bit DOS OEM strings.
   794                              <1> ;Search for DOS 2.0, 3.1 and 3.2. These versions have ID's such that 
   795                              <1> ; the version number starts at position 5.
   796                              <1> ;Usually, these BPBs have MSDOS or IBM<SPC><SPC> or OEM<SPC><SPC>
   797                              <1> ; as the OEM string. OEM stands for any three characters used by an
   798                              <1> ; OEM to identify disks they formatted, follows by "x.y" for a major
   799                              <1> ; and minor version number.
   800                              <1> ;Since we cannot enumerate all the OEM strings and can't guarantee
   801                              <1> ; that they have the bug, we will simply check the version number @
   802                              <1> ; position 5 in the string which seems to have been an unofficial 
   803                              <1> ; standard for placing the version number in the OEM string at the 
   804                              <1> ; time. 
   805                              <1> ;The dot in the check helps "guarantee" the number is a version number 
   806                              <1> ; we are possibly interested in.
   807 000008CC 66817B08332E        <1>     cmp word [rbx + oemHeader.oemString + 5], "3."  ;DOS 3?
   808 000008D2 720A                <1>     jb .ubpbAdjustSPC  ;If below, must be "2." or "1." which has bug. Adjust.
   809 000008D4 807B0A32            <1>     cmp byte [rbx + oemHeader.oemString + 7], "2"   ;DOS 3.2?
   810 000008D8 0F838B000000        <1>     jae .ubpbNormalDisk ;If above or equal 3.2, no need for adjustment.
   811                              <1> .ubpbAdjustSPC:
   812                              <1> ;Here we must be pre 16-bit DOS 3.2. Adjust the BPB in memory to have 
   813                              <1> ; a spc value of 1.
   814 000008DE C6430D01            <1>     mov byte [rbx + oemHeader_size + bpb.secPerClus], 1
   815 000008E2 E982000000          <1>     jmp .ubpbNormalDisk ;Now proceed as a normal disk
   816                              <1> .checkMedByt:
   817                              <1> ;Checks the media byte is of a valid type. Refuse media bytes we don't
   818                              <1> ; recognise as this is a sign of an unhealthy volume.
   819                              <1> ;Accept values 0FFh - 0F8h and 0F0h.
   820                              <1> ;Input: al = Media byte. 
   821                              <1> ;Ouput: ZF=NZ: Bad media byte. ZF=ZE: Ok media byte!
   822 000008E7 3CF0                <1>     cmp al, 0F0h
   823                              <1>     rete
