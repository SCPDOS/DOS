   349 00000018 ????????????????    <1>     .rdx    dq ?
   350 00000020 ????????????????    <1>     .rsi    dq ?
   351 00000028 ????????????????    <1>     .rdi    dq ?
   352 00000030 ????????????????    <1>     .rbp    dq ?
   353 00000038 ????????????????    <1>     .r8     dq ?  ;To be removed if truly not needed
