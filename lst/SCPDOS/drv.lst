   527                              <1> ;MISC ASCII control chars
   528                              <1> NUL equ 00h ;^@         | ASCII Null
   529                              <1> ETX equ 03h ;^C         | ASCII Break (End of Text) 
   530                              <1> ACK equ 06h ;^F         | ASCII Acknowledgement
   531                              <1> BEL equ 07h ;^G         | ASCII Bell
   532                              <1> BSP equ 08h ;^H         | ASCII Backspace
   533                              <1> TAB equ 09h ;^I         | ASCII Horizontal Tab
   534                              <1> LF  equ 0Ah ;^J         | ASCII Line Feed
   535                              <1> CR  equ 0Dh ;^M         | ASCII Carriage Return
   536                              <1> DLE equ 10h ;^P         | ASCII Data Link End (Toggle Print Echo)
   537                              <1> DC3 equ 13h ;^S         | ASCII Device Control 3 (Toggle Scroll Lock)
   538                              <1> DC4 equ 14h ;^T         | ASCII Device Control 4
   539                              <1> NAK equ 15h ;^U         | ASCII Negative Acknowledgement
   540                              <1> ETB equ 17h ;^W         | ASCII End of Transmission Block
   541                              <1> EOF equ 1Ah ;^Z         | ASCII Substitute character (End of File)
   542                              <1> ESC equ 1Bh ;           | ASCII Escape char, used for ANSI.SYS
   543                              <1> SPC equ 20h ;Printable  | ASCII Space
   544                              <1> ;This last one is NEVER printed with a caret as it is a console control char
   545                              <1> DEL equ 7Fh ;^?         | ASCII Rubout (Del char and dec cursor)
   546                              <1> 
   547                              <1> asciiCaret  equ 20h ;Used to check which chars need to be printed with caret
   548                              <1> ;Extended Ascii Codes
   549                              <1> eF1     equ 3Bh ;F1 second byte
   550                              <1> eF2     equ 3Ch ;F2 second byte
   551                              <1> eF3     equ 3Dh ;F3 second byte
   552                              <1> eF4     equ 3Eh ;F4 second byte
   553                              <1> eF5     equ 3Fh ;F5 second byte
   554                              <1> eF6     equ 40h ;F6 second byte
   555                              <1> eF7     equ 41h ;F7 second byte
   556                              <1> eCursL  equ 4Bh ;Cursor Left second byte
   557                              <1> eCursR  equ 4Dh ;Cursor Right second byte
   558                              <1> eIns    equ 52h ;Insert second byte
   559                              <1> eDel    equ 53h ;DEL second byte (not necessarily delete key)
