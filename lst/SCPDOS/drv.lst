  1664                              <1> .ioctlerr:
  1665 00000F10 5B                  <1>     pop rbx ;Pop the ret addr off the stack and tail to the bad media
  1666 00000F11 E964FDFFFF          <1>     jmp .iobadMed
  1667                              <1> .ioChsToLba:
  1668                              <1> ;Gets the first sector of the track selected by this call.
  1669                              <1> ;Works with the values set in the bpb of drvBlk which isn't ideal...
  1670                              <1> ;LBA = (( C x HPC ) + H ) x SPT + S - 1
  1671                              <1> ;Input: ebx = BIOS Function to call. Preserved.
  1672                              <1> ;Output: ecx = eax = LBA address for the first sector of the track
  1673                              <1> ;        rdi -> chsFormatBlock or IOBlock
  1674 00000F16 4889D7              <1>     mov rdi, rdx
  1675 00000F19 0FB74519            <1>     movzx eax, word [rbp + drvBlk.wNumHeads]
  1676 00000F1D 0FB74F03            <1>     movzx ecx, word [rdi + chsFormatBlock.wStartCyl]
  1677 00000F21 663B4D39            <1>     cmp cx, word [rbp + drvBlk.wNumCyl]
  1678 00000F25 73E9                <1>     jae .ioctlerr
  1679 00000F27 FFC1                <1>     inc ecx ;Inc as we get it as a zero based number
  1680 00000F29 F7E1                <1>     mul ecx
  1681 00000F2B 0FB74F01            <1>     movzx ecx, word [rdi + chsFormatBlock.wStartHead]
  1682 00000F2F 663B4D19            <1>     cmp cx, word [rbp + drvBlk.wNumHeads]
  1683 00000F33 73DB                <1>     jae .ioctlerr 
  1684 00000F35 01C8                <1>     add eax, ecx
  1685 00000F37 0FB74D17            <1>     movzx ecx, word [rbp + drvBlk.wSecPerTrk]
  1686 00000F3B F7E1                <1>     mul ecx
  1687 00000F3D 89C1                <1>     mov ecx, eax
  1688                              <1>     return
    13                              <2> %%_ret:
    14 00000F3F C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1689                              <1> ;---------------------------------------------------------------------------
  1690                              <1> ;                    LBA IO requests are structured here
  1691                              <1> ;---------------------------------------------------------------------------
  1692                              <1> .lbaVerify:
  1693 00000F40 B800840000          <1>     mov eax, 8400h  ;Verify sectors
  1694 00000F45 EB05                <1>     jmp short .lbaFmtCmn
  1695                              <1> .lbaFmt:
  1696 00000F47 B800850000          <1>     mov eax, 8500h  ;Format sectors
  1697                              <1> .lbaFmtCmn:
  1698 00000F4C 803A10              <1>     cmp byte [rdx + lbaIOBlock.size], lbaFormatBlock_size
  1699 00000F4F EB13                <1>     jmp short .lbaCmn
  1700                              <1> .lbaRead:
  1701 00000F51 B800820000          <1>     mov eax, 8200h  ;Read sectors
  1702 00000F56 EB05                <1>     jmp short .lbaRWCmn
  1703                              <1> .lbaWrite:
  1704 00000F58 B800830000          <1>     mov eax, 8300h  ;Write sectors
  1705                              <1> .lbaRWCmn:
  1706 00000F5D 488B5A10            <1>     mov rbx, qword [rdx + lbaIOBlock.xferBuffer]
  1707 00000F61 803A18              <1>     cmp byte [rdx + lbaIOBlock.size], lbaIOBlock_size
  1708                              <1> .lbaCmn:
  1709 00000F64 0F8506FDFFFF        <1>     jne .iobadCmdLen
  1710                              <1> ;Setup the vars for block IO
  1711 00000F6A 4889D7              <1>     mov rdi, rdx
  1712                              <1> ;Formally numSectors is a byte and will only be treated as a byte but
  1713                              <1> ; we reserve the following three bytes for future updates to allow
  1714                              <1> ; up to a dword of contiguous sectors to be written in one go.
  1715 00000F6D 31F6                <1>     xor esi, esi
  1716 00000F6F 877701              <1>     xchg esi, dword [rdi + lbaFormatBlock.numSectors]
  1717 00000F72 8B4F08              <1>     mov ecx, dword [rdi + lbaFormatBlock.startSector]
  1718 00000F75 034D1B              <1>     add ecx, dword [rbp + drvBlk.dHiddSec]  ;Point to sector in partition
  1719                              <1> .ioEp:
  1720 00000F78 89C2                <1>     mov edx, eax    ;Move the function number into dh (and zero dl)
  1721 00000F7A 8A5508              <1>     mov dl, byte [rbp + drvBlk.bBIOSNum]    ;Get BIOS number for device
  1722                              <1> .ioLp:
  1723 00000F7D E88DFBFFFF          <1>     call .blkIODirect
  1724 00000F82 0F8247FBFFFF        <1>     jc .ioDoErr
  1725 00000F88 E84DFBFFFF          <1>     call .ioAdvIOCTL
  1726 00000F8D 75EE                <1>     jnz .ioLp
  1727                              <1>     return
    13                              <2> %%_ret:
    14 00000F8F C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1728                              <1> ;---------------------------------------------------------------------------
  1729                              <1> 
  1730                              <1> ;---------------------------------------------------------------------------
  1731                              <1> ;                           Misc GENIO routines 
  1732                              <1> ;---------------------------------------------------------------------------
  1733                              <1> .ioSetIds:
  1734                              <1> ;We get the BS from the disk, write the new metadata and write it
  1735                              <1> ; back to the disk. If the BS is not extended, we error exit with
  1736                              <1> ; unknown media error.
  1737                              <1> ;Input: rbp -> drvBlk
  1738                              <1> ;       rdx -> idParamBlk to set from
  1739 00000F90 52                  <1>     push rdx    ;Save the ptr to the parameter block
  1740 00000F91 E860000000          <1>     call .ioGetSetSetup ;Return rbx -> Extended Bootsector structure
  1741 00000F96 5A                  <1>     pop rdx
  1742                              <1>     retc    ;If CF=CY, just return. Error info has been setup already
    57                              <2> cret c
