    87                              <1> ;Replacement Int 39h routine to replace interrupts these drivers hook.
    88                              <1> dosInt39h:
    89                              <1> ;For now, we just replace int 33h and int 39h back and then jump to i39h
    90 000004F4 B833250000          <1>     mov eax, 2533h
    91 000004F9 488B15DCFFFFFF      <1>     mov rdx, qword [i33Org]
    92 00000500 CD21                <1>     int 21h
    93 00000502 B839250000          <1>     mov eax, 2539h
    94 00000507 488B15C6FFFFFF      <1>     mov rdx, qword [i39Org]
    95 0000050E CD21                <1>     int 21h
    96                              <1> ;And now do the actual warm reboot
    97 00000510 FF25BEFFFFFF        <1>     jmp qword [i39Org]
    98                              <1> 
    99                              <1> ;Replacement Int 33h routine
   100                              <1> dosInt33h:
   101                              <1> ;--------------------------------------------------------------------------
   102                              <1> ;       This is a wrapper around the BIOS Int 33h handler.
   103                              <1> ;--------------------------------------------------------------------------
   104                              <1> ;This routine does the following:
   105                              <1> ;1) Checks if a format request is being made, in which case
   106                              <1> ;   it will ensure that the devSetDASD and devChgd bits are set for all 
   107                              <1> ;   drives for the BIOS drive in dl to ensure that the DOS driver treats
   108                              <1> ;   the DOS drives properly.
   109                              <1> ;
   110                              <1> ; For the most part (CHS is depreciated so we don't talk about it here):
   111                              <1> ;   AH = Function number (05h/85h is FORMAT)
   112                              <1> ;   AL = Number of sectors to xact.
   113                              <1> ;   RBX -> Points to a xfr buffer.
   114                              <1> ;   RCX = Start sector of xft.
   115                              <1> ;   DL = BIOS Drive number to xact on.
   116                              <1> ;--------------------------------------------------------------------------
   117                              <1> ;Enter the DOS driver critical section . When the MSD driver enters this it 
   118                              <1> ; already has the lock so this simply incs the count. If a process attempts 
   119                              <1> ; to bypass DOS and we are already processing a request it gets put on ice.
   120                              <1> ;--------------------------------------------------------------------------
   121                              <1> %if e1Dbg
   122                              <1>     cmp byte [0700h], -1
   123                              <1>     jne .e1skip
   124                              <1>     mov eax, 0100h
   125                              <1>     or byte [rsp + 2*8h], 1 ;Set CF
   126                              <1>     iretq
   127                              <1> .e1skip:
   128                              <1> %endif
   129                              <1> %if i33Dbg
   130                              <1>     call .dbgFun
   131                              <1> %endif
   132                              <1> ;Start by clearing the CF on entry
   133 00000516 80642410FE          <1>     and byte [rsp + 2*8], ~1
   134                              <1> ;Enter the device critical section
   135 0000051B 50                  <1>     push rax
   136 0000051C B802800000          <1>     mov eax, 8002h
   137 00000521 CD2A                <1>     int 2ah
   138 00000523 58                  <1>     pop rax
   139                              <1> ;Now put the retaddr in the var we own 
   140 00000524 8F055F000000        <1>     pop qword [.tmp]
   141                              <1> ;Now check that we are not formatting. If we are, we need to set the bit on
   142                              <1> ; all DOS drives that use this BIOS drive that it has been formatted and 
   143                              <1> ; changed.
   144 0000052A 50                  <1>     push rax    ;Push the function number on stack
   145 0000052B 80E47F              <1>     and ah, 7Fh ;Clear the top bit (as both 05h and 85h are formats)
   146 0000052E 80FC05              <1>     cmp ah, 05h
   147 00000531 7405                <1>     je .format
   148 00000533 80FC07              <1>     cmp ah, 07h ;Undocumented SCSI format?
   149 00000536 750A                <1>     jne .notFormat
   150                              <1> .format:
   151                              <1> ;Here we register the format request!
   152 00000538 B8C0000000          <1>     mov eax, devChgd | devSetDASD   ;Bits to set in flags
   153 0000053D E8DA0E0000          <1>     call msdDriver.setBitsForAllDevs
   154                              <1> .notFormat:
   155 00000542 58                  <1>     pop rax     ;Get the function number from stack
   156                              <1> ;Call previous handler and exit irq in this call.
   157 00000543 88153F000000        <1>     mov byte [.drv], dl ;Save the drive we are acting on
   158                              <1> ;~~~~~~~~~~~~~~~~DEBUG~~~~~~~~~~~~~~~~
   159                              <1> %if drvDbg
   160                              <1>     push rax
   161                              <1>     push rsi
   162                              <1>     lea rsi, .i33dbgStr1
   163                              <1>     call dbgPrintString
   164                              <1>     mov al, ah
   165                              <1>     call dbgPrintHexByte
   166                              <1>     lea rsi, .i33dbgStr11
   167                              <1>     call dbgPrintString
   168                              <1>     mov al, dl
   169                              <1>     call dbgPrintHexByte
   170                              <1>     call dbgCrlf
   171                              <1>     pop rsi
   172                              <1>     pop rax
   173                              <1> %endif
   174                              <1> ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   175 00000549 FF159DFFFFFF        <1>     call qword [i33Next]    
   176 0000054F 7327                <1>     jnc .exitI33
   177                              <1> ;We enter here when an error occurs!
   178 00000551 84E4                <1>     test ah, ah ;Error 0? Magical error needs to be cleaned up
   179 00000553 7423                <1>     jz .exitI33
   180                              <1> ;~~~~~~~~~~~~~~~~DEBUG~~~~~~~~~~~~~~~~
   181                              <1> %if drvDbg
   182                              <1>     push rsi
   183                              <1>     lea rsi, .i33dbgStr
   184                              <1>     call dbgPrintString
   185                              <1>     pop rsi
   186                              <1>     push rax
   187                              <1>     mov al, ah
   188                              <1>     call dbgPrintHexByte
   189                              <1>     pop rax
   190                              <1>     call dbgCrlf
   191                              <1> %endif
   192                              <1> ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   193 00000555 80FC06              <1>     cmp ah, 06h         ;Did a swap occur?
   194 00000558 751D                <1>     jne .exitI33Bad     ;All other errors get bubbled up
   195                              <1> ;Here we ensure that on all drives with this BIOS number, we 
   196                              <1> ; register that the swap occured :)
   197 0000055A 50                  <1>     push rax
   198 0000055B 52                  <1>     push rdx
   199 0000055C 0FB61525000000      <1>     movzx edx, byte [.drv]
   200 00000563 F7C280000000        <1>     test edx, 80h       ;Was this a hard disk?
   201 00000569 750A                <1>     jnz .exitI33Weird   ;Just skip setting this bit in this case
   202 0000056B B840000000          <1>     mov eax, devChgd    ;Set the device changed bit on all devices
   203 00000570 E8A70E0000          <1>     call msdDriver.setBitsForAllDevs
   204                              <1> .exitI33Weird:
   205 00000575 5A                  <1>     pop rdx
   206 00000576 58                  <1>     pop rax
   207                              <1> .exitI33Bad:
   208 00000577 F9                  <1>     stc
   209                              <1> .exitI33:
   210                              <1> ;Replace the retaddr back on the stack
   211 00000578 FF350B000000        <1>     push qword [.tmp]
   212                              <1> ;Exit the device critical section now
   213 0000057E 50                  <1>     push rax
   214 0000057F B802810000          <1>     mov eax, 8102h
   215 00000584 CD2A                <1>     int 2ah
   216 00000586 58                  <1>     pop rax
   217                              <1> ;And finally go back to the caller :)
   218                              <1>     return
    13                              <2> %%_ret:
    14 00000587 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   219                              <1> %if i33Dbg
   220                              <1> .dbgFun:
   221                              <1>     cmp byte [0700h], -1
   222                              <1>     retne
   223                              <1>     cmp byte [.drv], 0
   224                              <1>     retne
   225                              <1>     pop rax
   226                              <1> ;Now we enter the fake handler.
   227                              <1>     mov byte [0700h], 0
   228                              <1>     ;inc byte [.dbgCnt]
   229                              <1>     ;mov ah, 80h ;Timeout most of the time
   230                              <1>     ;cmp byte [.dbgCnt], 1
   231                              <1>     ;jne .dbgIret
   232                              <1>     mov eax, devChgd    ;Set the device changed bit on all devices
   233                              <1>     call msdDriver.setBitsForAllDevs
   234                              <1>     mov ah, 06h
   235                              <1> .dbgIret:
   236                              <1>     push rsi
   237                              <1>     lea rsi, .dbgStrMsg
   238                              <1>     call dbgPrintString
   239                              <1>     push rax
   240                              <1>     mov al, ah
   241                              <1>     call dbgPrintHexByte
   242                              <1>     pop rax
   243                              <1>     call dbgCrlf
   244                              <1>     pop rsi
   245                              <1>     or byte [rsp + 2*8h], 1 ;Set CF
   246                              <1>     iretq
   247                              <1> .dbgStrMsg db  "[BIOS DEBUG] REPORTING ERROR AH=",0
   248                              <1> .dbgCnt db 0
   249                              <1> %endif
   250                              <1> ;Local data for the main IRQ handler
   251 00000588 00                  <1> .drv    db 0    ;Drive we are acting on
   252 00000589 0000000000000000    <1> .tmp    dq 0
   253                              <1> ;~~~~~~~~~~~~~~~~DEBUG~~~~~~~~~~~~~~~~
   254                              <1> %if drvDbg
   255                              <1> .i33dbgStr1     db "[BIOS] Entering BIOS function ",0
   256                              <1> .i33dbgStr11    db "h on drive ",0
   257                              <1> .i33dbgStr      db "[BIOS] Int 33h Error detected: ",0
   258                              <1> %endif
   259                              <1> ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
