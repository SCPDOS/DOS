  2183                              <1> .getTime:
  2184                              <1> ;Gets the current time in a format ready to be used for disk access.
  2185 0000139F 31C0                <1>     xor eax, eax
  2186 000013A1 CD3A                <1>     int 3Ah
  2187 000013A3 0FB7D2              <1>     movzx edx, dx
  2188 000013A6 C1E110              <1>     shl ecx, 16 ;Move the high word into place, fill low word with 0's
  2189 000013A9 09D1                <1>     or ecx, edx ;Store the current time count into ecx
  2190 000013AB 84C0                <1>     test al, al ;Are we rolling over? al tells us how many days...
  2191 000013AD 740E                <1>     jz .stStore
  2192 000013AF 0FB6C0              <1>     movzx eax, al
  2193 000013B2 51                  <1>     push rcx    ;Save the current time count
  2194 000013B3 B9B0001800          <1>     mov ecx, 1800B0h    ;A single day's worth of ticks at 55ms
  2195 000013B8 F7E1                <1>     mul ecx
  2196 000013BA 59                  <1>     pop rcx
  2197 000013BB 01C1                <1>     add ecx, eax        ;Add "al" worth of ticks at 55ms to ecx :)
  2198                              <1> .stStore:
  2199 000013BD F8                  <1>     clc
  2200                              <1>     return
    13                              <2> %%_ret:
    14 000013BE C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
