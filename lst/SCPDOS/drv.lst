   373                              <1> ;DISK DRIVER ERROR HANDLER. Errors from within the functions come here!
   374                              <1> .errorXlat:
   375                              <1> ;Jumped to with ah = BIOS error code as reported on function call
   376 00000682 488D3D99000000      <1>     lea rdi, .biosErrTbl
   377 00000689 88E0                <1>     mov al, ah
   378 0000068B B905000000          <1>     mov ecx, errTblLen
   379 00000690 F2AE                <1>     repne scasb
   380 00000692 7505                <1>     jne .exNotFnd
   381 00000694 8A4704              <1>     mov al, byte [rdi + errTblLen - 1] ;Get entry in DOS table now
   382 00000697 EB7A                <1>     jmp short .errorExit
   383                              <1> .exNotFnd:
   384                              <1> ;Come here if the BIOS supplied code was not mapped to anything.
   385                              <1> ; We now get the SCSI code. Only a few cases make sense so
   386                              <1> ; we try and decypher. Else, general fault.
   387 00000699 0FB65508            <1>     movzx edx, byte [rbp + drvBlk.bBIOSNum]
   388 0000069D B800010000          <1>     mov eax, 0100h
   389 000006A2 CD33                <1>     int 33h     ;No need to preserve regs across this call 
   390                              <1> ;Device Not Ready
   391 000006A4 B802000000          <1>     mov eax, drvNotReady  ;Device not ready code
   392 000006A9 4138C0              <1>     cmp r8b, al  ;SCSI Not ready commands start with 2
   393 000006AC 7465                <1>     je .errorExit
   394 000006AE 49C1E808            <1>     shr r8, 8       ;Remove Sense Key
   395 000006B2 410FB7C8            <1>     movzx ecx, r8w  ;Get ASC and ASCQ in cl and ch bzw.
   396                              <1> ;Write Protected
   397 000006B6 B800000000          <1>     mov eax, drvWPErr
   398 000006BB 6681F92700          <1>     cmp cx, 0027h   ;Write protected error
   399 000006C0 7451                <1>     je .errorExit
   400                              <1> ;CRC Error
   401 000006C2 B804000000          <1>     mov eax, drvCRCErr     ;CRC error code
   402 000006C7 6681F90803          <1>     cmp cx, 0308h   ;LU comms CRC error (UDMA/32)
   403 000006CC 7445                <1>     je .errorExit
   404 000006CE 6681F91000          <1>     cmp cx, 0010h   ;ID CRC or ECC error
