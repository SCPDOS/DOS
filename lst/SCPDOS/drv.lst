  1507 00000E4B F6450FFF            <1>     test byte [rbp + drvBlk.bNumFAT], -1    ;If 0 FATs, the FAT is invalid!
  1508 00000E4F 0F45C3              <1>     cmovnz eax, ebx                         ;Set if we have a FAT
  1509 00000E52 8B551B              <1>     mov edx, dword [rbp + drvBlk.dHiddSec]
  1510 00000E55 0FB75D0A            <1>     movzx ebx, word [rbp + drvBlk.wBpS]
  1511 00000E59 0FB74D12            <1>     movzx ecx, word [rbp + drvBlk.wTotSec16]
  1512 00000E5D 85C9                <1>     test ecx, ecx
  1513 00000E5F 7503                <1>     jnz .lgpStor
  1514 00000E61 8B4D1F              <1>     mov ecx, dword [rbp + drvBlk.dTotSec32]
  1515                              <1> .lgpStor:
  1516                              <1> ;Enter with:
  1517                              <1> ;ax = 0 if unformatted, 1 if any FAT type (means can call CHS function)
  1518                              <1> ;rbx = Sector size in bytes
  1519                              <1> ;rcx = Last LBA block address + 1 (Count of sectors)
  1520                              <1> ;rdx = Hidden sectors
  1521 00000E64 66894704            <1>     mov word [rdi + lbaParamsBlock.wFSType], ax
