   696                              <1> .updateBpb:
   697                              <1> ;------------------------------------------------------
   698                              <1> ;Updates the BPB fields in drvBlk for the BPB on disk
   699                              <1> ; or failing, for the BPB indicated by the media byte.
   700                              <1> ;Never called on Fixed devs in normal operation.
   701                              <1> ;------------------------------------------------------
   702                              <1> ;Entered with: 
   703                              <1> ;   rbp -> drvBlk for this drive
   704                              <1> ;------------------------------------------------------
   705                              <1> ;Exited with:
   706                              <1> ;   If CF=NC:
   707                              <1> ;       rbx -> The start of the BPB
   708                              <1> ;       rsi -> End of the BPB. Points to the extSig
   709                              <1> ;               if present.
   710                              <1> ;   Else:
   711                              <1> ;       If ZF=NZ: 
   712                              <1> ;           eax = DOS error code (Invalid BPB detected)
   713                              <1> ;       Else:
   714                              <1> ;           eax = BIOS error code
   715                              <1> ;------------------------------------------------------
   716 0000087C 66F745370500        <1>     test word [rbp + drvBlk.wDevFlgs], devFixed | devLockBpb
   717                              <1>     retnz  
