  1211                              <1> .bioError:
  1212                              <1> ;Jumped to with ah = BIOS error code
  1213 00000B60 E8BB050000          <1>     call .checkSwapIO
  1214                              <1> ;Reset the drive. WARNING: CRASHES BOCHS. Does E9h check. 
  1215 00000B65 E807000000          <1>     call .bioReset  ;Resets .bLastDsk to -1
  1216 00000B6A FFCE                <1>     dec esi
  1217 00000B6C 75C6                <1>     jnz .biolp
  1218 00000B6E 5E                  <1>     pop rsi ;Pop the sector count off the stack
  1219                              <1>     ;ZF=ZE set now as esi counted down
  1220 00000B6F F9                  <1>     stc
  1221                              <1>     return
    13                              <2> %%_ret:
    14 00000B70 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1222                              <1> .bioReset:
  1223                              <1> ;Resets the drive system for the drive in dl
  1224 00000B71 50                  <1>     push rax
  1225                              <1>     ;in al, 0E9h ;Catches if we are in BOCHS and avoids issuing a buggy reset
  1226                              <1>     ;cmp al, 0E9h
  1227                              <1>     ;je .bioResetSkip
  1228 00000B72 31C0                <1>     xor eax, eax    ;Do reset
  1229 00000B74 E8A4070000          <1>     call .callI33h  ;Ignore any errors
  1230                              <1> .bioResetSkip:
  1231 00000B79 C605C9080000FF      <1>     mov byte [.bLastDsk], -1    ;Reset the last disk accessed
  1232 00000B80 58                  <1>     pop rax
  1233                              <1>     return
    13                              <2> %%_ret:
    14 00000B81 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1234                              <1> .bioSanity:
  1235                              <1> ;Input: ecx = Sector we will transact on. rbp -> DrvBlk
  1236                              <1> ;Output: CF=NC, sector ok to xact on
  1237                              <1> ;        CF=CY, doesnt return, fails the call. ZF=ZE always (have DOS code)
  1238                              <1> ;        If the sector fails check, we return from the top level with ZF=ZE
  1239                              <1> ;           to indicate a DOS error code in eax.
  1240 00000B82 A9FF000000          <1>     test eax, 0FFh  ;If the bottom byte is set, it is a IOCTL call.
  1241                              <1>     retnz           ;BIOS checks these for us as IOCTL bypasses partitions.
    45                              <2> cret nz
