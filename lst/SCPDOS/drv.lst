  2335 000014BA 5B                  <1>     pop rbx
  2336                              <1> 
  2337 000014BB B802810000          <1>     mov eax, 8102h  ;Exit Driver critical section
  2338 000014C0 CD2A                <1>     int 2Ah
  2339 000014C2 58                  <1>     pop rax
  2340 000014C3 48CF                <1>     iretq
