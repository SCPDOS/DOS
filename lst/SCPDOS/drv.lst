  1572 00000ED6 0FB77517            <1>     movzx esi, word [rbp + drvBlk.wSecPerTrk]   ;Fmt/Verify this many sectors
  1573 00000EDA 89D8                <1>     mov eax, ebx    ;Move the function number to eax
