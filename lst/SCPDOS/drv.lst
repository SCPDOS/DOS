   825                              <1> .ubpbOldest:
   826                              <1> ;Here we build a pretend BPB in the sector buffer pointed to by rbx.
   827                              <1> ;This will then be used to build the internal data structure. 
   828 00000951 488D1DDB1B0000      <1>     lea rbx, .drvBpbTbl
   829 00000958 2CFA                <1>     sub al, 0FAh    ;Get the offset into the bpb table
   830 0000095A B919000000          <1>     mov ecx, bpb_size
   831 0000095F F7E1                <1>     mul ecx         ;Get byte offset into the bpb table
   832 00000961 4801C3              <1>     add rbx, rax    ;Point rbx to this bpb in the table
   833 00000964 EB07                <1>     jmp short .ubpbMoveBpb
