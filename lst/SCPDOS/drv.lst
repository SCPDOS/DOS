  2481                              <1> .drvBlkTbl:
  2482                              <1> ;All drives start with Sectors/Cluster as -1 to indicate not initialised.
  2483                              <1> ;All drives start with Media Descripter as 0 (invalid type)
  2484                              <1> ;All drives start with dAccTime at -1 to force "uncertain" read for remdevs
  2485                              <1> ;All drives present 63 Cylinders (only valid as a field on fixed disks)
  2486                              <1> ;All drives have as an alt BPB, a 1.44Mb 3.5" Floppy.
  2487                              <1>     %assign i 0
  2488                              <1>     %rep drvBlkTblL
  2489                              <1>     istruc drvBlk
  2490                              <1>         at .pLink,      dq -1   ;End of table marker
  2491                              <1>         at .bBIOSNum,   db i    ;DOS drive number
  2492                              <1>         at .bDOSNum,    db i    ;BIOS drives default to removable
  2493                              <1> ;Do a FAT12/16 BPB in FAT32 format
  2494                              <1>         at .wBpS,       dw 200h
  2495                              <1>         at .bSpC,       db -1       
  2496                              <1>         at .wResC,      dw 0001h
  2497                              <1>         at .bNumFAT,    db 02h
  2498                              <1>         at .wRtCntNum,  dw 00E0h    
  2499                              <1>         at .wTotSec16,  dw 0B40h    
  2500                              <1>         at .bMedDesc,   db 00h    
  2501                              <1>         at .wFATsz16,   dw 0009h    
  2502                              <1>         at .wSecPerTrk, dw 0012h    
  2503                              <1>         at .wNumHeads,  dw 0002h    
  2504                              <1>         at .dHiddSec,   dd 0    
  2505                              <1>         at .dTotSec32,  dd 0     
  2506                              <1> ;FAT 32 fields. All zeros
  2507                              <1>         at .FATsz32,    dd 0
  2508                              <1>         at .extFlags,   dw 0
  2509                              <1>         at .FSver,      dw 0
  2510                              <1>         at .RootClus,   dd 0
  2511                              <1>         at .FSinfo,     dw 0
  2512                              <1>         at .BkBootSec,  dw 0
  2513                              <1> ;DrvBlk Flags
  2514                              <1>         at .bBpbType,   db bpbFat12
  2515                              <1>         at .wOpenCnt,   dw 0
  2516                              <1>         at .bDevType,   db typeGenRem   ;Init to generic removable device
  2517                              <1>         at .wDevFlgs,   dw 0
  2518                              <1>         at .wNumCyl,    dw 63   
  2519                              <1>         istruc bpb32
  2520                              <1>             at .bytsPerSec, dw 200h
  2521                              <1>             at .secPerClus, db 01h
  2522                              <1>             at .revdSecCnt, dw 0001h
  2523                              <1>             at .numFATs,    db 02h    
  2524                              <1>             at .rootEntCnt, dw 00E0h    
  2525                              <1>             at .totSec16,   dw 0B40h    
  2526                              <1>             at .media,      db 0F0h    
  2527                              <1>             at .FATsz16,    dw 0009h    
  2528                              <1>             at .secPerTrk,  dw 0012h    
