  1408                              <1> .iosdpNoTrack:
  1409                              <1> ;Now we update the rest of the disk metadata.
  1410                              <1> ;Now copy the rest of the bytes and return
  1411 00000D06 0FB74202            <1>     movzx eax, word [rdx + chsParamsBlock.wDevFlgs]
  1412 00000D0A 2503000000          <1>     and eax, devFixed | devChgLine  ;Keep only these two bits
  1413 00000D0F 66816537FCFF        <1>     and word [rbp + drvBlk.wDevFlgs], ~(devFixed | devChgLine)   ;Clear em
  1414 00000D15 66094537            <1>     or word [rbp + drvBlk.wDevFlgs], ax  ;Add those two bits as set
  1415 00000D19 0FB64201            <1>     movzx eax, byte [rdx + chsParamsBlock.bDevType]
  1416 00000D1D 884536              <1>     mov byte [rbp + drvBlk.bDevType], al
  1417 00000D20 66814D378000        <1>     or word [rbp + drvBlk.wDevFlgs], devSetDASD 
  1418 00000D26 0FB74204            <1>     movzx eax, word [rdx + chsParamsBlock.wNumCyl]
  1419 00000D2A 66894539            <1>     mov word [rbp + drvBlk.wNumCyl], ax
  1420                              <1> ;Finally, here we do the BPB magic.
  1421                              <1> ;
  1422                              <1> ;The logic here is that in a format operation, we first update the driver 
  1423                              <1> ; devBlk bpb fields with the new format and set the devLockBpb flag. 
  1424                              <1> ; This is so the bpb isn't updated from the disk when a disk operation is 
  1425                              <1> ; enacted and that the parameters we passed in this call are what are
  1426                              <1> ; reported to DOS whilst the bootsector hasn't been synchronised with 
  1427                              <1> ; the disk.
  1428                              <1> ;
  1429                              <1> ;We then write the bootsector with the new bpb to disk, thus synchronising
  1430                              <1> ; the new bpb parameter block with what is on disk.
  1431                              <1> ;
  1432                              <1> ;Then we call this again, this time, to clear the locking flag as the disk
  1433                              <1> ; is now sychronised with the accurate bpb. We also here can get rid of 
  1434                              <1> ; the old backup bpb and so the second call will replace the backup
  1435                              <1> ; with whatever we pass it (ideally, the same bpb).
  1436                              <1> ;
  1437                              <1> ;This procedure protects us from accidentally making the drive unusable if
  1438                              <1> ; we somehow fail to write the BPB by having updated the drvBlk. The 
  1439                              <1> ; protection occurs by allowing us to restore the backup bpb as the devBlk 
  1440                              <1> ; bpb if the disk synchronisation of the new parameters failed.
  1441 00000D2E F60201              <1>     test byte [rdx + chsParamsBlock.bSpecFuncs], specFuncBPB
  1442 00000D31 7511                <1>     jnz .iosdpSetBPB    ;If bit set, lock the bpb
  1443                              <1> ;Else we update the backup bpb and unlock the main bpb
  1444 00000D33 488D7D3B            <1>     lea rdi, qword [rbp + drvBlk.sBkupBPB]
  1445 00000D37 B935000000          <1>     mov ecx, bpb32_size
  1446 00000D3C 66816537FBFF        <1>     and word [rbp + drvBlk.wDevFlgs], ~devLockBpb   ;Now allow update bpb 
  1447 00000D42 EB0F                <1>     jmp short .iosdpCopy
  1448                              <1> .iosdpSetBPB:
  1449 00000D44 488D7D0A            <1>     lea rdi, qword [rbp + drvBlk.bpb]   ;Default to the normal BPB in drvblk
  1450 00000D48 B929000000          <1>     mov ecx, drvBlkBpb_size
  1451 00000D4D 66814D370400        <1>     or word [rbp + drvBlk.wDevFlgs], devLockBpb ;Lock the BPB now
  1452                              <1> .iosdpCopy:
  1453 00000D53 488D7207            <1>     lea rsi, qword [rdx + chsParamsBlock.deviceBPB]
  1454 00000D57 F3A4                <1>     rep movsb
  1455                              <1>     return
