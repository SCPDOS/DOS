    82 00000002 ????                <1>     .shareSig   db 2 dup (?)  ;Share record number for this file (to find record)
    83 00000004 ????                <1>     .fileAttr   db 2 dup (?)  ;File attribute (accessed as a byte)
    84                              <1> endstruc
    85                              <1> 
