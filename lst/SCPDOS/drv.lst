  1408                              <1> .iosdpNoTrack:
  1409                              <1> ;Now we update the rest of the disk metadata.
  1410                              <1> ;Now copy the rest of the bytes and return
  1411 00000D06 0FB74202            <1>     movzx eax, word [rdx + chsParamsBlock.wDevFlgs]
  1412 00000D0A 2503000000          <1>     and eax, devFixed | devChgLine  ;Keep only these two bits
  1413 00000D0F 66816537FCFF        <1>     and word [rbp + drvBlk.wDevFlgs], ~(devFixed | devChgLine)   ;Clear em
  1414 00000D15 66094537            <1>     or word [rbp + drvBlk.wDevFlgs], ax  ;Add those two bits as set
  1415 00000D19 0FB64201            <1>     movzx eax, byte [rdx + chsParamsBlock.bDevType]
  1416 00000D1D 884536              <1>     mov byte [rbp + drvBlk.bDevType], al
  1417 00000D20 66814D378000        <1>     or word [rbp + drvBlk.wDevFlgs], devSetDASD 
  1418 00000D26 0FB74204            <1>     movzx eax, word [rdx + chsParamsBlock.wNumCyl]
  1419 00000D2A 66894539            <1>     mov word [rbp + drvBlk.wNumCyl], ax
  1420                              <1> ;Finally, here we do the BPB magic.
  1421                              <1> ;
  1422                              <1> ;The logic here is that in a format operation, we first update the driver 
  1423                              <1> ; devBlk bpb fields with the new format and set the devLockBpb flag. 
  1424                              <1> ; This is so the bpb isn't updated from the disk when a disk operation is 
  1425                              <1> ; enacted and that the parameters we passed in this call are what are
  1426                              <1> ; reported to DOS whilst the bootsector hasn't been synchronised with 
  1427                              <1> ; the disk.
  1428                              <1> ;
  1429                              <1> ;We then write the bootsector with the new bpb to disk, thus synchronising
  1430                              <1> ; the new bpb parameter block with what is on disk.
  1431                              <1> ;
  1432                              <1> ;Then we call this again, this time, to clear the locking flag as the disk
  1433                              <1> ; is now sychronised with the accurate bpb. We also here can get rid of 
  1434                              <1> ; the old backup bpb and so the second call will replace the backup
  1435                              <1> ; with whatever we pass it (ideally, the same bpb).
  1436                              <1> ;
  1437                              <1> ;This procedure protects us from accidentally making the drive unusable if
  1438                              <1> ; we somehow fail to write the BPB by having updated the drvBlk. The 
  1439                              <1> ; protection occurs by allowing us to restore the backup bpb as the devBlk 
  1440                              <1> ; bpb if the disk synchronisation of the new parameters failed.
  1441 00000D2E F60201              <1>     test byte [rdx + chsParamsBlock.bSpecFuncs], specFuncBPB
  1442 00000D31 7511                <1>     jnz .iosdpSetBPB    ;If bit set, lock the bpb
  1443                              <1> ;Else we update the backup bpb and unlock the main bpb
  1444 00000D33 488D7D3B            <1>     lea rdi, qword [rbp + drvBlk.sBkupBPB]
  1445 00000D37 B935000000          <1>     mov ecx, bpb32_size
  1446 00000D3C 66816537FBFF        <1>     and word [rbp + drvBlk.wDevFlgs], ~devLockBpb   ;Now allow update bpb 
  1447 00000D42 EB0F                <1>     jmp short .iosdpCopy
  1448                              <1> .iosdpSetBPB:
  1449 00000D44 488D7D0A            <1>     lea rdi, qword [rbp + drvBlk.bpb]   ;Default to the normal BPB in drvblk
  1450 00000D48 B929000000          <1>     mov ecx, drvBlkBpb_size
  1451 00000D4D 66814D370400        <1>     or word [rbp + drvBlk.wDevFlgs], devLockBpb ;Lock the BPB now
  1452                              <1> .iosdpCopy:
  1453 00000D53 488D7207            <1>     lea rsi, qword [rdx + chsParamsBlock.deviceBPB]
  1454 00000D57 F3A4                <1>     rep movsb
  1455                              <1>     return
    13                              <2> %%_ret:
    14 00000D59 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1456                              <1> 
  1457                              <1> .lbaSetParams:
  1458                              <1> ;This only sets the sector size and number of sectors in drvBlk.bpb.
  1459                              <1>     ;Set start sector of partition
  1460 00000D5A 8B4A18              <1>     mov ecx, dword [rdx + lbaParamsBlock.qStartSector]
  1461 00000D5D 894D1B              <1>     mov dword [rbp + drvBlk.dHiddSec], ecx
  1462                              <1>     ;Set sector size
  1463 00000D60 8B4A08              <1>     mov ecx, dword [rdx + lbaParamsBlock.qSectorSize]
  1464 00000D63 66894D0A            <1>     mov word [rbp + drvBlk.wBpS], cx
  1465                              <1>     ;Set same device flags as in CHS.
  1466 00000D67 0FB64A02            <1>     movzx ecx, byte [rdx + lbaParamsBlock.wDevFlgs]
  1467 00000D6B 6681E10300          <1>     and cx, devFixed | devChgLine
  1468 00000D70 66094D37            <1>     or word [rbp + drvBlk.wDevFlgs], cx
  1469                              <1>     ;Set sector information.
  1470 00000D74 8B4A10              <1>     mov ecx, dword [rdx + lbaParamsBlock.qNumSectors]
  1471 00000D77 81F9FFFF0000        <1>     cmp ecx, 0FFFFh
  1472 00000D7D 7605                <1>     jna .lbaSetSmall
  1473 00000D7F 894D1F              <1>     mov dword [rbp + drvBlk.dTotSec32], ecx
  1474 00000D82 31C9                <1>     xor ecx, ecx
  1475                              <1> .lbaSetSmall:
  1476 00000D84 66894D12            <1>     mov word [rbp + drvBlk.wTotSec16], cx
  1477                              <1>     return
    13                              <2> %%_ret:
    14 00000D88 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1478                              <1> ;---------------------------------------------------------------------------
  1479                              <1> ;               Get Device parameters in CHS and LBA here
  1480                              <1> ;---------------------------------------------------------------------------
  1481                              <1> .ioGetDevParams:
  1482 00000D89 7561                <1>     jnz .lbaGetParams
  1483                              <1> ;Here we get CHS params. 
  1484 00000D8B 488D750A            <1>     lea rsi, qword [rbp + drvBlk.bpb]
  1485 00000D8F F60201              <1>     test byte [rdx + chsParamsBlock.bSpecFuncs], specFuncBPB
  1486 00000D92 751F                <1>     jnz .iogdpBkup  ;If set, return the bpb data as is.
  1487 00000D94 66F745370100        <1>     test word [rbp + drvBlk.wDevFlgs], devFixed
  1488 00000D9A 7517                <1>     jnz .iogdpBkup  ;If it is fixed, return the BPB as is too
  1489 00000D9C E8DEFAFFFF          <1>     call .updateBpb ;Else, gets the BPB from the disk.
  1490 00000DA1 0F8228FDFFFF        <1>     jc .ioDoErr ;Errors returned as if from block IO handler
  1491 00000DA7 E8E9FBFFFF          <1>     call .moveVolIds    ;Move the volume ID's into the drvBlk if they exist.
  1492 00000DAC 488D358E070000      <1>     lea rsi, qword [.inBuffer + 11]
  1493                              <1> .iogdpBkup:
  1494                              <1> ;The caller block in memory must have a bpb32_size'ed space for the BPB
  1495                              <1> ; even if it is a FAT16/12 drive. The caller has to assertain the 
  1496                              <1> ; type of BPB it is based information in the common part of the BPB.
  1497 00000DB3 488D7A07            <1>     lea rdi, qword [rdx + chsParamsBlock.deviceBPB]
  1498 00000DB7 B935000000          <1>     mov ecx, bpb32_size
  1499 00000DBC F3A4                <1>     rep movsb
  1500 00000DBE B805000000          <1>     mov eax, typeHard
  1501 00000DC3 B907000000          <1>     mov ecx, typeGenRem
  1502 00000DC8 F6453701            <1>     test byte [rbp + drvBlk.wDevFlgs], devFixed
  1503 00000DCC 0F44C1              <1>     cmovz eax, ecx  ;eax is set to 7 if the dev is removable
  1504 00000DCF 884201              <1>     mov byte [rdx + chsParamsBlock.bDevType], al
  1505 00000DD2 0FB74537            <1>     movzx eax, word [rbp + drvBlk.wDevFlgs]
  1506 00000DD6 2503000000          <1>     and eax, devFixed | devChgLine
  1507 00000DDB 66894202            <1>     mov word [rdx + chsParamsBlock.wDevFlgs], ax
  1508 00000DDF C6420600            <1>     mov byte [rdx + chsParamsBlock.bMedTyp], 0
  1509 00000DE3 0FB74539            <1>     movzx eax, word [rbp + drvBlk.wNumCyl]
  1510 00000DE7 66894204            <1>     mov word [rdx + chsParamsBlock.wNumCyl], ax
