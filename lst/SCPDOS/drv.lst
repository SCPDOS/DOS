  2292                              <1> .i2fCheck:
  2293 00001452 B0FF                <1>     mov al, -1  ;Indicate installed!
  2294 00001454 48CF                <1>     iretq
  2295                              <1> .i2fAddTbl:
  2296                              <1> ;Adds a new entry to the drive chain and updates the multiownership bits
  2297                              <1> ; as it does :)
  2298                              <1> ;Input: rdi -> New drvBlk to link to table (can be multiple!)
  2299                              <1> ;Destroy rax, rbx and rsi
  2300 00001456 488D359E110000      <1>     lea rsi, .drvBlkTbl
  2301 0000145D 0FB64708            <1>     movzx eax, byte [rdi + drvBlk.bBIOSNum]
  2302                              <1> .i2fATLp:
