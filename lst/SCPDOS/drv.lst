    81                              <1> ;         Extended error codes level 2
    82                              <1> ;----------------------------------------------
    83                              <1> errFilExist equ 80  ;File already exists
    84                              <1> errDirExist equ 82  ;Directory already exists
    85                              <1> errFI24     equ 83  ;Fail on Int 24h
    86                              <1> errRedir    equ 84  ;Too many levels of redirection
    87                              <1> errDupRedir equ 85  ;Trying to redirect a redirection
    88                              <1> errBadPass  equ 86  ;Bad password
    89                              <1> errBadParam equ 87  ;Bad parameter passed to request
    90                              <1> errNetWrite equ 88  ;Network Write Fault
    91                              <1> errEnvVarNotFnd equ 203 ;Environment variable doesn't exist
    92                              <1> ;-----------------------------------------------------------------------------
    93                              <1> ;Error Loci
    94                              <1> eLocUnk     equ 1   ;Unknown locus, nonspecific or not appropriate
    95                              <1> eLocDsk     equ 2   ;Disk, related to Random Access to a disk or block device
    96                              <1> eLocNet     equ 3   ;Network related issues
    97                              <1> eLocChr     equ 4   ;Serial/Character Device error
    98                              <1> eLocMem     equ 5   ;Related to RAM
    99                              <1> ;-----------------------------------------------------------------------------
   100                              <1> ;Error Actions
   101                              <1> eActRet     equ 1   ;Retry
   102                              <1> eActDRet    equ 2   ;Delay then retry (Try again later)
   103                              <1> eActUsr     equ 3   ;Ask user to re-input data, i.e. bad filename or something
   104                              <1> eActAbt     equ 4   ;Abort with cleanup
   105                              <1> eActKil     equ 5   ;Abort without cleanup
   106                              <1> eActIgn     equ 6   ;Ignore error
   107                              <1> eActRetUsr  equ 7   ;Retry after user intervention (i.e swap remdev)
   108                              <1> ;-----------------------------------------------------------------------------
   109                              <1> ;Error Classes
   110                              <1> eClsOoR     equ 1   ;Out of resources, no mem or handles
   111                              <1> eClsTS      equ 2   ;Temp sitch, should go away
   112                              <1> eClsAuth    equ 3   ;Authorisation, e.g. file permission error 
   113                              <1> eClsInt     equ 4   ;Internal DOS error or bug
   114                              <1> eClsHrdFlt  equ 5   ;Hardware Failure
   115                              <1> eClsSysFlt  equ 6   ;System Failure, i.e. missing or bad cfg files
   116                              <1> eClsAppFlt  equ 7   ;Application Program error, inconsistent requests etc...
   117                              <1> eClsNotFnd  equ 8   ;Resource not found (such as free SFT entry etc...)
   118                              <1> eClsBadFmt  equ 9   ;Bad format for resource
   119                              <1> eClsLocked  equ 10  ;Resource Locked
   120                              <1> eClsMedia   equ 11  ;Error is on medium, i.e. wrong or damaged remdev
   121                              <1> eClsClash   equ 12  ;Resource already exists!
   122                              <1> eClsUnk     equ 13  ;Unknown class
