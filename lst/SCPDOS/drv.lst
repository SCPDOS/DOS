    45 000034BF 31D2                <1>     xor edx, edx    ;Set screen cursor to top right corner
    46 000034C1 88D7                <1>     mov bh, dl      ;Set cursor for page 0
    47 000034C3 CD30                <1>     int 30h
    48 000034C5 B707                <1>     mov bh, 07h     ;Grey/Black attribs
    49 000034C7 B800060000          <1>     mov eax, 0600h  ;Clear whole screen
    50 000034CC CD30                <1>     int 30h
    51 000034CE 5A                  <1>     pop rdx
    52 000034CF 59                  <1>     pop rcx
    53 000034D0 5B                  <1>     pop rbx
    54 000034D1 58                  <1>     pop rax
