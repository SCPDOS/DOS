  1358                              <1> .iosdpNoTrack:
  1359                              <1> ;Now we update the rest of the disk metadata.
  1360                              <1> ;Now copy the rest of the bytes and return
  1361 00000D03 0FB74202            <1>     movzx eax, word [rdx + chsParamsBlock.wDevFlgs]
  1362 00000D07 2503000000          <1>     and eax, devFixed | devChgLine  ;Keep only these two bits
  1363 00000D0C 66816537FCFF        <1>     and word [rbp + drvBlk.wDevFlgs], ~(devFixed | devChgLine)   ;Clear em
  1364 00000D12 66094537            <1>     or word [rbp + drvBlk.wDevFlgs], ax  ;Add those two bits as set
  1365 00000D16 0FB64201            <1>     movzx eax, byte [rdx + chsParamsBlock.bDevType]
  1366 00000D1A 884536              <1>     mov byte [rbp + drvBlk.bDevType], al
  1367 00000D1D 66814D378000        <1>     or word [rbp + drvBlk.wDevFlgs], devSetDASD 
  1368 00000D23 0FB74204            <1>     movzx eax, word [rdx + chsParamsBlock.wNumCyl]
  1369 00000D27 66894539            <1>     mov word [rbp + drvBlk.wNumCyl], ax
  1370                              <1> ;Finally, here we do the BPB magic.
  1371                              <1> ;
  1372                              <1> ;The logic here is that in a format operation, we first update the driver 
  1373                              <1> ; devBlk bpb fields with the new format and set the devLockBpb flag. 
  1374                              <1> ; This is so the bpb isn't updated from the disk when a disk operation is 
  1375                              <1> ; enacted and that the parameters we passed in this call are what are
  1376                              <1> ; reported to DOS whilst the bootsector hasn't been synchronised with 
  1377                              <1> ; the disk.
  1378                              <1> ;
  1379                              <1> ;We then write the bootsector with the new bpb to disk, thus synchronising
  1380                              <1> ; the new bpb parameter block with what is on disk.
  1381                              <1> ;
  1382                              <1> ;Then we call this again, this time, to clear the locking flag as the disk
  1383                              <1> ; is now sychronised with the accurate bpb. We also here can get rid of 
  1384                              <1> ; the old backup bpb and so the second call will replace the backup
  1385                              <1> ; with whatever we pass it (ideally, the same bpb).
  1386                              <1> ;
  1387                              <1> ;This procedure protects us from accidentally making the drive unusable if
  1388                              <1> ; we somehow fail to write the BPB by having updated the drvBlk. The 
  1389                              <1> ; protection occurs by allowing us to restore the backup bpb as the devBlk 
  1390                              <1> ; bpb if the disk synchronisation of the new parameters failed.
  1391 00000D2B F60201              <1>     test byte [rdx + chsParamsBlock.bSpecFuncs], specFuncBPB
  1392 00000D2E 7511                <1>     jnz .iosdpSetBPB    ;If bit set, lock the bpb
  1393                              <1> ;Else we update the backup bpb and unlock the main bpb
  1394 00000D30 488D7D3B            <1>     lea rdi, qword [rbp + drvBlk.sBkupBPB]
  1395 00000D34 B935000000          <1>     mov ecx, bpb32_size
  1396 00000D39 66816537FBFF        <1>     and word [rbp + drvBlk.wDevFlgs], ~devLockBpb   ;Now allow update bpb 
  1397 00000D3F EB0F                <1>     jmp short .iosdpCopy
  1398                              <1> .iosdpSetBPB:
  1399 00000D41 488D7D0A            <1>     lea rdi, qword [rbp + drvBlk.bpb]   ;Default to the normal BPB in drvblk
  1400 00000D45 B929000000          <1>     mov ecx, drvBlkBpb_size
  1401 00000D4A 66814D370400        <1>     or word [rbp + drvBlk.wDevFlgs], devLockBpb ;Lock the BPB now
  1402                              <1> .iosdpCopy:
  1403 00000D50 488D7207            <1>     lea rsi, qword [rdx + chsParamsBlock.deviceBPB]
  1404 00000D54 F3A4                <1>     rep movsb
  1405                              <1>     return
    13                              <2> %%_ret:
    14 00000D56 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1406                              <1> 
  1407                              <1> .lbaSetParams:
  1408                              <1> ;This only sets the sector size and number of sectors in drvBlk.bpb.
  1409                              <1>     ;Set start sector of partition
  1410 00000D57 8B4A18              <1>     mov ecx, dword [rdx + lbaParamsBlock.qStartSector]
  1411 00000D5A 894D1B              <1>     mov dword [rbp + drvBlk.dHiddSec], ecx
  1412                              <1>     ;Set sector size
  1413 00000D5D 8B4A08              <1>     mov ecx, dword [rdx + lbaParamsBlock.qSectorSize]
  1414 00000D60 66894D0A            <1>     mov word [rbp + drvBlk.wBpS], cx
  1415                              <1>     ;Set same device flags as in CHS.
  1416 00000D64 0FB64A02            <1>     movzx ecx, byte [rdx + lbaParamsBlock.wDevFlgs]
  1417 00000D68 6681E10300          <1>     and cx, devFixed | devChgLine
  1418 00000D6D 66094D37            <1>     or word [rbp + drvBlk.wDevFlgs], cx
  1419                              <1>     ;Set sector information.
  1420 00000D71 8B4A10              <1>     mov ecx, dword [rdx + lbaParamsBlock.qNumSectors]
  1421 00000D74 81F9FFFF0000        <1>     cmp ecx, 0FFFFh
  1422 00000D7A 7605                <1>     jna .lbaSetSmall
  1423 00000D7C 894D1F              <1>     mov dword [rbp + drvBlk.dTotSec32], ecx
  1424 00000D7F 31C9                <1>     xor ecx, ecx
  1425                              <1> .lbaSetSmall:
  1426 00000D81 66894D12            <1>     mov word [rbp + drvBlk.wTotSec16], cx
  1427                              <1>     return
    13                              <2> %%_ret:
    14 00000D85 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1428                              <1> ;---------------------------------------------------------------------------
  1429                              <1> ;               Get Device parameters in CHS and LBA here
  1430                              <1> ;---------------------------------------------------------------------------
  1431                              <1> .ioGetDevParams:
  1432 00000D86 7561                <1>     jnz .lbaGetParams
  1433                              <1> ;Here we get CHS params. 
  1434 00000D88 488D750A            <1>     lea rsi, qword [rbp + drvBlk.bpb]
  1435 00000D8C F60201              <1>     test byte [rdx + chsParamsBlock.bSpecFuncs], specFuncBPB
  1436 00000D8F 751F                <1>     jnz .iogdpBkup  ;If set, return the bpb data as is.
  1437 00000D91 66F745370100        <1>     test word [rbp + drvBlk.wDevFlgs], devFixed
  1438 00000D97 7517                <1>     jnz .iogdpBkup  ;If it is fixed, return the BPB as is too
  1439 00000D99 E8DEFAFFFF          <1>     call .updateBpb ;Else, gets the BPB from the disk.
  1440 00000D9E 0F8228FDFFFF        <1>     jc .ioDoErr ;Errors returned as if from block IO handler
  1441 00000DA4 E8E9FBFFFF          <1>     call .moveVolIds    ;Move the volume ID's into the drvBlk if they exist.
  1442 00000DA9 488D358E070000      <1>     lea rsi, qword [.inBuffer + 11]
  1443                              <1> .iogdpBkup:
  1444                              <1> ;The caller block in memory must have a bpb32_size'ed space for the BPB
  1445                              <1> ; even if it is a FAT16/12 drive. The caller has to assertain the 
  1446                              <1> ; type of BPB it is based information in the common part of the BPB.
  1447 00000DB0 488D7A07            <1>     lea rdi, qword [rdx + chsParamsBlock.deviceBPB]
  1448 00000DB4 B935000000          <1>     mov ecx, bpb32_size
  1449 00000DB9 F3A4                <1>     rep movsb
  1450 00000DBB B805000000          <1>     mov eax, typeHard
  1451 00000DC0 B907000000          <1>     mov ecx, typeGenRem
  1452 00000DC5 F6453701            <1>     test byte [rbp + drvBlk.wDevFlgs], devFixed
  1453 00000DC9 0F44C1              <1>     cmovz eax, ecx  ;eax is set to 7 if the dev is removable
  1454 00000DCC 884201              <1>     mov byte [rdx + chsParamsBlock.bDevType], al
  1455 00000DCF 0FB74537            <1>     movzx eax, word [rbp + drvBlk.wDevFlgs]
  1456 00000DD3 2503000000          <1>     and eax, devFixed | devChgLine
  1457 00000DD8 66894202            <1>     mov word [rdx + chsParamsBlock.wDevFlgs], ax
  1458 00000DDC C6420600            <1>     mov byte [rdx + chsParamsBlock.bMedTyp], 0
  1459 00000DE0 0FB74539            <1>     movzx eax, word [rbp + drvBlk.wNumCyl]
  1460 00000DE4 66894204            <1>     mov word [rdx + chsParamsBlock.wNumCyl], ax
  1461                              <1>     return
    13                              <2> %%_ret:
    14 00000DE8 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1462                              <1> 
  1463                              <1> .lbaGetParams:
  1464                              <1> ;Gets more "updated" information on partitions.
  1465                              <1> ;The data returned will always be the partition maximum! For remdevs
  1466                              <1> ; this means up to the whole media size and for fixed disks we are still 
  1467                              <1> ; restricted to the partition size.
  1468 00000DE9 B805000000          <1>     mov eax, drvBadDrvReq
  1469 00000DEE 803A20              <1>     cmp byte [rdx + lbaParamsBlock.bSize], lbaParamsBlock_size
  1470 00000DF1 0F851CF9FFFF        <1>     jne .errorExit
  1471 00000DF7 4889D7              <1>     mov rdi, rdx    ;Store the params block ptr in rdi
  1472 00000DFA 807F0102            <1>     cmp byte [rdi + lbaParamsBlock.bSpecFuncs], 2   ;Check get phys call.
  1473 00000DFE 0F870FF9FFFF        <1>     ja .errorExit   ;If above 2, error with bad request!
  1474 00000E04 7425                <1>     je .lgpbpbGetPhys
  1475 00000E06 F6470101            <1>     test byte [rdi + lbaParamsBlock.bSpecFuncs], 1  ;Check if we update BPB.
  1476 00000E0A 7539                <1>     jnz .lgpbpbok
  1477 00000E0C 66F745370100        <1>     test word [rbp + drvBlk.wDevFlgs], devFixed
  1478 00000E12 7531                <1>     jnz .lgpbpbok  ;If it is fixed, return the BPB as is too
  1479 00000E14 57                  <1>     push rdi    ;Push the param block onto the stack
  1480 00000E15 E862FAFFFF          <1>     call .updateBpb
  1481 00000E1A 7208                <1>     jc .lgpbpbnotok ;Even if just bad BPB, keep changed bit on!
  1482 00000E1C E871FBFFFF          <1>     call .moveVolIds    ;Move the volume ID's into the drvBlk if they exist.
  1483 00000E21 5F                  <1>     pop rdi     ;Pop param block
  1484 00000E22 EB21                <1>     jmp short .lgpbpbok
  1485                              <1> .lgpbpbnotok:
  1486                              <1> ;If no valid BPB found, and the device removable, return BIOS params for the 
  1487                              <1> ; whole device. We never come here for fixed disks as updateBpb always passes.
  1488 00000E24 5F                  <1>     pop rdi
  1489 00000E25 0F8457F8FFFF        <1>     jz .errorXlat   ;If update returned CF=CY and ZF=ZE, xlat the BIOS code
  1490                              <1> ;We only fall here if on an unformatted removable disk.
  1491                              <1> ;Unformatted means with an unrecognisable BPB.
  1492                              <1> .lgpbpbGetPhys:
  1493 00000E2B 0FB65508            <1>     movzx edx, byte [rbp + drvBlk.bBIOSNum]
  1494 00000E2F B800880000          <1>     mov eax, 8800h  ;Read LBA Device Parameters
  1495 00000E34 CD33                <1>     int 33h         ;Need a naked call as params returned in regs!
  1496 00000E36 0F8246F8FFFF        <1>     jc .errorXlat
  1497 00000E3C 48FFC1              <1>     inc rcx         ;Turn into an absolute count of sectors
  1498 00000E3F 31D2                <1>     xor edx, edx    ;0 Hidden sectors on remdevs/unformatted media
  1499                              <1> ;eax = 0 since either not formatted or values may not be ok for CHS calls
  1500 00000E41 89D0                <1>     mov eax, edx     
  1501 00000E43 EB1F                <1>     jmp short .lgpStor
  1502                              <1> .lgpbpbok:
  1503 00000E45 31C0                <1>     xor eax, eax
  1504 00000E47 89C3                <1>     mov ebx, eax
  1505 00000E49 FFC3                <1>     inc ebx
