    84                              <1> ;Replacement Int 39h routine to replace interrupts these drivers hook.
    85                              <1> dosInt39h:
    86                              <1> ;For now, we just replace int 33h and int 39h back and then jump to i39h
    87 000004F4 B833250000          <1>     mov eax, 2533h
    88 000004F9 488B15DCFFFFFF      <1>     mov rdx, qword [i33Org]
    89 00000500 CD21                <1>     int 21h
    90 00000502 B839250000          <1>     mov eax, 2539h
    91 00000507 488B15C6FFFFFF      <1>     mov rdx, qword [i39Org]
    92 0000050E CD21                <1>     int 21h
    93                              <1> ;And now do the actual warm reboot
    94 00000510 FF25BEFFFFFF        <1>     jmp qword [i39Org]
    95                              <1> 
    96                              <1> ;Replacement Int 33h routine
    97                              <1> dosInt33h:
    98                              <1> ;--------------------------------------------------------------------------
    99                              <1> ;       This is a wrapper around the BIOS Int 33h handler.
   100                              <1> ;--------------------------------------------------------------------------
   101                              <1> ;This routine does the following:
   102                              <1> ;1) Checks if a format request is being made, in which case
   103                              <1> ;   it will ensure that the devSetDASD and devChgd bits are set for all 
   104                              <1> ;   drives for the BIOS drive in dl to ensure that the DOS driver treats
   105                              <1> ;   the DOS drives properly.
   106                              <1> ;
   107                              <1> ; For the most part (CHS is depreciated so we don't talk about it here):
   108                              <1> ;   AH = Function number (05h/85h is FORMAT)
   109                              <1> ;   AL = Number of sectors to xact.
   110                              <1> ;   RBX -> Points to a xfr buffer.
   111                              <1> ;   RCX = Start sector of xft.
   112                              <1> ;   DL = BIOS Drive number to xact on.
   113                              <1> ;--------------------------------------------------------------------------
   114                              <1> ;Enter the DOS driver critical section . When the MSD driver enters this it 
   115                              <1> ; already has the lock so this simply incs the count. If a process attempts 
   116                              <1> ; to bypass DOS and we are already processing a request it gets put on ice.
   117                              <1> ;--------------------------------------------------------------------------
   118                              <1> %if drvDbg && i33Dbg
   119                              <1>     call .dbgFun
   120                              <1> %endif
   121                              <1> ;Start by clearing the CF on entry
   122 00000516 80642410FE          <1>     and byte [rsp + 2*8], ~1
   123                              <1> ;Enter the device critical section
   124 0000051B 50                  <1>     push rax
   125 0000051C B802800000          <1>     mov eax, 8002h
   126 00000521 CD2A                <1>     int 2ah
   127 00000523 58                  <1>     pop rax
   128                              <1> ;Now put the retaddr in the var we own 
   129 00000524 8F055F000000        <1>     pop qword [.tmp]
   130                              <1> ;Now check that we are not formatting. If we are, we need to set the bit on
   131                              <1> ; all DOS drives that use this BIOS drive that it has been formatted and 
   132                              <1> ; changed.
   133 0000052A 50                  <1>     push rax    ;Push the function number on stack
   134 0000052B 80E47F              <1>     and ah, 7Fh ;Clear the top bit (as both 05h and 85h are formats)
   135 0000052E 80FC05              <1>     cmp ah, 05h
   136 00000531 7405                <1>     je .format
   137 00000533 80FC07              <1>     cmp ah, 07h ;Undocumented SCSI format?
   138 00000536 750A                <1>     jne .notFormat
   139                              <1> .format:
   140                              <1> ;Here we register the format request!
   141 00000538 B8C0000000          <1>     mov eax, devChgd | devSetDASD   ;Bits to set in flags
   142 0000053D E8D30E0000          <1>     call msdDriver.setBitsForAllDevs
   143                              <1> .notFormat:
   144 00000542 58                  <1>     pop rax     ;Get the function number from stack
   145                              <1> ;Call previous handler and exit irq in this call.
   146 00000543 88153F000000        <1>     mov byte [.drv], dl ;Save the drive we are acting on
   147                              <1> ;~~~~~~~~~~~~~~~~DEBUG~~~~~~~~~~~~~~~~
   148                              <1> %if drvDbg
   149                              <1>     push rax
   150                              <1>     push rsi
   151                              <1>     lea rsi, .i33dbgStr1
   152                              <1>     call dbgPrintString
   153                              <1>     mov al, ah
   154                              <1>     call dbgPrintHexByte
   155                              <1>     lea rsi, .i33dbgStr11
   156                              <1>     call dbgPrintString
   157                              <1>     mov al, dl
   158                              <1>     call dbgPrintHexByte
   159                              <1>     call dbgCrlf
   160                              <1>     pop rsi
   161                              <1>     pop rax
   162                              <1> %endif
   163                              <1> ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   164 00000549 FF159DFFFFFF        <1>     call qword [i33Next]    
   165 0000054F 7327                <1>     jnc .exitI33
   166                              <1> ;We enter here when an error occurs!
   167 00000551 84E4                <1>     test ah, ah ;Error 0? Magical error needs to be cleaned up
   168 00000553 7423                <1>     jz .exitI33
   169                              <1> ;~~~~~~~~~~~~~~~~DEBUG~~~~~~~~~~~~~~~~
   170                              <1> %if drvDbg
   171                              <1>     push rsi
   172                              <1>     lea rsi, .i33dbgStr
   173                              <1>     call dbgPrintString
   174                              <1>     pop rsi
   175                              <1>     push rax
   176                              <1>     mov al, ah
   177                              <1>     call dbgPrintHexByte
   178                              <1>     pop rax
   179                              <1>     call dbgCrlf
   180                              <1> %endif
   181                              <1> ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   182 00000555 80FC06              <1>     cmp ah, 06h         ;Did a swap occur?
   183 00000558 751D                <1>     jne .exitI33Bad     ;All other errors get bubbled up
   184                              <1> ;Here we ensure that on all drives with this BIOS number, we 
   185                              <1> ; register that the swap occured :)
   186 0000055A 50                  <1>     push rax
   187 0000055B 52                  <1>     push rdx
   188 0000055C 0FB61525000000      <1>     movzx edx, byte [.drv]
   189 00000563 F7C280000000        <1>     test edx, 80h       ;Was this a hard disk?
   190 00000569 750A                <1>     jnz .exitI33Weird   ;Just skip setting this bit in this case
   191 0000056B B840000000          <1>     mov eax, devChgd    ;Set the device changed bit on all devices
   192 00000570 E8A00E0000          <1>     call msdDriver.setBitsForAllDevs
   193                              <1> .exitI33Weird:
   194 00000575 5A                  <1>     pop rdx
   195 00000576 58                  <1>     pop rax
   196                              <1> .exitI33Bad:
   197 00000577 F9                  <1>     stc
   198                              <1> .exitI33:
   199                              <1> ;Replace the retaddr back on the stack
   200 00000578 FF350B000000        <1>     push qword [.tmp]
   201                              <1> ;Exit the device critical section now
   202 0000057E 50                  <1>     push rax
   203 0000057F B802810000          <1>     mov eax, 8102h
   204 00000584 CD2A                <1>     int 2ah
   205 00000586 58                  <1>     pop rax
   206                              <1> ;And finally go back to the caller :)
   207                              <1>     return
    13                              <2> %%_ret:
    14 00000587 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   208                              <1> %if drvDbg && i33Dbg
   209                              <1> .dbgFun:
   210                              <1>     cmp byte [0700h], -1
   211                              <1>     retne
   212                              <1>     cmp byte [.drv], 0
   213                              <1>     retne
   214                              <1>     pop rax
   215                              <1> ;Now we enter the fake handler.
   216                              <1>     mov byte [0700h], 0
   217                              <1>     ;inc byte [.dbgCnt]
   218                              <1>     ;mov ah, 80h ;Timeout most of the time
   219                              <1>     ;cmp byte [.dbgCnt], 1
   220                              <1>     ;jne .dbgIret
   221                              <1>     mov eax, devChgd    ;Set the device changed bit on all devices
   222                              <1>     call msdDriver.setBitsForAllDevs
   223                              <1>     mov ah, 06h
   224                              <1> .dbgIret:
   225                              <1>     push rsi
   226                              <1>     lea rsi, .dbgStrMsg
   227                              <1>     call dbgPrintString
   228                              <1>     push rax
   229                              <1>     mov al, ah
   230                              <1>     call dbgPrintHexByte
   231                              <1>     pop rax
   232                              <1>     call dbgCrlf
   233                              <1>     pop rsi
   234                              <1>     or byte [rsp + 2*8h], 1 ;Set CF
   235                              <1>     iretq
   236                              <1> .dbgStrMsg db  "[BIOS DEBUG] REPORTING ERROR AH=",0
   237                              <1> .dbgCnt db 0
   238                              <1> %endif
   239                              <1> ;Local data for the main IRQ handler
   240 00000588 00                  <1> .drv    db 0    ;Drive we are acting on
   241 00000589 0000000000000000    <1> .tmp    dq 0
   242                              <1> ;~~~~~~~~~~~~~~~~DEBUG~~~~~~~~~~~~~~~~
   243                              <1> %if drvDbg
   244                              <1> .i33dbgStr1     db "[BIOS] Entering BIOS function ",0
   245                              <1> .i33dbgStr11    db "h on drive ",0
   246                              <1> .i33dbgStr      db "[BIOS] Int 33h Error detected: ",0
   247                              <1> %endif
   248                              <1> ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
