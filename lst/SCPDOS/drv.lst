  2513                              <1> .drvBlkTbl:
  2514                              <1> ;All drives start with Sectors/Cluster as -1 to indicate not initialised.
  2515                              <1> ;All drives start with Media Descripter as 0 (invalid type)
  2516                              <1> ;All drives start with dAccTime at -1 to force "uncertain" read for remdevs
  2517                              <1> ;All drives present 63 Cylinders (only valid as a field on fixed disks)
  2518                              <1> ;All drives have as an alt BPB, a 1.44Mb 3.5" Floppy.
  2519                              <1>     %push
  2520                              <1>     %assign i 0
  2521                              <1>     %rep drvBlkTblL
  2522                              <1>     istruc drvBlk
  2523                              <1>         at .pLink,      dq -1   ;End of table marker
  2524                              <1>         at .bBIOSNum,   db i    ;DOS drive number
  2525                              <1>         at .bDOSNum,    db i    ;BIOS drives default to removable
  2526                              <1> ;Do a FAT12/16 BPB in FAT32 format
