   905                              <1> .moveVolIds:
   906                              <1> ;Now check the BPB for a extBs. If it is present, we copy the information.
   907                              <1> ;Input: rsi -> End of the BPB in sector. rbp -> drvBlk
   908                              <1> ;Output: CF=CY: No volume label in sector found.
   909                              <1> ;        CF=NC: Volume Label in sector found and copied.
   910 00000995 E849080000          <1>     call .clearMediaChange   ;Start by clearing the changed bit if it was set
   911 0000099A 807E0229            <1>     cmp byte [rsi + extBs.bootSig], extBsSig
   912 0000099E 752B                <1>     jne .mviNoSig
   913                              <1> ;Else, now we copy the volume information from the extended bs info block
   914 000009A0 8B4603              <1>     mov eax, dword [rsi + extBs.volId]
   915 000009A3 898580000000        <1>     mov dword [rbp + drvBlk.volId], eax
   916 000009A9 4881C607000000      <1>     add rsi, extBs.volLab
   917 000009B0 488D7D74            <1>     lea rdi, qword [rbp + drvBlk.volLab]
   918 000009B4 B90B000000          <1>     mov ecx, 11 ;Copy the volume label
   919 000009B9 F3A4                <1>     rep movsb   
   920                              <1>     ;rsi now points to the filSysType field in the extBs.
   921                              <1>     ;Move rdi to the filSysType field in the drvBlk.
   922 000009BB 488DBD84000000      <1>     lea rdi, qword [rbp + drvBlk.filSysType]
   923 000009C2 B908000000          <1>     mov ecx, 8  ;Now copy the 8 char string over too
   924 000009C7 F3A4                <1>     rep movsb   
   925                              <1> ;Clear the change bit now
   926 000009C9 F8                  <1>     clc
   927                              <1>     return
