    36                              <3> %%a:
    37                              <3> 
   606                              <1> .checkDataPtn:
   607 00003A64 3C05                <1>     cmp al, 05h     ;Extended Partition which should use CHS for addressing
   608 00003A66 7407                <1>     je .ceptBad
   609 00003A68 3C0F                <1>     cmp al, 0Fh     ;Extended Partition which should use LBA for addressing
   610 00003A6A 7403                <1>     je .ceptBad
   611 00003A6C 39C0                <1>     cmp eax, eax    ;Set the Zero flag
   612                              <1>     return
    13                              <2> %%_ret:
    14 00003A6E C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   613                              <1> .ceptBad:
   614 00003A6F 85C0                <1>     test eax, eax   ;Clears the Zero flag (as eax is not zero)
   615                              <1>     return
    13                              <2> %%_ret:
    14 00003A71 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   616                              <1> 
   617                              <1> .checkMbrPtnType:
   618                              <1> ;Input: al = Partition type
   619                              <1> ;Output: ZF=ZE => Valid partition type found
   620                              <1> ;        ZF=NZ => Not a valid partition type
   621 00003A72 51                  <1>     push rcx
   622 00003A73 57                  <1>     push rdi
   623 00003A74 488D3D0A000000      <1>     lea rdi, .ptnTbl
   624 00003A7B B909000000          <1>     mov ecx, .ptnTblL
   625 00003A80 F2AE                <1>     repne scasb ;Find the entry in al
   626 00003A82 5F                  <1>     pop rdi
   627 00003A83 59                  <1>     pop rcx
   628                              <1>     return
    13                              <2> %%_ret:
    14 00003A84 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   629                              <1> 
   630                              <1> ;Table contents:
   631                              <1> ; 01h - FAT 12 Partition. CHS addressing should be used.
   632                              <1> ; 04h - FAT 16 Partition up to 32MB. CHS addressing should be used.
   633                              <1> ; 05h - Extended Partition in MBR found. CHS addressing should be used.
   634                              <1> ; 06h - FAT 16 Partition over 32MB. CHS addressing should be used.
   635                              <1> ; 0Bh - FAT 32 Partition. CHS addressing should be used.
   636                              <1> ; 0Ch - FAT 32 Partition. LBA addressing should be used.
   637                              <1> ; 0Eh - FAT 16 Partition. LBA addressing should be used.
   638                              <1> ; 0Fh - Extended Partition in MBR found. LBA addressing should be used.
   639 00003A85 010405060B0C0D0E0F  <1> .ptnTbl db 01h, 04h, 05h, 06h, 0Bh, 0Ch, 0Dh, 0Eh, 0Fh
   640                              <1> .ptnTblL    equ $ - .ptnTbl 
