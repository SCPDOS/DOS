  2586                              <1>             at .FSinfo,     dw 0
  2587                              <1>             at .BkBootSec,  dw 0
  2588                              <1>             at .reserved,   db 12 dup (0) 
  2589                              <1>         iend
  2590                              <1>         at .dAccTime,   dd -1 
