   719                              <1> ;1) Clear volume Id
   720 0000082E C78580000000000000- <1>     mov dword [rbp + drvBlk.volId], 0
   720 00000837 00                  <1>
   721                              <1> ;2) Reset the volume label to default
   722 00000838 488D35ED0C0000      <1>     lea rsi, .defLbl
