  1642                              <1> .ioctlerr:
  1643 00000EFE 5B                  <1>     pop rbx ;Pop the ret addr off the stack and tail to the bad media
  1644 00000EFF E976FDFFFF          <1>     jmp .iobadMed
  1645                              <1> .ioChsToLba:
  1646                              <1> ;Gets the first sector of the track selected by this call.
  1647                              <1> ;Works with the values set in the bpb of drvBlk which isn't ideal...
  1648                              <1> ;LBA = (( C x HPC ) + H ) x SPT + S - 1
  1649                              <1> ;Input: ebx = BIOS Function to call. Preserved.
  1650                              <1> ;Output: ecx = eax = LBA address for the first sector of the track
  1651                              <1> ;        rdi -> chsFormatBlock or IOBlock
  1652 00000F04 4889D7              <1>     mov rdi, rdx
  1653 00000F07 0FB74519            <1>     movzx eax, word [rbp + drvBlk.wNumHeads]
  1654 00000F0B 0FB74F03            <1>     movzx ecx, word [rdi + chsFormatBlock.wStartCyl]
  1655 00000F0F 663B4D39            <1>     cmp cx, word [rbp + drvBlk.wNumCyl]
  1656 00000F13 73E9                <1>     jae .ioctlerr
  1657 00000F15 FFC1                <1>     inc ecx ;Inc as we get it as a zero based number
  1658 00000F17 F7E1                <1>     mul ecx
  1659 00000F19 0FB74F01            <1>     movzx ecx, word [rdi + chsFormatBlock.wStartHead]
  1660 00000F1D 663B4D19            <1>     cmp cx, word [rbp + drvBlk.wNumHeads]
  1661 00000F21 73DB                <1>     jae .ioctlerr 
  1662 00000F23 01C8                <1>     add eax, ecx
  1663 00000F25 0FB74D17            <1>     movzx ecx, word [rbp + drvBlk.wSecPerTrk]
  1664 00000F29 F7E1                <1>     mul ecx
  1665 00000F2B 89C1                <1>     mov ecx, eax
  1666                              <1>     return
    13                              <2> %%_ret:
    14 00000F2D C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
