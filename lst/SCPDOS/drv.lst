  1661                              <1> .ioSetIds:
  1662                              <1> ;We get the BS from the disk, write the new metadata and write it
  1663                              <1> ; back to the disk. If the BS is not extended, we error exit with
  1664                              <1> ; unknown media error.
  1665                              <1> ;Input: rbp -> drvBlk
  1666                              <1> ;       rdx -> idParamBlk to set from
  1667 00000F7B 52                  <1>     push rdx    ;Save the ptr to the parameter block
  1668 00000F7C E860000000          <1>     call .ioGetSetSetup ;Return rbx -> Extended Bootsector structure
  1669 00000F81 5A                  <1>     pop rdx
  1670                              <1>     retc    ;If CF=CY, just return. Error info has been setup already
