  1721                              <1> ;Now we setup the info in the BS we just read and write the BS back.
  1722                              <1> ;rbx points to the extBS structure
  1723 00000F88 B917000000          <1>     mov ecx, 4+11+8 ;Lengths of ID, Label and FS string 
  1724 00000F8D 488D7202            <1>     lea rsi, qword [rdx + idParamBlk.volId]
  1725 00000F91 488D7B03            <1>     lea rdi, qword [rbx + extBs.volId]
  1726 00000F95 F3A4                <1>     rep movsb
  1727                              <1> ;Now write the bootsector back
  1728 00000F97 31C9                <1>     xor ecx, ecx    ;Write Sector 0...
  1729 00000F99 034D1B              <1>     add ecx, dword [rbp + drvBlk.dHiddSec]
  1730 00000F9C 0FB65508            <1>     movzx edx, byte [rbp + drvBlk.bBIOSNum]
  1731 00000FA0 488D1D8F050000      <1>     lea rbx, .inBuffer  ;Use the in sector buffer.
  1732 00000FA7 BE05000000          <1>     mov esi, 5
  1733                              <1> .iosidLp:
  1734 00000FAC B801830000          <1>     mov eax, 8301h  ;LBA Write function (write 1 sector)
  1735 00000FB1 E853040000          <1>     call .callI33h
  1736 00000FB6 0F8388FBFFFF        <1>     jnc .bioExit   ;Setup the last access time and disk and return to caller
  1737                              <1> ;Here if an error. AH has the BIOS error code. Return with
  1738                              <1> ; ZF=ZE to indicate we are returning a BIOS code!
  1739 00000FBC E8B0FBFFFF          <1>     call .bioReset  ;Reset the drive. Saves error code in ah
  1740 00000FC1 FFCE                <1>     dec esi
  1741 00000FC3 75E7                <1>     jnz .iosidLp
  1742                              <1> ;Exit by translating BIOS error to DOS error and putting it in the reqpkt.
  1743                              <1> ; We return to the caller directly. The rest call sets the last drive to -1.
  1744                              <1> ; Dont update time fields.
  1745 00000FC5 E9B8F6FFFF          <1>     jmp .errorXlat 
