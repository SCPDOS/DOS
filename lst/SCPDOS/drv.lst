   905                              <1> .moveVolIds:
   906                              <1> ;Now check the BPB for a extBs. If it is present, we copy the information.
   907                              <1> ;Input: rsi -> End of the BPB in sector. rbp -> drvBlk
   908                              <1> ;Output: CF=CY: No volume label in sector found.
   909                              <1> ;        CF=NC: Volume Label in sector found and copied.
   910 00000995 E835090000          <1>     call .clearMediaChange   ;Start by clearing the changed bit if it was set
   911 0000099A 807E0229            <1>     cmp byte [rsi + extBs.bootSig], extBsSig
