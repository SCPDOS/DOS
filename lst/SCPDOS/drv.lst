   940 000009DD 01D0                <1>     add eax, edx
   941 000009DF 31D2                <1>     xor edx, edx
   942 000009E1 F7F1                <1>     div ecx     ;eax = Root Dir sectors
   943 000009E3 50                  <1>     push rax    ;Save Root Dir sectors on the stack
   944 000009E4 0FB7430B            <1>     movzx eax, word [rbx + bpb.FATsz16]
   945 000009E8 8B5319              <1>     mov edx, dword [rbx + bpb32.FATsz32]
   946 000009EB 85C0                <1>     test eax, eax
   947 000009ED 0F44C2              <1>     cmovz eax, edx
   948 000009F0 0FB64B05            <1>     movzx ecx, byte [rbx + bpb.numFATs]
   949 000009F4 F7E1                <1>     mul ecx         ;eax = BPB_NumFATs * FATSz
   950 000009F6 85C0                <1>     test eax, eax   ;If either BPB_NumFATs or FATSz is 0, fail!
