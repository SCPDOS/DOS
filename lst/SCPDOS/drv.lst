   538 000039EC 0FB605(03000000)    <1>     movzx eax, byte [biosDrv]   ;Get the BIOS drive
   539 000039F3 884508              <1>     mov byte [rbp + drvBlk.bBIOSNum], al
   540 000039F6 51                  <1>     push rcx
   541 000039F7 56                  <1>     push rsi    ;Save the mbr entry ptr
   542 000039F8 E882CEFFFF          <1>     call msdDriver.updateBpb
   543 000039FD 7209                <1>     jc .pubBad
   544 000039FF E891CFFFFF          <1>     call msdDriver.moveVolIds
   545 00003A04 5E                  <1>     pop rsi
   546 00003A05 59                  <1>     pop rcx
   547 00003A06 F8                  <1>     clc         ;Always clean even if no ids
   548                              <1>     return
    13                              <2> %%_ret:
    14 00003A07 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   549                              <1> .pubBad:
   550 00003A08 5E                  <1>     pop rsi
