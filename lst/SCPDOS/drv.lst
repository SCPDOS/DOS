   910 00000A0C 29C8                <1>     sub eax, ecx    ;Datasec [eax] = eax - ecx
   911 00000A0E 0FB64B02            <1>     movzx ecx, byte [rbx + bpb.secPerClus]
   912 00000A12 E31D                <1>     jrcxz .bbpbGFTErr
   913 00000A14 31D2                <1>     xor edx, edx
   914 00000A16 F7F1                <1>     div ecx         ;eax = CountofClusters = DataSec / BPB_SecPerClus;
   915 00000A18 BA10000000          <1>     mov edx, bpbFat12
   916 00000A1D 3DF50F0000          <1>     cmp eax, fat12MaxClustCnt
