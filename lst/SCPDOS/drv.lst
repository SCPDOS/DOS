    38                              <1> 
    39                              <1> dbgCrlf:
    40                              <1> ;Prints a CRLF
    41                              <1>     push rax
    42                              <1>     mov al, 0Ah 
    43                              <1>     call dbgPutch
    44                              <1>     mov al, 0Dh
    45                              <1>     call dbgPutch
    46                              <1>     pop rax
    47                              <1>     return
    48                              <1> 
    49                              <1> dbgPutch:
    50                              <1> ;Input: al = ASCII char to print
    51                              <1>     push rdx
    52                              <1>     mov dx, 0E9h
    53                              <1>     out dx, al
    54                              <1>     ;mov ah, 0Eh
    55                              <1>     ;int 30h
    56                              <1>     pop rdx
    57                              <1>     return
    58                              <1> 
    59                              <1> dbgPrintHexByte:
    60                              <1> ;Print the hex byte in al as a hex value
    61                              <1>     pushfq
    62                              <1>     push rdx
    63                              <1>     push rbx
    64                              <1>     push rax
    65                              <1> 
    66                              <1>     mov dl, al           ;save byte in dl
    67                              <1>     and ax, 00F0h        ;Hi nybble
    68                              <1>     and dx, 000Fh        ;Lo nybble
    69                              <1>     shr ax, 4            ;shift one hex place value pos right
    70                              <1>     call .wrchar
    71                              <1>     mov ax, dx           ;mov lo nybble, to print
    72                              <1>     call .wrchar
    73                              <1> 
    74                              <1>     pop rax
    75                              <1>     pop rbx
    76                              <1>     pop rdx
    77                              <1>     popfq
    78                              <1>     return
    79                              <1> .wrchar:
    80                              <1>     lea rbx, .debascii
    81                              <1>     xlatb    ;point al to entry in ascii table, using al as offset into table
    82                              <1>     call dbgPutch
    83                              <1>     return
    84                              <1> .debascii   db "0123456789ABCDEF"
    85                              <1> %endif
