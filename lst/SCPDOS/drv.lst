   849 00000987 4889DE              <1>     mov rsi, rbx    ;Source from the BPB in disk buffer
   850 0000098A 488D7D0A            <1>     lea rdi, qword [rbp + drvBlk.bpb]
   851 0000098E F3A4                <1>     rep movsb        ;Now copy the BPB over!
