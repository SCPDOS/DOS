    57 000034D6 66C743030001        <1>     mov word [rbx + initReqPkt.status], drvDonStatus ;Set done bit
    58 000034DC 50                  <1>     push rax
    59 000034DD 488D0570FFFFFF      <1>     lea rax, ejectPoint
    60 000034E4 4889430E            <1>     mov qword [rbx + initReqPkt.endptr], rax
