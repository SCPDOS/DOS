   125                              <1> msdInit:
   126                              <1> ;Drive letter assignment works as follows:
   127                              <1> ; A and B always reserved for removable devices even if none.
   128                              <1> ; C,... for as many fixed disk partitions present in system.
   129                              <1> ; Any additional removable devices then come after the fixed disks.
   130                              <1> 
   131                              <1> 
   132                              <1> ;TEST TEST TEST TEST TEST TEST TEST TEST TEST TEST TEST TEST 
   133                              <1> ;    mov byte [7c02h], 0
   134                              <1> ;TEST TEST TEST TEST TEST TEST TEST TEST TEST TEST TEST TEST 
   135                              <1> ;Start by setting up the interrupt vectors!
   136 00003564 B839350000          <1>     mov eax, 3539h  ;Get original Int 39h
   137 00003569 CD21                <1>     int 21h
   138 0000356B 48891D62CFFFFF      <1>     mov qword [i39Org], rbx
   139 00003572 B839250000          <1>     mov eax, 2539h  ;Setup our handler
   140 00003577 488D1576CFFFFF      <1>     lea rdx, dosInt39h
   141 0000357E CD21                <1>     int 21h
   142                              <1> 
   143 00003580 B833350000          <1>     mov eax, 3533h  ;Get original Int 33h
   144 00003585 CD21                <1>     int 21h
   145 00003587 48891D4ECFFFFF      <1>     mov qword [i33Org], rbx
   146 0000358E 48891D57CFFFFF      <1>     mov qword [i33Next], rbx    ;This is also the low level handler
   147 00003595 B833250000          <1>     mov eax, 2533h  ;Setup our handler
   148 0000359A 488D1575CFFFFF      <1>     lea rdx, dosInt33h
   149 000035A1 CD21                <1>     int 21h
   150                              <1> 
   151 000035A3 B82F350000          <1>     mov eax, 352Fh  ;Get previous Int 2Fh handler
   152 000035A8 CD21                <1>     int 21h
   153 000035AA 48891D33CFFFFF      <1>     mov qword [i2FNext], rbx
   154 000035B1 B82F250000          <1>     mov eax, 252Fh
   155 000035B6 488D15D4CFFFFF      <1>     lea rdx, i2fhSwap33h
   156 000035BD CD21                <1>     int 21h
   157                              <1> 
   158                              <1> 
   159                              <1> ;Then set up the link pointers to the load address of the 
   160                              <1> ; drive table.
   161 000035BF B919000000          <1>     mov ecx, drvBlkTblL - 1
   162 000035C4 488D2D33F0FFFF      <1>     lea rbp, msdDriver.drvBlkTbl      ;Point to the first drive block
   163 000035CB 4889EE              <1>     mov rsi, rbp
   164                              <1> .dskTblLp:
   165 000035CE 4889F7              <1>     mov rdi, rsi            ;Mov current block to current block
   166 000035D1 4881C68D000000      <1>     add rsi, drvBlk_size    ;Point current block to next block
   167 000035D8 488937              <1>     mov qword [rdi + drvBlk.pLink], rsi    ;Store next blk ptr in cur block
   168 000035DB FFC9                <1>     dec ecx                 ;Decrement the count
   169 000035DD 75EF                <1>     jnz .dskTblLp
   170 000035DF 48C706FFFFFFFF      <1>     mov qword [rsi + drvBlk.pLink], -1     ;Store end of table here
   171                              <1> ;Now get number of Int 33h information packed in r8
