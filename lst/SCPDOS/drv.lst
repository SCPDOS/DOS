  1478                              <1> ;---------------------------------------------------------------------------
  1479                              <1> ;               Get Device parameters in CHS and LBA here
  1480                              <1> ;---------------------------------------------------------------------------
  1481                              <1> .ioGetDevParams:
  1482 00000D89 7561                <1>     jnz .lbaGetParams
  1483                              <1> ;Here we get CHS params. 
  1484 00000D8B 488D750A            <1>     lea rsi, qword [rbp + drvBlk.bpb]
  1485 00000D8F F60201              <1>     test byte [rdx + chsParamsBlock.bSpecFuncs], specFuncBPB
  1486 00000D92 751F                <1>     jnz .iogdpBkup  ;If set, return the bpb data as is.
  1487 00000D94 66F745370100        <1>     test word [rbp + drvBlk.wDevFlgs], devFixed
  1488 00000D9A 7517                <1>     jnz .iogdpBkup  ;If it is fixed, return the BPB as is too
  1489 00000D9C E8DEFAFFFF          <1>     call .updateBpb ;Else, gets the BPB from the disk.
  1490 00000DA1 0F8228FDFFFF        <1>     jc .ioDoErr ;Errors returned as if from block IO handler
  1491 00000DA7 E8E9FBFFFF          <1>     call .moveVolIds    ;Move the volume ID's into the drvBlk if they exist.
  1492 00000DAC 488D3592070000      <1>     lea rsi, qword [.inBuffer + 11]
  1493                              <1> .iogdpBkup:
  1494                              <1> ;The caller block in memory must have a bpb32_size'ed space for the BPB
  1495                              <1> ; even if it is a FAT16/12 drive. The caller has to assertain the 
  1496                              <1> ; type of BPB it is based information in the common part of the BPB.
  1497 00000DB3 488D7A07            <1>     lea rdi, qword [rdx + chsParamsBlock.deviceBPB]
  1498 00000DB7 B935000000          <1>     mov ecx, bpb32_size
  1499 00000DBC F3A4                <1>     rep movsb
  1500 00000DBE B805000000          <1>     mov eax, typeHard
  1501 00000DC3 B907000000          <1>     mov ecx, typeGenRem
  1502 00000DC8 F6453701            <1>     test byte [rbp + drvBlk.wDevFlgs], devFixed
  1503 00000DCC 0F44C1              <1>     cmovz eax, ecx  ;eax is set to 7 if the dev is removable
  1504 00000DCF 884201              <1>     mov byte [rdx + chsParamsBlock.bDevType], al
  1505 00000DD2 0FB74537            <1>     movzx eax, word [rbp + drvBlk.wDevFlgs]
  1506 00000DD6 2503000000          <1>     and eax, devFixed | devChgLine
  1507 00000DDB 66894202            <1>     mov word [rdx + chsParamsBlock.wDevFlgs], ax
  1508 00000DDF C6420600            <1>     mov byte [rdx + chsParamsBlock.bMedTyp], 0
  1509 00000DE3 0FB74539            <1>     movzx eax, word [rbp + drvBlk.wNumCyl]
  1510 00000DE7 66894204            <1>     mov word [rdx + chsParamsBlock.wNumCyl], ax
  1511                              <1>     return
    13                              <2> %%_ret:
    14 00000DEB C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1512                              <1> 
  1513                              <1> .lbaGetParams:
  1514                              <1> ;Gets more "updated" information on partitions.
  1515                              <1> ;The data returned will always be the partition maximum! For remdevs
  1516                              <1> ; this means up to the whole media size and for fixed disks we are still 
  1517                              <1> ; restricted to the partition size.
  1518 00000DEC B805000000          <1>     mov eax, drvBadDrvReq
  1519 00000DF1 803A20              <1>     cmp byte [rdx + lbaParamsBlock.bSize], lbaParamsBlock_size
  1520 00000DF4 0F851CF9FFFF        <1>     jne .errorExit
  1521 00000DFA 4889D7              <1>     mov rdi, rdx    ;Store the params block ptr in rdi
  1522 00000DFD 807F0102            <1>     cmp byte [rdi + lbaParamsBlock.bSpecFuncs], 2   ;Check get phys call.
  1523 00000E01 0F870FF9FFFF        <1>     ja .errorExit   ;If above 2, error with bad request!
  1524 00000E07 7425                <1>     je .lgpbpbGetPhys
  1525 00000E09 F6470101            <1>     test byte [rdi + lbaParamsBlock.bSpecFuncs], 1  ;Check if we update BPB.
  1526 00000E0D 7539                <1>     jnz .lgpbpbok
  1527 00000E0F 66F745370100        <1>     test word [rbp + drvBlk.wDevFlgs], devFixed
  1528 00000E15 7531                <1>     jnz .lgpbpbok  ;If it is fixed, return the BPB as is too
  1529 00000E17 57                  <1>     push rdi    ;Push the param block onto the stack
  1530 00000E18 E862FAFFFF          <1>     call .updateBpb
  1531 00000E1D 7208                <1>     jc .lgpbpbnotok ;Even if just bad BPB, keep changed bit on!
  1532 00000E1F E871FBFFFF          <1>     call .moveVolIds    ;Move the volume ID's into the drvBlk if they exist.
  1533 00000E24 5F                  <1>     pop rdi     ;Pop param block
  1534 00000E25 EB21                <1>     jmp short .lgpbpbok
  1535                              <1> .lgpbpbnotok:
  1536                              <1> ;If no valid BPB found, and the device removable, return BIOS params for the 
  1537                              <1> ; whole device. We never come here for fixed disks as updateBpb always passes.
  1538 00000E27 5F                  <1>     pop rdi
  1539 00000E28 0F8454F8FFFF        <1>     jz .errorXlat   ;If update returned CF=CY and ZF=ZE, xlat the BIOS code
  1540                              <1> ;We only fall here if on an unformatted removable disk.
  1541                              <1> ;Unformatted means with an unrecognisable BPB.
  1542                              <1> .lgpbpbGetPhys:
  1543 00000E2E 0FB65508            <1>     movzx edx, byte [rbp + drvBlk.bBIOSNum]
  1544 00000E32 B800880000          <1>     mov eax, 8800h  ;Read LBA Device Parameters
  1545 00000E37 CD33                <1>     int 33h         ;Need a naked call as params returned in regs!
  1546 00000E39 0F8243F8FFFF        <1>     jc .errorXlat
  1547 00000E3F 48FFC1              <1>     inc rcx         ;Turn into an absolute count of sectors
  1548 00000E42 31D2                <1>     xor edx, edx    ;0 Hidden sectors on remdevs/unformatted media
  1549                              <1> ;eax = 0 since either not formatted or values may not be ok for CHS calls
  1550 00000E44 89D0                <1>     mov eax, edx     
  1551 00000E46 EB1F                <1>     jmp short .lgpStor
  1552                              <1> .lgpbpbok:
  1553 00000E48 31C0                <1>     xor eax, eax
  1554 00000E4A 89C3                <1>     mov ebx, eax
  1555 00000E4C FFC3                <1>     inc ebx
  1556                              <1> ;Here eax=0 and ebx=1.
  1557 00000E4E F6450FFF            <1>     test byte [rbp + drvBlk.bNumFAT], -1    ;If 0 FATs, the FAT is invalid!
  1558 00000E52 0F45C3              <1>     cmovnz eax, ebx                         ;Set if we have a FAT
  1559 00000E55 8B551B              <1>     mov edx, dword [rbp + drvBlk.dHiddSec]
  1560 00000E58 0FB75D0A            <1>     movzx ebx, word [rbp + drvBlk.wBpS]
  1561 00000E5C 0FB74D12            <1>     movzx ecx, word [rbp + drvBlk.wTotSec16]
  1562 00000E60 85C9                <1>     test ecx, ecx
  1563 00000E62 7503                <1>     jnz .lgpStor
  1564 00000E64 8B4D1F              <1>     mov ecx, dword [rbp + drvBlk.dTotSec32]
  1565                              <1> .lgpStor:
  1566                              <1> ;Enter with:
  1567                              <1> ;ax = 0 if unformatted, 1 if any FAT type (means can call CHS function)
  1568                              <1> ;rbx = Sector size in bytes
  1569                              <1> ;rcx = Last LBA block address + 1 (Count of sectors)
  1570                              <1> ;rdx = Hidden sectors
  1571 00000E67 66894704            <1>     mov word [rdi + lbaParamsBlock.wFSType], ax
  1572 00000E6B 48895F08            <1>     mov qword [rdi + lbaParamsBlock.qSectorSize], rbx
  1573 00000E6F 48894F10            <1>     mov qword [rdi + lbaParamsBlock.qNumSectors], rcx
  1574 00000E73 48895718            <1>     mov qword [rdi + lbaParamsBlock.qStartSector], rdx
  1575 00000E77 0FB74537            <1>     movzx eax, word [rbp + drvBlk.wDevFlgs]
  1576 00000E7B 2503000000          <1>     and eax, devFixed | devChgLine
  1577 00000E80 66894702            <1>     mov word [rdi + lbaParamsBlock.wDevFlgs], ax
  1578                              <1>     return 
    13                              <2> %%_ret:
    14 00000E84 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1579                              <1> ;---------------------------------------------------------------------------
  1580                              <1> ;                    CHS IO requests are structured here
  1581                              <1> ;---------------------------------------------------------------------------
  1582                              <1> .ioWrite:
  1583 00000E85 0F85BB000000        <1>     jnz .lbaWrite
  1584                              <1> ;Here for CHS write tracks. 
  1585 00000E8B BB00830000          <1>     mov ebx, 8300h  ;Write sectors
  1586                              <1> .iochsRW:
  1587 00000E90 E86F000000          <1>     call .ioChsToLba
  1588 00000E95 E853000000          <1>     call .ioChsSanity
  1589 00000E9A 0FB74705            <1>     movzx eax, word [rdi + chsIOBlock.wStartSector]
  1590 00000E9E 01C1                <1>     add ecx, eax    ;Add the zero based sector number to start of "track"
  1591 00000EA0 0FB77707            <1>     movzx esi, word [rdi + chsIOBlock.wNumSectors]  ;How many sectors to IO on
  1592                              <1> .iochsCmn:
  1593 00000EA4 89D8                <1>     mov eax, ebx    ;Move the function number to eax
  1594 00000EA6 488B5F09            <1>     mov rbx, qword [rdi + chsIOBlock.pXferBuffer]   ;And get buffer ptr in rbx
  1595 00000EAA E9B7000000          <1>     jmp .ioEp
  1596                              <1> .ioRead:
  1597 00000EAF 0F858A000000        <1>     jnz .lbaRead
  1598                              <1> ;Here for CHS read tracks.
  1599 00000EB5 BB00820000          <1>     mov ebx, 8200h  ;Read sectors
  1600 00000EBA EBD4                <1>     jmp short .iochsRW
  1601                              <1> .ioFormat:
  1602                              <1> ;DASD TEMP DASD TEMP DASD TEMP DASD TEMP DASD TEMP DASD TEMP DASD TEMP 
  1603                              <1> ;
  1604                              <1> ;We start by setting DASD parameters but for now we do nothing so just
  1605                              <1> ; clear the flag.
  1606 00000EBC 9C                  <1>     pushfq
  1607 00000EBD 668165377FFF        <1>     and word [rbp + drvBlk.wDevFlgs], ~devSetDASD
  1608 00000EC3 9D                  <1>     popfq
  1609                              <1> ;DASD TEMP DASD TEMP DASD TEMP DASD TEMP DASD TEMP DASD TEMP DASD TEMP 
  1610 00000EC4 756F                <1>     jnz .lbaFmt
  1611                              <1> ;Here for CHS format track.
  1612 00000EC6 BB00850000          <1>     mov ebx, 8500h  ;Format sectors
  1613 00000ECB F60201              <1>     test byte [rdx + chsFormatBlock.bSpecFuncs], 1  ;If this bit clear do format
  1614 00000ECE 7404                <1>     jz .iochsFmtCmn
  1615                              <1> ;Else we should respond if the sector table is valid. Since our BIOS is crap
  1616                              <1> ; we always return OK and let the format call fail. This would possibly be
  1617                              <1> ; dangerous but its not since the BIOS CHS emulation is very meh.
  1618 00000ED0 C60200              <1>     mov byte [rdx + chsFormatBlock.bSpecFuncs], 0   ;All ok!
  1619                              <1>     return
    13                              <2> %%_ret:
    14 00000ED3 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1620                              <1> .iochsFmtCmn:
  1621 00000ED4 E82B000000          <1>     call .ioChsToLba    ;Get the LBA of the first sector of the track in ecx
  1622 00000ED9 0FB77517            <1>     movzx esi, word [rbp + drvBlk.wSecPerTrk]   ;Fmt/Verify this many sectors
  1623 00000EDD 89D8                <1>     mov eax, ebx    ;Move the function number to eax
  1624 00000EDF E982000000          <1>     jmp .ioEp
  1625                              <1> .ioVerify:
  1626 00000EE4 7548                <1>     jnz .lbaVerify
