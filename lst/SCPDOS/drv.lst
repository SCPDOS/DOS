   889 000009D7 C1E205              <1>     shl edx, 5  ;Multiply by 32 (dir entry size)
   890 000009DA 01D0                <1>     add eax, edx
   891 000009DC 31D2                <1>     xor edx, edx
   892 000009DE F7F1                <1>     div ecx     ;eax = Root Dir sectors
   893 000009E0 50                  <1>     push rax    ;Save Root Dir sectors on the stack
   894 000009E1 0FB7430B            <1>     movzx eax, word [rbx + bpb.FATsz16]
   895 000009E5 8B5319              <1>     mov edx, dword [rbx + bpb32.FATsz32]
   896 000009E8 85C0                <1>     test eax, eax
   897 000009EA 0F44C2              <1>     cmovz eax, edx
   898 000009ED 0FB64B05            <1>     movzx ecx, byte [rbx + bpb.numFATs]
   899 000009F1 F7E1                <1>     mul ecx         ;eax = BPB_NumFATs * FATSz
   900 000009F3 85C0                <1>     test eax, eax   ;If either BPB_NumFATs or FATSz is 0, fail!
   901 000009F5 59                  <1>     pop rcx         ;Get RootDirSectors into ecx
