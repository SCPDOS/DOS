  2554                              <1>         at .dHiddSec,   dd 0    
  2555                              <1>         at .dTotSec32,  dd 0     
  2556                              <1> ;FAT 32 fields. All zeros
  2557                              <1>         at .FATsz32,    dd 0
  2558                              <1>         at .extFlags,   dw 0
  2559                              <1>         at .FSver,      dw 0
  2560                              <1>         at .RootClus,   dd 0
  2561                              <1>         at .FSinfo,     dw 0
  2562                              <1>         at .BkBootSec,  dw 0
  2563                              <1> ;DrvBlk Flags
  2564                              <1>         at .bBpbType,   db bpbFat12
  2565                              <1>         at .wOpenCnt,   dw 0
  2566                              <1>         at .bDevType,   db typeGenRem   ;Init to generic removable device
  2567                              <1>         at .wDevFlgs,   dw 0
  2568                              <1>         at .wNumCyl,    dw 63   
  2569                              <1>         istruc bpb32
