  1668                              <1> ;                    LBA IO requests are structured here
  1669                              <1> ;---------------------------------------------------------------------------
  1670                              <1> .lbaVerify:
  1671 00000F2E B800840000          <1>     mov eax, 8400h  ;Verify sectors
  1672 00000F33 EB05                <1>     jmp short .lbaFmtCmn
  1673                              <1> .lbaFmt:
  1674 00000F35 B800850000          <1>     mov eax, 8500h  ;Format sectors
  1675                              <1> .lbaFmtCmn:
  1676 00000F3A 803A10              <1>     cmp byte [rdx + lbaIOBlock.size], lbaFormatBlock_size
  1677 00000F3D EB13                <1>     jmp short .lbaCmn
  1678                              <1> .lbaRead:
  1679 00000F3F B800820000          <1>     mov eax, 8200h  ;Read sectors
  1680 00000F44 EB05                <1>     jmp short .lbaRWCmn
  1681                              <1> .lbaWrite:
  1682 00000F46 B800830000          <1>     mov eax, 8300h  ;Write sectors
  1683                              <1> .lbaRWCmn:
  1684 00000F4B 488B5A10            <1>     mov rbx, qword [rdx + lbaIOBlock.xferBuffer]
  1685 00000F4F 803A18              <1>     cmp byte [rdx + lbaIOBlock.size], lbaIOBlock_size
  1686                              <1> .lbaCmn:
  1687 00000F52 0F8518FDFFFF        <1>     jne .iobadCmdLen
  1688                              <1> ;Setup the vars for block IO
  1689 00000F58 4889D7              <1>     mov rdi, rdx
  1690                              <1> ;Formally numSectors is a byte and will only be treated as a byte but
  1691                              <1> ; we reserve the following three bytes for future updates to allow
  1692                              <1> ; up to a dword of contiguous sectors to be written in one go.
  1693 00000F5B 31F6                <1>     xor esi, esi
  1694 00000F5D 877701              <1>     xchg esi, dword [rdi + lbaFormatBlock.numSectors]
  1695 00000F60 8B4F08              <1>     mov ecx, dword [rdi + lbaFormatBlock.startSector]
  1696 00000F63 034D1B              <1>     add ecx, dword [rbp + drvBlk.dHiddSec]  ;Point to sector in partition
  1697                              <1> .ioEp:
  1698 00000F66 89C2                <1>     mov edx, eax    ;Move the function number into dh (and zero dl)
  1699 00000F68 8A5508              <1>     mov dl, byte [rbp + drvBlk.bBIOSNum]    ;Get BIOS number for device
  1700                              <1> .ioLp:
  1701 00000F6B E89FFBFFFF          <1>     call .blkIODirect
  1702 00000F70 0F8259FBFFFF        <1>     jc .ioDoErr
  1703 00000F76 E85FFBFFFF          <1>     call .ioAdvIOCTL
  1704 00000F7B 75EE                <1>     jnz .ioLp
  1705                              <1>     return
