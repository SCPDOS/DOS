  1540 00000E9B 01C1                <1>     add ecx, eax    ;Add the zero based sector number to start of "track"
  1541 00000E9D 0FB77707            <1>     movzx esi, word [rdi + chsIOBlock.wNumSectors]  ;How many sectors to IO on
