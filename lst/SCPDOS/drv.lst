   168 000035D8 FFC9                <1>     dec ecx                 ;Decrement the count
   169 000035DA 75EF                <1>     jnz .dskTblLp
   170 000035DC 48C706FFFFFFFF      <1>     mov qword [rsi + drvBlk.pLink], -1     ;Store end of table here
   171                              <1> ;Now get number of Int 33h information packed in r8
   172 000035E3 CD31                <1>     int 31h
   173                              <1>     ;Returns:
   174                              <1>     ;r8[Byte 0] = Number of COM ports
   175                              <1>     ;r8[Byte 1] = Number of fixed disks
   176                              <1>     ;r8[Byte 2] = Number of units on EHCI bus
   177                              <1>     ;r8[Byte 3] = Number of Int 33h units
   178 000035E5 4C890547DFFFFF      <1>     mov qword [msdDriver.inBuffer], r8   
