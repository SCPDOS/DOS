   770                              <1> ;Input: al = Media byte. 
   771                              <1> ;Ouput: ZF=NZ: Bad media byte. ZF=ZE: Ok media byte!
   772 000008E4 3CF0                <1>     cmp al, 0F0h
   773                              <1>     rete
