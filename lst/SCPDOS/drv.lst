  1631                              <1> .ioChsSanity:
  1632                              <1> ;Checks that the read/write will be on one track and makes sense.
  1633                              <1> ;Input: ebx = BIOS function to call. Preserved.
  1634                              <1> ;       ecx = LBA of start sector.
  1635                              <1> ;       rdi -> chsIOBlock
  1636                              <1> ;       rbp -> Drive block ptr
  1637 00000EED 0FB74705            <1>     movzx eax, word [rdi + chsIOBlock.wStartSector] ;Zero based
  1638 00000EF1 FFC0                <1>     inc eax         ;Make it 1 based for the comparison
  1639 00000EF3 66034707            <1>     add ax, word [rdi + chsIOBlock.wNumSectors]
  1640 00000EF7 663B4517            <1>     cmp ax, word [rbp + drvBlk.wSecPerTrk]  ;Does this surpass num sect/trck?
  1641                              <1>     retna
