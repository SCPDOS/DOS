     1                              <1> ejectPoint: ;Address of the ejection code
     2                              <1> 
     3                              <1> installInterrupt:
     4                              <1> ;Writes the interrupt in the right place in the table
     5                              <1>     ;al = Interrupt number
     6                              <1>     ;rdx -> Handler to install
     7 00003466 0F010D23000000      <1>     sidt [myIdt]
     8 0000346D 0FB6C0              <1>     movzx eax, al
     9 00003470 4892                <1>     xchg rdx, rax
    10 00003472 48C1E204            <1>     shl rdx, 4h     ;Multiply IDT entry number by 16
    11 00003476 48031515000000      <1>     add rdx, qword [myIdt.base]    
    12 0000347D 668902              <1>     mov word [rdx], ax  ;Get low word into offset 15...0
    13 00003480 48C1E810            <1>     shr rax, 10h    ;Bring next word low
    14 00003484 66894206            <1>     mov word [rdx + 6], ax  ;Get low word into offset 31...16
    15 00003488 48C1E810            <1>     shr rax, 10h    ;Bring last dword low
    16 0000348C 894208              <1>     mov dword [rdx + 8], eax
    17 0000348F C3                  <1>     ret
