   250                              <1> ;Int 33h replacement routine
   251                              <1> i2fhSwap33h:
   252                              <1> ;Replaces the current int 33h handler and the int 39h replacement handler
   253                              <1> ;Input: ah = 13h
   254                              <1> ;       rdx -> New Int 33h handler.
   255                              <1> ;       rbx -> Value to replace back when system shutdown occurs.
   256                              <1> ;Output:
   257                              <1> ;       rdx -> Replaced Int 33h handler.
   258                              <1> ;       rbx -> Replaced original lowest level Int 33h handler.
   259 00000591 80FC13              <1>     cmp ah, 13h
   260 00000594 0F859D0E0000        <1>     jne msdDriver.i2fDriver ;Goto the driver backdoor if not this handler 
   261 0000059A 4887154BFFFFFF      <1>     xchg qword [i33Next], rdx
   262 000005A1 48871D34FFFFFF      <1>     xchg qword [i33Org], rbx
   263 000005A8 48CF                <1>     iretq
   264                              <1> 
   265                              <1> ; Actual driver here
   266                              <1> msdDriver:
   267 000005AA 50                  <1>     push rax
   268 000005AB 53                  <1>     push rbx
   269 000005AC 51                  <1>     push rcx
   270 000005AD 52                  <1>     push rdx
   271 000005AE 56                  <1>     push rsi
   272 000005AF 57                  <1>     push rdi
   273 000005B0 55                  <1>     push rbp
   274 000005B1 4150                <1>     push r8
   275 000005B3 488B1D(98010000)    <1>     mov rbx, qword [reqPktPtr]  ;Get the ptr to the req header in rbx
   276 000005BA 0FB67302            <1>     movzx esi, byte [rbx + drvReqPkt.cmdcde]    ;Get the command code
   277 000005BE 81FE18000000        <1>     cmp esi, drvMAXCMD                  ;Command code bigger than max?
   278 000005C4 7741                <1>     ja .errBadCmd                 ;If yes, error!
   279 000005C6 488D2D4D000000      <1>     lea rbp, .fnTbl
   280 000005CD 488D7CB500          <1>     lea rdi, qword [rbp + 4*rsi]    ;Ptr to table entry
   281 000005D2 0FB737              <1>     movzx esi, word [rdi]   ;Get the offset from table into esi
   282 000005D5 85F6                <1>     test esi, esi           ;If the offset is 0, exit!
   283 000005D7 7417                <1>     jz .exit
   284 000005D9 0FB60B              <1>     movzx ecx, byte [rbx + drvReqPkt.hdrlen]       ;Get packet length
   285 000005DC 663B4F02            <1>     cmp cx, word [rdi + 2]          ;Cmp packet lengths
   286 000005E0 752C                <1>     jne .errBadPkt
   287 000005E2 4801EE              <1>     add rsi, rbp    ;Add the two to get the pointer!
   288 000005E5 0FB64301            <1>     movzx eax, byte [rbx + drvReqPkt.unitnm]    ;Get the unit to setup
   289 000005E9 E8F20B0000          <1>     call .setupDrive    ;Returns rbp -> Table entry
   290                              <1> ;Goto function! rbp -> Table entry, eax = Drive number. rbx -> Reqpkt
   291 000005EE FFD6                <1>     call rsi 
   292                              <1> .exit:
   293 000005F0 488B1D(98010000)    <1>     mov rbx, qword [reqPktPtr]  ;Get back the req header ptr
   294 000005F7 66814B030001        <1>     or word [rbx + drvReqPkt.status], drvDonStatus ;Set done bit
   295 000005FD 4158                <1>     pop r8
   296 000005FF 5D                  <1>     pop rbp
   297 00000600 5F                  <1>     pop rdi
   298 00000601 5E                  <1>     pop rsi
   299 00000602 5A                  <1>     pop rdx
   300 00000603 59                  <1>     pop rcx
   301 00000604 5B                  <1>     pop rbx
   302 00000605 58                  <1>     pop rax
   303 00000606 C3                  <1>     ret
