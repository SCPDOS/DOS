   527                              <1> .ptnUpdateBpb:
   528                              <1> ;Setups up the call for below on the current partition.
   529                              <1> ;Input: ecx = Number of hidden sectors (preserved)
   530                              <1> ;Output:
   531                              <1> ;   CF=NC: All ok, BPB entry in rbp filled.
   532                              <1> ;   CF=CY and ZF=ZE: Bad BPB read.
   533                              <1> ;   CF=CY and ZF=NZ: Sector read failed.
   534 000039D2 66C745370000        <1>     mov word [rbp + drvBlk.wDevFlgs], 0    ;Clean the flags to start with
   535 000039D8 894D1B              <1>     mov dword [rbp + drvBlk.dHiddSec], ecx
   536 000039DB 0FB605(04000000)    <1>     movzx eax, byte [dosDrv]
   537 000039E2 884509              <1>     mov byte [rbp + drvBlk.bDOSNum], al ;Save the DOS number
   538 000039E5 0FB605(03000000)    <1>     movzx eax, byte [biosDrv]   ;Get the BIOS drive
   539 000039EC 884508              <1>     mov byte [rbp + drvBlk.bBIOSNum], al
   540 000039EF 51                  <1>     push rcx
   541 000039F0 56                  <1>     push rsi    ;Save the mbr entry ptr
   542 000039F1 E886CEFFFF          <1>     call msdDriver.updateBpb
   543 000039F6 7209                <1>     jc .pubBad
   544 000039F8 E895CFFFFF          <1>     call msdDriver.moveVolIds
   545 000039FD 5E                  <1>     pop rsi
   546 000039FE 59                  <1>     pop rcx
   547 000039FF F8                  <1>     clc         ;Always clean even if no ids
   548                              <1>     return
