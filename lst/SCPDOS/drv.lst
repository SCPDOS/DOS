   410 00000002 ????????            <1>     .allocSize  dd ?  ;Number of paras in init alloc or when exiting as TSR.
   411 00000006 ????????            <1>                 dd ?  ;Reserved 4 bytes
   412 0000000A ????????????????    <1>     .oldInt22h  dq ?  ;Int 22h pointer on overlay load
   413 00000012 ????????????????    <1>     .oldInt23h  dq ?  ;Int 23h pointer on overlay load
   414 0000001A ????????????????    <1>     .oldInt24h  dq ?  ;Int 24h pointer on overlay load
   415 00000022 ????????????????    <1>     .parentPtr  dq ?  ;Pointer to parent process PSP
   416                              <1> ;If jftSize > 20, then the QWORD at .jobFileTbl becomes a pointer
   417                              <1> ; to the actual in use JFT and the other 12 bytes are left undefined.
   418                              <1> ;If jftSize < 20 (DOS will never set it so), then it is considered as 20
   419                              <1> ;If the user tries to reduce handle count to 20 or less, then the PSP JFT is 
   420                              <1> ; always used and jftSize.
