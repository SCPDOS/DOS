  2306                              <1> ; and make sure that the new drive has the accurate changeline bit set
  2307 00001466 66814E371000        <1>     or word [rsi + drvBlk.wDevFlgs], devMulti       ;Both drives now multi!
  2308 0000146C 66814F371000        <1>     or word [rdi + drvBlk.wDevFlgs], devMulti
  2309 00001472 66816737DFFF        <1>     and word [rdi + drvBlk.wDevFlgs], ~devOwnDrv    ;New cant own drv
  2310                              <1> ;Changeline check.
  2311 00001478 66816737FDFF        <1>     and word [rdi + drvBlk.wDevFlgs], ~devChgLine   ;Assume no changeline
  2312 0000147E 66F746370200        <1>     test word [rsi + drvBlk.wDevFlgs], devChgLine   ;Do we really have cline?
  2313 00001484 7406                <1>     jz .i2fATNext   ;Skip adding the bit if not
  2314 00001486 66814F370200        <1>     or word [rdi + drvBlk.wDevFlgs], devChgLine     ;Add if we do 
  2315                              <1> .i2fATNext:
  2316 0000148C 48813EFFFFFFFF      <1>     cmp qword [rsi + drvBlk.pLink], -1  ;Check if we @ end of table
  2317 00001493 480F4536            <1>     cmovne rsi, qword [rsi + drvBlk.pLink] ;Walk if not
  2318 00001497 75C8                <1>     jne .i2fATLp    ;And go again if not
  2319 00001499 48893E              <1>     mov qword [rsi + drvBlk.pLink], rdi ;Else, link rdi onto the end
  2320 0000149C 48C707FFFFFFFF      <1>     mov qword [rdi + drvBlk.pLink], -1  ;And terminate list @ rdi now :)
  2321 000014A3 48CF                <1>     iretq
  2322                              <1> .i2fExec:
  2323                              <1> ;We make a small change in that we clean up the flags from the stack
  2324                              <1> ; as opposed to DOS which leaves them on the stack. Doing so is fine 
  2325                              <1> ; as no useful information is ever passed in the flags from a driver
  2326                              <1> ; so by doing so, any ported applications which do an additional pop
  2327                              <1> ; from the stack to balance the stack will not be harmed by this.
