  2206                              <1> .setTime:
  2207                              <1> ;Sets the current time to the disk drive and resets the access counter
  2208                              <1> ;Preserves all registers and edits .bAccCnt and .dAccTime for rbp -> drvBlk
  2209 000012D6 50                  <1>     push rax
  2210 000012D7 51                  <1>     push rcx
  2211 000012D8 52                  <1>     push rdx
  2212 000012D9 E8D8FFFFFF          <1>     call .getTime   ;Return in ecx the time. eax and edx trashed.
  2213 000012DE 894D70              <1>     mov dword [rbp + drvBlk.dAccTime], ecx  ;And store it
  2214 000012E1 C6056001000000      <1>     mov byte [.bAccCnt], 0  ;And set the access count back to 0
  2215 000012E8 5A                  <1>     pop rdx
  2216 000012E9 59                  <1>     pop rcx
  2217 000012EA 58                  <1>     pop rax
  2218                              <1>     return
