   366 00000010 ????????????????    <1>     .rcx    dq ?
   367 00000018 ????????????????    <1>     .rdx    dq ?
   368 00000020 ????????????????    <1>     .rsi    dq ?
   369 00000028 ????????????????    <1>     .rdi    dq ?
   370 00000030 ????????????????    <1>     .r8     dq ?
   371 00000038 ????????????????    <1>     .r9     dq ?
   372 00000040 ????????????????    <1>     .align  dq ?
