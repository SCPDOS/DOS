  2202                              <1> .setTime:
  2203                              <1> ;Sets the current time to the disk drive and resets the access counter
  2204                              <1> ;Preserves all registers and edits .bAccCnt and .dAccTime for rbp -> drvBlk
  2205 000013BF 50                  <1>     push rax
  2206 000013C0 51                  <1>     push rcx
  2207 000013C1 52                  <1>     push rdx
  2208 000013C2 E8D8FFFFFF          <1>     call .getTime   ;Return in ecx the time. eax and edx trashed.
  2209 000013C7 894D70              <1>     mov dword [rbp + drvBlk.dAccTime], ecx  ;And store it
  2210 000013CA C6056001000000      <1>     mov byte [.bAccCnt], 0  ;And set the access count back to 0
  2211 000013D1 5A                  <1>     pop rdx
  2212 000013D2 59                  <1>     pop rcx
  2213 000013D3 58                  <1>     pop rax
  2214                              <1>     return
    13                              <2> %%_ret:
    14 000013D4 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  2215                              <1> 
  2216                              <1> .checkTime:
  2217                              <1> ;Does the time/access count check :)
  2218                              <1> ;Returns: CF=CY if unknown, CF=NC if no change
  2219 000013D5 E8C5FFFFFF          <1>     call .getTime   ;Returns in ecx the current time
  2220 000013DA 85C9                <1>     test ecx, ecx   ;If this is 0 for some reason, use the accesses count  
  2221 000013DC 7517                <1>     jnz .ctOk
  2222 000013DE FE054D010000        <1>     inc byte [.bAccCnt]
  2223 000013E4 803D4601000005      <1>     cmp byte [.bAccCnt], maxAcc ;If below, we say ok!
  2224 000013EB 7217                <1>     jb .ctNoChange
  2225 000013ED FE0D3E010000        <1>     dec byte [.bAccCnt] ;Else drop the inc and say unsure
  2226 000013F3 EB0D                <1>     jmp short .ctMaybeCh
  2227                              <1> .ctOk:
  2228 000013F5 8B5570              <1>     mov edx, dword [rbp + drvBlk.dAccTime]  ;Get last disk access time
  2229                              <1> ;ecx = time of current check, adjusted for day rollovers 
  2230 000013F8 29D1                <1>     sub ecx, edx    
  2231 000013FA 81F924000000        <1>     cmp ecx, 36 ;Is this leq 36? 36 ticks at 55ms is approx 2 seconds.
  2232 00001400 7602                <1>     jbe .ctNoChange
  2233                              <1> .ctMaybeCh:
  2234 00001402 F9                  <1>     stc
  2235                              <1>     return
    13                              <2> %%_ret:
    14 00001403 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
