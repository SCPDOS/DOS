   556                              <1> .getNumCyl:
   557                              <1> ;Computes the number of cylinders on the media. Not really to be used.
   558                              <1> ;Input: rbp -> drvBlk
   559 00003A20 50                  <1>     push rax
   560 00003A21 51                  <1>     push rcx
   561 00003A22 52                  <1>     push rdx
   562 00003A23 0FB74519            <1>     movzx eax, word [rbp + drvBlk.wNumHeads]
   563 00003A27 0FB74D17            <1>     movzx ecx, word [rbp + drvBlk.wSecPerTrk]
   564 00003A2B F7E1                <1>     mul ecx ;Get sectors per cylinder in eax. edx = 0
   565 00003A2D 85C0                <1>     test eax, eax   ;If ax is 0, store zero! Phoney CHS data in BPB.
   566 00003A2F 7414                <1>     jz .gncExit     ;This prevents CHS IOCTL from occuring.
