   653                              <1> .buildBPB:        ;Function 2
   654                              <1> ;Only build BPB for removable devices and "non-locked" devices.
   655                              <1> ;Start by setting the pointer to the BPB in the reqpkt as this is 
   656                              <1> ; the table entry bpb which we will be returning.
   657 000007E4 E8DC0A0000          <1>     call .checkDevFixed
