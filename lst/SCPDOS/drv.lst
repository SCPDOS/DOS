   588                              <1> ;  disk was more than 2 seconds ago, return unknown, else return ok.
   589 000007AB 8A4509              <1>     mov al, byte [rbp + drvBlk.bDOSNum] ;Get this disk number for the check
   590 000007AE 8605850D0000        <1>     xchg byte [.bLastDsk], al ;Swap with the old disk number
   591 000007B4 38057F0D0000        <1>     cmp byte [.bLastDsk], al    ;Are they equal? If not, unsure.
   592 000007BA 750E                <1>     jne .mmcUnsure
   593                              <1> ;Else, now we do the famous time check. 
   594 000007BC E81B0C0000          <1>     call .checkTime ;Sets CF if unsure. Else stays the same
   595 000007C1 7207                <1>     jc .mmcUnsure
