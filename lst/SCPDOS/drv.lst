  2338 000013CC E8D9F1FFFF          <1>     call msdDriver  ;And call the driver like from within DOS!
  2339 000013D1 5B                  <1>     pop rbx
  2340                              <1> 
  2341 000013D2 B802810000          <1>     mov eax, 8102h  ;Exit Driver critical section
  2342 000013D7 CD2A                <1>     int 2Ah
  2343 000013D9 58                  <1>     pop rax
  2344 000013DA 48CF                <1>     iretq
