    11 00003460 48031515000000      <1>     add rdx, qword [myIdt.base]    
    12 00003467 668902              <1>     mov word [rdx], ax  ;Get low word into offset 15...0
    13 0000346A 48C1E810            <1>     shr rax, 10h    ;Bring next word low
    14 0000346E 66894206            <1>     mov word [rdx + 6], ax  ;Get low word into offset 31...16
    15 00003472 48C1E810            <1>     shr rax, 10h    ;Bring last dword low
    16 00003476 894208              <1>     mov dword [rdx + 8], eax
