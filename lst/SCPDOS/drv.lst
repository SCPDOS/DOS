     3                              <1> installInterrupt:
     4                              <1> ;Writes the interrupt in the right place in the table
     5                              <1>     ;al = Interrupt number
     6                              <1>     ;rdx -> Handler to install
     7 00003454 0F010D23000000      <1>     sidt [myIdt]
     8 0000345B 0FB6C0              <1>     movzx eax, al
     9 0000345E 4892                <1>     xchg rdx, rax
    10 00003460 48C1E204            <1>     shl rdx, 4h     ;Multiply IDT entry number by 16
    11 00003464 48031515000000      <1>     add rdx, qword [myIdt.base]    
    12 0000346B 668902              <1>     mov word [rdx], ax  ;Get low word into offset 15...0
    13 0000346E 48C1E810            <1>     shr rax, 10h    ;Bring next word low
    14 00003472 66894206            <1>     mov word [rdx + 6], ax  ;Get low word into offset 31...16
    15 00003476 48C1E810            <1>     shr rax, 10h    ;Bring last dword low
    16 0000347A 894208              <1>     mov dword [rdx + 8], eax
    17 0000347D C3                  <1>     ret
