    14                              <1> ;DEBUG COMMON ROUTINES!
    15                              <1> dbgFnc equ 0    ;Enable debug output functions
    16                              <1> errDbg equ 0    ;Enable error recieving debug output
    17                              <1> drvDbg equ 0    ;Enable driver debug outputs
    18                              <1> i33Dbg equ 0    ;Enable i33h debug outputs
    19                              <1> wpDbg  equ 0    ;Mimic WP errors on writes
    20                              <1> e1Dbg  equ 0    ;Force 01h errors on all i33h calls
    21                              <1> ;~~~~~~~~~~~~~~~~DEBUG~~~~~~~~~~~~~~~~
    22                              <1> %if dbgFnc
    23                              <1> dbgPrintString:
    24                              <1> ;Pass in rsi the string we wanna print and its length in ecx.
    25                              <1> ;Preserves all registers
    26                              <1>     pushfq
    27                              <1>     push rax
    28                              <1> .lp:
    29                              <1>     lodsb
