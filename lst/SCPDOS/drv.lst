   491 00003981 488B6D00            <1>     mov rbp, qword [rbp + drvBlk.pLink]    ;Go to the next disk entry.
   492 00003985 FE05(04000000)      <1>     inc byte [dosDrv]       ;Go to the next DOS device
   493 0000398B FE05(00000000)      <1>     inc byte [physVol]
   494                              <1>     return
