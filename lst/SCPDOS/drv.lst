    64                              <1> clockInit:
    65 000034E6 53                  <1>     push rbx    ;Push the pointer to the request header here
    66                              <1> ;CH - Hours, in BCD
    67                              <1> ;CL - Minutes, in BCD
    68                              <1> ;DH - Seconds, in BCD
    69 000034E7 B402                <1>     mov ah, 02  ;Read RTC Time
    70 000034E9 CD3A                <1>     int 3Ah
    71 000034EB 7271                <1>     jc .clkEnd  ;if error, just exit
    72                              <1>     ;Now set the driver time. Convert From BCD to Decimal
    73 000034ED 0FB6C5              <1>     movzx eax, ch   ;Hours
    74 000034F0 E84D000000          <1>     call .bcd2Bin
    75 000034F5 88C5                <1>     mov ch, al
    76 000034F7 0FB6C1              <1>     movzx eax, cl     ;Mins
    77 000034FA E843000000          <1>     call .bcd2Bin
    78 000034FF 88C1                <1>     mov cl, al
    79 00003501 0FB6C6              <1>     movzx eax, dh   ;Seconds
    80 00003504 E839000000          <1>     call .bcd2Bin
    81 00003509 86E0                <1>     xchg ah, al ;Move seconds to ah, and 0 to al (hseconds)
    82 0000350B 89C2                <1>     mov edx, eax
    83 0000350D B42D                <1>     mov ah, 2Dh ;DOS Set Time
    84 0000350F CD21                <1>     int 21h
    85                              <1> ;Now get the date from RTC
    86                              <1> ;CL - Year, in BCD
    87                              <1> ;DH - Month, in BCD
    88                              <1> ;DL - Day, in BCD
    89 00003511 B404                <1>     mov ah, 04  ;Read RTC Date
    90 00003513 CD3A                <1>     int 3Ah
    91 00003515 7247                <1>     jc .clkEnd
    92                              <1> ;Year from RTC is assumed to be after 2000 (coz, you know... its 2022)
    93 00003517 0FB6C1              <1>     movzx eax, cl   ;Convert Year to Binary
    94 0000351A E823000000          <1>     call .bcd2Bin
    95 0000351F 0FB6C8              <1>     movzx ecx, al   ;Zero extend to ecx (because ch needs to be 0)
    96 00003522 81C1D0070000        <1>     add ecx, 2000   ;ecx is from 2000
    97 00003528 0FB6C6              <1>     movzx eax, dh   ;Get Months
    98 0000352B E812000000          <1>     call .bcd2Bin
    99 00003530 88C6                <1>     mov dh, al  
   100 00003532 0FB6C2              <1>     movzx eax, dl   ;Get day
   101 00003535 E808000000          <1>     call .bcd2Bin
   102 0000353A 88C2                <1>     mov dl, al
   103 0000353C B42B                <1>     mov ah, 2Bh ;DOS Set Date
   104 0000353E CD21                <1>     int 21h
   105 00003540 EB1C                <1>     jmp short .clkEnd
   106                              <1> .bcd2Bin:
   107                              <1> ;Converts a packed BCD value in al (zx to eax) to a decimal value in eax
   108 00003542 51                  <1>     push rcx
   109 00003543 89C1                <1>     mov ecx, eax
   110 00003545 250F000000          <1>     and eax, 0Fh ;Delete the upper nybble from al
   111 0000354A 81E1F0000000        <1>     and ecx, 0F0h    ;Isolate the second digit (high nybble)
   112 00003550 67E309              <1>     jecxz .b2bexit ;Exit if this is zero
   113 00003553 C1E904              <1>     shr ecx, 4   ;Shift it to the low nybble
   114                              <1> .b2blp:
   115 00003556 040A                <1>     add al, 10  ;Otherwise, keep adding 10  
   116 00003558 FFC9                <1>     dec ecx
   117 0000355A 75FA                <1>     jnz .b2blp
   118                              <1> .b2bexit:
   119 0000355C 59                  <1>     pop rcx
   120 0000355D C3                  <1>     ret
