   556                              <1> .getNumCyl:
   557                              <1> ;Computes the number of cylinders on the media. Not really to be used.
   558                              <1> ;Input: rbp -> drvBlk
   559 00003A0A 50                  <1>     push rax
   560 00003A0B 51                  <1>     push rcx
   561 00003A0C 52                  <1>     push rdx
   562 00003A0D 0FB74519            <1>     movzx eax, word [rbp + drvBlk.wNumHeads]
   563 00003A11 0FB74D17            <1>     movzx ecx, word [rbp + drvBlk.wSecPerTrk]
   564 00003A15 F7E1                <1>     mul ecx ;Get sectors per cylinder in eax. edx = 0
   565 00003A17 85C0                <1>     test eax, eax   ;If ax is 0, store zero! Phoney CHS data in BPB.
   566 00003A19 7414                <1>     jz .gncExit     ;This prevents CHS IOCTL from occuring.
   567 00003A1B 89C1                <1>     mov ecx, eax    ;Save this number in ecx
   568 00003A1D 0FB74512            <1>     movzx eax, word [rbp + drvBlk.wTotSec16]
   569 00003A21 85C0                <1>     test eax, eax   ;If this is zero, get the 32 bit count of sectors
   570 00003A23 0F44451F            <1>     cmovz eax, dword [rbp + drvBlk.dTotSec32]
   571 00003A27 F7F1                <1>     div ecx     ;sectors/(sectors/cylinder) = whole cylinders in eax
   572 00003A29 85D2                <1>     test edx, edx
   573 00003A2B 7402                <1>     jz .gncExit
   574 00003A2D FFC0                <1>     inc eax     ;Inc the cylinder count to account for not whole divide
   575                              <1> .gncExit:
   576 00003A2F BAFFFF0000          <1>     mov edx, 0FFFFh   ;A default Max cylinder value, since CHS is for floppies.
   577 00003A34 39D0                <1>     cmp eax, edx
   578 00003A36 0F47C2              <1>     cmova eax, edx
   579 00003A39 66894539            <1>     mov word [rbp + drvBlk.wNumCyl], ax
   580 00003A3D F8                  <1>     clc ;Ensure CF is clear
   581 00003A3E 5A                  <1>     pop rdx
   582 00003A3F 59                  <1>     pop rcx
   583 00003A40 58                  <1>     pop rax
   584                              <1>     return
