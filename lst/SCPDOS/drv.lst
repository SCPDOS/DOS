   734 00000867 480F42F0            <1>     cmovb rsi, rax
   735 0000086B 488DBD84000000      <1>     lea rdi, qword [rbp + drvBlk.filSysType]
   736 00000872 B909000000          <1>     mov ecx, 9
   737 00000877 F3A4                <1>     rep movsb
   738                              <1> 
   739 00000879 5F                  <1>     pop rdi
   740 0000087A 5E                  <1>     pop rsi
   741 0000087B 59                  <1>     pop rcx
   742 0000087C 5B                  <1>     pop rbx
   743 0000087D 58                  <1>     pop rax
