  1523 00000E6C 48894F10            <1>     mov qword [rdi + lbaParamsBlock.qNumSectors], rcx
  1524 00000E70 48895718            <1>     mov qword [rdi + lbaParamsBlock.qStartSector], rdx
  1525 00000E74 0FB74537            <1>     movzx eax, word [rbp + drvBlk.wDevFlgs]
  1526 00000E78 2503000000          <1>     and eax, devFixed | devChgLine
  1527 00000E7D 66894702            <1>     mov word [rdi + lbaParamsBlock.wDevFlgs], ax
  1528                              <1>     return 
