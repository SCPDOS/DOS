    34                              <1> .ci0:
    35 000034AA B401                <1>     mov ah, 01      ;Get buffer status
    36 000034AC CD36                <1>     int 36h
    37 000034AE 7406                <1>     jz .ci1      ;If zero clear => no more keys to read
    38 000034B0 30E4                <1>     xor ah, ah
    39 000034B2 CD36                <1>     int 36h ;Read key to flush from buffer
    40 000034B4 EBF4                <1>     jmp short .ci0
    41                              <1> .ci1:
    42 000034B6 B800050000          <1>     mov eax, 0500h  ;Set page zero as the default page
    43 000034BB CD30                <1>     int 30h
