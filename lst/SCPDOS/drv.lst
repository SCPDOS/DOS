   855                              <1> .moveVolIds:
   856                              <1> ;Now check the BPB for a extBs. If it is present, we copy the information.
   857                              <1> ;Input: rsi -> End of the BPB in sector. rbp -> drvBlk
   858                              <1> ;Output: CF=CY: No volume label in sector found.
   859                              <1> ;        CF=NC: Volume Label in sector found and copied.
   860 00000992 E835090000          <1>     call .clearMediaChange   ;Start by clearing the changed bit if it was set
   861 00000997 807E0229            <1>     cmp byte [rsi + extBs.bootSig], extBsSig
   862 0000099B 752B                <1>     jne .mviNoSig
   863                              <1> ;Else, now we copy the volume information from the extended bs info block
   864 0000099D 8B4603              <1>     mov eax, dword [rsi + extBs.volId]
   865 000009A0 898580000000        <1>     mov dword [rbp + drvBlk.volId], eax
   866 000009A6 4881C607000000      <1>     add rsi, extBs.volLab
   867 000009AD 488D7D74            <1>     lea rdi, qword [rbp + drvBlk.volLab]
   868 000009B1 B90B000000          <1>     mov ecx, 11 ;Copy the volume label
   869 000009B6 F3A4                <1>     rep movsb   
   870                              <1>     ;rsi now points to the filSysType field in the extBs.
   871                              <1>     ;Move rdi to the filSysType field in the drvBlk.
   872 000009B8 488DBD84000000      <1>     lea rdi, qword [rbp + drvBlk.filSysType]
   873 000009BF B908000000          <1>     mov ecx, 8  ;Now copy the 8 char string over too
   874 000009C4 F3A4                <1>     rep movsb   
   875                              <1> ;Clear the change bit now
   876 000009C6 F8                  <1>     clc
   877                              <1>     return
