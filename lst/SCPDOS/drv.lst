  1042                              <1> .ioDoErr:
  1043                              <1> ;Come here if after an error in block IO handler.
  1044                              <1> ;If ZF=ZE, disk error occured, the error needs translation so do it.
  1045                              <1> ;Else just return the error code in al
  1046 00000ACC 0F84B0FBFFFF        <1>     jz .errorXlat
  1047 00000AD2 E93CFCFFFF          <1>     jmp .errorExit
  1048                              <1> 
  1049                              <1> .ioAdvIOCTL:
  1050                              <1> ;Increments the count of sectors transferred in LBA IOCTL operations
  1051                              <1> ;Input/Output: As below except for rdi -> lbaFormatBlock (or lbaIOBlock)
  1052                              <1> ;               Remember, lbaIOBlock is a superset of lbaFormatBlock 
  1053 00000AD7 FE4701              <1>     inc byte [rdi + lbaIOBlock.numSectors]
  1054 00000ADA EB03                <1>     jmp short .ioAdvCmn
  1055                              <1> .ioAdv:
  1056                              <1> ;Increments the count of sectors transferred in normal read/writes
  1057                              <1> ;Input/Output: As below except for rdi -> ioReqPkt only
  1058 00000ADC FF4716              <1>     inc dword [rdi + ioReqPkt.tfrlen]    ;One more sector xfred ok!
  1059                              <1> .ioAdvCmn:
  1060                              <1> ;Advances the buffers on successful IO.
  1061                              <1> ;If returns ZF=ZE, we have completed all the IO for the request.
  1062                              <1> ;Input: 
  1063                              <1> ;       rbx -> Where we just IO'ed to
  1064                              <1> ;       rcx = LBA sector we just xfred
  1065                              <1> ;       dh  = BIOS function number
  1066                              <1> ;       dl  = BIOS drive number
  1067                              <1> ;       rdi -> ioReqPkt / lbaFormatBlock / lbaIOBlock
  1068                              <1> ;       rbp -> drvBlk
  1069                              <1> ;       esi = Number of sectors to xfr
  1070                              <1> ;Output:
  1071                              <1> ;       rbx -> Where to IO next sector to/from
  1072                              <1> ;       rcx = LBA of next sector to xfer
  1073                              <1> ;       dh  = BIOS function number
  1074                              <1> ;       dl  = BIOS drive number
  1075                              <1> ;       rdi -> ioReqPkt / lbaFormatBlock / lbaIOBlock
  1076                              <1> ;       rbp -> drvBlk
  1077                              <1> ;       esi = Sectors left to xfr.
  1078                              <1> ;       ZF=ZE if esi is 0. Else ZF=NZ.
  1079 00000ADF 50                  <1>     push rax
  1080 00000AE0 48FFC1              <1>     inc rcx     ;Goto next sector
  1081 00000AE3 0FB7450A            <1>     movzx eax, word [rbp + drvBlk.wBpS] 
  1082 00000AE7 4801C3              <1>     add rbx, rax  ;Advance the buffer pointer by 1 sector
  1083 00000AEA FFCE                <1>     dec esi     ;Once this hits 0, we stop the xfr
  1084 00000AEC 58                  <1>     pop rax
  1085                              <1>     return
    13                              <2> %%_ret:
    14 00000AED C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1086                              <1> 
  1087                              <1> .bioSetupRegs:
  1088                              <1> ;Sets up sector to read and buffer ptr for block IO call.
  1089                              <1> ;If returns ZF=ZE then xfr 0 sectors, exit immediately
  1090                              <1> ;Input: rbp -> drvBlk
  1091                              <1> ;Output: rdi -> ioReqPkt
  1092                              <1> ;        rbp -> drvBlk
  1093                              <1> ;        rbx -> Transfer buffer
  1094                              <1> ;        rcx = Sector to transfer
  1095                              <1> ;        dl  = BIOS Drive number
  1096                              <1> ;        dword [rdi + ioReqPkt.tfrlen] set to 0
  1097                              <1> ;        esi = Number of sectors to transfer
  1098                              <1> ;        ZF=ZE if esi is 0. Else ZF=NZ.
  1099 00000AEE 488B3D(98010000)    <1>     mov rdi, qword [reqPktPtr]  ;Get ioreqpktptr in rdi
  1100 00000AF5 8B4D1B              <1>     mov ecx, dword [rbp + drvBlk.dHiddSec]  ;Goto start of volume
  1101 00000AF8 48034F1A            <1>     add rcx, qword [rdi + ioReqPkt.strtsc]  ;Get sector in volume
  1102 00000AFC 488B5F0E            <1>     mov rbx, qword [rdi + ioReqPkt.bufptr]  ;Get Memory Buffer
  1103 00000B00 0FB65508            <1>     movzx edx, byte [rbp + drvBlk.bBIOSNum] ;Get BIOS drive number
  1104 00000B04 31F6                <1>     xor esi, esi   ;Setup esi to 0 to init tfrlen to 0
  1105 00000B06 877716              <1>     xchg esi, dword [rdi + ioReqPkt.tfrlen]  ;Get the tfrlen into esi
  1106 00000B09 85F6                <1>     test esi, esi   ;If esi is still 0, avoid doing IO
  1107                              <1>     return
    13                              <2> %%_ret:
    14 00000B0B C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
