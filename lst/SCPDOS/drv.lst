   875                              <1> .ubpbOldest:
   876                              <1> ;Here we build a pretend BPB in the sector buffer pointed to by rbx.
   877                              <1> ;This will then be used to build the internal data structure. 
   878 00000954 488D1DDF1B0000      <1>     lea rbx, .drvBpbTbl
   879 0000095B 2CFA                <1>     sub al, 0FAh    ;Get the offset into the bpb table
   880 0000095D B919000000          <1>     mov ecx, bpb_size
   881 00000962 F7E1                <1>     mul ecx         ;Get byte offset into the bpb table
   882 00000964 4801C3              <1>     add rbx, rax    ;Point rbx to this bpb in the table
   883 00000967 EB07                <1>     jmp short .ubpbMoveBpb
   884                              <1> .ubpbNormalDisk:
   885 00000969 4881C30B000000      <1>     add rbx, oemHeader_size ;Now point rbx to the BPB itself
   886                              <1> ;Update the drvBlk with info from the BPB.
   887                              <1> ;rbx points to the disk BPB. May be bad so we need to ensure the values 
   888                              <1> ; are ok before updating the msdTbl entry. 
   889                              <1> .ubpbMoveBpb:
   890 00000970 E858000000          <1>     call .getFATType    ;Fat type is given in edx
   891 00000975 72B8                <1>     jc .ubpbErr ;Only happens if crucial BPB fields are zero 
   892 00000977 885533              <1>     mov byte [rbp + drvBlk.bBpbType], dl    ;Save the FAT type
   893                              <1> ;Get the correct length to correctly position rsi over the extended bs struct
   894                              <1> ; if it is present
   895 0000097A B819000000          <1>     mov eax, bpb_size
   896 0000097F B929000000          <1>     mov ecx, bpb32_size - 12    ;BPB32 minus reserved count
   897 00000984 80FA20              <1>     cmp dl, bpbFat32
   898 00000987 0F45C8              <1>     cmovne ecx, eax     ;If not FAT32, replace move count
   899 0000098A 4889DE              <1>     mov rsi, rbx    ;Source from the BPB in disk buffer
   900 0000098D 488D7D0A            <1>     lea rdi, qword [rbp + drvBlk.bpb]
   901 00000991 F3A4                <1>     rep movsb        ;Now copy the BPB over!
   902 00000993 F8                  <1>     clc     ;Ensure if we return here, we return with CF happy :)
   903                              <1>     return
