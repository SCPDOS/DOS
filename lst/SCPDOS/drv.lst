    73 00000000 ??                  <1>     .attribWord db ?  ;(lowbyte DevAttrWord && 0Ch) || open mode
    74 00000001 ????                <1>     .startClust db 2 dup (?)  ;Starting cluster of file (too small for FAT32)
    75 00000003 ????                <1>     .dirSect    db 2 dup (?)  ;Sector containing dir entry (too small for FAT32)
    76 00000005 ??                  <1>     .dirEntry   db ?  ;Number of 32 byte directory entry IN sector
    77                              <1> endstruc
    78                              <1> 
