    89 00000000 ????                <1>     .dirSect    db 2 dup (?)  ;Sector number containing dir entry
    90 00000002 ????                <1>     .relClust   db 2 dup (?)  ;File relative cluster of last cluster accessed
    91 00000004 ????                <1>     .absClust   db 2 dup (?)  ;Disk relative cluster of last cluster accessed
    92                              <1> endstruc
     8                                  %include "./inc/dosStruc.inc"
     1                              <1> 
     2                              <1> ;-------------------------------------------------------;
     3                              <1> ; This include file contains miscellaneous internal     ;
     4                              <1> ; SCP/DOS structures.                                   ;
     5                              <1> ;-------------------------------------------------------;
     6                              <1> 
     7                              <1> ;File/path length equates.
     8                              <1> MAX_FNAME_FCB   equ 8
     9                              <1> MAX_EXT_FCB     equ 3
    10                              <1> MAX_NAME_FCB    equ MAX_FNAME_FCB + MAX_EXT_FCB
    11                              <1> MAX_NAME_FCBZ   equ MAX_NAME_FCB + 1    ;Space for a null terminator
    12                              <1> ;Values below include the null terminator.
    13                              <1> MAX_FILE    equ 13  ;Maximum length of a filename (includes dot)
    14                              <1> MAX_DRIVE   equ 3   ;Maximum length of a drive string (X:<NUL>)
    15                              <1> MAX_FSPEC   equ 64  ;Maximum length of a path to a file (filespec)
    16                              <1> MAX_PATH    equ 67  ;Maximum length of a fully qualified pathspec
    17                              <1> ;MAX_PATH is X:\<string, maxlen 63 chars>,<null> so 67 chars total.
    18                              <1> ;Use this symbol to check the length of a filename after qualification.
    19                              <1> MAX_PSPEC   equ MAX_PATH - MAX_FILE - 1 ;54 bytes
    20                              <1> ;MAX_PSPEC is the max length of a path with space for a filename!
    21                              <1> ;Remember, filenames for us are just a string of, at most, 13 characters,
    22                              <1> ; which we always resolve into FCB format. Buffers need to make space for
    23                              <1> ; both the dot and terminating null
    24                              <1> 
    25                              <1> ;Environment maximum
    26                              <1> ENV_MAX equ 7fffh
    27                              <1> 
    28                              <1> ;------------------------------------------------------------------------;
    29                              <1> ; Each mass storage device up to LASTDRIVE gets a DPB, describing 
    30                              <1> ; its file system structure. This is used to locate files and structures
    31                              <1> ; on the device itself and to translate file requests to cluster chains
    32                              <1> ; to LBAs to pass to the disk driver..
    33                              <1> ; The DPBs form a linked list, with each DPB formed after the devices 
    34                              <1> ; drivers Initialise routine has been called.
    35                              <1> ;------------------------------------------------------------------------;
    36                              <1> struc dpb        ;Drive Parameter Block
    37                              <1> 
    38 00000000 ??                  <1>     .bDriveNumber           db ?  ;Drive number (0=A, 1=B ...)
    39 00000001 ??                  <1>     .bUnitNumber            db ?  ;Unit number in device
    40 00000002 ????                <1>     .wBytesPerSector        dw ?  ;min 512, max 4096
    41 00000004 ??                  <1>     .bMaxSectorInCluster    db ?  ;(Maximum sector in cluster) - 1
    42 00000005 ??                  <1>     .bSecPerClustShift      db ?  ;Sectors per cluster exponent
    43 00000006 ????                <1>     .wFAToffset             dw ?  ;Number of reserved sectors in partition
    44 00000008 ??                  <1>     .bNumberOfFATs          db ?  ;Number of FATs
    45 00000009 ????                <1>     .wNumberRootDirEntries  dw ?  ;In 32 byte units, this is 0 for FAT32
    46 0000000B ????????            <1>     .dClusterHeapOffset     dd ?  ;Start sector of data area
    47 0000000F ????????            <1>     .dMaxClusterAddr        dd ?  ;Max Cluster Addr = # of data clusters + 1
    48 00000013 ????????            <1>     .dFATlength             dd ?  ;FAT length, in sectors
    49 00000017 ????????            <1>     .dFirstUnitOfRootDir    dd ?  
    50                              <1>     ;Unit=Sector/Cluster of Root Directory (FAT12/16 = Sector, FAT32 = Cluster)
    51 0000001B ????????????????    <1>     .qDriverHeaderPtr       dq ?  ;Pointer to device driver header
    52 00000023 ??                  <1>     .bMediaDescriptor       db ?  ;Media descriptor
    53 00000024 ??                  <1>     .bAccessFlag            db ?  ;Access Flag (0 if accessed, else -1)
    54 00000025 ????????????????    <1>     .qNextDPBPtr            dq ?  ;Pointer to next DPB, -1 if at end
    55 0000002D ????????            <1>     .dNextFreeClst          dd ?  ;Starting cluster of free space search
    56 00000031 ????????            <1>     .dFreeClustCnt          dd ?  ;Number of free clusters, -1 unknown
    57                              <1> 
    58                              <1> endstruc
    59                              <1> 
    60                              <1> fat12MaxClustCnt    equ 4085    ;Cluster count less than this is FAT12
    61                              <1> fat16MaxClustCnt    equ 65525   ;Cluster count less than this is FAT16
    62                              <1> ;------------------------------------------------------------------------;
    63                              <1> ; Each mass storage device up to LASTDRIVE has a CDS associated with it.
    64                              <1> ; All disk pathing requests go via the CDS for that drive.
    65                              <1> ; The default drive is the last accessed drive, this number is stored
    66                              <1> ; in the DOS data area.
    67                              <1> ; The CDS is stored as an array with the offset into the array being 
    68                              <1> ; given by the drive letter's offset into the alphabet (with A=0).
    69                              <1> ;
    70                              <1> ; DEFAULT LASTDRIVE=E, MINIMUM LASTDRIVE=B
    71                              <1> ;------------------------------------------------------------------------;
    72                              <1> struc cds       ;Current Directory structure
    73 00000000 <res 43h>           <1>     .sCurrentPath        db MAX_PATH dup (?)    ;Current Directory Path String
    74 00000043 ????                <1>     .wFlags              dw ?   ;CDS Flags - 
    75 00000045 ????????????????    <1>     .qDPBPtr             dq ?   ;Ptr to the DPB of the dev using this CDS
    76 0000004D ????????            <1>     .dStartCluster       dd ?   ;Starting cluster of the directory on disk
    77 00000051 ????????????????    <1>     .qIFSPtr             dq ?   ;Reserved for IFS driver expansions
    78 00000059 ????????            <1>     .dNetStore           dd ?   ;For storing a owner dword for IFS (21h/5F03h)
    79 0000005D ????                <1>     .wBackslashOffset    dw ?   ;How many chars to skip for getting the path
    80                              <1> ; currentPath (usually 2 to skip C: in C:\, but when SUBSTing a drive letter to 
    81                              <1> ; another, we save the number of chars to skip to that deep level).
    82                              <1> ; I.E. if we SUBST A:\DOS G: then this value for the CDS for drive G is 6
    83                              <1> ; Only affects for SUBST drives, not JOIN
    84                              <1> ; Flags: Bit 15 set = Network drive
    85                              <1> ;        Bit 14 set = Physical drive
    86                              <1> ;        Bit 13 set = JOIN'ed drive
    87                              <1> ;        Bit 12 set = SUBST'ed drive
    88                              <1> ;        Bit 7  set = Redirected, not net. drive (This is how MSCDEX worked)
    89                              <1> endstruc
    90                              <1> ;CDS equates
    91                              <1> cdsRedirDrive   equ 8000h   ;All drives which use the Redirector interface
    92                              <1> cdsValidDrive   equ 4000h   ;CDS valid
    93                              <1> cdsJoinDrive    equ 2000h   ;CDS for joined drives
    94                              <1> cdsSubstDrive   equ 1000h   ;Drives formed by Subst
    95                              <1> cdsRdirLocDrive equ 0080h   ;Redirector but Local
    96                              <1> ;------------------------------------------------------------------------;
    97                              <1> ; The SFT is a way to allow applications to open file handles to files 
    98                              <1> ; and devices. As things stand, the SFT chain will have 5 file handles
    99                              <1> ; under the first header, and then a second header will be linked to the 
   100                              <1> ; first one after CONFIG.SYS has been read, to allow for FILES= to specify
   101                              <1> ; a size for the second SFT (default 10 files). Same for System FCBs, 
   102                              <1> ; using the FCBS= command. Default FCBS=5.
   103                              <1> ;
   104                              <1> ; A file handle describes the file, and the location within the file that
   105                              <1> ; we are reading. The file handle can be manipulated without the file
   106                              <1> ; being in memory, thus allowing the user to access data without needing 
   107                              <1> ; to take up large portions of memory. Similarly, file handles allow for
   108                              <1> ; accessing devices, by treating them as files with their drivers 
   109                              <1> ; responding and translating the manipulations of the file handle itself.
   110                              <1> ; Neither the driver nor the application should see or use the SFT for
   111                              <1> ; the handle, as it is subject to change (and will change when file 
   112                              <1> ; sharing provisions are included). The DOS will make requests to the 
   113                              <1> ; driver in a generic way and the driver will respond, with DOS keeping
   114                              <1> ; track of the information in the SFT entry for that handle. 
   115                              <1> ;
   116                              <1> ; One SFT entry can have multiple handles and multiple SFT entries
   117                              <1> ; can point to the same file. It all depends on what the applications 
   118                              <1> ; want to do with the File.
   119                              <1> ;
   120                              <1> ; !!!!IMPORTANT!!!!
   121                              <1> ; Currently there are plans for File Sharing, but I include minimal 
   122                              <1> ; provisions for it. I really just wanna get a DOS out the door.
   123                              <1> ;
   124                              <1> ;Each SFT may look like this:
   125                              <1> ;sysvars-->sfth------------>sfth------------>|ENDOFLIST|
   126                              <1> ;            |                |
   127                              <1> ;       wNumFiles*sft    wNumFiles*sft
   128                              <1> ;
   129                              <1> ; Two SFT chains are built; one for files, and a one for so called 
   130                              <1> ; System FCBs.
   131                              <1> ;
   132                              <1> ; Each SFT header has an array of SFT's below it, with the number of 
   133                              <1> ; SFTs given by wNumFiles. The SFT headers form a linked list.
   134                              <1> ;
   135                              <1> ; DEFAULT FILES=8, MINIMUM FILES=5
   136                              <1> ; DEFAULT FCBS=5,  MINIMUM FCBS=5
   137                              <1> ;------------------------------------------------------------------------;
   138                              <1> struc sfth   ;System file table header
   139                              <1> ; This is the SFT header.
   140                              <1> ; This structure comes before the start of the first file in the array/table.
   141 00000000 ????????????????    <1>     .qNextSFTPtr dq ?    ;Pointer to the next SFT
   142 00000008 ????                <1>     .wNumFiles   dw ?    ;Number of files in this table
   143                              <1> endstruc
   144                              <1> 
   145                              <1> struc sft
   146                              <1> ;This is the file struc itself
   147 00000000 ????                <1>     .wNumHandles dw ?    ;Number of handles pointing to this file
   148 00000002 ????                <1>     .wOpenMode   dw ?    ;File access permissions and behaviours
   149 00000004 ??                  <1>     .bFileAttrib db ?    ;Regular File Attributes
   150 00000005 ????                <1>     .wDeviceInfo dw ?    ;Includes unit number if a block device
   151 00000007 ????????????????    <1>     .qPtr        dq ?    ;IF char, ptr to device driver header, ELSE DPBptr
   152 0000000F ????????            <1>     .dStartClust dd ?    ;Start cluster of file pointed to by SFT entry
   153                              <1> .dTimeDate:              ;Symbol to access time/date together
   154 00000013 ????                <1>     .wTime       dw ?    ;File Time, updated on open and writes
   155 00000015 ????                <1>     .wDate       dw ?    ;File Date, updated on open and writes
   156 00000017 ????????            <1>     .dFileSize   dd ?    ;File Size, in bytes
   157 0000001B ????????            <1>     .dCurntOff   dd ?    ;Current Offset pointed to by SFT entry, in bytes
   158 0000001F ????????            <1>     .dRelClust   dd ?    ;File relative cluster pointed to by SFT entry
   159 00000023 ????????            <1>     .dAbsClust   dd ?    ;Absolute disk cluster pointed to by SFT entry
   160 00000027 ????????????????    <1>     .qDirSect    dq ?    ;Abs number of sector containing directory entry 
   161 0000002F ??                  <1>     .bNumDirEnt  db ?    ;Directory entry within dir sector (byte offset/32)
   162 00000030 <res Bh>            <1>     .sFileName   db 11 dup (?)   ;8.3 Filename
   163                              <1> ;                       Share Vars
   164 0000003B ????????????????    <1>     .pNextSFT   dq ?    ;Ptr to the next SFT for this file in the chain
   165 00000043 ????????            <1>     .dMID       dd ?    ;Machine ID of the machine (VM) that opened this file
   166 00000047 ????????????????    <1>     .qPID       dq ?    ;Proc ID (PSP) of the program which opened this file
   167 0000004F ????????????????    <1>     .pMFT       dq ?    ;Pointer to the MFT for this file. 0 means no MFT
   168                              <1> endstruc
   169                              <1> ;Open Mode equates
   170                              <1> ;Access modes   Bits[2:0]
   171                              <1> openRdAcc   equ 0h
   172                              <1> openWrAcc   equ 1h
   173                              <1> openRWAcc   equ 2h
   174                              <1> ;Bit 3 reserved 0
   175                              <1> ;Sharing modes  Bits[6:4]
   176                              <1> openCompat      equ 0h  ;Deny all, compatibility mode
   177                              <1> openDenRWShr    equ 10h ;Deny all, explicity read/write
   178                              <1> openDenWrShr    equ 20h ;Deny writes
   179                              <1> openDenRdShr    equ 30h ;Deny reads
   180                              <1> openDenNoShr    equ 40h ;Don't deny anything!
   181                              <1> ;NetFCB is for files open by a local server, handling IO from a remote
   182                              <1> ; client by proxy opened by an FCB! Sets the Net bit to indicate this. 
   183                              <1> ;Thus, this is a handle with no JFT entry! Server handles its own JFT!
   184                              <1> openNetFCBShr   equ 70h
   185                              <1> openNoInherit   equ 80h
   186                              <1> 
   187                              <1> ;Bits 8-12 reserved 0
   188                              <1> ;The next two are extended open mode bits! 
   189                              <1> ;Can be set
   190                              <1> openFailOnI24   equ 2000h   ;If set, automatically FAIL all Int 24h
   191                              <1> openFlushWrites equ 4000h   ;If set, commit after each write call.
   192                              <1> ;SFT-FCBs mark that the SFT is indeed an FCB on the System FCB chain.
   193                              <1> ;These would only come into effect due to SHARE. We are yet to implement 
   194                              <1> ; them
   195                              <1> openSFTFCB      equ 8000h   ;If set, file is SFT-FCB.
   196                              <1> 
   197                              <1> ;Attribute Byte
   198                              <1> attrFileRO          equ 1h
   199                              <1> attrFileHidden      equ 2h
   200                              <1> attrFileSys         equ 4h
   201                              <1> attrFileVolLbl      equ 8h
   202                              <1> attrFileDir         equ 10h ;Directory entry
   203                              <1> attrFileArchive     equ 20h
   204                              <1> attrFileChar        equ 40h ;Reserved, never found in dir
   205                              <1> 
   206                              <1> ;Device Info word equates
   207                              <1> ;For a block device, bits [5:0] contain the drive number
   208                              <1> devCharConIn    equ 1h  ;If set, device is CON input
   209                              <1> devCharConOut   equ 2h  ;If set, device is CON output
   210                              <1> devCharNulDev   equ 4h  ;If set, device is NULL device
   211                              <1> devCharClkDev   equ 8h  ;If set, device is CLOCK device
   212                              <1> 
   213                              <1> devCharFastOut  equ 10h ;If set, device supports INT 29h
   214                              <1> devCharBinary   equ 20h ;If set, r/w char device in Binary mode
   215                              <1> devCharNotEOF   equ 40h ;If set, device not yet at end of file
   216                              <1> devDiskNoFlush  equ 40h ;Set if file is synchronised with hard store!
   217                              <1> devCharDev      equ 80h ;If set, it is a char device!
   218                              <1> 
   219                              <1> devDiskI24onFull    equ 100h    ;If set, Int 24h on disk full or disk EOF
   220                              <1> devCharNetSpool equ 800h    ;If set, device is a network spooler
   221                              <1> 
   222                              <1> devNoInherit    equ 1000h   ;If set, handle not inherited by child processes
   223                              <1> devCharNamePipe equ 2000h   ;If set, device is a named pipe
   224                              <1> devDiskNoDTonClose equ 4000h   ;If set, dont update date and time when closing
   225                              <1> devRedir        equ 8000h   ;If set, dev/file is redirected!
   226                              <1> 
   227                              <1> ;Extended open flags. For the var [wEOFlags]
   228                              <1> ;These are not related to the SFT but are used during an extended open
   229                              <1> ; call to keep track of whats going on and thus help build an SFT.
   230                              <1> eoInExtOpen     equ 0001h   ;Doing Extended Open
   231                              <1> eoFailI24       equ 0002h   ;If EO file hard fails, skip and fail Int 24h
   232                              <1> eoFileNoExist   equ 0004h   ;File doesnt exist
   233                              <1> 
   234                              <1> ;Can combine the third option with one of the first two options.
   235                              <1> ;The first two options cannot be combined.
   236                              <1> ; - If only create is selected, then we try to do a create new. If the 
   237                              <1> ;       file exists, this fails with a "File exists" error.
   238                              <1> ;       Acts like a normal create new call. (21/5Bh)
   239                              <1> ;
   240                              <1> ; - If only open is selected then we try to do an open. If the file doesn't
   241                              <1> ;       doesn't exist, this fails with a "File not found" error.
   242                              <1> ;       Acts like a normal open call. (21/3Dh)
   243                              <1> ;
   244                              <1> ; - If only truncate is selected then we try to do a create. If the file
   245                              <1> ;       doesn't exist, this fails a "File not found" error.
   246                              <1> ;       New behaviour.
   247                              <1> ;
   248                              <1> ; - If open and create are selected then we try and open the file. If 
   249                              <1> ;       the open fails due to the file not existing, we create a new file. 
   250                              <1> ;       New behaviour.
   251                              <1> ;
   252                              <1> ; - If truncate and create are selected then we try to truncate the file. 
   253                              <1> ;       If the file doesnt exist then we create a new file instead.
   254                              <1> ;       Acts like a normal create call. (21/3Ch)
   255                              <1> 
   256                              <1> eoActOpen       equ 01h ;Open the file. 
   257                              <1> eoActTruncate   equ 02h ;Truncate an existing file.
   258                              <1> eoActCreate     equ 10h ;Create a file if one doesnt exist.
   259                              <1> ;Extended Open Action Return 
   260                              <1> eoRetActOpen    equ 1   ;Open existing
   261                              <1> eoRetActCreate  equ 2   ;Create new and open
   262                              <1> eoRetActTruncate    equ 3    ;Recreate and open
   263                              <1> ;------------------------------------------------------------------------;
   264                              <1> ; Buffers allow for buffered drive IO, by first transferring a sector 
   265                              <1> ; to an internal buffer, and then copying it to the specified location
   266                              <1> ; in memory. The buffer is kept in the buffer chain,  in the event that 
   267                              <1> ; another request for the same sector from the same device is made, so 
   268                              <1> ; that is can be read from the device directly. Buffers are uniform in 
   269                              <1> ; size, selected according to the largest detected sector size during 
   270                              <1> ; the initial loadup.
   271                              <1> ;
   272                              <1> ; The buffer pointer in SysVars points to most recently used Buffer
   273                              <1> ;
   274                              <1> ; DEFAULT BUFFERS=30, MINIMUM BUFFERS=2
   275                              <1> ;------------------------------------------------------------------------;
   276                              <1> 
   277                              <1> struc bufferHdr
   278 00000000 ????????????????    <1>     .nextBufPtr  dq  ?   ;Pointer to the next buffer in the chain or -1 at end
   279                              <1>     .wDrvNumFlg:         ;Read as a word to get the following two bytes!
   280 00000008 ??                  <1>     .driveNumber db  ?   ;Drive number the buffer is used for (or -1 for free)
   281 00000009 ??                  <1>     .bufferFlags db  ?   ;Standard Flags
   282 0000000A ????????????????    <1>     .bufferLBA   dq  ?   ;LBA the buffer contains
   283 00000012 ??                  <1>     .bufFATcopy  db  ?   ;Number of copies of the FAT to write (1 if non-FAT)
   284 00000013 ????????            <1>     .bufFATsize  dd  ?   ;Number of sectors per FAT (or 0 if non-FAT)
   285 00000017 ????????????????    <1>     .driveDPBPtr dq  ?   ;Pointer to the device DPB block
   286 0000001F ??                  <1>     .reserved    db  ?   ;Alignment byte
   287                              <1>     .dataarea:             ;Points to the start of the data area
   288                              <1> endstruc
   289                              <1> ;Buffer Flag equates
   290                              <1> dosBuffer   equ 1h  ;Sector 0 (BPB/VPB) in buffer
   291                              <1> fatBuffer   equ 2h  ;FAT sector in buffer
   292                              <1> dirBuffer   equ 4h  ;Directory sector in buffer
   293                              <1> dataBuffer  equ 8h  ;File Data sector in buffer
   294                              <1> refBuffer   equ 20h ;Data in buffer has been referenced by an application
   295                              <1> dirtyBuffer equ 40h ;Data in buffer modified by an application
   296                              <1> freeBuffer  equ 00FFh   ;A word which goes into the drive number to clear both fields
   297                              <1> freeDrv     equ 0FFh    ;Same as above, just without modifying flags
   298                              <1> ;Note! A buffer is marked as referenced when the buffer is "obtained" by a syscall
   299                              <1> ;------------------------------------------------------------------------;
   300                              <1> ; Memory control block for each memory arena
   301                              <1> ;------------------------------------------------------------------------;
   302                              <1> struc mcb
   303 00000000 ??                  <1>     .marker     db ?  ;M = Member of the MCB chain. Z = Last member
   304 00000001 ????????????????    <1>     .owner      dq ?  ;Owning application PSP (para aligned) or 0 for free
   305 00000009 ????????            <1>     .blockSize  dd ?  ;Number of contiguous paragraphs owned by this block
   306                              <1>     ;The following byte is reserved outside of sysinit
   307 0000000D ??                  <1>     .subSysMark db ?  ;Marks the optional DOS subsystem of the MCB
   308 0000000E ????                <1>     .reserved   db 2 dup (?) 
   309                              <1>     .program:
   310                              <1> endstruc
   311                              <1> ;MCB equates
   312                              <1> mcbOwnerHole    equ 7   ;Owner = 7 => Memory hole, always fail free/realloc
   313                              <1> mcbOwnerFree    equ 0   ;Owner = 0 => Free and available space
   314                              <1> mcbOwnerDOS     equ 8   ;Owner = 8 => Owned by DOS
   315                              <1> mcbOwnerNewDOS  equ 9   ;Owner = 9 => New Kernel driver alloc. Needs setting to 8.
   316                              <1> mcbMarkCtn      equ "M"
   317                              <1> mcbMarkEnd      equ "Z"
   318                              <1> ;The following are used on MCB's that belong to DOS, that are not part of the
   319                              <1> ; main kernel (i.e. the CONFIG.SYS optional parts).
   320                              <1> mcbSubDriver    equ "D" ;Any memory allocated for a device driver's code.
   321                              <1> mcbSubDrvExtra  equ "L" ;Any memory allocated by a device driver.
   322                              <1> mcbSubDrvDPB    equ "P" ;Blocks used for DPB's are marked so.
   323                              <1> mcbSubIFS       equ "I" ;Unused for now
   324                              <1> mcbSubFiles     equ "F" ;Any memory allocated for Files.
   325                              <1> mcbSubFCBS      equ "X" ;Unused for now
   326                              <1> mcbSubBuffers   equ "B" ;Any memory allocated for Buffers.
   327                              <1> mcbSubCDS       equ "L" ;Any memory allocated to store a CDS.
   328                              <1> mcbSubStacks    equ "S" ;Unused for now
   329                              <1> mcbSubEnv       equ "E" ;Denotes an opaque environment copy produced by DOS
   330                              <1> 
   331                              <1> 
   332                              <1> memFirstFit     equ 0   ;First free block goes to application
   333                              <1> memBestFit      equ 1   ;Block whos size closest matches requirement
   334                              <1> memLastFit      equ 2   ;Last free block goes to application
   335                              <1> 
   336                              <1> ;Owner = Para aligned address => Owning application PSP
   337                              <1> ;...To consider...
   338                              <1> ;Owner = Non-para aligned address => Error? Should maybe lock up system?
   339                              <1> ;blockSize counts the number of paragraphs FROM .program TO THE NEXT MCB!
   340                              <1> ;------------------------------------------------------------------------;
