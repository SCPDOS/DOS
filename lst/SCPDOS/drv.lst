    31 0000349D 488D15D6CCFFFF      <1>     lea rdx, qword [ctrlBreak]
    32 000034A4 B83B000000          <1>     mov eax, 3Bh
    33 000034A9 E8A6FFFFFF          <1>     call installInterrupt
    34                              <1> .ci0:
    35 000034AE B401                <1>     mov ah, 01      ;Get buffer status
    36 000034B0 CD36                <1>     int 36h
    37 000034B2 7406                <1>     jz .ci1      ;If zero clear => no more keys to read
    38 000034B4 30E4                <1>     xor ah, ah
    39 000034B6 CD36                <1>     int 36h ;Read key to flush from buffer
    40 000034B8 EBF4                <1>     jmp short .ci0
    41                              <1> .ci1:
    42 000034BA B800050000          <1>     mov eax, 0500h  ;Set page zero as the default page
    43 000034BF CD30                <1>     int 30h
    44 000034C1 B402                <1>     mov ah, 02h
    45 000034C3 31D2                <1>     xor edx, edx    ;Set screen cursor to top right corner
    46 000034C5 88D7                <1>     mov bh, dl      ;Set cursor for page 0
    47 000034C7 CD30                <1>     int 30h
    48 000034C9 B707                <1>     mov bh, 07h     ;Grey/Black attribs
    49 000034CB B800060000          <1>     mov eax, 0600h  ;Clear whole screen
    50 000034D0 CD30                <1>     int 30h
    51 000034D2 5A                  <1>     pop rdx
    52 000034D3 59                  <1>     pop rcx
    53 000034D4 5B                  <1>     pop rbx
    54 000034D5 58                  <1>     pop rax
