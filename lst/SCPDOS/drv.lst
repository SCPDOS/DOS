  1762                              <1> .ioGetSetSetup:
  1763                              <1> ;Reads a bootsector in for us and checks it's the right kind of thing
  1764                              <1> ; for us to do this op on. All failures set up the return information
  1765                              <1> ; for us.
  1766                              <1> ;Sets up the BIOS/DOS error translation on hard error for us.
  1767 00000FE4 E852000000          <1>     call .ioIdCheckChange   ;Do this to ensure no fail in the read below
  1768 00000FE9 E84EFAFFFF          <1>     call .bbpbReadBS        ;Read BS for the drive in rbp. sets rbx to buffer
  1769 00000FEE 7244                <1>     jc .iogssHardErr        ;This returns CF=CY and ZF=ZE
  1770                              <1> ;Just do a quick jump check here too to make sure we're a decent BPB.
  1771 00000FF0 803B69              <1>     cmp byte [rbx + oemHeader.jump], 069h       ;Direct jump has no NOP
  1772 00000FF3 7410                <1>     je .iogssOk
  1773 00000FF5 803BE9              <1>     cmp byte [rbx + oemHeader.jump], 0E9h       ;Near jump has no NOP
  1774 00000FF8 740B                <1>     je .iogssOk
  1775 00000FFA 803BEB              <1>     cmp byte [rbx + oemHeader.jump], 0EBh       ;Short jump has a NOP
  1776 00000FFD 752E                <1>     jne .iogssBadBS
  1777 00000FFF 807B0290            <1>     cmp byte [rbx + oemHeader.jump + 2], 090h   ;NOP should be here
  1778 00001003 7528                <1>     jne .iogssBadBS
  1779                              <1> .iogssOk:
  1780 00001005 4881C30B000000      <1>     add rbx, oemHeader_size ;Point rbx to the bpb itself
  1781 0000100C E8BCF9FFFF          <1>     call .getFATType    ;Get in dl if we are FAT32 or CF=CY if bad
  1782 00001011 721A                <1>     jc .iogssBadBS
  1783 00001013 80FA20              <1>     cmp dl, bpbFat32    ;Did we get a FAT32 disk?
  1784 00001016 B819000000          <1>     mov eax, bpb_size
  1785 0000101B B935000000          <1>     mov ecx, bpb32_size
  1786 00001020 0F45C8              <1>     cmovne ecx, eax     ;If not FAT32, replace move count
  1787 00001023 4801CB              <1>     add rbx, rcx        ;Move rbx to point to the extended signature
  1788 00001026 807B0229            <1>     cmp byte [rbx + extBs.bootSig], extBsSig    ;Check ext boot sig?
  1789                              <1>     rete
