   820                              <1> ;Input: al = Media byte. 
   821                              <1> ;Ouput: ZF=NZ: Bad media byte. ZF=ZE: Ok media byte!
   822 000008E7 3CF0                <1>     cmp al, 0F0h
   823                              <1>     rete
