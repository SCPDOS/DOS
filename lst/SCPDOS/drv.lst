   261                              <1> ;Int 33h replacement routine
   262                              <1> i2fhSwap33h:
   263                              <1> ;Replaces the current int 33h handler and the int 39h replacement handler
   264                              <1> ;Input: ah = 13h
   265                              <1> ;       rdx -> New Int 33h handler.
   266                              <1> ;       rbx -> Value to replace back when system shutdown occurs.
   267                              <1> ;Output:
   268                              <1> ;       rdx -> Replaced Int 33h handler.
   269                              <1> ;       rbx -> Replaced original lowest level Int 33h handler.
   270 00000591 80FC13              <1>     cmp ah, 13h
   271 00000594 0F85B40D0000        <1>     jne msdDriver.i2fDriver ;Goto the driver backdoor if not this handler 
   272 0000059A 4887154BFFFFFF      <1>     xchg qword [i33Next], rdx
   273 000005A1 48871D34FFFFFF      <1>     xchg qword [i33Org], rbx
   274 000005A8 48CF                <1>     iretq
   275                              <1> 
   276                              <1> ; Actual driver here
   277                              <1> msdDriver:
   278 000005AA 50                  <1>     push rax
   279 000005AB 53                  <1>     push rbx
   280 000005AC 51                  <1>     push rcx
   281 000005AD 52                  <1>     push rdx
   282 000005AE 56                  <1>     push rsi
   283 000005AF 57                  <1>     push rdi
   284 000005B0 55                  <1>     push rbp
   285 000005B1 4150                <1>     push r8
   286 000005B3 488B1D(98010000)    <1>     mov rbx, qword [reqPktPtr]  ;Get the ptr to the req header in rbx
   287 000005BA 0FB67302            <1>     movzx esi, byte [rbx + drvReqPkt.cmdcde]    ;Get the command code
   288 000005BE 81FE18000000        <1>     cmp esi, drvMAXCMD                  ;Command code bigger than max?
   289 000005C4 7741                <1>     ja .errBadCmd                 ;If yes, error!
   290 000005C6 488D2D4D000000      <1>     lea rbp, .fnTbl
   291 000005CD 488D7CB500          <1>     lea rdi, qword [rbp + 4*rsi]    ;Ptr to table entry
   292 000005D2 0FB737              <1>     movzx esi, word [rdi]   ;Get the offset from table into esi
   293 000005D5 85F6                <1>     test esi, esi           ;If the offset is 0, exit!
   294 000005D7 7417                <1>     jz .exit
   295 000005D9 0FB60B              <1>     movzx ecx, byte [rbx + drvReqPkt.hdrlen]       ;Get packet length
   296 000005DC 663B4F02            <1>     cmp cx, word [rdi + 2]          ;Cmp packet lengths
   297 000005E0 752C                <1>     jne .errBadPkt
   298 000005E2 4801EE              <1>     add rsi, rbp    ;Add the two to get the pointer!
   299 000005E5 0FB64301            <1>     movzx eax, byte [rbx + drvReqPkt.unitnm]    ;Get the unit to setup
   300 000005E9 E8090B0000          <1>     call .setupDrive    ;Returns rbp -> Table entry
   301                              <1> ;Goto function! rbp -> Table entry, eax = Drive number. rbx -> Reqpkt
   302 000005EE FFD6                <1>     call rsi 
   303                              <1> .exit:
   304 000005F0 488B1D(98010000)    <1>     mov rbx, qword [reqPktPtr]  ;Get back the req header ptr
   305 000005F7 66814B030001        <1>     or word [rbx + drvReqPkt.status], drvDonStatus ;Set done bit
   306 000005FD 4158                <1>     pop r8
   307 000005FF 5D                  <1>     pop rbp
   308 00000600 5F                  <1>     pop rdi
   309 00000601 5E                  <1>     pop rsi
   310 00000602 5A                  <1>     pop rdx
   311 00000603 59                  <1>     pop rcx
   312 00000604 5B                  <1>     pop rbx
   313 00000605 58                  <1>     pop rax
   314 00000606 C3                  <1>     ret
   315                              <1> 
   316                              <1> .errBadCmd:
   317 00000607 B803000000          <1>     mov eax, drvBadCmd
   318 0000060C EB05                <1>     jmp short .writeEntryError
   319                              <1> .errBadPkt:
   320 0000060E B805000000          <1>     mov eax, drvBadDrvReq
   321                              <1> .writeEntryError:
   322                              <1> ;Used for errors in the driver entry
   323 00000613 E8FE000000          <1>     call .errorExit
   324 00000618 EBD6                <1>     jmp short .exit
   325                              <1> 
   326                              <1> 
   327                              <1> .fnTbl:
   328                              <1> ;Each table entry is 4 bytes to make searching easier. Low word is offset
   329                              <1> ; to function, high word is packet size for check
   330                              <1>     ;dw .initShim - .fnTbl        ;Function 0
   331 0000061A 602F                <1>     dw msdInit - .fnTbl
   332 0000061C 1F00                <1>     dw initReqPkt_size
   333 0000061E 1501                <1>     dw .medChk - .fnTbl          ;Function 1
   334 00000620 1700                <1>     dw mediaCheckReqPkt_size
   335 00000622 CA01                <1>     dw .buildBPB - .fnTbl        ;Function 2
   336 00000624 1E00                <1>     dw bpbBuildReqPkt_size
   337 00000626 0000                <1>     dw 0                         ;Function 3
   338 00000628 0000                <1>     dw 0
   339 0000062A 5204                <1>     dw .read - .fnTbl            ;Function 4
   340 0000062C 2A00                <1>     dw ioReqPkt_size
   341 0000062E 0000                <1>     dw 0                         ;Function 5
   342 00000630 0000                <1>     dw 0
   343 00000632 0000                <1>     dw 0                         ;Function 6
   344 00000634 0000                <1>     dw 0
   345 00000636 0000                <1>     dw 0                         ;Function 7
   346 00000638 0000                <1>     dw 0
   347 0000063A 7C04                <1>     dw .write - .fnTbl           ;Function 8
   348 0000063C 2A00                <1>     dw ioReqPkt_size
   349 0000063E 7C04                <1>     dw .write - .fnTbl           ;Function 9
   350 00000640 2A00                <1>     dw ioReqPkt_size
   351 00000642 0000                <1>     dw 0                         ;Function 10
   352 00000644 0000                <1>     dw 0
   353 00000646 0000                <1>     dw 0                         ;Function 11
   354 00000648 0000                <1>     dw 0
   355 0000064A 0000                <1>     dw 0                         ;Function 12
   356 0000064C 0000                <1>     dw 0
   357 0000064E 9705                <1>     dw .devOpen - .fnTbl         ;Function 13
   358 00000650 0D00                <1>     dw openReqPkt_size
   359 00000652 AD05                <1>     dw .devClose - .fnTbl        ;Function 14
   360 00000654 0D00                <1>     dw closeReqPkt_size
   361 00000656 C305                <1>     dw .remMed - .fnTbl          ;Function 15
   362 00000658 0D00                <1>     dw remMediaReqPkt_size
   363 0000065A 0000                <1>     dw 0                         ;Function 16
   364 0000065C 0000                <1>     dw 0
   365 0000065E 0000                <1>     dw 0                         ;Function 17
   366 00000660 0000                <1>     dw 0
