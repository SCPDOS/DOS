   527                              <1> .ptnUpdateBpb:
   528                              <1> ;Setups up the call for below on the current partition.
   529                              <1> ;Input: ecx = Number of hidden sectors (preserved)
   530                              <1> ;Output:
   531                              <1> ;   CF=NC: All ok, BPB entry in rbp filled.
   532                              <1> ;   CF=CY and ZF=ZE: Bad BPB read.
   533                              <1> ;   CF=CY and ZF=NZ: Sector read failed.
   534 000039EB 66C745370000        <1>     mov word [rbp + drvBlk.wDevFlgs], 0    ;Clean the flags to start with
   535 000039F1 894D1B              <1>     mov dword [rbp + drvBlk.dHiddSec], ecx
   536 000039F4 0FB605(04000000)    <1>     movzx eax, byte [dosDrv]
   537 000039FB 884509              <1>     mov byte [rbp + drvBlk.bDOSNum], al ;Save the DOS number
   538 000039FE 0FB605(03000000)    <1>     movzx eax, byte [biosDrv]   ;Get the BIOS drive
   539 00003A05 884508              <1>     mov byte [rbp + drvBlk.bBIOSNum], al
   540 00003A08 51                  <1>     push rcx
   541 00003A09 56                  <1>     push rsi    ;Save the mbr entry ptr
   542 00003A0A E870CEFFFF          <1>     call msdDriver.updateBpb
   543 00003A0F 7209                <1>     jc .pubBad
   544 00003A11 E87FCFFFFF          <1>     call msdDriver.moveVolIds
   545 00003A16 5E                  <1>     pop rsi
   546 00003A17 59                  <1>     pop rcx
   547 00003A18 F8                  <1>     clc         ;Always clean even if no ids
   548                              <1>     return
    13                              <2> %%_ret:
    14 00003A19 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   549                              <1> .pubBad:
   550 00003A1A 5E                  <1>     pop rsi
   551 00003A1B 59                  <1>     pop rcx
   552 00003A1C 3C07                <1>     cmp al, drvBadMed ;Bad Partition?
   553 00003A1E F9                  <1>     stc         ;Ensure we set the CF again
   554                              <1>     return
    13                              <2> %%_ret:
    14 00003A1F C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
