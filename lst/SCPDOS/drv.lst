  1287                              <1> .IOCTL:    ;Function 19
  1288                              <1> ;Implements LBA versions of the CHS functions by setting the high bit
  1289                              <1> ; in the minor code.
  1290 00000BEC B803000000          <1>     mov eax, drvBadCmd
  1291 00000BF1 0FB74B0D            <1>     movzx ecx, word [rbx + ioctlReqPkt.majfun]  ;Get CH and CL in one read
  1292 00000BF5 80FD08              <1>     cmp ch, 08h     ;Disk Drive Major Code?
  1293 00000BF8 0F8518FBFFFF        <1>     jne .errorExit  ;If not, exit bad
  1294                              <1> ;Disk Drive IOCTL here
  1295 00000BFE F6C118              <1>     test cl, 18h    ;If either bits 3 or 4 set, fail the call
  1296 00000C01 0F850FFBFFFF        <1>     jnz .errorExit
  1297 00000C07 F6C160              <1>     test cl, 60h    ;One of these two bits MUST be set (bits 5 and 6)
  1298 00000C0A 0F8406FBFFFF        <1>     jz .errorExit
  1299 00000C10 0FB6D1              <1>     movzx edx, cl
  1300 00000C13 81E207FFFFFF        <1>     and edx, ~0F8h   ;Clear bits 3-7 to get table offset
  1301 00000C19 488D3D21000000      <1>     lea rdi, .ioctlTbl
  1302 00000C20 57                  <1>     push rdi
  1303 00000C21 488D3C97            <1>     lea rdi, qword [rdi + 4*rdx]
  1304 00000C25 F6C120              <1>     test cl, 20h
  1305 00000C28 7407                <1>     jz .ioctlNoRead
  1306 00000C2A 4881C702000000      <1>     add rdi, 2  ;If we are doing the read function, goto the next instruction
  1307                              <1> .ioctlNoRead:
  1308 00000C31 0FB717              <1>     movzx edx, word [rdi]   ;Read the word offset
  1309 00000C34 5F                  <1>     pop rdi
  1310 00000C35 4801D7              <1>     add rdi, rdx    ;Add the table base
  1311 00000C38 488B531F            <1>     mov rdx, qword [rbx + ioctlReqPkt.ctlptr]
  1312 00000C3C F6C180              <1>     test cl, 80h    ;Now set the flag for if CHS (ZF=ZE) or LBA (ZF=NZ)
  1313 00000C3F FFE7                <1>     jmp rdi ;And enter the function with the ptr to the ctrl block in rdx
  1314                              <1> .ioctlTbl:
  1315                              <1> ;Note: For the CHS IO functions, we translate the CHS requests into LBA
  1316                              <1> ; requests and then recycle the LBA request code. We do this using the 
  1317                              <1> ; track table. If the sector size of any table entry is neq the 
  1318                              <1> ; device sector size, we fail the request. This is because these requests
  1319                              <1> ; work on a track by track basis.
  1320 00000C41 4300                <1>     dw .ioSetDevParams - .ioctlTbl  ;CL = 40h or CL = C0h, Write IOCTL
  1321 00000C43 4801                <1>     dw .ioGetDevParams - .ioctlTbl  ;CL = 60h or CL = E0h, Read IOCTL
  1322 00000C45 4402                <1>     dw .ioWrite - .ioctlTbl         ;CL = 41h or CL = C1h, Write IOCTL
  1323 00000C47 6E02                <1>     dw .ioRead - .ioctlTbl          ;CL = 61h or CL = E1h, Read IOCTL
  1324 00000C49 7B02                <1>     dw .ioFormat - .ioctlTbl        ;CL = 42h or CL = C2h, Write IOCTL
  1325 00000C4B A302                <1>     dw .ioVerify - .ioctlTbl        ;CL = 62h or CL = E2h, Read IOCTL
  1326 00000C4D 2500                <1>     dw .iobadCmd - .ioctlTbl        ;CL = 43h or CL = C3h, error
  1327 00000C4F 2500                <1>     dw .iobadCmd - .ioctlTbl        ;CL = 63h or CL = E3h, error
  1328 00000C51 2500                <1>     dw .iobadCmd - .ioctlTbl        ;CL = 44h or CL = C4h, error
  1329 00000C53 2500                <1>     dw .iobadCmd - .ioctlTbl        ;CL = 64h or CL = E4h, error
  1330 00000C55 2500                <1>     dw .iobadCmd - .ioctlTbl        ;CL = 45h or CL = C5h, error
  1331 00000C57 2500                <1>     dw .iobadCmd - .ioctlTbl        ;CL = 65h or CL = E5h, error
  1332 00000C59 3D03                <1>     dw .ioSetIds - .ioctlTbl        ;CL = 46h or CL = C6h, Set vol Ids
  1333 00000C5B 8903                <1>     dw .ioGetIds - .ioctlTbl        ;CL = 66h or CL = E6h, Get vol Ids
  1334 00000C5D 1B04                <1>     dw .ioSetAccessFlag - .ioctlTbl ;CL = 47h or CL = C7h, Write IOCTL
  1335 00000C5F 2F04                <1>     dw .ioGetAccessFlag - .ioctlTbl ;CL = 67h or CL = E7h, Read IOCTL
  1336                              <1> .ioctlQTbl:
  1337                              <1> ;Table of Read functions for IOCTL query. We homogenise the minor code 
  1338                              <1> ; value into a CHS level read request and then search for it (by clearing
  1339                              <1> ; bits 7 and 5 from the byte, both optionally set bits).
  1340                              <1> ;If we add a new function, add it to this table pls :)
  1341 00000C61 4041424647          <1>     db 40h, 41h, 42h, 46h, 47h
  1342                              <1> ioctlQTblL equ $ - .ioctlQTbl
