   338                              <1> ; registers by accessing the caller register stack frame.
   339                              <1> ;------------------------------------------------------------------------;
   340                              <1> struc callerFrame
   341 00000000 ????????????????    <1>     .rax    dq ?  ;Bottom of frame, pointer to rax saved in oldRSP
   342 00000008 ????????????????    <1>     .rbx    dq ?    
