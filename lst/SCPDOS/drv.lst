  1151                              <1> .bioNoIO:
  1152 00000B55 FFCE                <1>     dec esi ;Decrement the retry counter
  1153 00000B57 75D8                <1>     jnz .biolp  ;and try again if we still have retries to do
  1154 00000B59 5E                  <1>     pop rsi ;Now rebalance the stack
  1155                              <1> ;Here we return as if our request was successful but we set esi to zero
  1156                              <1> ; to stop IO processing as the operation isn't reading/writing the sector
  1157                              <1> ; for no erroring reason (should never actually happen as the sanity check 
  1158                              <1> ; should handle this case but _just in case_ ).
  1159 00000B5A 31F6                <1>     xor esi, esi
  1160                              <1>     return
    13                              <2> %%_ret:
    14 00000B5C C3                  <2>  ret
