   491 0000397E 488B6D00            <1>     mov rbp, qword [rbp + drvBlk.pLink]    ;Go to the next disk entry.
   492 00003982 FE05(04000000)      <1>     inc byte [dosDrv]       ;Go to the next DOS device
   493 00003988 FE05(00000000)      <1>     inc byte [physVol]
   494                              <1>     return
