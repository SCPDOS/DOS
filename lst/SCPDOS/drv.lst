   725 00000848 F3A4                <1>     rep movsb
   726                              <1> ;3) Reset the FAT string
   727                              <1> ;Since fat32 indicator is in the middle, compare against it.
   728                              <1> ;If dskOff is set instead of FAT16, then FAT16 works as a default value :)
   729 0000084A 488D35D20C0000      <1>     lea rsi, .fat32Str
   730 00000851 488D05B90C0000      <1>     lea rax, .fat12Str
   731 00000858 488D1DBB0C0000      <1>     lea rbx, .fat16Str
   732 0000085F F6453320            <1>     test byte [rbp + drvBlk.bBpbType], bpbFat32
