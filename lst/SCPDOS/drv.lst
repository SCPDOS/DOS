  1413                              <1> ;Now we update the rest of the disk metadata.
  1414                              <1> ;Now copy the rest of the bytes and return
  1415 00000CF1 0FB74202            <1>     movzx eax, word [rdx + chsParamsBlock.wDevFlgs]
  1416 00000CF5 2503000000          <1>     and eax, devFixed | devChgLine  ;Keep only these two bits
  1417 00000CFA 66816537FCFF        <1>     and word [rbp + drvBlk.wDevFlgs], ~(devFixed | devChgLine)   ;Clear em
  1418 00000D00 66094537            <1>     or word [rbp + drvBlk.wDevFlgs], ax  ;Add those two bits as set
  1419 00000D04 0FB64201            <1>     movzx eax, byte [rdx + chsParamsBlock.bDevType]
  1420 00000D08 884536              <1>     mov byte [rbp + drvBlk.bDevType], al
  1421 00000D0B 66814D378000        <1>     or word [rbp + drvBlk.wDevFlgs], devSetDASD 
  1422 00000D11 0FB74204            <1>     movzx eax, word [rdx + chsParamsBlock.wNumCyl]
  1423 00000D15 66894539            <1>     mov word [rbp + drvBlk.wNumCyl], ax
  1424                              <1> ;Finally, here we do the BPB magic.
  1425                              <1> ;
  1426                              <1> ;The logic here is that in a format operation, we first update the driver 
  1427                              <1> ; devBlk bpb fields with the new format and set the devLockBpb flag. 
  1428                              <1> ; This is so the bpb isn't updated from the disk when a disk operation is 
  1429                              <1> ; enacted and that the parameters we passed in this call are what are
  1430                              <1> ; reported to DOS whilst the bootsector hasn't been synchronised with 
  1431                              <1> ; the disk.
  1432                              <1> ;
  1433                              <1> ;We then write the bootsector with the new bpb to disk, thus synchronising
  1434                              <1> ; the new bpb parameter block with what is on disk.
  1435                              <1> ;
  1436                              <1> ;Then we call this again, this time, to clear the locking flag as the disk
  1437                              <1> ; is now sychronised with the accurate bpb. We also here can get rid of 
  1438                              <1> ; the old backup bpb and so the second call will replace the backup
  1439                              <1> ; with whatever we pass it (ideally, the same bpb).
  1440                              <1> ;
  1441                              <1> ;This procedure protects us from accidentally making the drive unusable if
  1442                              <1> ; we somehow fail to write the BPB by having updated the drvBlk. The 
  1443                              <1> ; protection occurs by allowing us to restore the backup bpb as the devBlk 
  1444                              <1> ; bpb if the disk synchronisation of the new parameters failed.
  1445 00000D19 F60201              <1>     test byte [rdx + chsParamsBlock.bSpecFuncs], specFuncBPB
  1446 00000D1C 7511                <1>     jnz .iosdpSetBPB    ;If bit set, lock the bpb
  1447                              <1> ;Else we update the backup bpb and unlock the main bpb
  1448 00000D1E 488D7D3B            <1>     lea rdi, qword [rbp + drvBlk.sBkupBPB]
  1449 00000D22 B935000000          <1>     mov ecx, bpb32_size
  1450 00000D27 66816537FBFF        <1>     and word [rbp + drvBlk.wDevFlgs], ~devLockBpb   ;Now allow update bpb 
  1451 00000D2D EB0F                <1>     jmp short .iosdpCopy
  1452                              <1> .iosdpSetBPB:
  1453 00000D2F 488D7D0A            <1>     lea rdi, qword [rbp + drvBlk.bpb]   ;Default to the normal BPB in drvblk
  1454 00000D33 B929000000          <1>     mov ecx, drvBlkBpb_size
  1455 00000D38 66814D370400        <1>     or word [rbp + drvBlk.wDevFlgs], devLockBpb ;Lock the BPB now
  1456                              <1> .iosdpCopy:
  1457 00000D3E 488D7207            <1>     lea rsi, qword [rdx + chsParamsBlock.deviceBPB]
  1458 00000D42 F3A4                <1>     rep movsb
  1459                              <1>     return
    13                              <2> %%_ret:
    14 00000D44 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
  1460                              <1> .iosdpSetTblEntry:
  1461                              <1> ;Input: eax = A number between 128 and 4096. If not, adjusted to.
  1462                              <1> ; 128  = 0080h -> 0
  1463                              <1> ; 256  = 0100h -> 1
  1464                              <1> ; 512  = 0200h -> 2
  1465                              <1> ; 1024 = 0400h -> 3
  1466                              <1> ; 4096 = 1000h -> 5
  1467                              <1> ;Output: eax = Code [0 = 128 ... 5 = 4096]
  1468 00000D45 C1E808              <1>     shr eax, 8  ;Shift the upper word down
  1469 00000D48 3D02000000          <1>     cmp eax, 2  
  1470                              <1>     retb
