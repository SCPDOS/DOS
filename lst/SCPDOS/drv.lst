  1109                              <1> .blkIODirect:    ;Does block IO without sanity checking the sector number
  1110                              <1> ;All registers as below!
  1111 00000B0C 66F745370002        <1>     test word [rbp + drvBlk.wDevFlgs], devUnFmt
  1112 00000B12 0F858F000000        <1>     jnz .bioUfmted
  1113 00000B18 EB11                <1>     jmp short .biocmn
  1114                              <1> .blkIO:  ;Does block IO for one sector
  1115                              <1> ;Sector count handled by caller.
  1116                              <1> ;All registers marked as input registers must be preserved across the call
  1117                              <1> ; except ah
  1118                              <1> ;Input: ah = BIOS function number
  1119                              <1> ;       rdi -> ioReqPkt             (Normal Read/Write only)
  1120                              <1> ;       rbp -> drvBlk
  1121                              <1> ;       rbx -> Transfer buffer
  1122                              <1> ;       rcx = LBA sector to transfer
  1123                              <1> ;       dh  = BIOS function number
  1124                              <1> ;       dl  = BIOS drive number
  1125                              <1> ;       esi = Sectors left to xfr!  (Normal Read/Write only)
  1126                              <1> ;Output: CF=NC: esi number of sectors xferred.
  1127                              <1> ;        CF=CY: An error ocured. 
  1128                              <1> ;           ZF=NZ: Non-disk error, return the DOS error code in eax
  1129                              <1> ;           ZF=ZE: Disk error, xlat BIOS error code in ah
  1130 00000B1A 66F745370002        <1>     test word [rbp + drvBlk.wDevFlgs], devUnFmt
  1131 00000B20 0F8581000000        <1>     jnz .bioUfmted
  1132 00000B26 E854000000          <1>     call .bioSanity ;Sanity check ecx here
  1133                              <1> .biocmn:
  1134 00000B2B 56                  <1>     push rsi    ;Save sector count
  1135 00000B2C BE05000000          <1>     mov esi, 5  ;Retry counter five times
  1136                              <1> .biolp:
  1137 00000B31 B001                <1>     mov al, 01h ;Do one sector
  1138 00000B33 88F4                <1>     mov ah, dh  ;Get the function number into its proper place
  1139 00000B35 E8CC080000          <1>     call .callI33h  ;Preserves all passed regs except eax. eax trashed
  1140 00000B3A 7221                <1>     jc .bioError
  1141 00000B3C 3C01                <1>     cmp al, 1   ;Did we do one sector?
  1142 00000B3E 7515                <1>     jne .bioNoIO    ;No, try again without calling BIOS error handling
  1143 00000B40 5E                  <1>     pop rsi ;Rebalance stack
  1144                              <1> .bioExit:
  1145 00000B41 8815EB090000        <1>     mov byte [.bLastDsk], dl    ;Last DOS disk accessed
  1146 00000B47 E872070000          <1>     call .checkDevFixed
  1147                              <1>     retnz
