  1287                              <1> .IOCTL:    ;Function 19
  1288                              <1> ;Implements LBA versions of the CHS functions by setting the high bit
  1289                              <1> ; in the minor code.
  1290 00000BEC B803000000          <1>     mov eax, drvBadCmd
  1291 00000BF1 0FB74B0D            <1>     movzx ecx, word [rbx + ioctlReqPkt.majfun]  ;Get CH and CL in one read
  1292 00000BF5 80FD08              <1>     cmp ch, 08h     ;Disk Drive Major Code?
  1293 00000BF8 0F8518FBFFFF        <1>     jne .errorExit  ;If not, exit bad
  1294                              <1> ;Disk Drive IOCTL here
  1295 00000BFE F6C118              <1>     test cl, 18h    ;If either bits 3 or 4 set, fail the call
  1296 00000C01 0F850FFBFFFF        <1>     jnz .errorExit
  1297 00000C07 F6C160              <1>     test cl, 60h    ;One of these two bits MUST be set (bits 5 and 6)
  1298 00000C0A 0F8406FBFFFF        <1>     jz .errorExit
  1299 00000C10 0FB6D1              <1>     movzx edx, cl
  1300 00000C13 81E207FFFFFF        <1>     and edx, ~0F8h   ;Clear bits 3-7 to get table offset
  1301 00000C19 488D3D21000000      <1>     lea rdi, .ioctlTbl
  1302 00000C20 57                  <1>     push rdi
  1303 00000C21 488D3C97            <1>     lea rdi, qword [rdi + 4*rdx]
  1304 00000C25 F6C120              <1>     test cl, 20h
  1305 00000C28 7407                <1>     jz .ioctlNoRead
  1306 00000C2A 4881C702000000      <1>     add rdi, 2  ;If we are doing the read function, goto the next instruction
  1307                              <1> .ioctlNoRead:
  1308 00000C31 0FB717              <1>     movzx edx, word [rdi]   ;Read the word offset
  1309 00000C34 5F                  <1>     pop rdi
  1310 00000C35 4801D7              <1>     add rdi, rdx    ;Add the table base
  1311 00000C38 488B531F            <1>     mov rdx, qword [rbx + ioctlReqPkt.ctlptr]
  1312 00000C3C F6C180              <1>     test cl, 80h    ;Now set the flag for if CHS (ZF=ZE) or LBA (ZF=NZ)
  1313 00000C3F FFE7                <1>     jmp rdi ;And enter the function with the ptr to the ctrl block in rdx
  1314                              <1> .ioctlTbl:
  1315                              <1> ;Note: For the CHS IO functions, we translate the CHS requests into LBA
  1316                              <1> ; requests and then recycle the LBA request code. We do this using the 
  1317                              <1> ; track table. If the sector size of any table entry is neq the 
  1318                              <1> ; device sector size, we fail the request. This is because these requests
  1319                              <1> ; work on a track by track basis.
  1320 00000C41 4300                <1>     dw .ioSetDevParams - .ioctlTbl  ;CL = 40h or CL = C0h, Write IOCTL
  1321 00000C43 4801                <1>     dw .ioGetDevParams - .ioctlTbl  ;CL = 60h or CL = E0h, Read IOCTL
  1322 00000C45 4402                <1>     dw .ioWrite - .ioctlTbl         ;CL = 41h or CL = C1h, Write IOCTL
  1323 00000C47 6E02                <1>     dw .ioRead - .ioctlTbl          ;CL = 61h or CL = E1h, Read IOCTL
  1324 00000C49 7B02                <1>     dw .ioFormat - .ioctlTbl        ;CL = 42h or CL = C2h, Write IOCTL
  1325 00000C4B A302                <1>     dw .ioVerify - .ioctlTbl        ;CL = 62h or CL = E2h, Read IOCTL
  1326 00000C4D 2500                <1>     dw .iobadCmd - .ioctlTbl        ;CL = 43h or CL = C3h, error
  1327 00000C4F 2500                <1>     dw .iobadCmd - .ioctlTbl        ;CL = 63h or CL = E3h, error
  1328 00000C51 2500                <1>     dw .iobadCmd - .ioctlTbl        ;CL = 44h or CL = C4h, error
  1329 00000C53 2500                <1>     dw .iobadCmd - .ioctlTbl        ;CL = 64h or CL = E4h, error
  1330 00000C55 2500                <1>     dw .iobadCmd - .ioctlTbl        ;CL = 45h or CL = C5h, error
  1331 00000C57 2500                <1>     dw .iobadCmd - .ioctlTbl        ;CL = 65h or CL = E5h, error
  1332 00000C59 3D03                <1>     dw .ioSetIds - .ioctlTbl        ;CL = 46h or CL = C6h, Set vol Ids
  1333 00000C5B 8903                <1>     dw .ioGetIds - .ioctlTbl        ;CL = 66h or CL = E6h, Get vol Ids
  1334 00000C5D 1B04                <1>     dw .ioSetAccessFlag - .ioctlTbl ;CL = 47h or CL = C7h, Write IOCTL
  1335 00000C5F 2F04                <1>     dw .ioGetAccessFlag - .ioctlTbl ;CL = 67h or CL = E7h, Read IOCTL
  1336                              <1> .ioctlQTbl:
  1337                              <1> ;Table of Read functions for IOCTL query. We homogenise the minor code 
  1338                              <1> ; value into a CHS level read request and then search for it (by clearing
  1339                              <1> ; bits 7 and 5 from the byte, both optionally set bits).
  1340                              <1> ;If we add a new function, add it to this table pls :)
  1341 00000C61 4041424647          <1>     db 40h, 41h, 42h, 46h, 47h
  1342                              <1> ioctlQTblL equ $ - .ioctlQTbl
  1343                              <1> .iobadCmd:
  1344 00000C66 B803000000          <1>     mov eax, drvBadCmd
  1345 00000C6B E9A6FAFFFF          <1>     jmp .errorExit
  1346                              <1> .iobadCmdLen:
  1347 00000C70 B805000000          <1>     mov eax, drvBadDrvReq
  1348 00000C75 E99CFAFFFF          <1>     jmp .errorExit
  1349                              <1> .iobadMed:
  1350 00000C7A B807000000          <1>     mov eax, drvBadMed
  1351 00000C7F E992FAFFFF          <1>     jmp .errorExit
  1352                              <1> ;---------------------------------------------------------------------------
  1353                              <1> ;               Set Device parameters in CHS and LBA here
  1354                              <1> ;---------------------------------------------------------------------------
  1355                              <1> .ioSetDevParams:
  1356 00000C84 9C                  <1>     pushfq
  1357                              <1> ;If the parameters are swapped, set the flags and indicate the media 
  1358                              <1> ; was swapped (even if not).
  1359 00000C85 66814D374001        <1>     or word [rbp + drvBlk.wDevFlgs], devNewParms | devChgd
  1360 00000C8B 9D                  <1>     popfq
  1361 00000C8C 0F85C8000000        <1>     jnz .lbaSetParams
  1362                              <1> ;Here we set CHS params. 
  1363                              <1> ;Before we trust the table, we check that indeed
  1364                              <1> ; no sector index is past the max sector count and that if the caller
  1365                              <1> ; claimed that all the sectors are of the same size, they really are.    
  1366 00000C92 488D723C            <1>     lea rsi, qword [rdx + chsParamsBlock.TrackLayout]
  1367 00000C96 4889F7              <1>     mov rdi, rsi    ;Save the pointer in rdi
  1368 00000C99 66AD                <1>     lodsw           ;Get the lead word and adv rsi by 2
  1369 00000C9B 0FB7C8              <1>     movzx ecx, ax   ;Get the lead table entry into ax
  1370 00000C9E 81F93F000000        <1>     cmp ecx, maxTrackTblSz
  1371 00000CA4 7460                <1>     jz .iosdpNoTrack   ;Don't touch the tracks bit in this case!
  1372 00000CA6 0F8765FAFFFF        <1>     ja .genErrExit
  1373 00000CAC 66813E3F00          <1>     cmp word [rsi], maxTrackTblSz   ;Check the first entry is ok!
  1374 00000CB1 0F875AFAFFFF        <1>     ja .genErrExit
  1375                              <1> .iosdpTblCheckLp:
  1376 00000CB7 AD                  <1>     lodsd   ;Go to next entry
  1377 00000CB8 FFC9                <1>     dec ecx ;And remove from the count
  1378 00000CBA 7420                <1>     jz .iosdpTblCheckEnd
  1379 00000CBC 66813E3F00          <1>     cmp word [rsi], maxTrackTblSz   ;Ensure no entry above the max entry value
  1380 00000CC1 0F874AFAFFFF        <1>     ja .genErrExit
  1381 00000CC7 F60204              <1>     test byte [rdx + chsParamsBlock.bSpecFuncs], specFuncSec ;All same size?
  1382 00000CCA 74EB                <1>     jz .iosdpTblCheckLp ;If not, skip this check (always check 1=<i<=n)
  1383 00000CCC 668B4602            <1>     mov ax, word [rsi + 2]  ;Else get sector size
  1384 00000CD0 663946FE            <1>     cmp word [rsi - 2], ax  ;And compare with the previous sector size
  1385 00000CD4 0F8537FAFFFF        <1>     jne .genErrExit
  1386 00000CDA EBDB                <1>     jmp short .iosdpTblCheckLp
  1387                              <1> .iosdpTblCheckEnd:
  1388                              <1> ;Now we set the sector size bit if all tracks same size check was passed.
  1389                              <1> ;If all sectors have the same size but the caller didn't specify this
  1390                              <1> ; bit, we also don't specify this bit.
  1391 00000CDC 66816537F7FF        <1>     and word [rbp + drvBlk.wDevFlgs], ~devSameSec    ;Clear bit first
  1392 00000CE2 F60204              <1>     test byte [rdx + chsParamsBlock.bSpecFuncs], specFuncSec
  1393 00000CE5 7406                <1>     jz .iosdpNoSetTrackBit
  1394                              <1> ;The only way we got here if the bit was set is that the check passed.
  1395                              <1> ; Set the bit in the device block.
  1396 00000CE7 66814D370800        <1>     or word [rbp + drvBlk.wDevFlgs], devSameSec
  1397                              <1> .iosdpNoSetTrackBit:
  1398                              <1> ;Now we copy the table directly as sector numbers may be purposefully
  1399                              <1> ; interleaved. NO SORTING!!
  1400 00000CED 4889FE              <1>     mov rsi, rdi    ;Get back the track layout pointer 
  1401 00000CF0 488D3D8A030000      <1>     lea rdi, .ioTrackTbl    ;We overwrite our internal track table
  1402 00000CF7 66AD                <1>     lodsw   ;Get the table length
  1403 00000CF9 0FB7C8              <1>     movzx ecx, ax   ;This many entries
  1404 00000CFC 66AB                <1>     stosw
  1405 00000CFE F3A5                <1>     rep movsd       ;Move the dword entries over
  1406 00000D00 F60202              <1>     test byte [rdx + chsParamsBlock.bSpecFuncs], specFuncTrk    ;Just tracks?
  1407                              <1>     retnz   ;Return if bit set!
