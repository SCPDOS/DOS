  1159                              <1> .blkIODirect:    ;Does block IO without sanity checking the sector number
  1160                              <1> ;All registers as below!
  1161 00000B0F 66F745370002        <1>     test word [rbp + drvBlk.wDevFlgs], devUnFmt
  1162 00000B15 0F858F000000        <1>     jnz .bioUfmted
  1163 00000B1B EB11                <1>     jmp short .biocmn
  1164                              <1> .blkIO:  ;Does block IO for one sector
  1165                              <1> ;Sector count handled by caller.
  1166                              <1> ;All registers marked as input registers must be preserved across the call
  1167                              <1> ; except ah
  1168                              <1> ;Input: ah = BIOS function number
  1169                              <1> ;       rdi -> ioReqPkt             (Normal Read/Write only)
  1170                              <1> ;       rbp -> drvBlk
  1171                              <1> ;       rbx -> Transfer buffer
  1172                              <1> ;       rcx = LBA sector to transfer
  1173                              <1> ;       dh  = BIOS function number
  1174                              <1> ;       dl  = BIOS drive number
  1175                              <1> ;       esi = Sectors left to xfr!  (Normal Read/Write only)
  1176                              <1> ;Output: CF=NC: esi number of sectors xferred.
  1177                              <1> ;        CF=CY: An error ocured. 
  1178                              <1> ;           ZF=NZ: Non-disk error, return the DOS error code in eax
  1179                              <1> ;           ZF=ZE: Disk error, xlat BIOS error code in ah
  1180 00000B1D 66F745370002        <1>     test word [rbp + drvBlk.wDevFlgs], devUnFmt
  1181 00000B23 0F8581000000        <1>     jnz .bioUfmted
  1182 00000B29 E854000000          <1>     call .bioSanity ;Sanity check ecx here
  1183                              <1> .biocmn:
  1184 00000B2E 56                  <1>     push rsi    ;Save sector count
  1185 00000B2F BE05000000          <1>     mov esi, 5  ;Retry counter five times
  1186                              <1> .biolp:
  1187 00000B34 B001                <1>     mov al, 01h ;Do one sector
  1188 00000B36 88F4                <1>     mov ah, dh  ;Get the function number into its proper place
  1189 00000B38 E8E0070000          <1>     call .callI33h  ;Preserves all passed regs except eax. eax trashed
  1190 00000B3D 7221                <1>     jc .bioError
  1191 00000B3F 3C01                <1>     cmp al, 1   ;Did we do one sector?
  1192 00000B41 7515                <1>     jne .bioNoIO    ;No, try again without calling BIOS error handling
  1193 00000B43 5E                  <1>     pop rsi ;Rebalance stack
  1194                              <1> .bioExit:
  1195 00000B44 8815FF080000        <1>     mov byte [.bLastDsk], dl    ;Last DOS disk accessed
  1196 00000B4A E886060000          <1>     call .checkDevFixed
  1197                              <1>     retnz
