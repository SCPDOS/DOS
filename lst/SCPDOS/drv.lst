   770                              <1> ;Check we if we have a valid bootsector.
   771 00000890 803B69              <1>     cmp byte [rbx + oemHeader.jump], 069h       ;Direct jump has no NOP
   772 00000893 7410                <1>     je .ubpbCheckMedOk
   773 00000895 803BE9              <1>     cmp byte [rbx + oemHeader.jump], 0E9h       ;Near jump has no NOP
   774 00000898 740B                <1>     je .ubpbCheckMedOk
