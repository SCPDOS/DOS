   720                              <1> ;Check we if we have a valid bootsector.
   721 0000088D 803B69              <1>     cmp byte [rbx + oemHeader.jump], 069h       ;Direct jump has no NOP
   722 00000890 7410                <1>     je .ubpbCheckMedOk
   723 00000892 803BE9              <1>     cmp byte [rbx + oemHeader.jump], 0E9h       ;Near jump has no NOP
   724 00000895 740B                <1>     je .ubpbCheckMedOk
   725 00000897 803BEB              <1>     cmp byte [rbx + oemHeader.jump], 0EBh       ;Short jump has a NOP
   726 0000089A 7555                <1>     jne .ubpbOldDisk
   727 0000089C 807B0290            <1>     cmp byte [rbx + oemHeader.jump + 2], 090h   ;NOP should be here
   728 000008A0 754F                <1>     jne .ubpbOldDisk
   729                              <1> .ubpbCheckMedOk:
   730 000008A2 8A4315              <1>     mov al, byte [rbx + oemHeader_size + bpb.media] ;Get medbyte from BPB
   731 000008A5 E83A000000          <1>     call .checkMedByt   ;Check if it is 0F0h or geq 0F8h
   732 000008AA 7545                <1>     jnz .ubpbOldDisk    ;If it is not, don't trust the BPB. Read the FAT sector
   733                              <1> ;Now we do the pre DOS 3.2 single sided check and kludge.
   734 000008AC A801                <1>     test al, 1  ;Double sided bit set on media byte?
   735 000008AE 0F85B2000000        <1>     jnz .ubpbNormalDisk ;If set, proceed as normal.
   736                              <1> ;Here if we have a "single-sided" formatted media.
   737                              <1> ;Check the OEM string. We filter out SCPDOS disks first.
   738 000008B4 817B0353435044      <1>     cmp dword [rbx + oemHeader.oemString], "SCPD"
   739 000008BB 750C                <1>     jne .ubpbNotSCP
   740 000008BD 66817B074F53        <1>     cmp word [rbx + oemHeader.oemString + 4], "OS"
   741 000008C3 0F849D000000        <1>     je .ubpbNormalDisk
   742                              <1> .ubpbNotSCP:
   743                              <1> ;Now blind check version numbers for 16-bit DOS OEM strings.
   744                              <1> ;Search for DOS 2.0, 3.1 and 3.2. These versions have ID's such that 
   745                              <1> ; the version number starts at position 5.
   746                              <1> ;Usually, these BPBs have MSDOS or IBM<SPC><SPC> or OEM<SPC><SPC>
   747                              <1> ; as the OEM string. OEM stands for any three characters used by an
   748                              <1> ; OEM to identify disks they formatted, follows by "x.y" for a major
   749                              <1> ; and minor version number.
   750                              <1> ;Since we cannot enumerate all the OEM strings and can't guarantee
   751                              <1> ; that they have the bug, we will simply check the version number @
   752                              <1> ; position 5 in the string which seems to have been an unofficial 
   753                              <1> ; standard for placing the version number in the OEM string at the 
   754                              <1> ; time. 
   755                              <1> ;The dot in the check helps "guarantee" the number is a version number 
   756                              <1> ; we are possibly interested in.
   757 000008C9 66817B08332E        <1>     cmp word [rbx + oemHeader.oemString + 5], "3."  ;DOS 3?
