   786                              <1> ;Here if we have a "single-sided" formatted media.
   787                              <1> ;Check the OEM string. We filter out SCPDOS disks first.
   788 000008B7 817B0353435044      <1>     cmp dword [rbx + oemHeader.oemString], "SCPD"
