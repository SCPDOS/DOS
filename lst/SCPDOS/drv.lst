   903 000009F8 0FB75303            <1>     movzx edx, word [rbx + bpb.revdSecCnt]
   904 000009FC 01C1                <1>     add ecx, eax    ;ecx = (BPB_NumFATs * FATSz) + RootDirSectors
   905 000009FE 01D1                <1>     add ecx, edx    ;ecx = (BPB_ResvdSecCnt + ecx)
   906 00000A00 0FB74308            <1>     movzx eax, word [rbx + bpb.totSec16]
   907 00000A04 8B5315              <1>     mov edx, dword [rbx + bpb32.totSec32]
