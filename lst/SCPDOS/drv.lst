   250                              <1>     .TrackLayout:
   251                              <1> endstruc
   252                              <1> 
   253                              <1> ;Used for get and set params. Refer to DOS docs for meaning of bit.
   254                              <1> specFuncBPB equ 1<<0    ;Does BPB stuff
   255                              <1> ;The below two are only used in setparams requests. Ignored for getparams.
   256                              <1> specFuncTrk equ 1<<1    ;Set if just track layout cpy. Clear if set all.
   257                              <1> ;Note, if specFuncSec is not set, we fail the request. We also verify
   258                              <1> ; that all entries are the same and update the drvBlk wBpS field accordingly.
   259                              <1> specFuncSec equ 1<<2    ;Set if all sectors same size. Clear if not. 
   260                              <1> 
