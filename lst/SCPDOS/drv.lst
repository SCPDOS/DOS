  1711                              <1> .ioSetIds:
  1712                              <1> ;We get the BS from the disk, write the new metadata and write it
  1713                              <1> ; back to the disk. If the BS is not extended, we error exit with
  1714                              <1> ; unknown media error.
  1715                              <1> ;Input: rbp -> drvBlk
  1716                              <1> ;       rdx -> idParamBlk to set from
  1717 00000F7E 52                  <1>     push rdx    ;Save the ptr to the parameter block
  1718 00000F7F E860000000          <1>     call .ioGetSetSetup ;Return rbx -> Extended Bootsector structure
  1719 00000F84 5A                  <1>     pop rdx
  1720                              <1>     retc    ;If CF=CY, just return. Error info has been setup already
