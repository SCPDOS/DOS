  1551                              <1> .ioFormat:
  1552                              <1> ;DASD TEMP DASD TEMP DASD TEMP DASD TEMP DASD TEMP DASD TEMP DASD TEMP 
  1553                              <1> ;
  1554                              <1> ;We start by setting DASD parameters but for now we do nothing so just
  1555                              <1> ; clear the flag.
  1556 00000EB9 9C                  <1>     pushfq
  1557 00000EBA 668165377FFF        <1>     and word [rbp + drvBlk.wDevFlgs], ~devSetDASD
  1558 00000EC0 9D                  <1>     popfq
  1559                              <1> ;DASD TEMP DASD TEMP DASD TEMP DASD TEMP DASD TEMP DASD TEMP DASD TEMP 
  1560 00000EC1 756F                <1>     jnz .lbaFmt
  1561                              <1> ;Here for CHS format track.
  1562 00000EC3 BB00850000          <1>     mov ebx, 8500h  ;Format sectors
  1563 00000EC8 F60201              <1>     test byte [rdx + chsFormatBlock.bSpecFuncs], 1  ;If this bit clear do format
  1564 00000ECB 7404                <1>     jz .iochsFmtCmn
