  1946 00001231 E856000000          <1>     call .checkFATSame  ;Returns status in eax
  1947 00001236 85C0                <1>     test eax, eax       ;Set sign bit to exit via bad disk change exit
  1948 00001238 B800060000          <1>     mov eax, 0600h      ;Else, return Changeline detected (ah = 06h)
