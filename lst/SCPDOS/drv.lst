   552 00003A0A 3C07                <1>     cmp al, drvBadMed ;Bad Partition?
   553 00003A0C F9                  <1>     stc         ;Ensure we set the CF again
   554                              <1>     return
    13                              <2> %%_ret:
    14 00003A0D C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
