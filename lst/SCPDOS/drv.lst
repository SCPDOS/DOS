  1671                              <1> ;Now we setup the info in the BS we just read and write the BS back.
  1672                              <1> ;rbx points to the extBS structure
  1673 00000F85 B917000000          <1>     mov ecx, 4+11+8 ;Lengths of ID, Label and FS string 
  1674 00000F8A 488D7202            <1>     lea rsi, qword [rdx + idParamBlk.volId]
  1675 00000F8E 488D7B03            <1>     lea rdi, qword [rbx + extBs.volId]
  1676 00000F92 F3A4                <1>     rep movsb
  1677                              <1> ;Now write the bootsector back
  1678 00000F94 31C9                <1>     xor ecx, ecx    ;Write Sector 0...
  1679 00000F96 034D1B              <1>     add ecx, dword [rbp + drvBlk.dHiddSec]
  1680 00000F99 0FB65508            <1>     movzx edx, byte [rbp + drvBlk.bBIOSNum]
  1681 00000F9D 488D1D8F050000      <1>     lea rbx, .inBuffer  ;Use the in sector buffer.
  1682 00000FA4 BE05000000          <1>     mov esi, 5
  1683                              <1> .iosidLp:
  1684 00000FA9 B801830000          <1>     mov eax, 8301h  ;LBA Write function (write 1 sector)
  1685 00000FAE E853040000          <1>     call .callI33h
  1686 00000FB3 0F8388FBFFFF        <1>     jnc .bioExit   ;Setup the last access time and disk and return to caller
  1687                              <1> ;Here if an error. AH has the BIOS error code. Return with
  1688                              <1> ; ZF=ZE to indicate we are returning a BIOS code!
  1689 00000FB9 E8B0FBFFFF          <1>     call .bioReset  ;Reset the drive. Saves error code in ah
  1690 00000FBE FFCE                <1>     dec esi
  1691 00000FC0 75E7                <1>     jnz .iosidLp
  1692                              <1> ;Exit by translating BIOS error to DOS error and putting it in the reqpkt.
  1693                              <1> ; We return to the caller directly. The rest call sets the last drive to -1.
  1694                              <1> ; Dont update time fields.
  1695 00000FC2 E9BBF6FFFF          <1>     jmp .errorXlat 
