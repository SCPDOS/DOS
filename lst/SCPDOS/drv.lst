   809 000008D4 807B0A32            <1>     cmp byte [rbx + oemHeader.oemString + 7], "2"   ;DOS 3.2?
   810 000008D8 0F838B000000        <1>     jae .ubpbNormalDisk ;If above or equal 3.2, no need for adjustment.
   811                              <1> .ubpbAdjustSPC:
   812                              <1> ;Here we must be pre 16-bit DOS 3.2. Adjust the BPB in memory to have 
   813                              <1> ; a spc value of 1.
   814 000008DE C6430D01            <1>     mov byte [rbx + oemHeader_size + bpb.secPerClus], 1
   815 000008E2 E982000000          <1>     jmp .ubpbNormalDisk ;Now proceed as a normal disk
