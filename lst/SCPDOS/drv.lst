   141 0000357B CD21                <1>     int 21h
   142                              <1> 
   143 0000357D B833350000          <1>     mov eax, 3533h  ;Get original Int 33h
   144 00003582 CD21                <1>     int 21h
   145 00003584 48891D51CFFFFF      <1>     mov qword [i33Org], rbx
   146 0000358B 48891D5ACFFFFF      <1>     mov qword [i33Next], rbx    ;This is also the low level handler
   147 00003592 B833250000          <1>     mov eax, 2533h  ;Setup our handler
   148 00003597 488D1578CFFFFF      <1>     lea rdx, dosInt33h
   149 0000359E CD21                <1>     int 21h
   150                              <1> 
   151 000035A0 B82F350000          <1>     mov eax, 352Fh  ;Get previous Int 2Fh handler
   152 000035A5 CD21                <1>     int 21h
   153 000035A7 48891D36CFFFFF      <1>     mov qword [i2FNext], rbx
   154 000035AE B82F250000          <1>     mov eax, 252Fh
   155 000035B3 488D15D7CFFFFF      <1>     lea rdx, i2fhSwap33h
   156 000035BA CD21                <1>     int 21h
   157                              <1> 
   158                              <1> 
   159                              <1> ;Then set up the link pointers to the load address of the 
   160                              <1> ; drive table.
   161 000035BC B919000000          <1>     mov ecx, drvBlkTblL - 1
   162 000035C1 488D2D33F0FFFF      <1>     lea rbp, msdDriver.drvBlkTbl      ;Point to the first drive block
   163 000035C8 4889EE              <1>     mov rsi, rbp
   164                              <1> .dskTblLp:
   165 000035CB 4889F7              <1>     mov rdi, rsi            ;Mov current block to current block
