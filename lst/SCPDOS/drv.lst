  1092                              <1> .ioDoErr:
  1093                              <1> ;Come here if after an error in block IO handler.
  1094                              <1> ;If ZF=ZE, disk error occured, the error needs translation so do it.
  1095                              <1> ;Else just return the error code in al
  1096 00000ACF 0F84ADFBFFFF        <1>     jz .errorXlat
  1097 00000AD5 E93CFCFFFF          <1>     jmp .errorExit
