   835 00000966 4881C30B000000      <1>     add rbx, oemHeader_size ;Now point rbx to the BPB itself
   836                              <1> ;Update the drvBlk with info from the BPB.
   837                              <1> ;rbx points to the disk BPB. May be bad so we need to ensure the values 
   838                              <1> ; are ok before updating the msdTbl entry. 
