  2362                              <1> .ioTrackTbl:
  2363                              <1> ;Track table. In theory, used for formatting only.
  2364                              <1> ; In practise, we dont use it at all as we only allow for media where all 
  2365                              <1> ; sectors on a ``track'' have the same size. Find me a memory stick
  2366                              <1> ; with variable sector sizes...
  2367                              <1> ;
  2368                              <1> ;First entry is just a word with the number of entries
  2369                              <1> ; following. Then each row of the table is as defined below.
  2370                              <1> ;Only needed for removable devices with sectors on a track are of different size. 
  2371                              <1> ;We dont support these so this logic might just be eliminated.
  2372 0000144A 3F00                <1>     dw maxTrackTblSz    ;Have a maximum of 63 sectors per track
  2373                              <1> ;Each row is four bytes:
  2374                              <1> ;Track number, Head number (0 based), Sector number, Sector size
  2375                              <1> ; Sector size is a code 0-5 defined as
  2376                              <1> ; 0 =  128 bytes
  2377                              <1> ; 1 =  256 bytes
  2378                              <1> ; 2 =  512 bytes
  2379                              <1> ; 3 = 1024 bytes
  2380                              <1> ; 4 = 2048 bytes (invalid)
  2381                              <1> ; 5 = 4096 bytes 
  2382                              <1>     %push
  2383                              <1>     %assign i 1
  2384                              <1>         %rep (maxTrackTblSz + 1)
  2385                              <1>         db 0, 0, i, 2
  2386                              <1>             %assign i i+1
  2387                              <1>         %endrep
