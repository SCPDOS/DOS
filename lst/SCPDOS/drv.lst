  2531                              <1> .drvBlkTbl:
  2532                              <1> ;All drives start with Sectors/Cluster as -1 to indicate not initialised.
  2533                              <1> ;All drives start with Media Descripter as 0 (invalid type)
  2534                              <1> ;All drives start with dAccTime at -1 to force "uncertain" read for remdevs
  2535                              <1> ;All drives present 63 Cylinders (only valid as a field on fixed disks)
  2536                              <1> ;All drives have as an alt BPB, a 1.44Mb 3.5" Floppy.
  2537                              <1>     %assign i 0
  2538                              <1>     %rep drvBlkTblL
  2539                              <1>     istruc drvBlk
  2540                              <1>         at .pLink,      dq -1   ;End of table marker
  2541                              <1>         at .bBIOSNum,   db i    ;DOS drive number
  2542                              <1>         at .bDOSNum,    db i    ;BIOS drives default to removable
  2543                              <1> ;Do a FAT12/16 BPB in FAT32 format
  2544                              <1>         at .wBpS,       dw 200h
  2545                              <1>         at .bSpC,       db -1       
  2546                              <1>         at .wResC,      dw 0001h
  2547                              <1>         at .bNumFAT,    db 02h
