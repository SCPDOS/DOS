  2193 000012C0 09D1                <1>     or ecx, edx ;Store the current time count into ecx
  2194 000012C2 84C0                <1>     test al, al ;Are we rolling over? al tells us how many days...
  2195 000012C4 740E                <1>     jz .stStore
  2196 000012C6 0FB6C0              <1>     movzx eax, al
  2197 000012C9 51                  <1>     push rcx    ;Save the current time count
  2198 000012CA B9B0001800          <1>     mov ecx, 1800B0h    ;A single day's worth of ticks at 55ms
  2199 000012CF F7E1                <1>     mul ecx
  2200 000012D1 59                  <1>     pop rcx
  2201 000012D2 01C1                <1>     add ecx, eax        ;Add "al" worth of ticks at 55ms to ecx :)
