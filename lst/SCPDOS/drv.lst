  1838                              <1> .ioTrackTbl:
  1839                              <1> ;Table. First entry is just a word with the number of entries
  1840                              <1> ; following. Then each row of the table is as defined below.
  1841                              <1> ;Only needed for removable devices. Currently set to 63 but in principle, 
  1842                              <1> ; allow, eventually, up to 255.
  1843 00001081 3F00                <1>     dw maxTrackTblSz    ;Have a maximum of 63 sectors per track
  1844                              <1> ;Each row is four bytes:
  1845                              <1> ;Track number, Head number (0 based), Sector number, Sector size
  1846                              <1> ; Sector size is a code 0-3 defined as
  1847                              <1> ; 0 =  128 bytes
  1848                              <1> ; 1 =  256 bytes
  1849                              <1> ; 2 =  512 bytes
  1850                              <1> ; 3 = 1024 bytes
  1851                              <1>     %push
  1852                              <1>     %assign i 1
  1853                              <1>         %rep (maxTrackTblSz + 1)
  1854                              <1>         db 0, 0, i, 2
  1855                              <1>             %assign i i+1
  1856                              <1>         %endrep
