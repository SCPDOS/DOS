   630                              <1> growDirectory:
   631                              <1> ;Input: dword [dirClustPar] must have the first cluster number of the directory
   632                              <1> ;Output: CF=NC => All ok, directory grew by 1 sector
   633                              <1> ;                 eax = New Cluster number
   634                              <1> ;               TWO NON CF ERROR CASES.
   635                              <1> ;               If eax = -1 => disk full!
   636                              <1> ;               If eax = 0 => Trying to grow FAT12/16 root dir. Bad.
   637                              <1> ;        CF=CY => Something went wrong. Rip. 
   638 000024F5 53                  <1>     push rbx
   639 000024F6 51                  <1>     push rcx
   640 000024F7 57                  <1>     push rdi
   641 000024F8 8B05(AC070000)      <1>     mov eax, dword [dirClustPar]    ;Get first cluster for directory
   642 000024FE 85C0                <1>     test eax, eax
   643 00002500 742B                <1>     jz .exit
   644 00002502 E80BE6FFFF          <1>     call getLastClusterInChain  ;Get last cluster in chain in eax
   645 00002507 89C3                <1>     mov ebx, eax    ;Setup last cluster value in ebx
   646 00002509 B901000000          <1>     mov ecx, 1  ;Allocate one more cluster
   647 0000250E E87EE6FFFF          <1>     call allocateClusters   ;ebx has last cluster value
   648 00002513 7218                <1>     jc .exit
   649 00002515 3DFFFFFFFF          <1>     cmp eax, -1 ;Disk full?
   650 0000251A 7411                <1>     je .exit
   651 0000251C 89D8                <1>     mov eax, ebx    ;Walk this next cluster value to get new cluster value
   652 0000251E E853E8FFFF          <1>     call readFAT
   653 00002523 7208                <1>     jc .exit
   654 00002525 E807000000          <1>     call sanitiseCluster    ;Preserves all regs, sanitises the cluster for use
   655 0000252A 7201                <1>     jc .exit
   656 0000252C F8                  <1>     clc
   657                              <1> .exit:
   658 0000252D 5F                  <1>     pop rdi
   659 0000252E 59                  <1>     pop rcx
   660 0000252F 5B                  <1>     pop rbx
   661                              <1>     return   
    13                              <2> %%_ret:
    14 00002530 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   662                              <1> sanitiseCluster:
   663                              <1> ;Sanitises the cluster in eax to all zeros
   664                              <1> ;Does not move file pointers
   665                              <1> ;Currently, is only called to sanitise subdirectory clusters
   666                              <1> ;Input: eax = Cluster number
   667                              <1> ;       qword [workingDPB] = DPB of drive whose cluster we are sanitising
   668                              <1> ;Output: If CF=NC => eax = Sanitised Cluster number
   669                              <1> ;        If CF=CY => Error, exit
   670 00002531 50                  <1>     push rax
   671 00002532 53                  <1>     push rbx
   672 00002533 51                  <1>     push rcx
   673 00002534 52                  <1>     push rdx
   674 00002535 56                  <1>     push rsi
   675 00002536 55                  <1>     push rbp
   676 00002537 488B2D(3B070000)    <1>     mov rbp, qword [workingDPB]
   677 0000253E E8A2E5FFFF          <1>     call getStartSectorOfCluster    ;Needs DPB in rbp
   678 00002543 0FB65504            <1>     movzx edx, byte [rbp + dpb.bMaxSectorInCluster] 
   679 00002547 FFC2                <1>     inc edx ;Make it a count of sectors
   680                              <1> .getSectorInCluster:
   681 00002549 E810E5FFFF          <1>     call getBufForDir  ;Get a generic data buffer in rbx
   682 0000254E 721E                <1>     jc .exitBad
   683 00002550 488D7B20            <1>     lea rdi, qword [rbx + bufferHdr.dataarea]
   684 00002554 0FB74D02            <1>     movzx ecx, word [rbp + dpb.wBytesPerSector]
   685 00002558 31C0                <1>     xor eax, eax
   686 0000255A F3AA                <1>     rep stosb   ;Store one sectorful of zeros
   687 0000255C E8A9E3FFFF          <1>     call markBufferDirty ;We wrote to this buffer
   688                              <1> 
   689 00002561 FFCA                <1>     dec edx     ;One less sector in the cluster to sanitise!
   690 00002563 740A                <1>     jz .exit    ;Jump if we done
   691 00002565 488B430A            <1>     mov rax, qword [rbx + bufferHdr.bufferLBA] ;Get current sector number
   692 00002569 48FFC0              <1>     inc rax ;Goto next sector in cluster
   693 0000256C EBDB                <1>     jmp short .getSectorInCluster
   694                              <1> .exitBad:
   695 0000256E F9                  <1>     stc
   696                              <1> .exit:
   697 0000256F 5D                  <1>     pop rbp
   698 00002570 5E                  <1>     pop rsi
   699 00002571 5A                  <1>     pop rdx
   700 00002572 59                  <1>     pop rcx
   701 00002573 5B                  <1>     pop rbx
   702 00002574 58                  <1>     pop rax
