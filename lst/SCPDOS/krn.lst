    61 00008440 D1E1                <1>     shl ecx, 1   ;multiply by 2
    62 00008442 48FFC3              <1>     inc rbx         ;Go past the first byte (length count)
    63 00008445 0FB71C0B            <1>     movzx ebx, word [rbx + rcx] ;Get the word at this address
    64 00008449 59                  <1>     pop rcx ;Get the EA of the displacement table in rcx
