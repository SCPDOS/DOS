    29 00003172 4889D6              <1>     mov rsi, rdx
    30 00003175 803EFF              <1>     cmp byte [rsi], -1
    31 00003178 7507                <1>     jne .notExt1
    32 0000317A 4881C607000000      <1>     add rsi, exFcb.driveNum
    33                              <1> .notExt1:
    34 00003181 0FB606              <1>     movzx eax, byte [rsi]
    35 00003184 50                  <1>     push rax    ;Push on stack the drive number
    36 00003185 488D3D(50050000)    <1>     lea rdi, buffer1    ;Use buffer 1 to build path in
    37 0000318C E837030000          <1>     call fcbInitRoutine ;Build path and canonicaliseFilename
    38 00003191 7306                <1>     jnc .fcbOk
    39 00003193 5B                  <1>     pop rbx ;Just pop into next reg to preserve error code
    40 00003194 E9614B0000          <1>     jmp fcbErrExit
    41                              <1> .fcbOk:
    42 00003199 488D3D(50050000)    <1>     lea rdi, buffer1
    43 000031A0 E837E4FFFF          <1>     call getFilePathNoCanon ;Now hit disk for this file
    44 000031A5 7306                <1>     jnc .fileFound
    45 000031A7 5B                  <1>     pop rbx
    46 000031A8 E94D4B0000          <1>     jmp fcbErrExit
    47                              <1> .fileFound:
    48                              <1> ;Now we build an FFBlock internally
