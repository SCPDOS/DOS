  2936 000053E3 8B471B              <1>     mov eax, dword [rdi + sft.dCurntOff] ;Update cur. offset if it was changed
  2937 000053E6 8905(98070000)      <1>     mov dword [currByteF], eax
  2938 000053EC 488B6F07            <1>     mov rbp, qword [rdi + sft.qPtr] ;Get DPB ptr in rbp
