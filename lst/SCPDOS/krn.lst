   354                              <1> readSectorBuffer:   ;Internal Linkage
   355                              <1> ;Reads a sector into a built sector buffer
   356                              <1> ;Entry: 
   357                              <1> ; rbx = qword ptr: Buffer area to read into.
   358                              <1> ; rcx = byte: Buffer flags.
