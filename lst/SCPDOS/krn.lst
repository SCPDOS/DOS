   381                              <1> truncateFAT:
   382                              <1> ;Same as below but always sets the cluster we are unlinking at to EOC.
   383                              <1> ;Input: eax = Cluster to start unlinking at (zero extended to 32 bits)
   384                              <1> ;       rbp = Current DPB to use for disk
   385                              <1> ;Output: CF = NC => All ok. CF = CY => Hard Error, exit
   386 00000D15 50                  <1>     push rax    ;Save the cluster number to start unlinking at
   387 00000D16 56                  <1>     push rsi
   388 00000D17 E82B000000          <1>     call freeChainFAT   ;Preserves eax, frees the full chain.
   389 00000D1C 721B                <1>     jc .exit
   390 00000D1E BEFFFFFFFF          <1>     mov esi, -1         ;Realloc the cluster we are freeing from as EOC
   391 00000D23 50                  <1>     push rax            ;Save the cluster we are writing at
   392 00000D24 E8F9000000          <1>     call writeFAT
   393 00000D29 58                  <1>     pop rax
   394 00000D2A 720D                <1>     jc .exit
   395 00000D2C E8D1010000          <1>     call decrementFreeClusterCount  ;Remove it from the free cluster count!
   396                              <1> .setFree:
   397                              <1> ;Do this stuff here, because we want to update the free count too!
   398 00000D31 89452D              <1>     mov dword [rbp + dpb.dNextFreeClst], eax ;And set this to search from
   399 00000D34 E874020000          <1>     call writeFSInfoSector  ;New first free cluster values
   400                              <1> .exit:
   401 00000D39 5E                  <1>     pop rsi
   402 00000D3A 58                  <1>     pop rax
   403                              <1>     return
    13                              <2> %%_ret:
    14 00000D3B C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   404                              <1> unlinkFAT:
   405                              <1> ;Given a cluster number, will free the cluster and walk the FAT until the first
   406                              <1> ; cluster number considered EOC is found. The given cluster number MUST be
   407                              <1> ; the start cluster of a chain, or at least the cluster linking to the given
   408                              <1> ; cluster must be set to EOC before this proc is called.
   409                              <1> ;Stops at first invalid cluster number.
   410                              <1> ;
   411                              <1> ;Input: eax = Cluster to start unlinking at (zero extended to 32 bits)
   412                              <1> ;       rbp = Current DPB to use for disk
   413                              <1> ;Output: CF = NC => All ok. CF = CY => Hard Error, exit
   414                              <1> 
   415 00000D3C 50                  <1>     push rax    ;Save the cluster number to start unlinking at
   416 00000D3D 56                  <1>     push rsi
   417                              <1> ;The below call decrements the cluster count for the full chain freed including
   418                              <1> ; the starting cluster address.
   419 00000D3E E804000000          <1>     call freeChainFAT    ;Preserved eax. May set eax to first free cluster.
   420 00000D43 73EC                <1>     jnc truncateFAT.setFree ;Set the first free sector to eax
   421 00000D45 EBF2                <1>     jmp short truncateFAT.exit  ;If an error, skip updating the FSInfo sector
   422                              <1> 
   423                              <1> freeChainFAT:
   424                              <1> ;Given a cluster number, will set that cluster to EOC and walk the FAT freeing 
   425                              <1> ; each cluster until the firstcluster number considered EOC is found. The given 
   426                              <1> ; cluster number MUST be the start cluster of a chain, or at least the cluster 
   427                              <1> ; linking to the given cluster must be set to EOC before this proc is called.
   428                              <1> ;Stops at first invalid cluster number.
   429                              <1> ;
   430                              <1> ;Input: eax = Cluster to start unlinking at (zero extended to 32 bits)
   431                              <1> ;       rbp = Current DPB to use for disk
   432                              <1> ;Output: CF = NC => All ok. CF = CY => Hard Error, exit
   433 00000D47 50                  <1>     push rax
   434 00000D48 53                  <1>     push rbx
   435 00000D49 51                  <1>     push rcx
   436 00000D4A 56                  <1>     push rsi
   437 00000D4B 89C3                <1>     mov ebx, eax    ;Store the current cluster we are at in ebx
   438                              <1> .lp:
   439 00000D4D E824000000          <1>     call readFAT    ;Get the value of the cluster at this location in eax
   440 00000D52 721D                <1>     jc .exit    ;Error exit
   441 00000D54 89C1                <1>     mov ecx, eax   ;Move chain marker to ecx
   442 00000D56 93                  <1>     xchg eax, ebx  ;Move clust. to write at in eax and save next cluster in ebx
   443 00000D57 31F6                <1>     xor esi, esi   ;Free cluster at eax (write a 0)
   444 00000D59 E8C4000000          <1>     call writeFAT
   445 00000D5E 7211                <1>     jc .exit    ;Error exit
   446 00000D60 E88E010000          <1>     call incrementFreeClusterCount  ;Successfully freed the cluster
   447 00000D65 81F9FFFFFFFF        <1>     cmp ecx, -1 ;End of chain?
   448 00000D6B 7404                <1>     je .exit
   449 00000D6D 89D8                <1>     mov eax, ebx    ;Move next cluster into eax
   450 00000D6F EBDC                <1>     jmp short .lp
   451                              <1> .exit:
   452 00000D71 5E                  <1>     pop rsi
   453 00000D72 59                  <1>     pop rcx
   454 00000D73 5B                  <1>     pop rbx
   455 00000D74 58                  <1>     pop rax
   456                              <1>     return
    13                              <2> %%_ret:
    14 00000D75 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   457                              <1> readFAT:
   458                              <1> ;Given a cluster number, it gives us the next cluster in the cluster chain
   459                              <1> ; or -1 to indicate end of cluster chain on the device with workingDPB
   460                              <1> ;Input: eax = Cluster number (zero extended to 32 bits)
   461                              <1> ;       rbp = DPB
   462                              <1> ;Output: eax = Next Cluster number (-1 indicates end of chain)
   463                              <1> ;If carry set, getBuffer failed!
   464 00000D76 53                  <1>     push rbx
   465 00000D77 51                  <1>     push rcx
   466 00000D78 52                  <1>     push rdx
   467 00000D79 57                  <1>     push rdi
   468 00000D7A 55                  <1>     push rbp
   469 00000D7B 89C7                <1>     mov edi, eax    ;Save cluster number in edi
   470 00000D7D E817FDFFFF          <1>     call clust2FATEntry ;Returns sector in FAT in eax, offset in sector in edx
   471                              <1>     ;and FAT type in ecx
   472 00000D82 E8D2FCFFFF          <1>     call getBufForFat ;Buffer Header in ebx, first buffer being requested
   473 00000D87 7232                <1>     jc .exitFail
   474                              <1>     ;Check if FAT 12, 16, 32
   475 00000D89 85C9                <1>     test ecx, ecx
   476 00000D8B 7434                <1>     jz .gotoNextClusterFat12    ;Handle FAT 12 separately
   477 00000D8D F7C101000000        <1>     test ecx, 1
   478 00000D93 740E                <1>     jz .goToNextClusterFat32
   479                              <1>     ;Here we handle FAT16
   480 00000D95 0FB7441320          <1>     movzx eax, word [rbx + bufferHdr.dataarea + rdx]
   481 00000D9A 3DF7FF0000          <1>     cmp eax, 0FFF7h  ;Valid cluster number?
   482 00000D9F 7219                <1>     jb .exit
   483 00000DA1 EB0B                <1>     jmp short .eocExit
   484                              <1> .goToNextClusterFat32:
   485 00000DA3 8B441320            <1>     mov eax, dword [rbx + bufferHdr.dataarea + rdx]
   486 00000DA7 3DF7FFFF0F          <1>     cmp eax, 0FFFFFF7h ;First reserved value. Any Reserved number = EOC
   487 00000DAC 7207                <1>     jb .validCluster32   
   488                              <1> .eocExit:
   489 00000DAE B8FFFFFFFF          <1>     mov eax, -1 ;Always translate it to -1 and skip zeroing upper nybble
   490 00000DB3 EB05                <1>     jmp short .exit
   491                              <1> .validCluster32:
   492 00000DB5 25FFFFFF0F          <1>     and eax, 0FFFFFFFh  ;Zero upper nybble
   493                              <1> .exit:
   494 00000DBA F8                  <1>     clc
   495                              <1> .exitFail:
   496 00000DBB 5D                  <1>     pop rbp
   497 00000DBC 5F                  <1>     pop rdi
   498 00000DBD 5A                  <1>     pop rdx
   499 00000DBE 59                  <1>     pop rcx
   500 00000DBF 5B                  <1>     pop rbx
   501                              <1>     return
    13                              <2> %%_ret:
    14 00000DC0 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   502                              <1> .gotoNextClusterFat12:
   503                              <1> ;eax has the sector number of the FAT
   504                              <1> ;edx has byte offset into the sector
   505                              <1> ;edi has current cluster number
   506                              <1> ;rbx has ptr to buffer header
   507 00000DC1 0FB74D02            <1>     movzx ecx, word [rbp + dpb.wBytesPerSector]
   508 00000DC5 F7C701000000        <1>     test edi, 1  ;Check if cluster is odd
   509 00000DCB 741C                <1>     jz .gotoNextClusterFat12Even
   510                              <1>     ;Here the cluster is ODD, and might cross sector boundary
   511 00000DCD 29D1                <1>     sub ecx, edx
   512 00000DCF FFC9                <1>     dec ecx ;If edx = BytesPerSector - 1 then it crosses, else no
   513 00000DD1 750C                <1>     jnz .gotoNextClusterFat12OddNoX
   514 00000DD3 E833000000          <1>     call .xBndry        ;Boundary cross, build entry properly
   515 00000DD8 72E1                <1>     jc .exitFail    
   516 00000DDA C1E804              <1>     shr eax, 4   ;Save upper three nybbles of loword, eax has cluster num
   517 00000DDD EB23                <1>     jmp short .checkIfLastFAT12Cluster
   518                              <1> .gotoNextClusterFat12OddNoX:
   519 00000DDF 0FB7441320          <1>     movzx eax, word [rbx + bufferHdr.dataarea + rdx]    ;Read the entry
   520 00000DE4 C1E804              <1>     shr eax, 4   ;Save upper three nybbles of loword, eax has cluster num
   521 00000DE7 EB19                <1>     jmp short .checkIfLastFAT12Cluster
   522                              <1> .gotoNextClusterFat12Even:
   523 00000DE9 29D1                <1>     sub ecx, edx
   524 00000DEB FFC9                <1>     dec ecx ;If edx = BytesPerSector - 1 then it crosses, else no
   525 00000DED 7509                <1>     jnz .gotoNextClusterFat12EvenNoX
   526 00000DEF E817000000          <1>     call .xBndry    ;Save the lower three nybbles
   527 00000DF4 72C5                <1>     jc .exitFail
   528 00000DF6 EB05                <1>     jmp short .evenCmn
   529                              <1> .gotoNextClusterFat12EvenNoX:
   530                              <1>     ;Here the cluster is even and can't cross a sector boundary
   531 00000DF8 0FB7441320          <1>     movzx eax, word [rbx + bufferHdr.dataarea + rdx]    ;Read the entry
   532                              <1> .evenCmn:
   533 00000DFD 25FF0F0000          <1>     and eax, 0FFFh   ;Save lower three nybbles, eax has cluster num
   534                              <1> .checkIfLastFAT12Cluster:
   535 00000E02 3DF70F0000          <1>     cmp eax, 0FF7h   ;Is it below the first invalid cluster number?
   536 00000E07 72B1                <1>     jb .exit         ;If so, exit with it in eax (and clear CF)
   537 00000E09 EBA3                <1>     jmp short .eocExit
   538                              <1> .xBndry:
   539                              <1> ;Gets a word that goes across a boundary in ax. It is left to the caller it 
   540                              <1> ; do what they will with it. If CF=CY on return, something went wrong.
   541 00000E0B 0FB65C1320          <1>     movzx ebx, byte [rbx + bufferHdr.dataarea + rdx] ;Use ebx as it is free
   542 00000E10 FFC0                <1>     inc eax ;Get next FAT sector
   543 00000E12 53                  <1>     push rbx
   544 00000E13 E841FCFFFF          <1>     call getBufForFat ;Get buffer Header in ebx
   545 00000E18 59                  <1>     pop rcx ;Get bl in ecx, the last entry from the previous buffer
   546                              <1>     retc
