   283                              <1> findFreeClusterData:
   284                              <1> ;Walks the FAT to find a free cluster and returns the 
   285                              <1> ;   zero extended cluster number in eax (-1 means no free cluster)
   286                              <1> ; Also finds NumberOfFreeClusters, if it is unknown. 
   287                              <1> ; Both fields get filled in the workingDPB
   288                              <1> ;Works on the workingDPB
   289                              <1> ;If returns with CF=CY => Fail set, return immediately to caller
   290 00000C3D 53                  <1>     push rbx
   291 00000C3E 51                  <1>     push rcx
   292 00000C3F 52                  <1>     push rdx
   293 00000C40 55                  <1>     push rbp
   294 00000C41 488B2D(3B070000)    <1>     mov rbp, qword [workingDPB]
   295 00000C48 E82DFEFFFF          <1>     call getFATtype
   296 00000C4D 81F902000000        <1>     cmp ecx, 2  ;If not FAT32, always get afresh
   297 00000C53 7512                <1>     jne .getNew
   298                              <1>     ;Else, if either entry is unknown, get both!
   299 00000C55 817D31FFFFFFFF      <1>     cmp dword [rbp + dpb.dFreeClustCnt], -1
   300 00000C5C 7409                <1>     je .getNew
   301 00000C5E 817D2DFFFFFFFF      <1>     cmp dword [rbp + dpb.dNextFreeClst], -1
   302 00000C65 7542                <1>     jne .exit
   303                              <1> .getNew:
   304                              <1>     ;Reset this data. Get first free cluster
   305 00000C67 C7452DFFFFFFFF      <1>     mov dword [rbp + dpb.dNextFreeClst], -1
   306 00000C6E C74531FFFFFFFF      <1>     mov dword [rbp + dpb.dFreeClustCnt], -1
   307 00000C75 E863FFFFFF          <1>     call findFreeCluster
   308 00000C7A 7236                <1>     jc .exitFail
   309 00000C7C C7453100000000      <1>     mov dword [rbp + dpb.dFreeClustCnt], 0  ;Set to 0 for new count
   310 00000C83 3DFFFFFFFF          <1>     cmp eax, -1 ;First free cluster = -1 means disk full!
   311 00000C88 741F                <1>     je .exit
   312                              <1>     ;Else, eax has the first free cluster. Keep reading FAT
   313 00000C8A 89C3                <1>     mov ebx, eax    ;Save the cluster number
   314 00000C8C EB0D                <1>     jmp short .incGo
   315                              <1> .lp:
   316 00000C8E 89C3                <1>     mov ebx, eax    ;Save the cluster number
   317 00000C90 E8E1000000          <1>     call readFAT    ;Get dereferenced value in eax
   318 00000C95 721B                <1>     jc .exitFail
   319 00000C97 85C0                <1>     test eax, eax
   320 00000C99 7505                <1>     jnz .notFree
   321                              <1> .incGo:
   322 00000C9B E853020000          <1>     call incrementFreeClusterCount  ;Increment the count!
   323                              <1> .notFree:
   324 00000CA0 678D4301            <1>     lea eax, dword [ebx + 1]    ;Get the next consecutive cluster
   325 00000CA4 3B450F              <1>     cmp eax, dword [rbp + dpb.dMaxClusterAddr]
   326 00000CA7 76E5                <1>     jbe .lp
   327                              <1> .exit:
   328 00000CA9 8B452D              <1>     mov eax, dword [rbp + dpb.dNextFreeClst]  ;Get first free cluster in eax
   329 00000CAC E8FC020000          <1>     call writeFSInfoSector
   330 00000CB1 F8                  <1>     clc
   331                              <1> .exitFail:      ;Keep carry flag
   332 00000CB2 5D                  <1>     pop rbp
   333 00000CB3 5A                  <1>     pop rdx
   334 00000CB4 59                  <1>     pop rcx
   335 00000CB5 5B                  <1>     pop rbx
   336                              <1>     return
    13                              <2> %%_ret:
    14 00000CB6 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
