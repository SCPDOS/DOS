   232                              <1> .getInterInfo:
   233 00006BB2 81F909000000        <1>     cmp ecx, 9  ;Is our buffer of minimum acceptable size?
   234 00006BB8 7250                <1>     jb .invFuncExit
   235 00006BBA 488D353996FFFF      <1>     lea rsi, dosNLSPtr
   236 00006BC1 6681FAFFFF          <1>     cmp dx, -1
   237 00006BC6 660F4415A896FFFF    <1>     cmove dx, word [extCtryTbl.countryCode] ;Get the current country code
   238 00006BCE 6681FBFFFF          <1>     cmp bx, -1
