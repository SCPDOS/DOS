   907 00003EF2 B857000000          <1>     mov eax, errBadParam
   908 00003EF7 E91E3E0000          <1>     jmp extErrExit
   909                              <1> .okStart:
   910 00003EFC 84D2                <1>     test dl, dl                 ;Are we a fail if exist and dont exist?
   911 00003EFE 74F2                <1>     jz .badParmExit
   912 00003F00 66F7C2ECFF          <1>     test dx, ~(eoActCreate | eoActOpen | eoActTruncate)
   913 00003F05 75EB                <1>     jnz .badParmExit    ;If set any bits we are not allowed to set, fail!
   914 00003F07 80E203              <1>     and dl, eoActOpen | eoActTruncate   ;Isolate the file exist bits
   915 00003F0A 80FA03              <1>     cmp dl, eoActOpen | eoActTruncate   ;They cannot both be set
   916 00003F0D 74E3                <1>     je .badParmExit     
   917                              <1> ;Test to check if the force fail bit is set
