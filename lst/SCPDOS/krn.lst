   117 000032B6 0F831AFFFFFF        <1>     jnc findFirstFileFCB.fileFound  ;Go build a new FFBlock for the found file
   118 000032BC 488B3D(4B070000)    <1>     mov rdi, qword [workingFCB] ;If no more files or error, get working FCB ptr
   119 000032C3 F607FF              <1>     test byte [rdi], -1
   120 000032C6 7407                <1>     jz .notExt2
   121 000032C8 4881C707000000      <1>     add rdi, exFcb.driveNum
