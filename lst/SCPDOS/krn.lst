    79 0000725C 0A05(9A040000)      <1>     or al, byte [bI24OkBtfld]       ;Set the OK bits now
    80 00007262 8025(31070000)01    <1>     and byte [bRwFlag], 1           ;Save only the bottom bit
    81 00007269 0A05(31070000)      <1>     or al, byte [bRwFlag]           ;And get the read/write bit
    82 0000726F C1E008              <1>     shl eax, 8                      ;And put this byte into eax
    83                              <1> ;Now get the drive we failed on from the dpb 
    84 00007272 8A4500              <1>     mov al, byte [rbp + dpb.bDriveNumber]   ;Get the drive number
    85 00007275 48892D(CA070000)    <1>     mov qword [qErrRbp], rbp  ;Save the DPB 
    86 0000727C 488B751B            <1>     mov rsi, qword [rbp + dpb.qDriverHeaderPtr] ;And get the driver ptr in rsi
    87 00007280 E806000000          <1>     call hardErrorCommon
