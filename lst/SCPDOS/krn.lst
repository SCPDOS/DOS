   733                              <1> getPtrToEndOfEnvBlk:
   734                              <1> ;Gets ptr to end of an environment block by searching for the 
   735                              <1> ; double terminator in a region.
   736                              <1> ;Input: rdi -> Block to get the size of.
   737                              <1> ;Output:
   738                              <1> ;   ZF=ZE: Environment is bad. Is not double null terminated.
   739                              <1> ;   ZF=NZ: Environment is good. Is double null terminated.
   740                              <1> ;           rdi -> Second null byte of the terminator of the environment.
   741 00006E9C 50                  <1>     push rax
   742 00006E9D 51                  <1>     push rcx
   743 00006E9E B9FF7F0000          <1>     mov ecx, ENV_MAX
   744                              <1> ;Ensure we have a good environment, i.e. one that is double null terminated
   745                              <1> ; within the max range.
   746 00006EA3 31C0                <1>     xor eax, eax
   747                              <1> .pathNulScan:
   748 00006EA5 F2AE                <1>     repne scasb
   749 00006EA7 85C9                <1>     test ecx, ecx   ;If we are zero on first null, its an error
   750 00006EA9 7407                <1>     jz .badExit
   751 00006EAB 3807                <1>     cmp byte [rdi], al  ;Is char two null?
   752 00006EAD 75F6                <1>     jne .pathNulScan    ;If not, keep searching
   753 00006EAF 4D85C0              <1>     test r8, r8         ;Clear the ZF. PSP ptr can never be NULL :)
   754                              <1> .badExit:
   755 00006EB2 59                  <1>     pop rcx
   756 00006EB3 58                  <1>     pop rax
   757                              <1>     return
