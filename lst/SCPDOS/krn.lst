   630                              <1> growDirectory:
   631                              <1> ;Input: dword [dirClustPar] must have the first cluster number of the directory
   632                              <1> ;Output: CF=NC => All ok, directory grew by 1 sector
   633                              <1> ;                 eax = New Cluster number
   634                              <1> ;               TWO NON CF ERROR CASES.
   635                              <1> ;               If eax = -1 => disk full!
   636                              <1> ;               If eax = 0 => Trying to grow FAT12/16 root dir. Bad.
   637                              <1> ;        CF=CY => Something went wrong. Rip. 
   638 00002502 53                  <1>     push rbx
   639 00002503 51                  <1>     push rcx
   640 00002504 57                  <1>     push rdi
   641 00002505 8B05(AC070000)      <1>     mov eax, dword [dirClustPar]    ;Get first cluster for directory
   642 0000250B 85C0                <1>     test eax, eax
   643 0000250D 742B                <1>     jz .exit
   644 0000250F E80CE6FFFF          <1>     call getLastClusterInChain  ;Get last cluster in chain in eax
   645 00002514 89C3                <1>     mov ebx, eax    ;Setup last cluster value in ebx
   646 00002516 B901000000          <1>     mov ecx, 1  ;Allocate one more cluster
   647 0000251B E849E6FFFF          <1>     call allocateClusters   ;ebx has last cluster value
   648 00002520 7218                <1>     jc .exit
   649 00002522 3DFFFFFFFF          <1>     cmp eax, -1 ;Disk full?
   650 00002527 7411                <1>     je .exit
   651 00002529 89D8                <1>     mov eax, ebx    ;Walk this next cluster value to get new cluster value
   652 0000252B E81EE8FFFF          <1>     call readFAT
   653 00002530 7208                <1>     jc .exit
   654 00002532 E807000000          <1>     call sanitiseCluster    ;Preserves all regs, sanitises the cluster for use
   655 00002537 7201                <1>     jc .exit
   656 00002539 F8                  <1>     clc
   657                              <1> .exit:
   658 0000253A 5F                  <1>     pop rdi
   659 0000253B 59                  <1>     pop rcx
   660 0000253C 5B                  <1>     pop rbx
   661                              <1>     return   
