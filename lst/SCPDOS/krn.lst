   823                              <1> checkClusterValid:
   824                              <1> ;Checks the cluster number is valid. This should help prevent infinite loops
   825                              <1> ; when reading bad directory entries from corrupted disks.
   826                              <1> ;Input: eax = Cluster number to analyse (32 bits zero extended)
   827                              <1> ;       rbp -> DPB for the drive we are analysing.
   828                              <1> ;Output: ZF=ZE: Cluster number ok!
   829                              <1> ;        ZF=NZ: Cluster number not good.
   830                              <1> ;               CF=CY: If eax was 0 or 1, likely disk corruption.
   831                              <1> ;               CF=NC: If eax was past end of disk or max cluster (return EOC).
   832 00001038 51                  <1>     push rcx
   833 00001039 3D02000000          <1>     cmp eax, 2
   834 0000103E 7233                <1>     jb .exit
   835 00001040 E852FAFFFF          <1>     call getFATtype
   836 00001045 81F901000000        <1>     cmp ecx, 1
   837 0000104B 770B                <1>     ja .fat32Check
   838 0000104D 7212                <1>     jb .fat12Check
   839                              <1> ;fat16Check 
   840 0000104F 3DF5FF0000          <1>     cmp eax, fat16MaxClustCnt
   841 00001054 7212                <1>     jb .chkMax
   842 00001056 EB15                <1>     jmp short .exitBad    
   843                              <1> .fat32Check:
   844 00001058 3DF8FFFF0F          <1>     cmp eax, 0FFFFFF8h
   845 0000105D 7209                <1>     jb .chkMax
   846 0000105F EB0C                <1>     jmp short .exitBad
   847                              <1> .fat12Check:
   848 00001061 3DF50F0000          <1>     cmp eax, fat12MaxClustCnt
