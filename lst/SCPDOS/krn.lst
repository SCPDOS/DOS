    30 00003182 803EFF              <1>     cmp byte [rsi], -1
    31 00003185 7507                <1>     jne .notExt1
    32 00003187 4881C607000000      <1>     add rsi, exFcb.driveNum
    33                              <1> .notExt1:
    34 0000318E 0FB606              <1>     movzx eax, byte [rsi]
    35 00003191 50                  <1>     push rax    ;Push on stack the drive number
    36 00003192 488D3D(50050000)    <1>     lea rdi, buffer1    ;Use buffer 1 to build path in
    37 00003199 E830030000          <1>     call fcbInitRoutine ;Build path and canonicaliseFilename
    38 0000319E 7306                <1>     jnc .fcbOk
    39 000031A0 5B                  <1>     pop rbx ;Just pop into next reg to preserve error code
    40 000031A1 E9AD4A0000          <1>     jmp fcbErrExit
    41                              <1> .fcbOk:
    42 000031A6 488D3D(50050000)    <1>     lea rdi, buffer1
