  3203                              <1> syncVolLabel:
  3204                              <1> ;Used to sync volume labels when a new vol label made in DOS.
  3205                              <1> ;If the device doesn't support this function we just ignore it.
  3206                              <1> ;Fails therefore are ignored.
  3207                              <1> ;Input: fcbName = Volume Label name in FCB format
  3208                              <1> ;       bl = 0 : Create label
  3209                              <1> ;       bl = 1 : Delete label (reset to NO NAME and 0 time)
  3210                              <1> ;       al = 0 based drive to work on
  3211                              <1> ;Preserves all registers except rax and rbx (rbx saved externally)
  3212 000055B5 51                  <1>     push rcx
  3213 000055B6 52                  <1>     push rdx
  3214 000055B7 56                  <1>     push rsi
  3215 000055B8 57                  <1>     push rdi
  3216                              <1>     
  3217 000055B9 0FB6C0              <1>     movzx eax, al   ;Zero extend the rest code to rest of the register
  3218 000055BC FFC0                <1>     inc eax     ;Convert the 0 based drive number to a 1 based number
  3219 000055BE 50                  <1>     push rax    ;Save the 1 based drive number on the stack
  3220 000055BF 53                  <1>     push rbx    ;Save subfunction code
  3221                              <1> 
  3222 000055C0 89C3                <1>     mov ebx, eax    ;Save this number into eax
  3223 000055C2 B80D000000          <1>     mov eax, 0Dh    ;IOCTL Function code
  3224 000055C7 B966080000          <1>     mov ecx, 0866h  ;IOCTL GET LABEL PACKET
  3225 000055CC 488D15(691A0000)    <1>     lea rdx, labelPkt
  3226 000055D3 52                  <1>     push rdx    ;Save the ptr to the xfr packet
  3227 000055D4 E838000000          <1>     call ioctrl ;This call sets the working drive again to drive in bx
  3228 000055D9 5A                  <1>     pop rdx     ;Get xfr packet ptr back
  3229 000055DA 58                  <1>     pop rax     ;Get the subfunction code back in eax
  3230 000055DB 5B                  <1>     pop rbx     ;Get the 1 based drive number back into bl (ebl)
  3231 000055DC 722E                <1>     jc .exit
  3232 000055DE 85C0                <1>     test eax, eax   ;Check subfunction to do 
  3233 000055E0 7509                <1>     jnz .defaultLbl
  3234 000055E2 488D35(0B070000)    <1>     lea rsi, fcbName
  3235 000055E9 EB07                <1>     jmp short .makePkt
  3236                              <1> .defaultLbl:
  3237 000055EB 488D3528AAFFFF      <1>     lea rsi, dosDfltLbl
  3238                              <1> .makePkt:
  3239                              <1> ;rsi -> Source of 11 chars to copy over
  3240                              <1> ;bx = 1 based drive number to operate on
  3241                              <1> ;rdx -> Packet to work on
  3242 000055F2 488D7A06            <1>     lea rdi, qword [rdx + idParamBlk.volLab]    ;Point rdi here
  3243 000055F6 B90B000000          <1>     mov ecx, 11
  3244 000055FB F3A4                <1>     rep movsb
  3245 000055FD B946080000          <1>     mov ecx, 0846h  ;IOCTL SET LABEL PACKET
  3246 00005602 B80D000000          <1>     mov eax, 0Dh    ;IOCTL Function code
  3247 00005607 E805000000          <1>     call ioctrl
  3248                              <1> .exit:
  3249 0000560C 5F                  <1>     pop rdi
  3250 0000560D 5E                  <1>     pop rsi
  3251 0000560E 5A                  <1>     pop rdx
  3252 0000560F 59                  <1>     pop rcx
  3253                              <1>     return
