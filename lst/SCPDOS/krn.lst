  1863 0000485F 48894647            <1>     mov qword [rsi + sft.qPID], rax ;Set who opened the file
  1864                              <1> ;Set file pointer to first byte
  1865 00004863 C7461B00000000      <1>     mov dword [rsi + sft.dCurntOff], 0  
  1866                              <1> ;Common fields set. Now check if creating or opening.
  1867 0000486A F605(38070000)FF    <1>     test byte [openCreate], -1  ;Create = -1
  1868 00004871 0F84F8010000        <1>     jz .openProc
