   405                              <1> checkPathspecOK:
   406                              <1> ;Input:
   407                              <1> ;rsi -> points to a path to verify if it is ok.
   408                              <1> ;Output:
   409                              <1> ;CF=NC => The path is totally clean and ok to use.
   410                              <1> ;CF=CY => the path is malformed or longer than 64 chars.
   411                              <1> ; If CF=CY and ZF=ZE then wildcards were found in the last portion
   412                              <1> ; and depending on method of invokation and caller, may be permissable.
   413                              <1> ;We accept lc and uc characters in this check function.
   414 00007A1D 50                  <1>     push rax
   415 00007A1E 53                  <1>     push rbx    ;Use rbx as the return flag status
   416 00007A1F 56                  <1>     push rsi
   417 00007A20 31DB                <1>     xor ebx, ebx    ;Clear the return status flags
   418                              <1>     ;Start by getting the length of the ASCIIZ string.
   419 00007A22 51                  <1>     push rcx
   420 00007A23 57                  <1>     push rdi
   421 00007A24 4889F7              <1>     mov rdi, rsi
   422 00007A27 E88DFFFFFF          <1>     call strlen
   423 00007A2C 89C8                <1>     mov eax, ecx    ;Save the length in eax
   424 00007A2E 5F                  <1>     pop rdi
   425 00007A2F 59                  <1>     pop rcx
   426 00007A30 3D40000000          <1>     cmp eax, MAX_FSPEC    ;Check
   427 00007A35 0F8792000000        <1>     ja .badExit ;Above 64 only as the count includes the terminating null
   428 00007A3B 85C0                <1>     test eax, eax   ;If the path is empty, also error out!
   429 00007A3D 0F848A000000        <1>     jz .badExit
   430                              <1>     ;First we verify if our path is relative or canonical (absolute)
   431 00007A43 668B06              <1>     mov ax, word [rsi]  ;Get the first two chars
   432 00007A46 663D5C5C            <1>     cmp ax, "\\"    ;UNC network start
   433 00007A4A 7416                <1>     je .netName
   434 00007A4C 663D2F2F            <1>     cmp ax, "//"    ;Also acceptable UNC network start
   435 00007A50 7410                <1>     je .netName
   436 00007A52 80FC3A              <1>     cmp ah, ":" ;Is this a full or CWD of drive letter relative disk path?
   437 00007A55 7419                <1>     je .diskPath    ;Need to check if the char preceeding is an ASCII drive char
   438                              <1>     ;Here if relative
   439 00007A57 F605(33070000)FF    <1>     test byte [dosInvoke], -1
   440 00007A5E 756D                <1>     jnz .badExit    ;If this is -1, server invoke.
   441 00007A60 EB3B                <1>     jmp short .okToScan
   442                              <1> .netName:
   443 00007A62 4881C602000000      <1>     add rsi, 2  ;Goto the first char after the UNC start symbol
   444 00007A69 803E00              <1>     cmp byte [rsi], 0   ;If this is an empty path, error!
   445 00007A6C 745F                <1>     je .badExit
   446 00007A6E EB2D                <1>     jmp short .okToScan
   447                              <1> .diskPath:
   448 00007A70 4881C602000000      <1>     add rsi, 2  ;Go past the X:
   449 00007A77 803E00              <1>     cmp byte [rsi], 0   ;Cannot have an empty relative path!
   450 00007A7A 7451                <1>     je .badExit
