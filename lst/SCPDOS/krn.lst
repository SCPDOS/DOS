   523                              <1> .expEnvVar:
   524                              <1> 
   525                              <1> ;-----------------------
   526                              <1> ; Get Command Line Copy
   527                              <1> ;-----------------------
   528                              <1> ;Checks the args to see if there are 2 strings there. 
   529                              <1> ; If so, returns the pointer to the second string.
   530                              <1> ;Else, enlarges the block (if needed by reallocating and freeing)
   531                              <1> ; copies the environment and args as necessary and adds the new string.
   532                              <1> ;The new string is the execution command (if one exists, else an empty 
   533                              <1> ; string is made for entry 0) in quotation marks, followed by the 
   534                              <1> ; unquoted args string, i.e. "C:\Myprog.exe" /p /a:TEST
   535                              <1> .getCmdLine:
   536 00006D9E B801000000          <1>     mov eax, errInvFnc
   537 00006DA3 E90E140000          <1>     jmp extErrExit
