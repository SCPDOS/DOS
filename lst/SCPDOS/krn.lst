   325 00003483 7518                <1>     jnz .okToGo ;If the file is a char dev, its always ok for FileIO
   326 00003485 E877420000          <1>     call testCDSNet ;If CF=CY => Net CDS (with and without CDS)
   327 0000348A 7218                <1>     jc .exit
   328                              <1>     ;rdi has cds ptr now
   329 0000348C 488B6F45            <1>     mov rbp, qword [rdi + cds.qDPBPtr]  ;Get dpb ptr in rbp
   330 00003490 E8F3D5FFFF          <1>     call getFATtype
   331 00003495 81F901000000        <1>     cmp ecx, 1  ;0 = FAT12, 1 = FAT16
   332 0000349B 7707                <1>     ja .exit
   333                              <1> .okToGo:
   334 0000349D C605(2B070000)00    <1>     mov byte [volIncmpFCB], 0   ;Clear this to permit usage
   335                              <1> .exit:
   336 000034A4 9D                  <1>     popfq
   337 000034A5 5D                  <1>     pop rbp
   338 000034A6 5F                  <1>     pop rdi
