   216 00006B2D EBEC                <1>     jmp short .ynExit
   217                              <1> .convChar:
   218                              <1> ;Input: dl = Char to uppercase
   219                              <1> ;       rbx -> Table to use for conversion
   220                              <1> ;Output: dl = Uppercased char
   221 00006B2F 88D0                <1>     mov al, dl  ;Move the char into al to uppercase
   222 00006B31 E803000000          <1>     call .doChar
   223 00006B36 88C2                <1>     mov dl, al
   224                              <1>     return
