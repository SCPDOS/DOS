   397 00007711 8905(F4040000)      <1>     mov dword [primReqPkt + ioReqPkt.unitnm], eax   ;Clear unit number field
   398 00007717 4885ED              <1>     test rbp, rbp   ;If RBP is the null ptr, skip the Disk fields
