   368                              <1> asciiToFCB:
   369                              <1> ;Converts a filename in the form FILENAME.EXT,0 to FILENAMEEXT
   370                              <1> ;Will uppercase any lowercase chars as this could be used with user buffers.
   371                              <1> ;Names such as SYS.COM get converted to "SYS     COM"
   372                              <1> ;Name is space padded.
   373                              <1> ;Input: rsi = ASCII string buffer
   374                              <1> ;       rdi = FCB name buffer
   375                              <1> ;Output: al = Char that terminated the source string 
   376 000013FA 53                  <1>     push rbx    
   377 000013FB 57                  <1>     push rdi
   378 000013FC B90B000000          <1>     mov ecx, 11
   379 00001401 B020                <1>     mov al, " "
   380 00001403 F3AA                <1>     rep stosb   ;Fill the buffer with spaces (so we don't need to fill later)
   381 00001405 5F                  <1>     pop rdi
   382 00001406 4889FB              <1>     mov rbx, rdi    ;Use rbx as the base pointer of this buffer
   383                              <1> .processName:
   384 00001409 AC                  <1>     lodsb   ;Get the char in al
   385 0000140A E85A650000          <1>     call uppercaseChar  ;Just in ANY case, we will uppercase the cahar
   386 0000140F 84C0                <1>     test al, al
   387 00001411 742D                <1>     jz .exit
   388 00001413 3C20                <1>     cmp al, " " ;If space or a period, go to extension field. If null, exit
   389 00001415 740E                <1>     je .extSpace
   390 00001417 3C2E                <1>     cmp al, "."
   391 00001419 7413                <1>     je .ext
   392                              <1>     ;Test if the char is valid
   393 0000141B E8CB660000          <1>     call checkCharValid ;ZF=ZE => Invalid char
   394 00001420 741E                <1>     jz .exit    ;If the char invalid, consider it a terminator
   395 00001422 AA                  <1>     stosb   ;Store the char
   396 00001423 EBE4                <1>     jmp short .processName
   397                              <1> .extSpace:
   398                              <1> ;Now we scan for a period in the name
   399 00001425 AC                  <1>     lodsb   ;Get a char and increase rsi
   400 00001426 84C0                <1>     test al, al
   401 00001428 7416                <1>     jz .exit
   402 0000142A 3C2E                <1>     cmp al, "."     ;If al is not a period...
   403 0000142C 75F7                <1>     jne .extSpace   ; keep searching
   404                              <1> .ext:
   405 0000142E 488D7B08            <1>     lea rdi, qword [rbx + filename.fExt]    ;Put destination at the extension
   406                              <1> .processExt:
   407 00001432 AC                  <1>     lodsb
   408 00001433 84C0                <1>     test al, al
   409 00001435 7409                <1>     jz .exit
   410 00001437 3C20                <1>     cmp al, " "
   411 00001439 7405                <1>     je .exit
   412 0000143B AA                  <1>     stosb
   413 0000143C EBF4                <1>     jmp short .processExt
   414                              <1> .exitBadChar:
   415 0000143E 30C0                <1>     xor al, al  ;Return a null terminator
   416                              <1> .exit:
   417 00001440 5B                  <1>     pop rbx
   418                              <1>     return
    13                              <2> %%_ret:
    14 00001441 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
