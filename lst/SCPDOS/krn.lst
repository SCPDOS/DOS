   936 00003F8B 00                  <1>
   937 00003F8C 7531                <1>     jnz .openFile
   938                              <1> ;----DO TRUNCATE CREATE HERE----
   939                              <1> ;cx = File attributes (same as search attributes for find first)
   940                              <1> ;rdx = Ptr to ASCIZ filename to create
   941 00003F8E E8F2F6FFFF          <1>     call createFileHdl
   942 00003F93 0F829D3D0000        <1>     jc extErrExit
   943 00003F99 66813D(BA070000)00- <1>     cmp word [wEOFlags], 0  ;Cleared by Network drives
   943 00003FA1 00                  <1>
   944 00003FA2 0F84803D0000        <1>     jz extGoodExit  ;Exit immediately, vars set by Network drive
   945                              <1> ;Now check if we created a new file or an existing file.
   946 00003FA8 B902000000          <1>     mov ecx, eoRetActCreate ;Anticipate new create
   947 00003FAD 66F705(BA070000)04- <1>     test word [wEOFlags], eoFileNoExist   ;Set if file was newly created
   947 00003FB5 00                  <1>
   948 00003FB6 7568                <1>     jnz .localGoodExit
