   372                              <1> ;Update the new cluster and sector information
   373 00000CF4 8905(85070000)      <1>     mov dword [currClustD], eax ;Update disk location of next cluster
   374 00000CFA FF05(81070000)      <1>     inc dword [currClustF]   ;Goto next file cluster
   375 00000D00 E8E0FDFFFF          <1>     call getStartSectorOfCluster    ;Get start sector of Cluster
