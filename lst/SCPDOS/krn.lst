    61                              <1> ;Assertain correct buffer type
    62 00007231 31C0                <1>     xor eax, eax    ;Set for critDOS (0h -> 0h)
    63 00007233 F7C101000000        <1>     test ecx, dosBuffer
    64 00007239 751F                <1>     jnz .goXlat
    65 0000723B FFC0                <1>     inc eax         ;Set for critFAT (1h -> 200h)
    66 0000723D F7C102000000        <1>     test ecx, fatBuffer
    67 00007243 7409                <1>     jz .getNonFatType
    68 00007245 C74531FFFFFFFF      <1>     mov dword [rbp + dpb.dFreeClustCnt], -1 ;Invalidate the count for FAT err!
    69 0000724C EB0C                <1>     jmp short .goXlat
    70                              <1> .getNonFatType:
    71 0000724E FFC0                <1>     inc eax         ;Set for critDir (2h -> 400h)
