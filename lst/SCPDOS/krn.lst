  1089 00001A0B F2AE                <1>     repne scasb
  1090 00001A0D 7452                <1>     je .sfpPnf  ;Path not found if a ? found in the name
  1091 00001A0F B010                <1>     mov al, dirDirectory    ;We want a directory only search.
  1092 00001A11 C605(9B040000)00    <1>     mov byte [fileDirFlag], 0   ;Override setting to search exclusively for dir
  1093 00001A18 EB07                <1>     jmp short .sfpPNMain
  1094                              <1> .sfpPNfile:
  1095                              <1>     ;Here if we are searching for a file or directory as setup by search init
  1096 00001A1A 0FB605(2E070000)    <1>     movzx eax, byte [searchAttr]    ;Get the search attributes
  1097                              <1> .sfpPNMain:
  1098 00001A21 803D(60060000)00    <1>     cmp byte [skipDisk], 0  ;If we are just qualifying a path, skip the disk hit
