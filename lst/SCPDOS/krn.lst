   598                              <1> .gotoNextClusterFat12:
   599                              <1> ;FAT12 might need two FAT sectors read so we always read two sectors
   600                              <1> ;eax has the sector number of the FAT
   601                              <1> ;edx has byte offset into the sector
   602                              <1> ;edi has current cluster number
   603                              <1> ;rbx has ptr to buffer header
   604 00000E52 0FB74D02            <1>     movzx ecx, word [rbp + dpb.wBytesPerSector]
   605 00000E56 81E6FF0F0000        <1>     and esi, 0FFFh  ;Clear the upper bits. Save only low 12 bits
   606 00000E5C F7C701000000        <1>     test edi, 1  ;Check if cluster is odd
   607 00000E62 7432                <1>     jz .gotoNextClusterFat12Even
   608                              <1>     ;Here the cluster is ODD, and might cross sector boundary
   609 00000E64 29D1                <1>     sub ecx, edx
   610 00000E66 FFC9                <1>     dec ecx ;If edx = BytesPerSector - 1 then it crosses, else no
   611 00000E68 7556                <1>     jnz .gotoNextClusterFat12OddNoX
   612                              <1>     ;Boundary cross, build entry properly
   613                              <1>     ;Replace the high nybble of the low byte
   614 00000E6A 0FB64C1320          <1>     movzx ecx, byte [rbx + bufferHdr.dataarea + rdx] ;Use ecx as it is free
   615 00000E6F 81E10F000000        <1>     and ecx, 0Fh    ;Clear the high nybble
   616 00000E75 C1E604              <1>     shl esi, 4  ;Shift value up by 4 to insert the low nybble in the right place
   617 00000E78 09F1                <1>     or ecx, esi ;Add low nybble of esi to upper nybble of ecx
   618 00000E7A C1EE08              <1>     shr esi, 8  ;Move upper byte to lower byte of esi
   619 00000E7D 884C1320            <1>     mov byte [rbx + bufferHdr.dataarea + rdx], cl
   620 00000E81 E8A3FAFFFF          <1>     call markBufferDirty
   621 00000E86 FFC0                <1>     inc eax ;Get next FAT sector
   622 00000E88 E8E9FBFFFF          <1>     call getBufForFat ;Get buffer Header in ebx
   623 00000E8D 72BC                <1>     jc .exitFail
   624 00000E8F 89F1                <1>     mov ecx, esi    ;Get the high byte of the entry into cl
   625 00000E91 884B20              <1>     mov byte [rbx + bufferHdr.dataarea], cl  ;Write entry
   626 00000E94 EBAF                <1>     jmp short .exit
   627                              <1> .gotoNextClusterFat12Even:
   628 00000E96 29D1                <1>     sub ecx, edx
   629 00000E98 FFC9                <1>     dec ecx ;If edx = BytesPerSector - 1 then it crosses, else no
   630 00000E9A 7533                <1>     jnz .gotoNextClusterFat12EvenNoX
   631 00000E9C 89F1                <1>     mov ecx, esi
   632 00000E9E 80E50F              <1>     and ch, 0Fh ;Save only the lower nybble of ch
   633 00000EA1 884C1320            <1>     mov byte [rbx + bufferHdr.dataarea + rdx], cl   ;Store the first byte
   634 00000EA5 E87FFAFFFF          <1>     call markBufferDirty
   635 00000EAA FFC0                <1>     inc eax ;Get next FAT sector
   636 00000EAC E8C5FBFFFF          <1>     call getBufForFat
   637 00000EB1 7298                <1>     jc .exitFail
   638 00000EB3 8A4B20              <1>     mov cl, byte [rbx + bufferHdr.dataarea] ;Get the first data byte from buffer
   639 00000EB6 80E1F0              <1>     and cl, 0F0h    ;Clear the lower nybble of this entry
   640 00000EB9 08E9                <1>     or cl, ch       ;Add our entry in
   641 00000EBB 884B20              <1>     mov byte [rbx + bufferHdr.dataarea], cl ;Write it back
   642 00000EBE EB85                <1>     jmp short .exit    
   643                              <1> .gotoNextClusterFat12OddNoX:
   644 00000EC0 0FB7441320          <1>     movzx eax, word [rbx + bufferHdr.dataarea + rdx]    ;Read the entry
   645 00000EC5 250F000000          <1>     and eax, 0Fh    ;Clear the upper three nybbles of entry (the entry)
   646 00000ECA C1E604              <1>     shl esi, 4  ;Shift entry up by 4
   647 00000ECD EB0A                <1>     jmp short .fat12common
   648                              <1> .gotoNextClusterFat12EvenNoX:
   649                              <1>     ;Here the cluster is even and can't cross a sector boundary
   650 00000ECF 0FB7441320          <1>     movzx eax, word [rbx + bufferHdr.dataarea + rdx]    ;Read the entry
   651 00000ED4 2500F00000          <1>     and eax, 0F000h ;Clear the lower three nybbles of entry (the entry)
