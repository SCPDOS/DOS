   983 00001946 3C2A                <1>     cmp al, "*" ;Wildcard?
   984 00001948 7430                <1>     je .cpsWildcard
   985 0000194A 3C3F                <1>     cmp al, "?" ;Good wildcard?
   986 0000194C 740C                <1>     je .store
   987 0000194E E86F5F0000          <1>     call uppercaseChar  ;Uppercase the char if it needs to be...
   988 00001953 E8EC600000          <1>     call checkCharValid ; and check it is a valid char
   989 00001958 7472                <1>     je .cpsExitError
