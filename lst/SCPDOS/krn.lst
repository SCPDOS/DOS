   696 00000F33 F64524FF            <1>     test byte [rbp + dpb.bAccessFlag], -1
   697 00000F37 7472                <1>     jz .exit
   698 00000F39 0FB74625            <1>     movzx eax, word [rsi + bpb32.FSinfo]    ;Get the FSInfo sector number
   699 00000F3D 85C0                <1>     test eax, eax   ;0 is an invalid value for this 
   700                              <1>     retz
