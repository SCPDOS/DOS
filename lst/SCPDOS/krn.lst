    15                              <2> %assign retOff %%_ret-$$
   233                              <1> 
   234                              <1> createFileFCB:     ;ah = 16h
   235                              <1> openFileFCB:       ;ah = 0Fh
   236                              <1> ;rdx -> Extended FCB
   237                              <1> ;   MUST BE EXTENDED. 
   238                              <1> ;   MUST HAVE ATTRIBUTE OF 08h, VOLID, else will fail
   239                              <1> ; Using FCB's, one can only create a volume label on a volume.
   240                              <1> ;
   241                              <1> ;Deleting a volume label can be done using delete file (fcb)
   242                              <1> ;Renaming a volume label can be done using rename file (fcb)
   243                              <1> ;Creating a volume label can be done using create file (fcb and hdl)
   244                              <1> ;
   245                              <1> ; In all cases, we recommend the use of fcb's ONLY. Hdl funcs are not 
   246                              <1> ; suggested for use with the vol crud because, do we really need the hdl? No!
   247                              <1> ;
   248 000033DD 488915(4B070000)    <1>     mov qword [workingFCB], rdx     ;Save the FCB ptr
   249 000033E4 803AFF              <1>     cmp byte [rdx + exFcb.extSig], -1
   250 000033E7 755D                <1>     jne .exitErr
   251 000033E9 807A0608            <1>     cmp byte [rdx + exFcb.attribute], dirVolumeID
   252 000033ED 7557                <1>     jne .exitErr
   253                              <1>     ;Here we proceed with creating a volume label
   254 000033EF 488D3D(50050000)    <1>     lea rdi, buffer1
   255 000033F6 57                  <1>     push rdi
   256 000033F7 E8D2000000          <1>     call fcbInitRoutine     ;Build path to volid
   257 000033FC 5E                  <1>     pop rsi                 ;Point rsi to the canonised path
   258 000033FD 0F8250480000        <1>     jc fcbErrExit
   259 00003403 4889F7              <1>     mov rdi, rsi            ;Pass argument to rdi. rsi, rdi preserved
   260 00003406 E86B450000          <1>     call checkPathspecOK    ;If the path has wildcards, fail!
   261 0000340B 7239                <1>     jc .exitErr
   262 0000340D E8D7E1FFFF          <1>     call getFilePathNoCanon ;Get the file if it exists! Sets DPB too.
   263 00003412 8B05(50050000)      <1>     mov eax, dword [buffer1]    ;Get the first four chars for comparison
   264 00003418 30C0                <1>     xor al, al
   265 0000341A 3D003A5C00          <1>     cmp eax, 005C3A00h  ;Do null path check!
   266 0000341F 7425                <1>     je .exitErr
   267 00003421 488D3D(500D0000)    <1>     lea rdi, scratchSFT     ;Set the working SFT to the scratch in the SDA
   268 00003428 E8141F0000          <1>     call setCurrentSFT
   269 0000342D 0FB605(2E070000)    <1>     movzx eax, byte [searchAttr]   ;Get the file attribute in al
   270 00003434 E817130000          <1>     call createMain
   271 00003439 720B                <1>     jc .exitErr
   272                              <1>     ;We close the sda sft since we dont have an explicit FCB close fn.
   273                              <1>     ;Necessary to close the associated share record when sharing.
   274 0000343B E874160000          <1>     call closeMain
   275 00003440 0F830A480000        <1>     jnc fcbGoodExit     ;We require no back copying so exit!
   276                              <1> .exitErr:
   277 00003446 B805000000          <1>     mov eax, errAccDen
   278 0000344B E903480000          <1>     jmp fcbErrExit
