   241                              <1> setDaysInFeb:   ;Int 2Fh AX = 121Bh, Set days in february
   242                              <1> ;Every fourth year has an extra day in feb (!! 2100 exception!!)
   243                              <1> ;Input: cl = Year - 1980
   244                              <1> ;Output: al = Number of days in February
   245 00003107 880D(C2040000)      <1>     mov byte [years], cl    ;Save this figure
   246 0000310D F6C103              <1>     test cl, 3   ;Every fourth year, the year is 0
   247 00003110 51                  <1>     push rcx
   248 00003111 57                  <1>     push rdi
   249 00003112 B81C000000          <1>     mov eax, 28  ;Usual days in february
   250 00003117 B91D000000          <1>     mov ecx, 29  ;Leap year days in february
