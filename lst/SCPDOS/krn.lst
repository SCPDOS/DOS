   134                              <1> criticalDOSError:   ;Int 2Fh, AX=1206h, Invoke Critical Error Function 
   135                              <1> ;Will swap stacks and enter int 24h safely and handle passing the right data 
   136                              <1> ; to the critical error handler.
   137                              <1> ; Called with rsi set as required by Int 24h (caller decides), ax, di
   138                              <1> ; and with Int24Bitfield set
   139                              <1> ;               AH = Critical Error Bitfield
   140                              <1> ;               Bit 7 = 0 - Disk Error, Bit 7 = 1 - Char Device Error
   141                              <1> ;               Bit 6 - Reserved
   142                              <1> ;               Bit 5 = 0 - IGNORE not allowed, Bit 5 = 1 - IGNORE allowed
   143                              <1> ;               Bit 4 = 0 - RETRY not allowed, Bit 4 = 1 - RETRY allowed
   144                              <1> ;               Bit 3 = 0 - FAIL not allowed, Bit 3 = 1 - FAIL allowed
   145                              <1> ;               Bits [2-1] = Affected Disk Error
   146                              <1> ;                     0 0   DOS area
   147                              <1> ;                     0 1   FAT area
   148                              <1> ;                     1 0   Directory area
   149                              <1> ;                     1 1   Data area
   150                              <1> ;               Bit 0 = 0 - Read Operation, Bit 0 = 1 - Write Operation
   151                              <1> ;               AL  = Failing drive number if AH[7] = 0
   152                              <1> ;               DIL = Error code for errorMsg
   153                              <1> ;               RSI = EA of Device Header for which device the error occured
   154                              <1> ;Return:
   155                              <1> ;               AL = 0 - Ignore the Error       (Ignore)
   156                              <1> ;                  = 1 - Retry the Operation    (Retry)
   157                              <1> ;               XXX= 2 - Terminate the Program  (Abort)XXX
   158                              <1> ;                  = 3 - Fail the DOS call      (Fail)
   159                              <1> ; Return response from int 24h in al
   160                              <1> ; Caller must preserve rsp, rbx, rcx, rdx if they wish to return to DOS
   161                              <1> ; This function will terminate the program if an abort was requested!
   162                              <1> ; This function also destroys RBP
