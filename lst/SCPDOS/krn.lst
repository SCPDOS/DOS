    81                              <1> flushAllBuffersForDPB:  ;External linkage
    82                              <1> ;Wrapper to allow calls to the below functions from the workingDPB
    83 000007BF 50                  <1>     push rax
    84 000007C0 488B05(3B070000)    <1>     mov rax, qword [workingDPB]
    85 000007C7 0FB600              <1>     movzx eax, byte [rax + dpb.bDriveNumber]
    86 000007CA E802000000          <1>     call flushAllBuffersForDrive
