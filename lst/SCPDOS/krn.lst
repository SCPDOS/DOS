    50 000031B4 57                  <1>     push rdi
    51 000031B5 E8C8E2FFFF          <1>     call setupFFBlock
    52 000031BA 5E                  <1>     pop rsi
    53                              <1> ;Now we use the provided FCB to store the created FFblock, to be used by us only
    54 000031BB 488B3D(4B070000)    <1>     mov rdi, qword [workingFCB]
    55 000031C2 F605(2D070000)FF    <1>     test byte [extFCBFlag], -1
    56 000031C9 7407                <1>     jz .notExt2
    57 000031CB 4881C707000000      <1>     add rdi, exFcb.driveNum ;Go to the drive number 
    58                              <1> .notExt2:
    59 000031D2 5B                  <1>     pop rbx ;Get back the drive number in bl
    60 000031D3 85DB                <1>     test ebx, ebx
