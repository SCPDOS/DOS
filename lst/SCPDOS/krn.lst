   846 0000184E F605(60060000)FF    <1>     test byte [skipDisk], -1    ;Are we a join drive in truename?
   847 00001855 7510                <1>     jnz .okJoin                 ;If not, proceed. If so, fail.    
   848 00001857 F9                  <1>     stc
   849 00001858 EB19                <1>     jmp short .critExit    ;If the drive number in al is too great or a join drive specified.
