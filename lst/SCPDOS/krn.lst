   961                              <1> 
   962 00001915 488D1D(16070000)    <1>     lea rbx, fcbName + 11   ;Use rbx as the end of fcb name marker address
   963 0000191C AC                  <1>     lodsb   ;Get first char from user path in al
   964 0000191D 3C2E                <1>     cmp al, "."   ;Handle starting dot separately
   965 0000191F 746B                <1>     je .cpsDots
