   246 00006BED 488D355296FFFF      <1>     lea rsi, charTableArray
   247 00006BF4 0FB72D4996FFFF      <1>     movzx ebp, word [ctryFunctions]    ;Get max number of tables to parse
   248                              <1> .loopTableSearch:
   249 00006BFB 3A06                <1>     cmp al, byte [rsi]  ;Is the table ours?
   250 00006BFD 751C                <1>     jne .tblFound
   251 00006BFF 4881C609000000      <1>     add rsi, 9          ;Go to next table (skip one byte and one qword)
