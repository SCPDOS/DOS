     1                              <1> 
     2                              <1> 
     3                              <1> ;Environment and process information functions go here :)
     4                              <1> ;
     5                              <1> ;An environment (ENV) is a list of strings of the form:
     6                              <1> ; var1 = <value>,<NUL>
     7                              <1> ;      .
     8                              <1> ;      .
     9                              <1> ;      .
    10                              <1> ; varN = <value>,<NUL>
    11                              <1> ; <NUL>
    12                              <1> ;
    13                              <1> ;Argument block (ARGS) is a list of strings of the form:
    14                              <1> ; wArgc (argc)
    15                              <1> ; <string1>,<NUL> (argv[0])
    16                              <1> ;       .
    17                              <1> ;       .
    18                              <1> ;       .
    19                              <1> ; <stringN>,<NUL> (argv[N-1])
    20                              <1> ; <NUL>
    21                              <1> ;
    22                              <1> ; where wArgc has a maximum value of (ENV_MAX-2)/2
    23                              <1> ; Subtract 2 for the mandatory argc count and divide by 2 as the minimum
    24                              <1> ; non-empty string length is 2.
    25                              <1> ;An empty string in ARGS is given by the string <NUL>.
    26                              <1> ;The end of the ARGS block is denoted by a <NUL>.
    27                              <1> ;Both ENV and ARGS have a maximum size defined by ENV_MAX.
    28                              <1> ;
    29                              <1> ;Together, an environment list and an argv list forms the 
    30                              <1> ; full environment (FENV) of an application. 
    31                              <1> ;Each application has a field in the PSP called the envPtr. This 
    32                              <1> ; contains a pointer to a special memory block called the full 
    33                              <1> ; environment memory block. The FENV memory block contains both the 
    34                              <1> ; ENV and the ARGS for the application. Note, this pointer can point 
    35                              <1> ; to an ENV without a following ARGS. This will only happen if someone 
    36                              <1> ; attempts to manually twiddle with the environment pointer in the PSP. 
    37                              <1> ;In such cases, all documented functions will fail. The only caveat is if
    38                              <1> ; the pointer is the null pointer, in which case, function calls to 
    39                              <1> ; GetEnvironmentStrings will always return an empty opaque environment.
    40                              <1> 
    41                              <1> 
    42                              <1> systemServices: ;ah = 61h, this is so named as it forms the core of
    43                              <1> ;   the system services endpoint.
    44                              <1> ;Available subfunctions:
    45                              <1> ;-------------------------------- UNDOCUMENTED --------------------------------
    46                              <1> ;al = 0 -> Get Environment pointer in rdx                                     :
    47                              <1> ;   Output: rdx -> Environment Pointer. May be a null pointer. Caller checks! :
    48                              <1> ;al = 1 -> Get Command Line Arguments Pointer in rdx                          :
    49                              <1> ;   Output: rdx -> Pointer to whatever was passed as a CR terminated          :
    50                              <1> ;                   command line.                                             :
    51                              <1> ;al = 2 -> Get ptr to ASCIIZ name for program in rdx. Might not be FQ.        :
    52                              <1> ;   Output: CF=NC: rdx -> Filename                                            :
    53                              <1> ;           CF=CY: eax = Error code (errAccDen) if no filename ptr.           :
    54                              <1> ;                   The error case should only happen for programms           :
    55                              <1> ;                   which have twiddled with their own environments.          :
    56                              <1> ;                               DON'T DO THAT!!!                              :
    57                              <1> ;-------------------------------- UNDOCUMENTED --------------------------------
    58                              <1> ;al = 3 -> GetEnvironmentStrings, gets an opaque copy of the environment
    59                              <1> ;al = 4 -> GetEnvironmentVariable, gets this var's value from the environment
    60                              <1> ;al = 5 -> SetEnvironmentStrings, copies these strings into a new env, if valid
    61                              <1> ;al = 6 -> SetEnvironmentVariable, sets this var value in the environment
    62                              <1> ;al = 7 -> FreeEnvironmentStrings, frees a Get Env Strings block
    63                              <1> ;al = 8 -> ExpandEnvironmentStrings, expands a string which has a string
    64                              <1> ;           of the form %var% in it, where var is an environment variable.
    65                              <1> ;al = 9 -> GetCommandLine, get lpcsz to command line.
    66                              <1> ;al = 0Ah -> GetLaunchParameters, copy the PSP from cmdLineArgPtr down.
    67                              <1> ;               However, .fcb1 and .fcb2 are reserved!!!!
    68                              <1> ;
    69                              <1> ;al > 0Bh: Returns CF=CY and eax = Error code (errInvFnc).
    70                              <1> ;Subfunctions 0-2 remain undocumented for use!
    71                              <1> 
    72 00006A05 4C8B05(4F040000)    <1>     mov r8, qword [currentPSP]  ;Use r8 as the PSP pointer
    73 00006A0C 3C01                <1>     cmp al, 01h ;Get RAW CmdLine arguments
    74 00006A0E 745A                <1>     je .getPSPCmdLineArgs
    75 00006A10 3C02                <1>     cmp al, 02h ;Get RAW env pointer (al=0 and al=2)
    76 00006A12 765C                <1>     jbe .getPSPEnvPtr
    77                              <1> ;Functions below this are documented for users.
    78 00006A14 3C03                <1>     cmp al, 03h ;GetEnvironmentStrings
    79 00006A16 0F84A7000000        <1>     je .getEnvStrings
    80 00006A1C 3C04                <1>     cmp al, 04h ;GetEnvironmentVariable
    81 00006A1E 0F8475010000        <1>     je .getEnvVar
    82 00006A24 3C05                <1>     cmp al, 05h ;SetEnvironmentStrings
    83 00006A26 0F84E2000000        <1>     je .setEnvStrings
    84 00006A2C 3C06                <1>     cmp al, 06h ;SetEnvironmentVariable
    85 00006A2E 0F84D3010000        <1>     je .setEnvVar
    86 00006A34 3C07                <1>     cmp al, 07h ;FreeEnvironmentStrings
    87 00006A36 0F844B010000        <1>     je .freeEnvStrings
    88                              <1>     ;cmp al, 08h ;UNIMPLEMENTED: ExpandEnvironmentStrings
    89                              <1>     ;je .expEnvVar
    90                              <1>     ;cmp al, 09h ;UNIMPLEMENTED: GetCommandLine
    91                              <1>     ;je .getCmdLine
    92 00006A3C 3C0A                <1>     cmp al, 0Ah ;GetLaunchParameters
    93 00006A3E 0F8423030000        <1>     je .getLaunchParams
    94                              <1> .exitBadFunc:
    95 00006A44 C605(3A040000)01    <1>     mov byte [errorLocus], eLocUnk  
    96 00006A4B B801000000          <1>     mov eax, errInvFnc  ;Error, with invalid function number error
    97                              <1> .exitBad:
    98 00006A50 E961170000          <1>     jmp extErrExit
    99                              <1> .exitBadFmt:
   100 00006A55 B80B000000          <1>     mov eax, errBadFmt
   101 00006A5A EBF4                <1>     jmp short .exitBad
   102                              <1> .exitBadEnv:
   103 00006A5C B80A000000          <1>     mov eax, errBadEnv
   104 00006A61 EBED                <1>     jmp short .exitBad
   105                              <1> .exitAccDen:
   106 00006A63 B805000000          <1>     mov eax, errAccDen  ;Set error code here
   107 00006A68 EBE6                <1>     jmp short .exitBad  ;Return setting CF=CY and errAccDen (no pointer)
   108                              <1> ;------------------
   109                              <1> ; Undoc functions
   110                              <1> ;------------------
   111                              <1> .getPSPCmdLineArgs:
   112 00006A6A 498D505C            <1>     lea rdx, qword [r8 + psp.cmdLineArgPtr]   ;Get the cmdArgs pointer
   113 00006A6E EB45                <1>     jmp short .exitOk
   114                              <1> .getPSPEnvPtr:
   115                              <1> ;Gets the environment pointer in rdx
   116 00006A70 498B503E            <1>     mov rdx, qword [r8 + psp.envPtr]   ;Get the environment pointer
   117 00006A74 84C0                <1>     test al, al     ;Was al=0?
   118 00006A76 743D                <1>     jz .exitOk   ;Exit if al = 0 since we have the pointer we need!
   119 00006A78 4885D2              <1>     test rdx, rdx   ;Check if the env pointer is ok to use
   120 00006A7B 74E6                <1>     jz .exitAccDen
   121 00006A7D 4881FAFFFFFFFF      <1>     cmp rdx, -1
   122 00006A84 74DD                <1>     je .exitAccDen
   123                              <1> ;Here we search for the double 00 and then check if it is 0001 and
   124                              <1> ; pass the ptr to the word after.
   125 00006A86 51                  <1>     push rcx
   126 00006A87 31C9                <1>     xor ecx, ecx
   127 00006A89 B9FF7F0000          <1>     mov ecx, ENV_MAX  ;Max environment size
   128                              <1> .gep0:
   129 00006A8E 66813A0000          <1>     cmp word [rdx], 0   ;Zero word?
   130 00006A93 740A                <1>     je short .gep1
   131 00006A95 48FFC2              <1>     inc rdx         ;Go to the next byte
   132 00006A98 FFC9                <1>     dec ecx
   133 00006A9A 75F2                <1>     jnz short .gep0
   134                              <1> .gep00:
   135                              <1> ;Failure here if we haven't hit the double null by the end of 32Kb
   136 00006A9C 59                  <1>     pop rcx
   137 00006A9D EBC4                <1>     jmp short .exitAccDen
   138                              <1> .gep1:
   139 00006A9F 4881C202000000      <1>     add rdx, 2          ;Skip the double null
   140 00006AA6 66813A0100          <1>     cmp word [rdx], 1   ;Check the count. Must be 1 for argv[0].
   141 00006AAB 72EF                <1>     jb .gep00
   142 00006AAD 4881C202000000      <1>     add rdx, 2          ;Skip the argc count.
   143 00006AB4 59                  <1>     pop rcx
   144                              <1> .exitOk:
   145 00006AB5 E81E120000          <1>     call getUserRegs
   146 00006ABA 48895618            <1>     mov qword [rsi + callerFrame.rdx], rdx
   147 00006ABE E9E5160000          <1>     jmp extGoodExit
