    37                              <1> diskDevErr:
    38                              <1> ;Called, NOT Jumped to. 
    39                              <1> ;Input: eax = Driver status word (Error code in al)
    40                              <1> ;       ecx = byte: Buffer flag; error on DOS, FAT, DIR or DATA xaction?
    41                              <1> ;       rbp = Disk DPB pointer
    42                              <1> ; [bI24OkBtfld] = Set with OK responses
    43                              <1> ; [bRwFlag] = Set or cleared as required.
    44                              <1> ;Output: al = Int 24h response (0-3)
    45                              <1> ; Preserves rbx, rcx, rdx, rsi, rdi, rbp. 
    46                              <1> ;NOTE: DOS requires bx-si be preserved by i24h for ignore/retry. 
    47                              <1> ;   We don't trust the user handler.
    48 00007218 53                  <1>     push rbx
    49 00007219 51                  <1>     push rcx
