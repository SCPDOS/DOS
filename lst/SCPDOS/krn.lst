    71 00003217 488B3D(47040000)    <1>     mov rdi, qword [currentDTA] ;Now copy current directory to DTA 
    72 0000321E 488D35(8C060000)    <1>     lea rsi, curDirCopy ;Point rsi to the current directory copy
    73 00003225 F605(2D070000)FF    <1>     test byte [extFCBFlag], -1
