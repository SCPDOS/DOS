   233 00006BDB 81F909000000        <1>     cmp ecx, 9  ;Is our buffer of minimum acceptable size?
   234 00006BE1 7250                <1>     jb .invFuncExit
   235 00006BE3 488D351096FFFF      <1>     lea rsi, dosNLSPtr
