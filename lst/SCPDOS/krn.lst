   108 00003266 AA                  <1>     stosb   ;Store this as the search drive in the ffblock
   109 00003267 B905000000          <1>     mov ecx, 5
   110 0000326C F3A5                <1>     rep movsd   ;Copy 20 bytes now to the ffblock
   111 0000326E FF35(47040000)      <1>     push qword [currentDTA] ;Save original currentDTA
   112 00003274 488D3D(61060000)    <1>     lea rdi, dosffblock
