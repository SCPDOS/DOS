   435                              <1> parseNameToFCB:
   436                              <1> ;rsi points to a command line to parse
   437                              <1> ;rdi points to a future unopened FCB
   438                              <1> ;al = parsing control bits. 
   439                              <1> ; al[0] = If set, leading filename separators are scanned off
   440                              <1> ; al[1] = If set, we set the drive ID byte if a drive letter was found
   441                              <1> ; al[2] = If set, will copy the filename to the FCB filename field
   442                              <1> ; al[3] = If set, will copy the extension to the FCB extension field
   443                              <1> ;
   444                              <1> ;Separators include : . ; , = + TAB SPACE
   445                              <1> ;Terminators include separators and , < > | / " [ ] and all ctrl chars
   446 00003564 C605(BF040000)00    <1>     mov byte [fcbSpaceOk], 0    ;Don't allow spaces in filename
