   138 0000787B 2C40                <1>     sub al, "A"-1
   139 0000787D 3805(7F000000)      <1>     cmp byte [numPhysVol], al    ;al must be bigger than # of block drives
   140 00007883 488B3D(43070000)    <1>     mov rdi, qword [workingCDS] ;Get CDS pointer
   141 0000788A 66C747430000        <1>     mov word [rdi + cds.wFlags], 0  ;Nullify CDS (mark as invalid)
   142 00007890 58                  <1>     pop rax
   143 00007891 723C                <1>     jb .exit    ;Exit with CF=CY
   144 00007893 50                  <1>     push rax
