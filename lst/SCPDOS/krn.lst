   194                              <1> .foundBunch:
   195                              <1>     ;If ecx = 0, february has 29 days!
   196                              <1>     ;eax has number of four year bunches elapsed since 1980
   197 000030A0 C1E002              <1>     shl eax, 2  ;Multiply by 4 to get # of years to start of four year bunch
   198 000030A3 01C1                <1>     add ecx, eax    ;Add # of years offset in 4 year bunch
