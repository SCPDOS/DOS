   403                              <1> findLRUBuffer: ;Internal Linkage
   404                              <1> ;Finds first free or least recently used buffer, links it and returns ptr to it 
   405                              <1> ; in rdi and the pCurrBuff variable
   406                              <1> ;Input: Nothing
   407                              <1> ;Output: rdi = Pointer to the buffer hdr to use
   408                              <1> ;       [pCurrBuff] = Pointer to the buffer hdr to use
   409 000009EA 52                  <1>     push rdx
   410 000009EB 488B3D(65000000)    <1>     mov rdi, qword [bufHeadPtr]
   411 000009F2 807F08FF            <1>     cmp byte [rdi + bufferHdr.driveNumber], -1  ;Check if 1st entry is free
   412 000009F6 7436                <1>     je .flbExit 
   413 000009F8 48813FFFFFFFFF      <1>     cmp qword [rdi + bufferHdr.nextBufPtr], -1  ;Check if 1st entry is last
   414 000009FF 742D                <1>     je .flbExit
   415                              <1> .flbWalk:
   416 00000A01 4889FA              <1>     mov rdx, rdi    ;Save a ptr to the previous buffer header
   417 00000A04 488B3A              <1>     mov rdi, qword [rdx + bufferHdr.nextBufPtr] ;Get next buffer header ptr
   418 00000A07 807F08FF            <1>     cmp byte [rdi + bufferHdr.driveNumber], -1
   419 00000A0B 742A                <1>     je .flbFreeLink ;If free, link to head, and xlink prev and next buffs
   420 00000A0D 48813FFFFFFFFF      <1>     cmp qword [rdi + bufferHdr.nextBufPtr], -1 ;Check if at LRU buffer
   421 00000A14 75EB                <1>     jne .flbWalk   ;If not LRU, keep walking, else process
   422 00000A16 48C702FFFFFFFF      <1>     mov qword [rdx + bufferHdr.nextBufPtr], -1  ;Make prev node the LRU node
   423                              <1> .flbHeadLink:
   424 00000A1D 488B15(65000000)    <1>     mov rdx, qword [bufHeadPtr]    ;Now copy old MRU buffer ptr to rdx
   425 00000A24 48893D(65000000)    <1>     mov qword [bufHeadPtr], rdi    ;Sysvars to point to new buffer
   426 00000A2B 488917              <1>     mov qword [rdi + bufferHdr.nextBufPtr], rdx
   427                              <1> .flbExit:
   428 00000A2E 5A                  <1>     pop rdx
   429 00000A2F 48893D(6F070000)    <1>     mov qword [pCurrBuff], rdi   ;Save in variable too
   430                              <1>     return
