    15                              <1> .mainlp:
    16 00000751 48393E              <1>     cmp qword [rsi + bufferHdr.nextBufPtr], rdi ;Is the next buffer ours?
    17 00000754 7405                <1>     je .fnd  ;Found the buffer as the next buffer in the chain
    18 00000756 488B36              <1>     mov rsi, qword [rsi + bufferHdr.nextBufPtr]   ;Goto next buffer
    19 00000759 EBF6                <1>     jmp short .mainlp
    20                              <1> .fnd:
    21 0000075B 57                  <1>     push rdi
    22 0000075C 488B3F              <1>     mov rdi, qword [rdi + bufferHdr.nextBufPtr] ;Get next buffer from rdi in rdi
    23 0000075F 48893E              <1>     mov qword [rsi + bufferHdr.nextBufPtr], rdi ;Set prev buf to goto next buf
    24 00000762 5F                  <1>     pop rdi ;Get original buf back
    25 00000763 4889FE              <1>     mov rsi, rdi    ;Save new head buf in rsi
    26 00000766 488735(65000000)    <1>     xchg qword [bufHeadPtr], rsi ;Set rsi to head, get new 2nd buf in rsi
    27 0000076D 488937              <1>     mov qword [rdi + bufferHdr.nextBufPtr], rsi ;Set 2nd buf to rsi
    28 00000770 5E                  <1>     pop rsi
