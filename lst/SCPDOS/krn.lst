   147 0000789B 58                  <1>     pop rax
   148 0000789C 66814F430040        <1>     or word [rdi + cds.wFlags], cdsValidDrive    ;Config bit set
   149 000078A2 C7474D00000000      <1>     mov dword [rdi + cds.dStartCluster], 0  ;Root dir
   150 000078A9 48C7475100000000    <1>     mov qword [rdi + cds.qIFSPtr], 0    ;Optional redir signature field
   151 000078B1 C7475900000000      <1>     mov dword [rdi + cds.dNetStore], 0   ;Optional storage/signature dword
   152 000078B8 66C7475D0200        <1>     mov word [rdi + cds.wBackslashOffset], 2    ;Skip letter and :
   153                              <1>     ;Search for a DPB for the CDS if it is based on a physical device
   154 000078BE 50                  <1>     push rax
