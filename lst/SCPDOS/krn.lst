   405                              <1> checkPathspecOK:
   406                              <1> ;Input:
   407                              <1> ;rsi -> points to a path to verify if it is ok.
   408                              <1> ;Output:
   409                              <1> ;CF=NC => The path is totally clean and ok to use.
   410                              <1> ;CF=CY => the path is malformed or longer than 64 chars.
   411                              <1> ; If CF=CY and ZF=ZE then wildcards were found in the last portion
   412                              <1> ; and depending on method of invokation and caller, may be permissable.
   413                              <1> ;We accept lc and uc characters in this check function.
   414 00007EB9 50                  <1>     push rax
   415 00007EBA 53                  <1>     push rbx    ;Use rbx as the return flag status
   416 00007EBB 56                  <1>     push rsi
   417 00007EBC 31DB                <1>     xor ebx, ebx    ;Clear the return status flags
   418                              <1>     ;Start by getting the length of the ASCIIZ string.
   419 00007EBE 51                  <1>     push rcx
   420 00007EBF 57                  <1>     push rdi
   421 00007EC0 4889F7              <1>     mov rdi, rsi
   422 00007EC3 E88DFFFFFF          <1>     call strlen
   423 00007EC8 89C8                <1>     mov eax, ecx    ;Save the length in eax
   424 00007ECA 5F                  <1>     pop rdi
   425 00007ECB 59                  <1>     pop rcx
   426 00007ECC 3D40000000          <1>     cmp eax, MAX_FSPEC    ;Check
   427 00007ED1 0F8792000000        <1>     ja .badExit ;Above 64 only as the count includes the terminating null
   428 00007ED7 85C0                <1>     test eax, eax   ;If the path is empty, also error out!
   429 00007ED9 0F848A000000        <1>     jz .badExit
   430                              <1>     ;First we verify if our path is relative or canonical (absolute)
   431 00007EDF 668B06              <1>     mov ax, word [rsi]  ;Get the first two chars
   432 00007EE2 663D5C5C            <1>     cmp ax, "\\"    ;UNC network start
   433 00007EE6 7416                <1>     je .netName
   434 00007EE8 663D2F2F            <1>     cmp ax, "//"    ;Also acceptable UNC network start
   435 00007EEC 7410                <1>     je .netName
   436 00007EEE 80FC3A              <1>     cmp ah, ":" ;Is this a full or CWD of drive letter relative disk path?
   437 00007EF1 7419                <1>     je .diskPath    ;Need to check if the char preceeding is an ASCII drive char
   438                              <1>     ;Here if relative
   439 00007EF3 F605(33070000)FF    <1>     test byte [dosInvoke], -1
   440 00007EFA 756D                <1>     jnz .badExit    ;If this is -1, server invoke.
   441 00007EFC EB3B                <1>     jmp short .okToScan
   442                              <1> .netName:
   443 00007EFE 4881C602000000      <1>     add rsi, 2  ;Goto the first char after the UNC start symbol
   444 00007F05 803E00              <1>     cmp byte [rsi], 0   ;If this is an empty path, error!
   445 00007F08 745F                <1>     je .badExit
   446 00007F0A EB2D                <1>     jmp short .okToScan
   447                              <1> .diskPath:
   448 00007F0C 4881C602000000      <1>     add rsi, 2  ;Go past the X:
   449 00007F13 803E00              <1>     cmp byte [rsi], 0   ;Cannot have an empty relative path!
   450 00007F16 7451                <1>     je .badExit
   451 00007F18 F605(33070000)FF    <1>     test byte [dosInvoke], -1    ;If this is minus 1, this is a server invoke
   452 00007F1F 740F                <1>     jz .localAbsCheck
   453                              <1> .absMain:
   454 00007F21 AC                  <1>     lodsb   ;Get the third byte. It MUST be a pathsep if server invokation.
   455 00007F22 E8D2FEFFFF          <1>     call swapPathSeparator
   456 00007F27 7540                <1>     jnz .badExit    ;If ZF=NZ => Not a pathsep, bad path
   457 00007F29 803E00              <1>     cmp byte [rsi], 0   ;Is the char after the slash null?
   458 00007F2C 743B                <1>     je .badExit ;Error if so!
   459 00007F2E EB09                <1>     jmp short .okToScan
   460                              <1> .localAbsCheck:
   461 00007F30 8A06                <1>     mov al, byte [rsi]  ;Get the char we are pointing at
   462 00007F32 E8C2FEFFFF          <1>     call swapPathSeparator  ;Is it a pathsep?
   463 00007F37 74E8                <1>     jz .absMain ;If it is, we do the absolute check
   464                              <1>     ;Else we are relative and begin wildcard search
   465                              <1> .okToScan:
   466 00007F39 AC                  <1>     lodsb   
   467 00007F3A 84C0                <1>     test al, al ;End of path char?
   468 00007F3C 7430                <1>     jz .exit
   469 00007F3E E8B6FEFFFF          <1>     call swapPathSeparator
   470 00007F43 741C                <1>     jz .wcCheck ;If it was a pathsep, ensure no WC's have been detected
   471 00007F45 3C2A                <1>     cmp al, "*" ;Was al a big wildcard?
   472 00007F47 7411                <1>     je .wcFound
   473 00007F49 3C3F                <1>     cmp al, "?" ;Was al a small wildcard?
   474 00007F4B 740D                <1>     je .wcFound ;If al was a wildcard, proceed as for wildcard
   475                              <1>     ;Else we check that the char in al is an acceptable char
   476 00007F4D 3C2E                <1>     cmp al, "." ;Ensure that dots are allowed through this part check
   477 00007F4F 74E8                <1>     je .okToScan
   478 00007F51 E831000000          <1>     call checkCharValid
   479 00007F56 7411                <1>     jz .badExit ;If the char is invalid, exit immediately badly
   480 00007F58 EBDF                <1>     jmp short .okToScan
   481                              <1> .wcFound:
   482 00007F5A BB41000000          <1>     mov ebx, 41h    ;Set bit 6 and bit 0
   483 00007F5F EBD8                <1>     jmp short .okToScan
   484                              <1> .wcCheck:
   485                              <1> ;This is to check we havent had any WC's upon hitting a pathsep
   486 00007F61 F7C340000000        <1>     test ebx, 40h
   487 00007F67 74D0                <1>     jz .okToScan    ;Clearly al is not a WC, so goto next char now
   488                              <1>     ;Else fall through in error
   489                              <1> .badExit:
   490 00007F69 BB01000000          <1>     mov ebx, 1  ;Totally clear ZF and set CF
   491                              <1> .exit:
