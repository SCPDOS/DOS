    98 00008576 51                  <1>     push rcx
    99 00008577 E874FFFFFF          <1>     call openShareCallWrapper
   100 0000857C 59                  <1>     pop rcx
   101 0000857D 7310                <1>     jnc .exit   ;If all good, exit! (a record has now been made by SHARE.EXE)
   102 0000857F E897FFFFFF          <1>     call shareRetryCountdown
   103 00008584 FFC9                <1>     dec ecx
   104 00008586 75E3                <1>     jnz .keepLooping
   105 00008588 E842000000          <1>     call shareCriticalError
   106 0000858D 73D5                <1>     jnc .reloadCounter  ;If user selected retry, we retry
   107                              <1> .exit:
   108 0000858F 59                  <1>     pop rcx
   109                              <1>     return
