   435                              <1> parseNameToFCB:
   436                              <1> ;rsi points to a command line to parse
   437                              <1> ;rdi points to a future unopened FCB
   438                              <1> ;al = parsing control bits. 
   439                              <1> ; al[0] = If set, leading filename separators are scanned off
   440                              <1> ; al[1] = If set, we set the drive ID byte if a drive letter was found
   441                              <1> ; al[2] = If set, will copy the filename to the FCB filename field
   442                              <1> ; al[3] = If set, will copy the extension to the FCB extension field
   443                              <1> ;
   444                              <1> ;Separators include : . ; , = + TAB SPACE
   445                              <1> ;Terminators include separators and , < > | / " [ ] and all ctrl chars
   446 00003573 C605(BF040000)00    <1>     mov byte [fcbSpaceOk], 0    ;Don't allow spaces in filename
   447 0000357A 31D2                <1>     xor edx, edx    ;Use dl to keep drive name/state of operation
   448 0000357C A802                <1>     test al, 2  ;Set drive letter
   449 0000357E 7502                <1>     jnz .skipDriveLetter
   450 00003580 8817                <1>     mov byte [rdi + fcb.driveNum], dl   ;Clear this for usage
   451                              <1> .skipDriveLetter:
   452 00003582 48FFC7              <1>     inc rdi ;Go past the drive letter field in the FCB
   453 00003585 B908000000          <1>     mov ecx, 8  ;Copy Filename
   454 0000358A A804                <1>     test al, 4  ;Do we copy the filename to the fcb field?
   455 0000358C 93                  <1>     xchg eax, ebx
   456 0000358D B020                <1>     mov al, " " ;Clear the field
   457 0000358F 7405                <1>     jz .clearFilenameField
   458 00003591 4801CF              <1>     add rdi, rcx    ;Move to the extension field of the fcb
   459 00003594 31C9                <1>     xor ecx, ecx
   460                              <1> .clearFilenameField:
   461 00003596 F3AA                <1>     rep stosb
   462 00003598 B903000000          <1>     mov ecx, 3
   463 0000359D F6C308              <1>     test bl, 8  ;Skip clearing extension field?
   464 000035A0 7405                <1>     jz .clearExtensionField
   465 000035A2 4801CF              <1>     add rdi, rcx
   466 000035A5 31C9                <1>     xor ecx, ecx
   467                              <1> .clearExtensionField:
   468 000035A7 F3AA                <1>     rep stosb
   469 000035A9 91                  <1>     xchg eax, ecx
   470 000035AA AB                  <1>     stosd   ;Initialise curBlock and recordSize like DOS does in parseFilename
   471 000035AB 4881EF10000000      <1>     sub rdi, 10h    ;Go back to head of FCB
   472 000035B2 F6C301              <1>     test bl, 1  ;Skip scanning preceeding spaces
   473 000035B5 740F                <1>     jz .dontScanOffTerm
   474 000035B7 E89F000000          <1>     call skipSeparators ;Skip leading separators
   475 000035BC E86B480000          <1>     call isCharTerminator   ;If first char is terminator, go past and keep skipping
   476 000035C1 7508                <1>     jnz .skipIfNotTerminator
   477 000035C3 48FFC6              <1>     inc rsi
   478                              <1> .dontScanOffTerm:
   479 000035C6 E890000000          <1>     call skipSeparators  ;Skip separators
   480                              <1> .skipIfNotTerminator:
   481 000035CB E834480000          <1>     call uppercaseCharAtPtr 
   482 000035D0 741E                <1>     jz .skipSettingDriveLetter  ;Skip if first char not a possible drive letter
   483 000035D2 803E3A              <1>     cmp byte [rsi], ":" ;Is the next char a drive separator?
   484 000035D5 7519                <1>     jne .skipSettingDriveLetter
   485 000035D7 48FFC6              <1>     inc rsi ;Goto next char
   486 000035DA 2C40                <1>     sub al, "@" ;Convert into a 1 based drive number
   487 000035DC 7609                <1>     jbe .invalidDriveLetter ;If less than 0 or 0, fail
   488 000035DE 50                  <1>     push rax    ;Save the 1 based drive letter
   489 000035DF E818470000          <1>     call getCDSNotJoin   ;Verifies if this drive letter is valid
   490 000035E4 58                  <1>     pop rax
   491 000035E5 7302                <1>     jnc .validDriveLetter
   492                              <1> .invalidDriveLetter:
   493 000035E7 B2FF                <1>     mov dl, -1
   494                              <1> .validDriveLetter:
   495 000035E9 AA                  <1>     stosb
   496 000035EA 48FFC6              <1>     inc rsi ;Align pointers...
   497 000035ED 48FFCF              <1>     dec rdi 
