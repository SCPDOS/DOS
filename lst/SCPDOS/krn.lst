  1870                              <1> ;First pull the file attribute off the stack and put it in SFT
  1871 0000486C 488B442408          <1>     mov rax, qword [rsp + 8h]
  1872 00004871 884604              <1>     mov byte [rsi + sft.bFileAttrib], al
  1873                              <1> ;Check if we are handling a volume label
  1874 00004874 A808                <1>     test al, attrFileVolLbl  ;Are we creating a volume label?
  1875 00004876 7423                <1>     jz .notVolLbl   ;Bit not set? Jump!
  1876                              <1> ;If we are, the previous search wouldn't have searched for all volids. 
  1877                              <1> ; Now check for any volids. 
  1878 00004878 C605(91040000)FF    <1>     mov byte [volIdFlag], -1    ;Set the volid search bit
  1879 0000487F 56                  <1>     push rsi                    ;Save the current SFT ptr in rsi
  1880 00004880 E867C9FFFF          <1>     call searchDir              ;Searches the root dir
  1881 00004885 5E                  <1>     pop rsi
