   383                              <1> truncateFAT:
   384                              <1> ;Same as below but always sets the cluster we are unlinking at to EOC.
   385                              <1> ;Input: eax = Cluster to start unlinking at (zero extended to 32 bits)
   386                              <1> ;       rbp = Current DPB to use for disk
   387                              <1> ;Output: CF = NC => All ok. CF = CY => Hard Error, exit
   388 00000CFC 50                  <1>     push rax    ;Save the cluster number to start unlinking at
   389 00000CFD 56                  <1>     push rsi
   390 00000CFE E82B000000          <1>     call freeChainFAT   ;Preserves eax, frees the full chain.
   391 00000D03 721B                <1>     jc .exit
   392 00000D05 BEFFFFFFFF          <1>     mov esi, -1         ;Realloc the cluster we are freeing from as EOC
   393 00000D0A 50                  <1>     push rax            ;Save the cluster we are writing at
   394 00000D0B E804010000          <1>     call writeFAT
   395 00000D10 58                  <1>     pop rax
   396 00000D11 720D                <1>     jc .exit
   397 00000D13 E8DC010000          <1>     call decrementFreeClusterCount  ;Remove it from the free cluster count!
   398                              <1> .setFree:
   399                              <1> ;Do this stuff here, because we want to update the free count too!
   400 00000D18 89452D              <1>     mov dword [rbp + dpb.dNextFreeClst], eax ;And set this to search from
   401 00000D1B E86C020000          <1>     call writeFSInfoSector  ;New first free cluster values
   402                              <1> .exit:
   403 00000D20 5E                  <1>     pop rsi
   404 00000D21 58                  <1>     pop rax
   405                              <1>     return
    13                              <2> %%_ret:
    14 00000D22 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   406                              <1> unlinkFAT:
   407                              <1> ;Given a cluster number, will free the cluster and walk the FAT until the first
   408                              <1> ; cluster number considered EOC is found. The given cluster number MUST be
   409                              <1> ; the start cluster of a chain, or at least the cluster linking to the given
   410                              <1> ; cluster must be set to EOC before this proc is called.
   411                              <1> ;Stops at first invalid cluster number.
   412                              <1> ;
   413                              <1> ;Input: eax = Cluster to start unlinking at (zero extended to 32 bits)
   414                              <1> ;       rbp = Current DPB to use for disk
   415                              <1> ;Output: CF = NC => All ok. CF = CY => Hard Error, exit
   416                              <1> 
   417 00000D23 50                  <1>     push rax    ;Save the cluster number to start unlinking at
   418 00000D24 56                  <1>     push rsi
   419                              <1> ;The below call decrements the cluster count for the full chain freed including
   420                              <1> ; the starting cluster address.
   421 00000D25 E804000000          <1>     call freeChainFAT    ;Preserved eax. May set eax to first free cluster.
   422 00000D2A 73EC                <1>     jnc truncateFAT.setFree ;Set the first free sector to eax
   423 00000D2C EBF2                <1>     jmp short truncateFAT.exit  ;If an error, skip updating the FSInfo sector
   424                              <1> 
   425                              <1> freeChainFAT:
   426                              <1> ;Given a cluster number, will set that cluster to EOC and walk the FAT freeing 
   427                              <1> ; each cluster until the firstcluster number considered EOC is found. The given 
   428                              <1> ; cluster number MUST be the start cluster of a chain, or at least the cluster 
   429                              <1> ; linking to the given cluster must be set to EOC before this proc is called.
   430                              <1> ;Stops at first invalid cluster number.
   431                              <1> ;
   432                              <1> ;Input: eax = Cluster to start unlinking at (zero extended to 32 bits)
   433                              <1> ;       rbp = Current DPB to use for disk
   434                              <1> ;Output: CF = NC => All ok. CF = CY => Hard Error, exit
   435 00000D2E 50                  <1>     push rax
   436 00000D2F 53                  <1>     push rbx
   437 00000D30 51                  <1>     push rcx
   438 00000D31 56                  <1>     push rsi
   439 00000D32 89C3                <1>     mov ebx, eax    ;Store the current cluster we are at in ebx
   440                              <1> .lp:
   441 00000D34 E824000000          <1>     call readFAT    ;Get the value of the cluster at this location in eax
   442 00000D39 721D                <1>     jc .exit    ;Error exit
   443 00000D3B 89C1                <1>     mov ecx, eax   ;Move chain marker to ecx
   444 00000D3D 93                  <1>     xchg eax, ebx  ;Move clust. to write at in eax and save next cluster in ebx
   445 00000D3E 31F6                <1>     xor esi, esi   ;Free cluster at eax (write a 0)
   446 00000D40 E8CF000000          <1>     call writeFAT
   447 00000D45 7211                <1>     jc .exit    ;Error exit
   448 00000D47 E899010000          <1>     call incrementFreeClusterCount  ;Successfully freed the cluster
   449 00000D4C 81F9FFFFFFFF        <1>     cmp ecx, -1 ;End of chain?
   450 00000D52 7404                <1>     je .exit
   451 00000D54 89D8                <1>     mov eax, ebx    ;Move next cluster into eax
   452 00000D56 EBDC                <1>     jmp short .lp
   453                              <1> .exit:
   454 00000D58 5E                  <1>     pop rsi
   455 00000D59 59                  <1>     pop rcx
   456 00000D5A 5B                  <1>     pop rbx
   457 00000D5B 58                  <1>     pop rax
   458                              <1>     return
    13                              <2> %%_ret:
    14 00000D5C C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   459                              <1> readFAT:
   460                              <1> ;Given a cluster number, it gives us the next cluster in the cluster chain
   461                              <1> ; or -1 to indicate end of cluster chain on the device with workingDPB
   462                              <1> ;Input: eax = Cluster number (zero extended to 32 bits)
   463                              <1> ;       rbp = DPB
   464                              <1> ;Output: eax = Next Cluster number (-1 indicates end of chain)
   465                              <1> ;If carry set, getBuffer failed!
   466 00000D5D 53                  <1>     push rbx
   467 00000D5E 51                  <1>     push rcx
   468 00000D5F 52                  <1>     push rdx
   469 00000D60 57                  <1>     push rdi
   470 00000D61 55                  <1>     push rbp
   471                              <1> ;Do a sanity check on the input cluster. 
   472 00000D62 E8D1020000          <1>     call checkClusterValid
   473 00000D67 7537                <1>     jnz .eocExit
   474 00000D69 7404                <1>     jz .clusterOK   ;No issues!
   475 00000D6B 7240                <1>     jc .exitFail    ;If the cluster requested was past last, exit error
   476 00000D6D 7331                <1>     jnc .eocExit    ;If the cluster requested was 0 or 1, exit EOC
   477                              <1> .clusterOK:
   478 00000D6F 89C7                <1>     mov edi, eax    ;Save cluster number in edi
   479 00000D71 E840FDFFFF          <1>     call clust2FATEntry ;Returns sector in FAT in eax, offset in sector in edx
   480                              <1>     ;and FAT type in ecx
   481 00000D76 E8FBFCFFFF          <1>     call getBufForFat ;Buffer Header in ebx, first buffer being requested
   482 00000D7B 7230                <1>     jc .exitFail
   483                              <1>     ;Check if FAT 12, 16, 32
   484 00000D7D 81F901000000        <1>     cmp ecx, 1
   485 00000D83 722E                <1>     jb .gotoNextClusterFat12
   486 00000D85 770E                <1>     ja .goToNextClusterFat32
   487                              <1>     ;Here we handle FAT16
   488 00000D87 0FB7441320          <1>     movzx eax, word [rbx + bufferHdr.dataarea + rdx]
   489 00000D8C 3DF7FF0000          <1>     cmp eax, 0FFF7h  ;Valid cluster number?
   490 00000D91 7219                <1>     jb .exit
   491 00000D93 EB0B                <1>     jmp short .eocExit
   492                              <1> .goToNextClusterFat32:
   493 00000D95 8B441320            <1>     mov eax, dword [rbx + bufferHdr.dataarea + rdx]
   494 00000D99 3DF7FFFF0F          <1>     cmp eax, 0FFFFFF7h ;First reserved value. Any Reserved number = EOC
   495 00000D9E 7207                <1>     jb .validCluster32   
   496                              <1> .eocExit:
   497 00000DA0 B8FFFFFFFF          <1>     mov eax, -1 ;Always translate it to -1 and skip zeroing upper nybble
   498 00000DA5 EB05                <1>     jmp short .exit
   499                              <1> .validCluster32:
   500 00000DA7 25FFFFFF0F          <1>     and eax, 0FFFFFFFh  ;Zero upper nybble
   501                              <1> .exit:
   502 00000DAC F8                  <1>     clc
   503                              <1> .exitFail:
   504 00000DAD 5D                  <1>     pop rbp
   505 00000DAE 5F                  <1>     pop rdi
   506 00000DAF 5A                  <1>     pop rdx
   507 00000DB0 59                  <1>     pop rcx
   508 00000DB1 5B                  <1>     pop rbx
   509                              <1>     return
    13                              <2> %%_ret:
    14 00000DB2 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   510                              <1> .gotoNextClusterFat12:
   511                              <1> ;eax has the sector number of the FAT
   512                              <1> ;edx has byte offset into the sector
   513                              <1> ;edi has current cluster number
   514                              <1> ;rbx has ptr to buffer header
   515 00000DB3 0FB74D02            <1>     movzx ecx, word [rbp + dpb.wBytesPerSector]
   516 00000DB7 F7C701000000        <1>     test edi, 1  ;Check if cluster is odd
   517 00000DBD 741C                <1>     jz .gotoNextClusterFat12Even
   518                              <1>     ;Here the cluster is ODD, and might cross sector boundary
   519 00000DBF 29D1                <1>     sub ecx, edx
   520 00000DC1 FFC9                <1>     dec ecx ;If edx = BytesPerSector - 1 then it crosses, else no
   521 00000DC3 750C                <1>     jnz .gotoNextClusterFat12OddNoX
   522 00000DC5 E833000000          <1>     call .xBndry        ;Boundary cross, build entry properly
   523 00000DCA 72E1                <1>     jc .exitFail    
   524 00000DCC C1E804              <1>     shr eax, 4   ;Save upper three nybbles of loword, eax has cluster num
   525 00000DCF EB23                <1>     jmp short .checkIfLastFAT12Cluster
   526                              <1> .gotoNextClusterFat12OddNoX:
   527 00000DD1 0FB7441320          <1>     movzx eax, word [rbx + bufferHdr.dataarea + rdx]    ;Read the entry
   528 00000DD6 C1E804              <1>     shr eax, 4   ;Save upper three nybbles of loword, eax has cluster num
   529 00000DD9 EB19                <1>     jmp short .checkIfLastFAT12Cluster
   530                              <1> .gotoNextClusterFat12Even:
   531 00000DDB 29D1                <1>     sub ecx, edx
   532 00000DDD FFC9                <1>     dec ecx ;If edx = BytesPerSector - 1 then it crosses, else no
   533 00000DDF 7509                <1>     jnz .gotoNextClusterFat12EvenNoX
   534 00000DE1 E817000000          <1>     call .xBndry    ;Save the lower three nybbles
   535 00000DE6 72C5                <1>     jc .exitFail
   536 00000DE8 EB05                <1>     jmp short .evenCmn
   537                              <1> .gotoNextClusterFat12EvenNoX:
   538                              <1>     ;Here the cluster is even and can't cross a sector boundary
   539 00000DEA 0FB7441320          <1>     movzx eax, word [rbx + bufferHdr.dataarea + rdx]    ;Read the entry
   540                              <1> .evenCmn:
   541 00000DEF 25FF0F0000          <1>     and eax, 0FFFh   ;Save lower three nybbles, eax has cluster num
   542                              <1> .checkIfLastFAT12Cluster:
   543 00000DF4 3DF70F0000          <1>     cmp eax, 0FF7h   ;Is it below the first invalid cluster number?
   544 00000DF9 72B1                <1>     jb .exit         ;If so, exit with it in eax (and clear CF)
   545 00000DFB EBA3                <1>     jmp short .eocExit
   546                              <1> .xBndry:
   547                              <1> ;Gets a word that goes across a boundary in ax. It is left to the caller it 
   548                              <1> ; do what they will with it. If CF=CY on return, something went wrong.
   549 00000DFD 0FB65C1320          <1>     movzx ebx, byte [rbx + bufferHdr.dataarea + rdx] ;Use ebx as it is free
   550 00000E02 FFC0                <1>     inc eax ;Get next FAT sector
   551 00000E04 53                  <1>     push rbx
   552 00000E05 E86CFCFFFF          <1>     call getBufForFat ;Get buffer Header in ebx
   553 00000E0A 59                  <1>     pop rcx ;Get bl in ecx, the last entry from the previous buffer
   554                              <1>     retc
