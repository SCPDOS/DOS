    34                              <1> getsetCountryInfo: ;ah = 38h, localisation info
    35                              <1> ;---------------------------------------------------------
    36                              <1> ;Common input registers
    37                              <1> ;al = Country code, 0 means current country info.
    38                              <1> ;bx = Country code if al = -1.
    39                              <1> ;Get country info:
    40                              <1> ;   rdx -> Buffer for the country table (not extended table)
    41                              <1> ;Set country info:
    42                              <1> ;   rdx = -1
    43                              <1> ;---------------------------------------------------------
    44                              <1> ;Return:
    45                              <1> ;Get country info:
    46                              <1> ;   CF=CY -> Error, ax = Error code
    47                              <1> ;   CF=NC -> OK, ax=bx=Country code, buffer @ rdx filled
    48                              <1> ;Set country info:
    49                              <1> ;   CF=CY -> Error, ax = Error code
    50                              <1> ;   CF=NC -> OK
    51                              <1> ;---------------------------------------------------------
    52 00006A94 4889D7              <1>     mov rdi, rdx    ;Move the pointer/set indicator to rdi
    53 00006A97 0FB6D0              <1>     movzx edx, al   ;Move potential partial country code, zx to edx
    54 00006A9A 3CFF                <1>     cmp al, -1      ;Does bx have the country code?
    55 00006A9C 0F45DA              <1>     cmovne ebx, edx ;If not, move it there
    56 00006A9F 31ED                <1>     xor ebp, ebp    ;Get country table
    57 00006AA1 B901000000          <1>     mov ecx, 1      ;Set country table
    58 00006AA6 4881FFFFFFFFFF      <1>     cmp rdi, -1     ;Set or Get?
    59 00006AAD 7429                <1>     je .goToNlsFuncSet ;If set, immediately goto nls func
    60 00006AAF 85DB                <1>     test ebx, ebx   ;Else, in get, are we looking for current country?
    61 00006AB1 7527                <1>     jnz .goToNlsFunc    ;If not zero, goto nls func
    62                              <1>     ;Get current country info here, works w/o NLSFUNC
    63                              <1> .copyCountryTable:
    64 00006AB3 488D35C097FFFF      <1>     lea rsi, ctryTbl
    65 00006ABA B926000000          <1>     mov ecx, countryStruc_size
    66 00006ABF F3A4                <1>     rep movsb
    67 00006AC1 0FB71DAE97FFFF      <1>     movzx ebx, word [extCtryTbl.countryCode]    ;Get current country code
    68                              <1> .exitWithCountryCode:
    69 00006AC8 E86F0D0000          <1>     call getUserRegs
    70 00006ACD 66895E08            <1>     mov word [rsi + callerFrame.rbx], bx    ;And store it in users bx
    71                              <1> .exitNoCountryCode: 
    72 00006AD1 89D8                <1>     mov eax, ebx    ;Move country code into eax for return (undocumented)
    73 00006AD3 E934120000          <1>     jmp extGoodExit
    74                              <1> .goToNlsFuncSet:
    75 00006AD8 89CD                <1>     mov ebp, ecx    ;Also set ebp to 1
    76                              <1> .goToNlsFunc:
    77 00006ADA E812000000          <1>     call .nlsWrap   ;Access NLS functionality
    78 00006ADF 0F8235120000        <1>     jc extErrExit   ;If CF=CY, exit error (error code in al)
    79 00006AE5 85ED                <1>     test ebp, ebp   ;If set, exit, else get, we may need to copy data
    80 00006AE7 75E8                <1>     jnz .exitNoCountryCode 
    81 00006AE9 85DB                <1>     test ebx, ebx   ;If ebx = 0, we entered NLS and data copied for us.
    82 00006AEB 75C6                <1>     jnz .copyCountryTable   ; If not, we gotta copy from our internal copy.
    83 00006AED 89D3                <1>     mov ebx, edx    ;Move the country code into ebx
    84 00006AEF EBD7                <1>     jmp short .exitWithCountryCode
    85                              <1> .nlsWrap:
    86                              <1> ;Subroutine to wrap NLS functions. Should do nothing if we are looking
    87                              <1> ; for the current country (to avoid hitting NLSFUNC and erroring if
    88                              <1> ; not installed).
    89                              <1> ;Input: ebp = 0 -> Get country info
    90                              <1> ;           = 1 -> Set DOS country info
    91                              <1> ;        bx = Country code (bx <> 0 here)
    92                              <1> ;       rdi -> User buffer
    93                              <1> ;       rsi -> DOS internal NLS structure
    94                              <1> ;Output: CF = CY -> Error, al has error code (-1 is generic error)
    95                              <1> ;        CF = NC -> OK
    96                              <1> ;        bx = 0 => Entered NLS and data copied to user buffer.
    97                              <1> ;           > 0 => User requested current country code. Data NOT copied.
    98                              <1> ;All other registers remain the unaffected.
    99 00006AF1 663B1D7E97FFFF      <1>     cmp bx, word [extCtryTbl.countryCode]   ;No NLS access if current ctry.
   100                              <1>     rete
    49                              <2> cret e
