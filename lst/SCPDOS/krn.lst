   901 00003EDC 668915(BC070000)    <1>     mov word [wEOActions], dx   ;Save these bit for later
   902 00003EE3 488935(C2070000)    <1>     mov qword [pszEOfile], rsi  ;Save filename ptr
   903                              <1> ;Now we sanity check that what we have is meaningful
   904 00003EEA 84C0                <1>     test al, al
   905 00003EEC 740A                <1>     jz .okStart
   906                              <1> .badParmExit:
   907 00003EEE B857000000          <1>     mov eax, errBadParam
   908 00003EF3 E97B3D0000          <1>     jmp extErrExit
   909                              <1> .okStart:
   910 00003EF8 84D2                <1>     test dl, dl                 ;Are we a fail if exist and dont exist?
   911 00003EFA 74F2                <1>     jz .badParmExit
   912 00003EFC 66F7C2ECFF          <1>     test dx, ~(eoActCreate | eoActOpen | eoActTruncate)
   913 00003F01 75EB                <1>     jnz .badParmExit    ;If set any bits we are not allowed to set, fail!
   914 00003F03 80E203              <1>     and dl, eoActOpen | eoActTruncate   ;Isolate the file exist bits
   915 00003F06 80FA03              <1>     cmp dl, eoActOpen | eoActTruncate   ;They cannot both be set
   916 00003F09 74E3                <1>     je .badParmExit     
   917                              <1> ;Test to check if the force fail bit is set
