   590                              <1> .gotoNextClusterFat12:
   591                              <1> ;FAT12 might need two FAT sectors read so we always read two sectors
   592                              <1> ;eax has the sector number of the FAT
   593                              <1> ;edx has byte offset into the sector
   594                              <1> ;edi has current cluster number
   595                              <1> ;rbx has ptr to buffer header
   596 00000E60 0FB74D02            <1>     movzx ecx, word [rbp + dpb.wBytesPerSector]
   597 00000E64 81E6FF0F0000        <1>     and esi, 0FFFh  ;Clear the upper bits. Save only low 12 bits
   598 00000E6A F7C701000000        <1>     test edi, 1  ;Check if cluster is odd
   599 00000E70 7432                <1>     jz .gotoNextClusterFat12Even
   600                              <1>     ;Here the cluster is ODD, and might cross sector boundary
   601 00000E72 29D1                <1>     sub ecx, edx
   602 00000E74 FFC9                <1>     dec ecx ;If edx = BytesPerSector - 1 then it crosses, else no
   603 00000E76 7556                <1>     jnz .gotoNextClusterFat12OddNoX
   604                              <1>     ;Boundary cross, build entry properly
   605                              <1>     ;Replace the high nybble of the low byte
   606 00000E78 0FB64C1320          <1>     movzx ecx, byte [rbx + bufferHdr.dataarea + rdx] ;Use ecx as it is free
   607 00000E7D 81E10F000000        <1>     and ecx, 0Fh    ;Clear the high nybble
   608 00000E83 C1E604              <1>     shl esi, 4  ;Shift value up by 4 to insert the low nybble in the right place
   609 00000E86 09F1                <1>     or ecx, esi ;Add low nybble of esi to upper nybble of ecx
   610 00000E88 C1EE08              <1>     shr esi, 8  ;Move upper byte to lower byte of esi
   611 00000E8B 884C1320            <1>     mov byte [rbx + bufferHdr.dataarea + rdx], cl
   612 00000E8F E876FAFFFF          <1>     call markBufferDirty
   613 00000E94 FFC0                <1>     inc eax ;Get next FAT sector
   614 00000E96 E8BEFBFFFF          <1>     call getBufForFat ;Get buffer Header in ebx
   615 00000E9B 72BC                <1>     jc .exitFail
   616 00000E9D 89F1                <1>     mov ecx, esi    ;Get the high byte of the entry into cl
   617 00000E9F 884B20              <1>     mov byte [rbx + bufferHdr.dataarea], cl  ;Write entry
   618 00000EA2 EBAF                <1>     jmp short .exit
   619                              <1> .gotoNextClusterFat12Even:
   620 00000EA4 29D1                <1>     sub ecx, edx
   621 00000EA6 FFC9                <1>     dec ecx ;If edx = BytesPerSector - 1 then it crosses, else no
   622 00000EA8 7533                <1>     jnz .gotoNextClusterFat12EvenNoX
   623 00000EAA 89F1                <1>     mov ecx, esi
   624 00000EAC 80E50F              <1>     and ch, 0Fh ;Save only the lower nybble of ch
   625 00000EAF 884C1320            <1>     mov byte [rbx + bufferHdr.dataarea + rdx], cl   ;Store the first byte
   626 00000EB3 E852FAFFFF          <1>     call markBufferDirty
   627 00000EB8 FFC0                <1>     inc eax ;Get next FAT sector
   628 00000EBA E89AFBFFFF          <1>     call getBufForFat
   629 00000EBF 7298                <1>     jc .exitFail
   630 00000EC1 8A4B20              <1>     mov cl, byte [rbx + bufferHdr.dataarea] ;Get the first data byte from buffer
   631 00000EC4 80E1F0              <1>     and cl, 0F0h    ;Clear the lower nybble of this entry
   632 00000EC7 08E9                <1>     or cl, ch       ;Add our entry in
   633 00000EC9 884B20              <1>     mov byte [rbx + bufferHdr.dataarea], cl ;Write it back
   634 00000ECC EB85                <1>     jmp short .exit    
   635                              <1> .gotoNextClusterFat12OddNoX:
   636 00000ECE 0FB7441320          <1>     movzx eax, word [rbx + bufferHdr.dataarea + rdx]    ;Read the entry
   637 00000ED3 250F000000          <1>     and eax, 0Fh    ;Clear the upper three nybbles of entry (the entry)
   638 00000ED8 C1E604              <1>     shl esi, 4  ;Shift entry up by 4
   639 00000EDB EB0A                <1>     jmp short .fat12common
   640                              <1> .gotoNextClusterFat12EvenNoX:
   641                              <1>     ;Here the cluster is even and can't cross a sector boundary
   642 00000EDD 0FB7441320          <1>     movzx eax, word [rbx + bufferHdr.dataarea + rdx]    ;Read the entry
   643 00000EE2 2500F00000          <1>     and eax, 0F000h ;Clear the lower three nybbles of entry (the entry)
   644                              <1> .fat12common:
   645 00000EE7 09F0                <1>     or eax, esi     ;Add the new entry bits
   646 00000EE9 6689441320          <1>     mov word [rbx + bufferHdr.dataarea + rdx], ax   ;Replace the entry
   647 00000EEE E960FFFFFF          <1>     jmp .exit
