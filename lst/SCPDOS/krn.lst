    92                              <1> .reloadCounter:
    93 00008564 0FB70D(27000000)    <1>     movzx ecx, word [shareCount] ;Try to allocate resources, this many times
    94                              <1> .keepLooping:
    95 0000856B E8D9CDFFFF          <1>     call getCurrentSFT
    96 00008570 31C0                <1>     xor eax, eax
