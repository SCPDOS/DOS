   182 00006DBF 488B25(92040000)    <1>     mov rsp, qword [xInt24hRSP] ;Ret to DOS stack for failing device
   183 00006DC6 C605(37040000)00    <1>     mov byte [critErrFlag], 0   ;Clear critical error flag
   184 00006DCD FE05(38040000)      <1>     inc byte [inDOS]            ;Reenter DOS
