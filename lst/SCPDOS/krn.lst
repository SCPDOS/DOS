   979 0000192F 0F848D000000        <1>     jz .cpsSkipPathseps ; and then exit with the final converted pathsep in al
   980 00001935 3C2E                <1>     cmp al, "." ;Filename extension separator
   981 00001937 7420                <1>     je .cpsExtension
   982                              <1>     ;If we have space in the filename, we check to see if the next char is *
   983 00001939 3C2A                <1>     cmp al, "*" ;Wildcard?
   984 0000193B 7430                <1>     je .cpsWildcard
   985 0000193D 3C3F                <1>     cmp al, "?" ;Good wildcard?
   986 0000193F 740C                <1>     je .store
   987 00001941 E823600000          <1>     call uppercaseChar  ;Uppercase the char if it needs to be...
   988 00001946 E8A0610000          <1>     call checkCharValid ; and check it is a valid char
   989 0000194B 7472                <1>     je .cpsExitError
   990                              <1> .store:
