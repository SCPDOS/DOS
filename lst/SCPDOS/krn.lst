   325 00003492 7518                <1>     jnz .okToGo ;If the file is a char dev, its always ok for FileIO
   326 00003494 E8AB470000          <1>     call testCDSNet ;If CF=CY => Net CDS (with and without CDS)
   327 00003499 7218                <1>     jc .exit
   328                              <1>     ;rdi has cds ptr now
   329 0000349B 488B6F45            <1>     mov rbp, qword [rdi + cds.qDPBPtr]  ;Get dpb ptr in rbp
   330 0000349F E8F3D5FFFF          <1>     call getFATtype
   331 000034A4 81F901000000        <1>     cmp ecx, 1  ;0 = FAT12, 1 = FAT16
   332 000034AA 7707                <1>     ja .exit
   333                              <1> .okToGo:
