   598                              <1> .gotoNextClusterFat12:
   599                              <1> ;FAT12 might need two FAT sectors read so we always read two sectors
   600                              <1> ;eax has the sector number of the FAT
   601                              <1> ;edx has byte offset into the sector
   602                              <1> ;edi has current cluster number
   603                              <1> ;rbx has ptr to buffer header
   604 00000E43 0FB74D02            <1>     movzx ecx, word [rbp + dpb.wBytesPerSector]
   605 00000E47 81E6FF0F0000        <1>     and esi, 0FFFh  ;Clear the upper bits. Save only low 12 bits
   606 00000E4D F7C701000000        <1>     test edi, 1  ;Check if cluster is odd
   607 00000E53 7432                <1>     jz .gotoNextClusterFat12Even
   608                              <1>     ;Here the cluster is ODD, and might cross sector boundary
   609 00000E55 29D1                <1>     sub ecx, edx
   610 00000E57 FFC9                <1>     dec ecx ;If edx = BytesPerSector - 1 then it crosses, else no
   611 00000E59 7556                <1>     jnz .gotoNextClusterFat12OddNoX
   612                              <1>     ;Boundary cross, build entry properly
   613                              <1>     ;Replace the high nybble of the low byte
