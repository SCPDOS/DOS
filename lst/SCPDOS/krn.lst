   450                              <1> ;SPECIAL BUFFER FUNCTIONS
   451                              <1> ;Buffer functions for sectors associated to file handles and specific purposes
   452                              <1> ; ALL sector types need to setup [workingDPB] to make the transfer
   453                              <1> ;-----------------------------------------------------------------------------
   454                              <1> getBufForDOS:
   455                              <1> ;Returns a buffer to use for DOS sector(s) in rbx
   456                              <1> ;Input: [workingDPB] = DPB to transact on
   457                              <1> ;       rax = Sector to transfer
   458                              <1> ;Output: rbx = Buffer to use or if CF=CY, error rbx = Undefined
   459 00000A54 51                  <1>     push rcx
   460 00000A55 B101                <1>     mov cl, dosBuffer
   461 00000A57 EB0D                <1>     jmp short getBufCommon
   462                              <1> getBufForFat:
   463                              <1> ;Returns a buffer to use for fat data in rbx
   464                              <1> ;Input: [workingDPB] = DPB to transact on
   465                              <1> ;       rax = Sector to transfer
   466                              <1> ;Output: rbx = Buffer to use or if CF=CY, error rbx = Undefined
   467 00000A59 51                  <1>     push rcx
   468 00000A5A B102                <1>     mov cl, fatBuffer
   469 00000A5C EB08                <1>     jmp short getBufCommon
   470                              <1> getBufForDir:
   471                              <1> ;Returns a buffer to use for disk directory data in rbx
   472                              <1> ;Input: [workingDPB] = File to manipulate
   473                              <1> ;       rax = Sector to transfer
   474                              <1> ;Output: rbx = Buffer to use or if CF=CY, error rbx = Undefined
   475 00000A5E 51                  <1>     push rcx
   476 00000A5F B104                <1>     mov cl, dirBuffer
   477 00000A61 EB03                <1>     jmp short getBufCommon
   478                              <1> getBufForData:
   479                              <1> ;Returns a buffer to use for disk data in rbx
   480                              <1> ;Requires a File Handle.
   481                              <1> ;Input: [workingDPB] = File to manipulate
   482                              <1> ;       rax = Sector to transfer
   483                              <1> ;Output: rbx = Buffer to use or if CF=CY, error rbx = Undefined
   484 00000A63 51                  <1>     push rcx
   485 00000A64 B108                <1>     mov cl, dataBuffer
   486                              <1> getBufCommon:
   487 00000A66 52                  <1>     push rdx
   488 00000A67 57                  <1>     push rdi
   489 00000A68 55                  <1>     push rbp
   490 00000A69 488B2D(3B070000)    <1>     mov rbp, qword [workingDPB] ;Get working DPB 
   491 00000A70 E8A5FEFFFF          <1>     call getBuffer  ;Gives the buffer ptr in rbx
   492 00000A75 5D                  <1>     pop rbp
   493 00000A76 5F                  <1>     pop rdi
   494 00000A77 5A                  <1>     pop rdx
   495 00000A78 59                  <1>     pop rcx
   496                              <1>     return
    13                              <2> %%_ret:
    14 00000A79 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
    35                                  %include "./src/dos/Kernel/FAT/fat.asm"
     1                              <1> ;-----------------------------------:
     2                              <1> ;       File System routines        :
     3                              <1> ;-----------------------------------:
     4                              <1> getFATtype:
     5                              <1> ;Gets a pointer to a DPB and returns the FAT type on the drive
     6                              <1> ;Entry: rbp = DPB to ascertain FAT
     7                              <1> ;Exit: ecx = 0 => FAT 12, ecx = 1 => FAT 16, ecx = 2 => FAT 32
     8 00000A7A 53                  <1>     push rbx
     9 00000A7B 8B5D0F              <1>     mov ebx, dword [rbp + dpb.dMaxClusterAddr]
    10 00000A7E B902000000          <1>     mov ecx, 2  ;FAT 32 marker
    11 00000A83 81FBF5FF0000        <1>     cmp ebx, fat16MaxClustCnt
    12 00000A89 730C                <1>     jae .exit
    13 00000A8B FFC9                <1>     dec ecx     ;FAT 16 marker
    14 00000A8D 81FBF50F0000        <1>     cmp ebx, fat12MaxClustCnt
    15 00000A93 7302                <1>     jae .exit
    16 00000A95 FFC9                <1>     dec ecx     ;FAT 12 marker
    17                              <1> .exit:
    18 00000A97 5B                  <1>     pop rbx
    19                              <1>     return
    13                              <2> %%_ret:
    14 00000A98 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
    20                              <1> 
    21                              <1> clust2FATEntry:
    22                              <1> ;Converts a cluster number to a offset in the FAT
    23                              <1> ;Entry:  Uses the workingDPB to convert cluster number
    24                              <1> ;        eax = Cluster number to look for
    25                              <1> ;Exit:   eax = Sector on disk of FAT 
    26                              <1> ;        ecx = 0 => FAT12, 1 => FAT16, 2 => FAT32
    27                              <1> ;        edx = 1.5Byte/Word/DWord in sector of entry
    28 00000A99 53                  <1>     push rbx
    29 00000A9A 55                  <1>     push rbp
    30 00000A9B 488B2D(3B070000)    <1>     mov rbp, qword [workingDPB]
    31 00000AA2 8B5D0F              <1>     mov ebx, dword [rbp + dpb.dMaxClusterAddr]
    32 00000AA5 81FBF5FF0000        <1>     cmp ebx, fat16MaxClustCnt
    33 00000AAB 731E                <1>     jae .fat32
    34 00000AAD 81FBF50F0000        <1>     cmp ebx, fat12MaxClustCnt
    35 00000AB3 7209                <1>     jb .fat12
    36                              <1> ;FAT16
    37 00000AB5 D1E0                <1>     shl eax, 1  ;Multiply cluster number by 2
    38 00000AB7 6801000000          <1>     push qword 1
    39 00000ABC EB15                <1>     jmp short .common
    40                              <1> .fat12:
    41 00000ABE 89C1                <1>     mov ecx, eax    ;ecx = eax
    42 00000AC0 D1E9                <1>     shr ecx, 1      ;ecx = ecx / 2
    43 00000AC2 01C8                <1>     add eax, ecx    ;eax = eax + ecx    (eax * 1.5)
    44 00000AC4 6800000000          <1>     push qword 0
    45 00000AC9 EB08                <1>     jmp short .common
    46                              <1> .fat32:
    47 00000ACB 6802000000          <1>     push qword 2
    48 00000AD0 C1E002              <1>     shl eax, 2  ;Multiply cluster number by 4
    49                              <1> .common:
    50                              <1> ;eax has the FAToffset
    51 00000AD3 0FB74D02            <1>     movzx ecx, word [rbp + dpb.wBytesPerSector]
    52 00000AD7 31D2                <1>     xor edx, edx    ;edx = 0
    53 00000AD9 F7F1                <1>     div ecx         ;Divide by bytes per sector (0:eax / ecx)
    54 00000ADB 0FB75D06            <1>     movzx ebx, word [rbp + dpb.wFAToffset]   ;Add the offset to the first FAT
    55 00000ADF 01D8                <1>     add eax, ebx
    56 00000AE1 59                  <1>     pop rcx ;Pop the FAT type back into rcx
    57 00000AE2 5D                  <1>     pop rbp
    58 00000AE3 5B                  <1>     pop rbx
    59                              <1>     return
    13                              <2> %%_ret:
    14 00000AE4 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
    60                              <1> 
    61                              <1> getStartSectorOfCluster:
    62                              <1> ;Input: eax = Cluster Number
    63                              <1> ;       rbp = dpb pointer
    64                              <1> ;Output: rax = Starting Sector number for cluster
    65                              <1> ;Gives the data sector we are at in the current cluster
    66                              <1> ;Start Sector = (ClusterNumber - 2)*SecPerClust + DataAreaStartSector
    67 00000AE5 51                  <1>     push rcx
    68 00000AE6 09C0                <1>     or eax, eax ;Zero upper dword
    69 00000AE8 7416                <1>     jz .rootDir ;If eax is zero, that is an alias for Root Directory
    70                              <1> .fat32Root:
    71 00000AEA 482D02000000        <1>     sub rax, 2
    72 00000AF0 8A4D05              <1>     mov cl, byte [rbp + dpb.bSecPerClustShift]
    73 00000AF3 48D3E0              <1>     shl rax, cl
    74 00000AF6 31C9                <1>     xor ecx, ecx
    75 00000AF8 8B4D0B              <1>     mov ecx, dword [rbp + dpb.dClusterHeapOffset]
    76 00000AFB 4801C8              <1>     add rax, rcx
    77                              <1>     ;rax now has the first sector of the current cluster
    78 00000AFE 59                  <1>     pop rcx
    79                              <1>     return
    13                              <2> %%_ret:
    14 00000AFF C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
    80                              <1> .rootDir:
    81 00000B00 8B4517              <1>     mov eax, dword [rbp + dpb.dFirstUnitOfRootDir]
    82 00000B03 E872FFFFFF          <1>     call getFATtype
    83 00000B08 81F902000000        <1>     cmp ecx, 2
    84 00000B0E 74DA                <1>     je .fat32Root   ;If FAT32, eax now has zero extended 1st cluster of Root Dir
    85                              <1>     ;Else rax has the first sector of the Root Dir
    86 00000B10 59                  <1>     pop rcx
    87                              <1>     return
    13                              <2> %%_ret:
    14 00000B11 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
    88                              <1> 
    89                              <1> 
    90                              <1> getLastClusterInChain:
    91                              <1> ;Given a cluster value in eax, returns in eax the last cluster in the chain
    92                              <1> ;Input: eax = Cluster to start searching at
    93                              <1> ;Output: eax = Last cluster in chain
    94                              <1> ;If input eax = 0, output eax = 0
    95 00000B12 85C0                <1>     test eax, eax   ;If eax = 0, then just exit
    96                              <1>     retz
    41                              <2> cret z
