   150 00006D9C 488B25(AD040000)    <1>     mov rsp, qword [oldRSP]     ;Get the stack ptr after regs were pushed
   151 00006DA3 31ED                <1>     xor ebp, ebp                ;Always zeroed for DOS portability!
   152 00006DA5 CD24                <1>     int 24h                     ;Call crit. err. hdlr. Ints reset on
   153                              <1> ;Now we do self-parent stablity handling. Do it here as interrupts are off
   154                              <1> ; and rsp is guaranteed to have the right value, thanks to int preserving 
   155                              <1> ; the stack pointer too. 
   156                              <1> ;If the process isn't its own parent we ignore it.
   157                              <1> ;Else, we have a self-parent process. This is undocumented and thus we can
   158                              <1> ; assume it is one of our DOS kernel extensions or something. 
   159                              <1> ; If the Int 24h handler didnt access int 21h then this is functionally a nop.
   160                              <1> ; Else, we modified the stack pointer in the psp and as a result, since we are 
   161                              <1> ;  our own parent, modified our parent's stack pointer in the psp. 
   162                              <1> ;  Consequently, our parent's psp stack pointer is no longer are pointing 
   163                              <1> ;  at a correct stack frame. This WILL lead to a GP fault if attempting to 
   164                              <1> ;  ABORT a self-parent process. 
   165                              <1> ;What we do here points the parent's psp stack pointer back to the stack 
   166                              <1> ; frame that was originally set upon entering the Int 21h call that caused the
   167                              <1> ; hard error. Since this code is within the main parent process space, which
   168                              <1> ; won't get deallocated, then the stack frame points safely to a known good 
   169                              <1> ; stack previously used by the parent process, within a memory block owned by
   170                              <1> ; the parent process.
   171                              <1> ;Since this code is not hit once inside Int 24h, it is safe wrt reentrancy 
   172                              <1> ; issues. Thus, the PSP is reset after all the Int 21h calls the Int 24h 
   173                              <1> ; handler may have made.
