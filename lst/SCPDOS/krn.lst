   150                              <1> 
   151 00003044 66C705(5D1A0000)00- <1>     mov word [keybTicks], 0 ;Reset ticks as we are gonna read time now
   151 0000304C 00                  <1>
   152 0000304D 488D1D(48050000)    <1>     lea rbx, CLOCKrecrd ;Read into clock record
   153 00003054 B906000000          <1>     mov ecx, 6      ;Number of bytes to xfr
   154 00003059 4831ED              <1>     xor rbp, rbp    ;Tell it we are a chardev
   155                              <1> ; rbp = DPB ptr | NullPtr if a char dev
   156                              <1> ; rbx = Data storage buffer ptr
   157                              <1> ; ecx = Number of sectors to transfer | Number of bytes to xfr, if char dev
   158                              <1> ; rdx = Starting sector to read/write from/to | Undefined if a char dev
   159 0000305C E8144B0000          <1>     call primReqReadSetup   ;rbx now points to request header
   160 00003061 488B35(53000000)    <1>     mov rsi, qword [clockPtr]   ;Get clock driver pointer
   161 00003068 E8B7470000          <1>     call goDriver
   162 0000306D 0FB705(48050000)    <1>     movzx eax, word [CLOCKrecrd + clkStruc.dateWord]
   163                              <1> ;Here we have:  ax = Days since 1/1/1980
   164                              <1> ;Updates the internal date fields
   165                              <1> ;Internal time fields are in the clock record
   166                              <1> ;So now we check if the number of days since 1980 are the same.
   167                              <1> ;If so, we can skip updating.
   168 00003074 663B05(C3040000)    <1>     cmp ax, word [daysOffset]
   169 0000307B 7466                <1>     je .exit    ;Return if equal
   170 0000307D 3D36AB0000          <1>     cmp eax, 365*120 + 25 + 5  ;Number of days until max date, 31/12/2099
   171 00003082 735F                <1>     jnb .exit  ;If it is equal or above (implying we are past max date), exit
   172 00003084 668905(C3040000)    <1>     mov word [daysOffset], ax   ;Save this new offset
   173                              <1>     ;Now want to update years, month and day fields
   174                              <1>     ;ax has the number of days since 01/01/1980
   175                              <1>     ;Get days in a 4 year period
   176 0000308B BBB5050000          <1>     mov ebx, 365*4 + 1
   177 00003090 31D2                <1>     xor edx, edx
   178 00003092 89D1                <1>     mov ecx, edx  ;Zero ecx
   179 00003094 F7F3                <1>     div ebx ;Divide # of days since 01/01/1980 into 4 year bunches
   180                              <1>     ;eax has # of 4 year bunches elapsed since 01/01/1980
   181                              <1>     ;edx has offset into current 4 year bunch
   182 00003096 BB6E010000          <1>     mov ebx, 366    ;Number of days in a leap year
   183 0000309B 39DA                <1>     cmp edx, ebx    ;Are we in the first year of this bunch? (The leap year)
   184 0000309D 7210                <1>     jb .foundBunch
   185 0000309F 29DA                <1>     sub edx, ebx    ;Subtract edx to hone in on the year we are in
   186 000030A1 FFC1                <1>     inc ecx
   187 000030A3 FFCB                <1>     dec ebx ;Number of days in a normal year
   188                              <1> .findBunch:
   189 000030A5 39DA                <1>     cmp edx, ebx
   190 000030A7 7206                <1>     jb .foundBunch
   191 000030A9 29DA                <1>     sub edx, ebx
   192 000030AB FFC1                <1>     inc ecx
   193 000030AD EBF6                <1>     jmp short .findBunch
   194                              <1> .foundBunch:
   195                              <1>     ;If ecx = 0, february has 29 days!
   196                              <1>     ;eax has number of four year bunches elapsed since 1980
   197 000030AF C1E002              <1>     shl eax, 2  ;Multiply by 4 to get # of years to start of four year bunch
   198 000030B2 01C1                <1>     add ecx, eax    ;Add # of years offset in 4 year bunch
   199                              <1>     ;ecx now has the number of years since 1980
   200 000030B4 E84E000000          <1>     call setDaysInFeb   ;Return in rax the # of days in feb
   201                              <1> ;edx has number of days into the year we are in
   202                              <1> ;eax has number of days in Feb for this year
   203 000030B9 488D35A8CFFFFF      <1>     lea rsi, monthsTbl
   204 000030C0 31C9                <1>     xor ecx, ecx    ;Use as month counter
   205                              <1> .monthSearch:
   206 000030C2 FFC1                <1>     inc ecx ;Start from 1
   207 000030C4 AC                  <1>     lodsb   ;Get value in al and inc rsi
   208 000030C5 0FB6C0              <1>     movzx eax, al   ;Zero extend number of days in month
   209 000030C8 39C2                <1>     cmp edx, eax
   210 000030CA 7204                <1>     jb .monthFound
   211 000030CC 29C2                <1>     sub edx, eax  ;Reduce the number of days by the number of days in the month
   212 000030CE EBF2                <1>     jmp short .monthSearch
   213                              <1> .monthFound:
   214                              <1>     ;cl has the month (01h-0Ch)
   215                              <1>     ;dl has the day of the month - 1
   216 000030D0 FFC2                <1>     inc edx
   217 000030D2 880D(C1040000)      <1>     mov byte [monthOfYear], cl
   218 000030D8 8815(C0040000)      <1>     mov byte [dayOfMonth], dl
   219 000030DE E806000000          <1>     call setDayofWeek
   220                              <1> .exit:
   221 000030E3 5D                  <1>     pop rbp
   222 000030E4 5E                  <1>     pop rsi
   223 000030E5 5A                  <1>     pop rdx
   224 000030E6 59                  <1>     pop rcx
   225 000030E7 5B                  <1>     pop rbx
   226                              <1>     return  ;Return with ZF is date set, or same day
