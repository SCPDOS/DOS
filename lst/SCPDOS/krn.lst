   107                              <1> getCDSNotJoin:   
   108                              <1> ;Gets a drive CDS, sets it as working and checks it is not a join drive
   109                              <1> ;Input: al = 1-based drive number
   110                              <1> ;Output: al = 0-based drive number
   111                              <1> ;   CF=NC => Drive can be set as Current Drive (i.e. Join)
   112                              <1> ;   CF=CY => 0-based drive number invalid OR CDS returned with Join flags
   113                              <1> ;            set.
   114 000077B9 E86B000000          <1>     call getCDS ;Setup working CDS DOS variable for this drive
   115 000077BE 7212                <1>     jc .exit    ;Carry the CF flag if not Physical or if al was too large
   116 000077C0 56                  <1>     push rsi
   117 000077C1 488B35(43070000)    <1>     mov rsi, qword [workingCDS] ;Get CDS
   118 000077C8 66F746430020        <1>     test word [rsi + cds.wFlags], cdsJoinDrive  ;Check if Join
   119 000077CE 5E                  <1>     pop rsi
   120 000077CF 7401                <1>     jz .exit
   121 000077D1 F9                  <1>     stc
   122                              <1> .exit:
   123                              <1>     return
