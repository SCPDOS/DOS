   257 0000340B 5E                  <1>     pop rsi                 ;Point rsi to the canonised path
   258 0000340C 0F82844D0000        <1>     jc fcbErrExit
   259 00003412 4889F7              <1>     mov rdi, rsi            ;Pass argument to rdi. rsi, rdi preserved
   260 00003415 E89F4A0000          <1>     call checkPathspecOK    ;If the path has wildcards, fail!
   261 0000341A 7239                <1>     jc .exitErr
   262 0000341C E8D7E1FFFF          <1>     call getFilePathNoCanon ;Get the file if it exists! Sets DPB too.
   263 00003421 8B05(50050000)      <1>     mov eax, dword [buffer1]    ;Get the first four chars for comparison
   264 00003427 30C0                <1>     xor al, al
   265 00003429 3D003A5C00          <1>     cmp eax, 005C3A00h  ;Do null path check!
   266 0000342E 7425                <1>     je .exitErr
   267 00003430 488D3D(500D0000)    <1>     lea rdi, scratchSFT     ;Set the working SFT to the scratch in the SDA
   268 00003437 E8141F0000          <1>     call setCurrentSFT
   269 0000343C 0FB605(2E070000)    <1>     movzx eax, byte [searchAttr]   ;Get the file attribute in al
   270 00003443 E817130000          <1>     call createMain
