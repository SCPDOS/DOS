   130                              <1> ;FUNCTION NEVER USED
   131                              <1> ;getClusterInChain:
   132                              <1> ;;Given a starting cluster, walk forwards by a number of clusters.
   133                              <1> ;;If an EOC is encountered, then ecx will not be 
   134                              <1> ;;Input: eax = Start Cluster to start searching from
   135                              <1> ;;       ecx = Number of clusters to go forwards by;
   136                              <1> ;;Ouput: eax = Value of the cluster ecx number of clusters forwards
   137                              <1> ;;       ecx = # of clusters left to walk forwards by (0 EOC was not encountered)
   138                              <1> ;;Also usual CF babble.
   139                              <1> ;    test eax, eax   ;If eax = 0, then just exit
   140                              <1> ;    retz
