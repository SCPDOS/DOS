  1111 00001A49 5F                  <1>     pop rdi ;rdi points to free space in internal filename buffer
  1112 00001A4A 5E                  <1>     pop rsi
  1113 00001A4B 5B                  <1>     pop rbx
  1114 00001A4C 58                  <1>     pop rax ;Get back the original al value
  1115                              <1>     retnc   ;Return if file found. Else, report what was not found correctly!
