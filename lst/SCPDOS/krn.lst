    59 00000789 E8A2FFFFFF          <1>     call makeBufferMostRecentlyUsed ;Make the buffer most recently used
    60 0000078E 4889D7              <1>     mov rdi, rdx    ;Continue searching from where we left off
    61 00000791 5A                  <1>     pop rdx
    62                              <1>     return
