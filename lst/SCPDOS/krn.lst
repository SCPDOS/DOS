   240 000074E4 750C                <1>     jne .notForce
   241                              <1> ;Here we are forced to rebuild the DPB. In principle, the medium has
   242                              <1> ; not changed but the volume label must be updated. 
   243                              <1> ;The driver can use this opportunity to synchronise its BPB with the 
   244                              <1> ; new label.
   245                              <1> ;We jump directly to skip buffer checking as the rebuilding of the BPB is not
   246                              <1> ; such that we invalidate the buffers.
   247 000074E6 C605(291A0000)FF    <1>     mov byte [rebuildDrv], -1   ;Reset this flag as we are doing our job.
   248 000074ED E959000000          <1>     jmp .resetDPB
   249                              <1> .notForce:
   250                              <1> ;Note dpb access flag is either 1 or 0.
   251                              <1> ;If either the check media byte or the dpb access flag is -1, rebuild bpb.
   252                              <1> ;Else assume here access flag is 0. If medret is neq 0, return. Else, 
