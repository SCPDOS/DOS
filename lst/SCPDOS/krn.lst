   398 00006C82 F645E8FF            <1>     test byte [bAction], -1 ;Now check if we need to recreate this var.
   399 00006C86 0F85BD000000        <1>     jnz .sevExitOk  ;Exit if not!
   400 00006C8C EB0F                <1>     jmp short .sevCreate    ;Else, lets build it afresh!
   401                              <1> .sevVarNotFnd:
