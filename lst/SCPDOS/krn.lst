   934                              <1> copyPathspec:
   935                              <1> ;1) Copies a path portion from the source buffer to the destination
   936                              <1> ;2) Advances rsi to the next null, \ or /
   937                              <1> ;3) Expands all * to ?'s
   938                              <1> ;4) Understands \. means "this directory" and can be ignored with rsi moving to
   939                              <1> ;    next path separator and rdi pointing to the previous pathsep
   940                              <1> ;5) Understands \.. means "parent directory" and rdi should be changed to rbx
   941                              <1> ;    with rsi moving to path separator
   942                              <1> ;6) Each name in destination is at most 12 chars long, to account for the dot
   943                              <1> ;
   944                              <1> ;INPUT:     rsi = First char of pathspec to qualify
   945                              <1> ;           rdi = Points to where to store it
   946                              <1> ;
   947                              <1> ;RETURN:    rsi = First char of next pathspec or past terminating null
   948                              <1> ;           rdi = First char of next space to store next pathspec
   949                              <1> ;           al = Last char stored (either \ or NULL)
   950                              <1> ;           CF=NC = OK path
   951                              <1> ;           CF=CY = PATH OR FILE NOT FOUND
   952                              <1> ;               IF A WILDCARD FOUND IN A SUBDIR NAME, RETURN PNF.
   953 00001907 57                  <1>     push rdi    ;Save the pointer into the user buffer
   954 00001908 C605(BF040000)FF    <1>     mov byte [fcbSpaceOk], -1    ;Set to be ok to have space in the name
   955 0000190F 488D3D(0B070000)    <1>     lea rdi, fcbName
   956 00001916 57                  <1>     push rdi
   957 00001917 B903000000          <1>     mov ecx, 3
   958 0000191C B820202020          <1>     mov eax, "    " ;Four spaces
   959 00001921 F3AB                <1>     rep stosd   ;Store 12 spaces
   960 00001923 5F                  <1>     pop rdi ;Point rdi back to fcb name head
   961                              <1> 
   962 00001924 488D1D(16070000)    <1>     lea rbx, fcbName + 11   ;Use rbx as the end of fcb name marker address
   963 0000192B AC                  <1>     lodsb   ;Get first char from user path in al
   964 0000192C 3C2E                <1>     cmp al, "."   ;Handle starting dot separately
   965 0000192E 746B                <1>     je .cpsDots
   966 00001930 48FFCE              <1>     dec rsi ;Else move rsi to point back to starting char
   967                              <1> ;First char is not a dot, so now check if starts with E5h? 
   968                              <1> ;If so, store 05h in its place!
   969 00001933 3CE5                <1>     cmp al, 0E5h
   970 00001935 7506                <1>     jne .cpsMainLoop
   971 00001937 48FFC6              <1>     inc rsi ;Push rsi to point to next char
   972 0000193A B005                <1>     mov al, 05h
   973 0000193C AA                  <1>     stosb   ;Store the char, rsi is pointing at next char
   974                              <1> .cpsMainLoop:
   975 0000193D AC                  <1>     lodsb   ;Get the char in al and advance rsi
   976 0000193E 84C0                <1>     test al, al ;Is it the null char?
   977 00001940 0F848A000000        <1>     jz .cpsStore  ;If so, terminate immediately
   978 00001946 E8AE640000          <1>     call swapPathSeparator  ;And if it is a pathsep, skip any bunched pathseps
   979 0000194B 0F848D000000        <1>     jz .cpsSkipPathseps ; and then exit with the final converted pathsep in al
   980 00001951 3C2E                <1>     cmp al, "." ;Filename extension separator
   981 00001953 7420                <1>     je .cpsExtension
   982                              <1>     ;If we have space in the filename, we check to see if the next char is *
   983 00001955 3C2A                <1>     cmp al, "*" ;Wildcard?
   984 00001957 7430                <1>     je .cpsWildcard
   985 00001959 3C3F                <1>     cmp al, "?" ;Good wildcard?
   986 0000195B 740C                <1>     je .store
   987 0000195D E8A3640000          <1>     call uppercaseChar  ;Uppercase the char if it needs to be...
   988 00001962 E820660000          <1>     call checkCharValid ; and check it is a valid char
   989 00001967 7472                <1>     je .cpsExitError
   990                              <1> .store:
   991 00001969 4839DF              <1>     cmp rdi, rbx
   992 0000196C 7442                <1>     je .cpsProcessName ;Skip any non-terminating chars
   993 0000196E AA                  <1>     stosb   ;And store the converted char in al and inc rdi
   994 0000196F EBCC                <1>     jmp short .cpsMainLoop
