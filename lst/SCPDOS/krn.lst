   235 000074C8 F7C700800000        <1>     test edi, drvErrStatus
   236 000074CE 0F85E0000000        <1>     jnz .diskDrvCritErr
   237 000074D4 0FB605(3A070000)    <1>     movzx eax, byte [workingDrv]   ;Get the drive number for test
