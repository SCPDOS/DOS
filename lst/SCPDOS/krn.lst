   427 00006CC8 48FFCF              <1>     dec rdi
   428 00006CCB B03D                <1>     mov al, "="
   429 00006CCD AA                  <1>     stosb
   430 00006CCE 488B75F0            <1>     mov rsi, qword [lpValue]
   431 00006CD2 E88D110000          <1>     call strcpy
   432 00006CD7 E96D000000          <1>     jmp .sevExitOk
   433                              <1> .sevGetMoreMem:
   434                              <1> ;Try reallocating, see if that works
   435 00006CDC 678D580F            <1>     lea ebx, dword [eax + 0Fh]
   436 00006CE0 C1EB04              <1>     shr ebx, 4  ;Turn into paragraphs
   437 00006CE3 410358F9            <1>     add ebx, dword [r8 - mcb_size + mcb.blockSize]
   438 00006CE7 53                  <1>     push rbx    ;Save the number of paragraphs we are allocating
   439 00006CE8 4150                <1>     push r8
   440 00006CEA E856F1FFFF          <1>     call reallocMemory
   441 00006CEF 4158                <1>     pop r8
   442 00006CF1 5B                  <1>     pop rbx
   443 00006CF2 721E                <1>     jc .sevGetNewBlk
   444                              <1> ;Now we have reallocated our block! We need to null the end portion.
   445 00006CF4 E81B020000          <1>     call getSzOfEnvAndStrings   ;Get the size of the env in ecx
   446 00006CF9 498B783E            <1>     mov rdi, qword [r8 + psp.envPtr]
   447 00006CFD 4801CF              <1>     add rdi, rcx    ;Move rdi to the end of the blocks.
   448 00006D00 C1E304              <1>     shl ebx, 4  ;Turn into bytes
   449 00006D03 412B58F9            <1>     sub ebx, dword [r8 - mcb_size + mcb.blockSize]  ;Get sz of new part
   450 00006D07 89D9                <1>     mov ecx, ebx
   451 00006D09 31C0                <1>     xor eax, eax
   452 00006D0B F3AA                <1>     rep stosb   ;Zero the newly allocated stuff
   453 00006D0D E997FFFFFF          <1>     jmp .sevDoMake
   454                              <1> .sevGetNewBlk:
   455 00006D12 3D08000000          <1>     cmp eax, errNoMem   ;We had no memory to grow?
   456 00006D17 752C                <1>     jne .sevBadMem      ;No? Must've been something more sinister.
   457                              <1> ;Now we allocate and free instead.
   458 00006D19 E82C010000          <1>     call allocEnv   ;Zeros the block for us so all is good
   459 00006D1E 7225                <1>     jc .sevBadMem
   460                              <1> ;rax -> new env block
   461 00006D20 50                  <1>     push rax    ;Save the new psp
   462 00006D21 498B703E            <1>     mov rsi, qword [r8 + psp.envPtr]
   463 00006D25 4889C7              <1>     mov rdi, rax    ;This is where we will write to
   464 00006D28 E8E7010000          <1>     call getSzOfEnvAndStrings   ;Get the size of everything from psp block
   465 00006D2D F3A4                <1>     rep movsb       ;And move it over :)
   466 00006D2F 4150                <1>     push r8         ;Save ptr to the psp on the stack
   467 00006D31 4D8B403E            <1>     mov r8, qword [r8 + psp.envPtr]
   468 00006D35 E803F0FFFF          <1>     call freeMemory ;Now we free r8.  
   469 00006D3A 4158                <1>     pop r8
   470 00006D3C 418F403E            <1>     pop qword [r8 + psp.envPtr] ;Get the new environment pointer in its place
   471 00006D40 E964FFFFFF          <1>     jmp .sevDoMake
   472                              <1> .sevBadMem:
   473 00006D45 31C0                <1>     xor eax, eax    ;The error code has been set so we return 0 bytes
   474 00006D47 EB03                <1>     jmp short .sevExit
