   999                              <1> ;rsi has been incremented past the extension field. Discard the . in al
  1000 00001975 B903000000          <1>     mov ecx, 3 
  1001 0000197A 488D3D(13070000)    <1>     lea rdi, qword [fcbName + filename.fExt]    ;Goto the extension field
  1002 00001981 57                  <1>     push rdi
