   320 00000C6D 721B                <1>     jc .exitFail
   321 00000C6F 85C0                <1>     test eax, eax
   322 00000C71 7505                <1>     jnz .notFree
   323                              <1> .incGo:
   324 00000C73 E85E020000          <1>     call incrementFreeClusterCount  ;Increment the count!
   325                              <1> .notFree:
   326 00000C78 678D4301            <1>     lea eax, dword [ebx + 1]    ;Get the next consecutive cluster
   327 00000C7C 3B450F              <1>     cmp eax, dword [rbp + dpb.dMaxClusterAddr]
   328 00000C7F 76E5                <1>     jbe .lp
