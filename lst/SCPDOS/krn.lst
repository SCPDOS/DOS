   176 00006DB2 7504                <1>     jne .notOwnParent
   177                              <1> ;Now we ensure that any self-parent applications that have gone through Int 24h
   178                              <1> ; have their PSP rsp returned to the rsp that they entered Int 21h with.
   179 00006DB4 48896546            <1>     mov qword [rbp + psp.rspPtr], rsp
   180                              <1> .notOwnParent:
