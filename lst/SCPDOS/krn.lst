   823                              <1> checkClusterValid:
   824                              <1> ;Checks the cluster number is valid. This should help prevent infinite loops
   825                              <1> ; when reading bad directory entries from corrupted disks.
   826                              <1> ;Input: eax = Cluster number to analyse (32 bits zero extended)
   827                              <1> ;       rbp -> DPB for the drive we are analysing.
   828                              <1> ;Output: ZF=ZE: Cluster number ok!
   829                              <1> ;        ZF=NZ: Cluster number not good.
   830                              <1> ;               CF=CY: If eax was 0 or 1, likely disk corruption.
   831                              <1> ;               CF=NC: If eax was past end of disk or max cluster (return EOC).
   832 00001029 51                  <1>     push rcx
   833 0000102A 3D02000000          <1>     cmp eax, 2
   834 0000102F 7233                <1>     jb .exit
   835 00001031 E852FAFFFF          <1>     call getFATtype
   836 00001036 81F901000000        <1>     cmp ecx, 1
   837 0000103C 770B                <1>     ja .fat32Check
   838 0000103E 7212                <1>     jb .fat12Check
   839                              <1> ;fat16Check 
   840 00001040 3DF5FF0000          <1>     cmp eax, fat16MaxClustCnt
   841 00001045 7212                <1>     jb .chkMax
   842 00001047 EB15                <1>     jmp short .exitBad    
   843                              <1> .fat32Check:
   844 00001049 3DF8FFFF0F          <1>     cmp eax, 0FFFFFF8h
   845 0000104E 7209                <1>     jb .chkMax
   846 00001050 EB0C                <1>     jmp short .exitBad
   847                              <1> .fat12Check:
   848 00001052 3DF50F0000          <1>     cmp eax, fat12MaxClustCnt
   849 00001057 7705                <1>     ja .exitBad
   850                              <1> .chkMax:
   851 00001059 3B450F              <1>     cmp eax, dword [rbp + dpb.dMaxClusterAddr]
   852 0000105C 7604                <1>     jbe .exitOk
   853                              <1> .exitBad:
   854 0000105E 85C0                <1>     test eax, eax   ;Clear ZF since eax > 1 here. Clear CF since test.
   855 00001060 EB02                <1>     jmp short .exit
   856                              <1> .exitOk:
   857 00001062 39C0                <1>     cmp eax, eax    ;Set ZF and clear CF
   858                              <1> .exit:
   859 00001064 59                  <1>     pop rcx
   860                              <1>     return
