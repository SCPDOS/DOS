   440                              <1> parseNameToFCB:
   441                              <1> ;rsi points to a command line to parse
   442                              <1> ;rdi points to a future unopened FCB
   443                              <1> ;al = parsing control bits. 
   444                              <1> ; al[0] = If set, leading filename separators are scanned off
   445                              <1> ; al[1] = If set, we set the drive ID byte if a drive letter was found
   446                              <1> ; al[2] = If set, will copy the filename to the FCB filename field
   447                              <1> ; al[3] = If set, will copy the extension to the FCB extension field
   448                              <1> ;
   449                              <1> ;Separators include : . ; , = + TAB SPACE
   450                              <1> ;Terminators include separators and , < > | / " [ ] and all ctrl chars
   451 00003568 C605(BF040000)00    <1>     mov byte [fcbSpaceOk], 0    ;Don't allow spaces in filename
   452 0000356F 31D2                <1>     xor edx, edx    ;Use dl to keep drive name/state of operation
   453 00003571 A802                <1>     test al, 2  ;Set drive letter
   454 00003573 7402                <1>     jz .skipDriveLetter
   455 00003575 8817                <1>     mov byte [rdi + fcb.driveNum], dl   ;Clear this for usage
   456                              <1> .skipDriveLetter:
   457 00003577 48FFC7              <1>     inc rdi ;Go past the drive letter field in the FCB
   458 0000357A B908000000          <1>     mov ecx, 8  ;Copy Filename
   459 0000357F A804                <1>     test al, 4  ;Do we copy the filename to the fcb field?
   460 00003581 93                  <1>     xchg eax, ebx
   461 00003582 B020                <1>     mov al, " " ;Clear the field
   462 00003584 7405                <1>     jz .clearFilenameField
   463 00003586 4801CF              <1>     add rdi, rcx    ;Move to the extension field of the fcb
   464 00003589 31C9                <1>     xor ecx, ecx
   465                              <1> .clearFilenameField:
   466 0000358B F3AA                <1>     rep stosb
   467 0000358D B903000000          <1>     mov ecx, 3
   468 00003592 F6C308              <1>     test bl, 8  ;Skip clearing extension field?
   469 00003595 7405                <1>     jz .clearExtensionField
   470 00003597 4801CF              <1>     add rdi, rcx
   471 0000359A 31C9                <1>     xor ecx, ecx
   472                              <1> .clearExtensionField:
   473 0000359C F3AA                <1>     rep stosb
   474 0000359E 91                  <1>     xchg eax, ecx
   475 0000359F AB                  <1>     stosd   ;Initialise curBlock and recordSize like DOS does in parseFilename
   476 000035A0 4881EF10000000      <1>     sub rdi, 10h    ;Go back to head of FCB
   477 000035A7 F6C301              <1>     test bl, 1  ;Skip scanning preceeding spaces
   478 000035AA 740F                <1>     jz .dontScanOffTerm
   479 000035AC E89F000000          <1>     call skipSeparators ;Skip leading separators
   480 000035B1 E8DA430000          <1>     call isCharTerminator   ;If first char is terminator, go past and keep skipping
   481 000035B6 7508                <1>     jnz .skipIfNotTerminator
   482 000035B8 48FFC6              <1>     inc rsi
