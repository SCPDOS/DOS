   234                              <1> createFileFCB:     ;ah = 16h
   235                              <1> openFileFCB:       ;ah = 0Fh
   236                              <1> ;rdx -> Extended FCB
   237                              <1> ;   MUST BE EXTENDED. 
   238                              <1> ;   MUST HAVE ATTRIBUTE OF 08h, VOLID, else will fail
   239                              <1> ; Using FCB's, one can only create a volume label on a volume.
   240                              <1> ;
   241                              <1> ;Deleting a volume label can be done using delete file (fcb)
   242                              <1> ;Renaming a volume label can be done using rename file (fcb)
   243                              <1> ;Creating a volume label can be done using create file (fcb and hdl)
   244                              <1> ;
   245                              <1> ; In all cases, we recommend the use of fcb's ONLY. Hdl funcs are not 
   246                              <1> ; suggested for use with the vol crud because, do we really need the hdl? No!
   247                              <1> ;
   248 000033D0 488915(4B070000)    <1>     mov qword [workingFCB], rdx     ;Save the FCB ptr
   249 000033D7 803AFF              <1>     cmp byte [rdx + exFcb.extSig], -1
   250 000033DA 755D                <1>     jne .exitErr
   251 000033DC 807A0608            <1>     cmp byte [rdx + exFcb.attribute], dirVolumeID
   252 000033E0 7557                <1>     jne .exitErr
   253                              <1>     ;Here we proceed with creating a volume label
   254 000033E2 488D3D(50050000)    <1>     lea rdi, buffer1
   255 000033E9 57                  <1>     push rdi
   256 000033EA E8D9000000          <1>     call fcbInitRoutine     ;Build path to volid
   257 000033EF 5E                  <1>     pop rsi                 ;Point rsi to the canonised path
   258 000033F0 0F8204490000        <1>     jc fcbErrExit
   259 000033F6 4889F7              <1>     mov rdi, rsi            ;Pass argument to rdi. rsi, rdi preserved
   260 000033F9 E81F460000          <1>     call checkPathspecOK    ;If the path has wildcards, fail!
   261 000033FE 7239                <1>     jc .exitErr
   262 00003400 E8D7E1FFFF          <1>     call getFilePathNoCanon ;Get the file if it exists! Sets DPB too.
   263 00003405 8B05(50050000)      <1>     mov eax, dword [buffer1]    ;Get the first four chars for comparison
   264 0000340B 30C0                <1>     xor al, al
   265 0000340D 3D003A5C00          <1>     cmp eax, 005C3A00h  ;Do null path check!
   266 00003412 7425                <1>     je .exitErr
   267 00003414 488D3D(500D0000)    <1>     lea rdi, scratchSFT     ;Set the working SFT to the scratch in the SDA
   268 0000341B E8251F0000          <1>     call setCurrentSFT
   269 00003420 0FB605(2E070000)    <1>     movzx eax, byte [searchAttr]   ;Get the file attribute in al
   270 00003427 E828130000          <1>     call createMain
   271 0000342C 720B                <1>     jc .exitErr
   272                              <1>     ;We close the sda sft since we dont have an explicit FCB close fn.
   273                              <1>     ;Necessary to close the associated share record when sharing.
   274 0000342E E885160000          <1>     call closeMain
   275 00003433 0F83BE480000        <1>     jnc fcbGoodExit     ;We require no back copying so exit!
   276                              <1> .exitErr:
   277 00003439 B805000000          <1>     mov eax, errAccDen
   278 0000343E E9B7480000          <1>     jmp fcbErrExit
   279                              <1> 
   280                              <1> closeFileFCB:      ;ah = 10h
   281                              <1> ;This is a minimal function stub which is necessary to "pseudo"-close
   282                              <1> ; opens/creates of volume labels via the open/createFCB function.
   283                              <1> ; Though those functions close by themselves, I won't document that
   284                              <1> ; for future compatibility. Thus, if this function encounters a 
   285                              <1> ; open/create volume label FCB, it returns OK. Else it fails.
   286 00003443 488915(4B070000)    <1>     mov qword [workingFCB], rdx     ;Save the FCB ptr
   287 0000344A 803AFF              <1>     cmp byte [rdx + exFcb.extSig], -1
   288 0000344D 75EA                <1>     jne openFileFCB.exitErr
   289 0000344F 807A0608            <1>     cmp byte [rdx + exFcb.attribute], dirVolumeID
   290 00003453 75E4                <1>     jne openFileFCB.exitErr
   291 00003455 E99D480000          <1>     jmp fcbGoodExit
