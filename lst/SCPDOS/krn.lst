    22 0000770F 7409                <1>     je .net
    23 00007711 66F747430080        <1>     test word [rdi + cds.wFlags], cdsRedirDrive
    24 00007717 7501                <1>     jnz .net ;Net with CDS
    25                              <1>     return  ;CF=NC => Not net
    13                              <2> %%_ret:
    14 00007719 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
