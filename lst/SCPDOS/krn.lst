    90                              <1> flushAllBuffersForDrive:    ;External linkage (2 - diskReset/exit)
    91                              <1> ; Flushes and resets the dirty bit for all dirty bufs in buffer chain.
    92                              <1> ; Used also to allow flushing all buffers
    93                              <1> ; Input: al = 0-based physical drive number we are xacting on
    94                              <1> ; Returns: CF=NC => All is well, buffers flushed and dirty bits cleaned
    95                              <1> ;          CF=CY => A Buffer failed to flush, it was lost.
    96 000007D1 57                  <1>     push rdi
    97 000007D2 50                  <1>     push rax
    98 000007D3 488B3D(65000000)    <1>     mov rdi, qword [bufHeadPtr]
    99 000007DA B4FF                <1>     mov ah, -1  ;Set to ignore no buffers
   100                              <1> .mainLp:
   101 000007DC 4881FFFFFFFFFF      <1>     cmp rdi, -1 ;When we get to the end of the buffer chain, exit
   102 000007E3 741E                <1>     je .exit   
   103 000007E5 E827000000          <1>     call flushAndCleanBuffer    ;Flush this buffer if it is on the DPB we want
   104 000007EA 50                  <1>     push rax
   105 000007EB 0FB64708            <1>     movzx eax, byte [rdi + bufferHdr.driveNumber]
   106 000007EF 3A05(39040000)      <1>     cmp al, byte [errorDrv] ;Was this a buffer on the error drive?
   107 000007F5 58                  <1>     pop rax
   108 000007F6 7405                <1>     je .errDrv      ;If not, goto next buffer
   109                              <1> .nextBuffer:        ;This handles the case if the user aborts or ignores.
   110 000007F8 488B3F              <1>     mov rdi, qword [rdi + bufferHdr.nextBufPtr] ;Goto next buffer
   111 000007FB EBDF                <1>     jmp short .mainLp
   112                              <1> .errDrv:
   113                              <1> ;Free the buffer if it caused an error in this DOS call and was aborted
   114                              <1> ; or ignored.
   115 000007FD C64708FF            <1>     mov byte [rdi + bufferHdr.wDrvNumFlg], freeBuffer
   116 00000801 EBF5                <1>     jmp short .nextBuffer
   117                              <1> .exit:
   118 00000803 58                  <1>     pop rax
   119 00000804 5F                  <1>     pop rdi
   120 00000805 F605(9C040000)FF    <1>     test byte [Int24Fail], -1   ;Did we return fail at any point?
   121                              <1>     retz
    41                              <2> cret z
