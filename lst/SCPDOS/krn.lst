   323                              <1> .notFree:
   324 00000CC9 678D4301            <1>     lea eax, dword [ebx + 1]    ;Get the next consecutive cluster
   325 00000CCD 3B450F              <1>     cmp eax, dword [rbp + dpb.dMaxClusterAddr]
   326 00000CD0 76E5                <1>     jbe .lp
   327                              <1> .exit:
   328 00000CD2 8B452D              <1>     mov eax, dword [rbp + dpb.dNextFreeClst]  ;Get first free cluster in eax
   329 00000CD5 E8FC020000          <1>     call writeFSInfoSector
   330 00000CDA F8                  <1>     clc
