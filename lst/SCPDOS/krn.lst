   385 00006C58 8845E8              <1>     mov byte [bAction], al  ;Save the action flag
   386 00006C5B 488975F8            <1>     mov qword [lpName], rsi
   387 00006C5F 488955F0            <1>     mov qword [lpValue], rdx
   388                              <1> ;Now we get the full length of the string we're gonna write into the env
   389 00006C63 E8E2110000          <1>     call strlen2    ;Get the length of the name portion
