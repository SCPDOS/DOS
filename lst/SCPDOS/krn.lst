  2961                              <1> findFreeSFT:
  2962                              <1> ;Returns a pointer to a free SFT if CF=NC. Else, no free SFTs.
  2963                              <1> ;Modifies an SFT entry. Must be called in a critical section.
  2964                              <1> ;Output: CF=NC => rdi = Points to a free SFT entry, bx = SFTndx
  2965                              <1> ;        CF=CY => eax = errNhl, error exit
  2966 00005436 31DB                <1>     xor ebx, ebx
  2967                              <1> .mainLp:
  2968 00005438 53                  <1>     push rbx    ;Save the sft ndx
  2969 00005439 E853000000          <1>     call getSFTPtrfromSFTNdx    ;Get ptr to SFT in rdi
  2970 0000543E 5B                  <1>     pop rbx
  2971 0000543F 7307                <1>     jnc .sftExists
  2972 00005441 B804000000          <1>     mov eax, errNhl
  2973 00005446 F9                  <1>     stc
  2974                              <1>     return
