   662                              <1> sanitiseCluster:
   663                              <1> ;Sanitises the cluster in eax to all zeros
   664                              <1> ;Does not move file pointers
   665                              <1> ;Currently, is only called to sanitise subdirectory clusters
   666                              <1> ;Input: eax = Cluster number
   667                              <1> ;       qword [workingDPB] = DPB of drive whose cluster we are sanitising
   668                              <1> ;Output: If CF=NC => eax = Sanitised Cluster number
   669                              <1> ;        If CF=CY => Error, exit
   670 0000253E 50                  <1>     push rax
   671 0000253F 53                  <1>     push rbx
   672 00002540 51                  <1>     push rcx
   673 00002541 52                  <1>     push rdx
   674 00002542 56                  <1>     push rsi
   675 00002543 55                  <1>     push rbp
   676 00002544 488B2D(3B070000)    <1>     mov rbp, qword [workingDPB]
   677 0000254B E8A3E5FFFF          <1>     call getStartSectorOfCluster    ;Needs DPB in rbp
   678 00002550 0FB65504            <1>     movzx edx, byte [rbp + dpb.bMaxSectorInCluster] 
   679 00002554 FFC2                <1>     inc edx ;Make it a count of sectors
   680                              <1> .getSectorInCluster:
   681 00002556 E811E5FFFF          <1>     call getBufForDir  ;Get a generic data buffer in rbx
   682 0000255B 721E                <1>     jc .exitBad
   683 0000255D 488D7B20            <1>     lea rdi, qword [rbx + bufferHdr.dataarea]
   684 00002561 0FB74D02            <1>     movzx ecx, word [rbp + dpb.wBytesPerSector]
   685 00002565 31C0                <1>     xor eax, eax
   686 00002567 F3AA                <1>     rep stosb   ;Store one sectorful of zeros
   687 00002569 E8ACE3FFFF          <1>     call markBufferDirty ;We wrote to this buffer
   688                              <1> 
   689 0000256E FFCA                <1>     dec edx     ;One less sector in the cluster to sanitise!
   690 00002570 740A                <1>     jz .exit    ;Jump if we done
   691 00002572 488B430A            <1>     mov rax, qword [rbx + bufferHdr.bufferLBA] ;Get current sector number
   692 00002576 48FFC0              <1>     inc rax ;Goto next sector in cluster
   693 00002579 EBDB                <1>     jmp short .getSectorInCluster
   694                              <1> .exitBad:
   695 0000257B F9                  <1>     stc
   696                              <1> .exit:
   697 0000257C 5D                  <1>     pop rbp
   698 0000257D 5E                  <1>     pop rsi
   699 0000257E 5A                  <1>     pop rdx
   700 0000257F 59                  <1>     pop rcx
   701 00002580 5B                  <1>     pop rbx
   702 00002581 58                  <1>     pop rax
   703                              <1>     return
