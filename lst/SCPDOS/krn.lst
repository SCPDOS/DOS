   958 00001900 B820202020          <1>     mov eax, "    " ;Four spaces
   959 00001905 F3AB                <1>     rep stosd   ;Store 12 spaces
   960 00001907 5F                  <1>     pop rdi ;Point rdi back to fcb name head
   961                              <1> 
   962 00001908 488D1D(16070000)    <1>     lea rbx, fcbName + 11   ;Use rbx as the end of fcb name marker address
   963 0000190F AC                  <1>     lodsb   ;Get first char from user path in al
   964 00001910 3C2E                <1>     cmp al, "."   ;Handle starting dot separately
   965 00001912 746B                <1>     je .cpsDots
