   405                              <1> checkPathspecOK:
   406                              <1> ;Input:
   407                              <1> ;rsi -> points to a path to verify if it is ok.
   408                              <1> ;Output:
   409                              <1> ;CF=NC => The path is totally clean and ok to use.
   410                              <1> ;CF=CY => the path is malformed or longer than 64 chars.
   411                              <1> ; If CF=CY and ZF=ZE then wildcards were found in the last portion
   412                              <1> ; and depending on method of invokation and caller, may be permissable.
   413                              <1> ;We accept lc and uc characters in this check function.
   414 00007976 50                  <1>     push rax
   415 00007977 53                  <1>     push rbx    ;Use rbx as the return flag status
   416 00007978 56                  <1>     push rsi
   417 00007979 31DB                <1>     xor ebx, ebx    ;Clear the return status flags
   418                              <1>     ;Start by getting the length of the ASCIIZ string.
   419 0000797B 51                  <1>     push rcx
   420 0000797C 57                  <1>     push rdi
   421 0000797D 4889F7              <1>     mov rdi, rsi
   422 00007980 E88DFFFFFF          <1>     call strlen
   423 00007985 89C8                <1>     mov eax, ecx    ;Save the length in eax
   424 00007987 5F                  <1>     pop rdi
   425 00007988 59                  <1>     pop rcx
   426 00007989 3D40000000          <1>     cmp eax, MAX_FSPEC    ;Check
   427 0000798E 0F8792000000        <1>     ja .badExit ;Above 64 only as the count includes the terminating null
   428 00007994 85C0                <1>     test eax, eax   ;If the path is empty, also error out!
   429 00007996 0F848A000000        <1>     jz .badExit
   430                              <1>     ;First we verify if our path is relative or canonical (absolute)
   431 0000799C 668B06              <1>     mov ax, word [rsi]  ;Get the first two chars
   432 0000799F 663D5C5C            <1>     cmp ax, "\\"    ;UNC network start
   433 000079A3 7416                <1>     je .netName
   434 000079A5 663D2F2F            <1>     cmp ax, "//"    ;Also acceptable UNC network start
   435 000079A9 7410                <1>     je .netName
   436 000079AB 80FC3A              <1>     cmp ah, ":" ;Is this a full or CWD of drive letter relative disk path?
   437 000079AE 7419                <1>     je .diskPath    ;Need to check if the char preceeding is an ASCII drive char
   438                              <1>     ;Here if relative
   439 000079B0 F605(33070000)FF    <1>     test byte [dosInvoke], -1
   440 000079B7 756D                <1>     jnz .badExit    ;If this is -1, server invoke.
   441 000079B9 EB3B                <1>     jmp short .okToScan
   442                              <1> .netName:
   443 000079BB 4881C602000000      <1>     add rsi, 2  ;Goto the first char after the UNC start symbol
   444 000079C2 803E00              <1>     cmp byte [rsi], 0   ;If this is an empty path, error!
   445 000079C5 745F                <1>     je .badExit
   446 000079C7 EB2D                <1>     jmp short .okToScan
   447                              <1> .diskPath:
   448 000079C9 4881C602000000      <1>     add rsi, 2  ;Go past the X:
   449 000079D0 803E00              <1>     cmp byte [rsi], 0   ;Cannot have an empty relative path!
   450 000079D3 7451                <1>     je .badExit
   451 000079D5 F605(33070000)FF    <1>     test byte [dosInvoke], -1    ;If this is minus 1, this is a server invoke
   452 000079DC 740F                <1>     jz .localAbsCheck
   453                              <1> .absMain:
   454 000079DE AC                  <1>     lodsb   ;Get the third byte. It MUST be a pathsep if server invokation.
   455 000079DF E8D2FEFFFF          <1>     call swapPathSeparator
   456 000079E4 7540                <1>     jnz .badExit    ;If ZF=NZ => Not a pathsep, bad path
   457 000079E6 803E00              <1>     cmp byte [rsi], 0   ;Is the char after the slash null?
   458 000079E9 743B                <1>     je .badExit ;Error if so!
   459 000079EB EB09                <1>     jmp short .okToScan
   460                              <1> .localAbsCheck:
   461 000079ED 8A06                <1>     mov al, byte [rsi]  ;Get the char we are pointing at
   462 000079EF E8C2FEFFFF          <1>     call swapPathSeparator  ;Is it a pathsep?
   463 000079F4 74E8                <1>     jz .absMain ;If it is, we do the absolute check
   464                              <1>     ;Else we are relative and begin wildcard search
   465                              <1> .okToScan:
   466 000079F6 AC                  <1>     lodsb   
   467 000079F7 84C0                <1>     test al, al ;End of path char?
   468 000079F9 7430                <1>     jz .exit
   469 000079FB E8B6FEFFFF          <1>     call swapPathSeparator
   470 00007A00 741C                <1>     jz .wcCheck ;If it was a pathsep, ensure no WC's have been detected
   471 00007A02 3C2A                <1>     cmp al, "*" ;Was al a big wildcard?
   472 00007A04 7411                <1>     je .wcFound
   473 00007A06 3C3F                <1>     cmp al, "?" ;Was al a small wildcard?
   474 00007A08 740D                <1>     je .wcFound ;If al was a wildcard, proceed as for wildcard
   475                              <1>     ;Else we check that the char in al is an acceptable char
   476 00007A0A 3C2E                <1>     cmp al, "." ;Ensure that dots are allowed through this part check
   477 00007A0C 74E8                <1>     je .okToScan
   478 00007A0E E831000000          <1>     call checkCharValid
   479 00007A13 7411                <1>     jz .badExit ;If the char is invalid, exit immediately badly
   480 00007A15 EBDF                <1>     jmp short .okToScan
   481                              <1> .wcFound:
   482 00007A17 BB41000000          <1>     mov ebx, 41h    ;Set bit 6 and bit 0
   483 00007A1C EBD8                <1>     jmp short .okToScan
   484                              <1> .wcCheck:
   485                              <1> ;This is to check we havent had any WC's upon hitting a pathsep
   486 00007A1E F7C340000000        <1>     test ebx, 40h
   487 00007A24 74D0                <1>     jz .okToScan    ;Clearly al is not a WC, so goto next char now
   488                              <1>     ;Else fall through in error
   489                              <1> .badExit:
   490 00007A26 BB01000000          <1>     mov ebx, 1  ;Totally clear ZF and set CF
   491                              <1> .exit:
   492 00007A2B 53                  <1>     push rbx    ;Set bit 0 for CF and bit 6 for ZF
   493 00007A2C 9D                  <1>     popfq
   494 00007A2D 5E                  <1>     pop rsi
   495 00007A2E 5B                  <1>     pop rbx
   496 00007A2F 58                  <1>     pop rax
   497                              <1>     return
    13                              <2> %%_ret:
    14 00007A30 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
