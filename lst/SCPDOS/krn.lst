    15                              <2> %assign retOff %%_ret-$$
  2975                              <1> .sftExists:
  2976 00005448 66813F0000          <1>     cmp word [rdi + sft.wNumHandles], 0
  2977 0000544D 7425                <1>     je .sftFound
  2978 0000544F 66813FFFFF          <1>     cmp word [rdi + sft.wNumHandles], -1    ;Is SFT being alloc'd/free'd?
  2979 00005454 751A                <1>     jne .gotoNextNdx
  2980                              <1>     ;Here, check that if this sft is owned by the caller and repurpose it.
  2981 00005456 53                  <1>     push rbx
  2982 00005457 488B1D(6B040000)    <1>     mov rbx, qword [qPID]
  2983 0000545E 48395F47            <1>     cmp qword [rdi + sft.qPID], rbx
  2984 00005462 7509                <1>     jne .netGoToNextNdx
  2985 00005464 8B1D(73040000)      <1>     mov ebx, dword [dMID]
  2986 0000546A 395F43              <1>     cmp dword [rdi + sft.dMID], ebx
  2987                              <1> .netGoToNextNdx:
  2988 0000546D 5B                  <1>     pop rbx
  2989 0000546E 7404                <1>     je .sftFound
  2990                              <1> .gotoNextNdx:
  2991 00005470 FFC3                <1>     inc ebx
