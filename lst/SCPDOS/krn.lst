   383                              <1> truncateFAT:
   384                              <1> ;Same as below but always sets the cluster we are unlinking at to EOC.
   385                              <1> ;Input: eax = Cluster to start unlinking at (zero extended to 32 bits)
   386                              <1> ;       rbp = Current DPB to use for disk
   387                              <1> ;Output: CF = NC => All ok. CF = CY => Hard Error, exit
   388 00000CED 50                  <1>     push rax    ;Save the cluster number to start unlinking at
   389 00000CEE 56                  <1>     push rsi
   390 00000CEF E82B000000          <1>     call freeChainFAT   ;Preserves eax, frees the full chain.
   391 00000CF4 721B                <1>     jc .exit
   392 00000CF6 BEFFFFFFFF          <1>     mov esi, -1         ;Realloc the cluster we are freeing from as EOC
   393 00000CFB 50                  <1>     push rax            ;Save the cluster we are writing at
   394 00000CFC E804010000          <1>     call writeFAT
   395 00000D01 58                  <1>     pop rax
   396 00000D02 720D                <1>     jc .exit
   397 00000D04 E8DC010000          <1>     call decrementFreeClusterCount  ;Remove it from the free cluster count!
   398                              <1> .setFree:
   399                              <1> ;Do this stuff here, because we want to update the free count too!
   400 00000D09 89452D              <1>     mov dword [rbp + dpb.dNextFreeClst], eax ;And set this to search from
   401 00000D0C E86C020000          <1>     call writeFSInfoSector  ;New first free cluster values
   402                              <1> .exit:
   403 00000D11 5E                  <1>     pop rsi
   404 00000D12 58                  <1>     pop rax
   405                              <1>     return
