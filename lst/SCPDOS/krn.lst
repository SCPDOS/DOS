   420                              <1> FCBToAsciiz:
   421                              <1> ;Converts a filename in the form FILENAMEEXT to FILENAME.EXT,0
   422                              <1> ;Name is space padded too
   423                              <1> ;Input: rsi = FCB name buffer
   424                              <1> ;       rdi = ASCIIZ string buffer
   425 0000144F B908000000          <1>     mov ecx, 8
   426 00001454 F3A4                <1>     rep movsb   ;Move the name over
   427                              <1> .scanNameSpace:
   428 00001456 807FFF20            <1>     cmp byte [rdi - 1], " " ;Is the previous char a space?
   429 0000145A 750D                <1>     jne .ext
   430 0000145C 48FFCF              <1>     dec rdi
   431 0000145F FFC1                <1>     inc ecx
   432 00001461 81F908000000        <1>     cmp ecx, 8
   433 00001467 72ED                <1>     jb .scanNameSpace
   434                              <1> .ext:
   435 00001469 66813E2020          <1>     cmp word [rsi], "  "    ;Are the first two chars a space?
   436 0000146E 7506                <1>     jne .validExt
   437 00001470 807E0220            <1>     cmp byte [rsi + 2], " " ;Is the final char a space?
   438 00001474 7415                <1>     je .exit
   439                              <1> .validExt:
   440 00001476 B02E                <1>     mov al, "." ;We have a valid extension, store a period
   441 00001478 AA                  <1>     stosb
   442 00001479 B903000000          <1>     mov ecx, 3
   443 0000147E F3A4                <1>     rep movsb   ;Move the three extension chars over
   444                              <1> .scanExtSpace:
   445 00001480 807FFF20            <1>     cmp byte [rdi - 1], " " ;Is the previous char a space
   446 00001484 7505                <1>     jne .exit
   447 00001486 48FFCF              <1>     dec rdi
   448 00001489 EBF5                <1>     jmp short .scanExtSpace
   449                              <1> .exit:
   450 0000148B 31C0                <1>     xor eax, eax
   451 0000148D AA                  <1>     stosb   ;Store a null at the end
   452                              <1>     return
    13                              <2> %%_ret:
    14 0000148E C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
