  2996 0000547A 488B1D(6B040000)    <1>     mov rbx, qword [qPID]
  2997 00005481 48895F47            <1>     mov qword [rdi + sft.qPID], rbx
  2998 00005485 8B1D(73040000)      <1>     mov ebx, dword [dMID]
  2999 0000548B 895F43              <1>     mov dword [rdi + sft.dMID], ebx
  3000 0000548E 5B                  <1>     pop rbx
  3001 0000548F F8                  <1>     clc
