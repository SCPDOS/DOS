    36                              <3> %%a:
    37                              <3> 
    97 00000B25 53                  <1>     push rbx
    98                              <1> .lp:
    99 00000B26 89C3                <1>     mov ebx, eax
   100 00000B28 E821020000          <1>     call readFAT
   101 00000B2D 7209                <1>     jc .exit
   102 00000B2F 3DFFFFFFFF          <1>     cmp eax, -1 ;Once this is EOC, we add a new cluster.
   103 00000B34 75F0                <1>     jne .lp
   104 00000B36 89D8                <1>     mov eax, ebx    ;Get the last cluster value in ebx
   105                              <1> .exit: 
   106 00000B38 5B                  <1>     pop rbx
