   400 00007669 8A4501              <1>     mov al, byte [rbp + dpb.bUnitNumber]    ;Get the unit number
   401 0000766C 8805(F4040000)      <1>     mov byte [primReqPkt + ioReqPkt.unitnm], al ;Store the unit number
   402                              <1> primReqCommonExit:
