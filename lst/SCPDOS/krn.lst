     7                              <1> ;Above is the system stats
     8                              <1> ;Below is the DOS vars, DO NOT TOUCH FROM validNetNam TO NUMJOINDRV
     9 0000001D ????????????????    <1>     dosPSP      dq ?    ;PSP to initial DOS PSP (aliased by 8, used by share)
