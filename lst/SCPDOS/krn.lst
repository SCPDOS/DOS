  1067                              <1> searchForPathspec:
  1068                              <1>     ;Now search the current directory for this filename
  1069                              <1>     ;Find first using SDA ffBlock
  1070                              <1>     ;If al = 0, we have final file name or directory name
  1071                              <1>     ;If al = \, we have subdirectory. NO WILDCARDS ALLOWED IF PATHSEP
  1072                              <1>     ;Output: CF=CY => Error occured, al has error code (Fnf or Pnf)
  1073                              <1>     ;        CF=NC => Disk File in fcbName found with selected attributes
  1074                              <1>     ;                 FF block somewhat setup
  1075                              <1>     ;Preserves rax, rbx, rsi,  rdi
  1076 000019ED 50                  <1>     push rax
  1077 000019EE 53                  <1>     push rbx
  1078 000019EF 56                  <1>     push rsi    ;Save the current position of the pointer in the user buffer
  1079 000019F0 57                  <1>     push rdi    ;Save current position to store filename in internal buffer
  1080 000019F1 0FB61D(9B040000)    <1>     movzx ebx, byte [fileDirFlag]   ;Save the old flag that was set on entry
  1081 000019F8 53                  <1>     push rbx    ;and push it onto the stack
  1082                              <1> ;Evaluate whether we are searching for a file for a directory
  1083 000019F9 84C0                <1>     test al, al
