   338                              <1> getNextSectorOfFile:
   339                              <1> ;This function will return the next sector of a file in rax
   340                              <1> ;If the next sector to be read lives in the next cluster, it will update
   341                              <1> ; the vars appropriately
   342                              <1> ;
   343                              <1> ;Input: rbp = dpb pointer
   344                              <1> ;Output:
   345                              <1> ;       CF=NC => rax = Next sector to read into a memory buffer
   346                              <1> ;           If ZF=ZE => [currClustF] = Last Cluster of File.
   347                              <1> ;       CF=CY => Critical error occurred and was FAILed
   348                              <1> ;Read next sector. If at last sector in cluster, walk map, get
   349                              <1> ; next cluster and read first sector 
   350                              <1>     ;Check if we need to go to next cluster
   351 00000CB7 8A05(8D070000)      <1>     mov al, byte [currSectC]    ;Get current sector rel Cluster
   352 00000CBD 3A4504              <1>     cmp al, byte [rbp + dpb.bMaxSectorInCluster]
   353 00000CC0 741C                <1>     je .gotoNextCluster
   354                              <1>     ;Goto next sector in same cluster
   355 00000CC2 FE05(8D070000)      <1>     inc byte [currSectC]    ;Goto next sector in cluster
   356 00000CC8 48FF05(8E070000)    <1>     inc qword [currSectD]  ;Goto next sector on Disk
   357 00000CCF 488B05(8E070000)    <1>     mov rax, qword [currSectD]
   358                              <1> .exit:
   359 00000CD6 50                  <1>     push rax
   360 00000CD7 31C0                <1>     xor eax, eax
   361 00000CD9 FFC0                <1>     inc eax ;Ensure ZF=NZ
   362 00000CDB 58                  <1>     pop rax
   363 00000CDC F8                  <1>     clc     ;And CF=NC
   364                              <1>     return
    13                              <2> %%_ret:
    14 00000CDD C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   365                              <1> .gotoNextCluster:
   366 00000CDE 8B05(85070000)      <1>     mov eax, dword [currClustD] ;Get absolute cluster number
   367 00000CE4 E88D000000          <1>     call readFAT
   368                              <1>     retc
