   978 00001937 E87A5F0000          <1>     call swapPathSeparator  ;And if it is a pathsep, skip any bunched pathseps
   979 0000193C 0F848D000000        <1>     jz .cpsSkipPathseps ; and then exit with the final converted pathsep in al
   980 00001942 3C2E                <1>     cmp al, "." ;Filename extension separator
   981 00001944 7420                <1>     je .cpsExtension
