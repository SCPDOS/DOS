   559                              <1> writeFAT:
   560                              <1> ;Given a cluster number to edit in eax and a number in ebx to store in 
   561                              <1> ; that FAT entry, this program will write ebx for cluster eax in the FAT.
   562                              <1> ;If the FAT is FAT 12, only the low 12 bits of eax and ebx will be used.
   563                              <1> ;If the FAT is FAT 16, only the low 16 bits of eax and ebx will be used.
   564                              <1> ;Input: esi = Cluster value, eax = Cluster to write at
   565 00000E05 53                  <1>     push rbx
   566 00000E06 51                  <1>     push rcx
   567 00000E07 52                  <1>     push rdx
   568 00000E08 56                  <1>     push rsi
   569 00000E09 57                  <1>     push rdi
   570 00000E0A 55                  <1>     push rbp
   571 00000E0B 89C7                <1>     mov edi, eax    ;Save cluster number in edi
   572 00000E0D E895FCFFFF          <1>     call clust2FATEntry ;Returns sector in FAT in eax, offset in sector in edx
   573                              <1>     ;and FAT type in ecx
   574 00000E12 E850FCFFFF          <1>     call getBufForFat ;Buffer Header in ebx, first buffer being requested
   575 00000E17 7223                <1>     jc .exitFail
   576                              <1>     ;Check if FAT 12, 16, 32
   577 00000E19 85C9                <1>     test ecx, ecx
   578 00000E1B 7426                <1>     jz .gotoNextClusterFat12    ;Handle FAT 12 separately
   579 00000E1D F7C101000000        <1>     test ecx, 1
   580 00000E23 7407                <1>     jz .goToNextClusterFat32
   581                              <1>     ;Here we handle FAT16
   582 00000E25 6689741320          <1>     mov word [rbx + bufferHdr.dataarea + rdx], si ;Store the value
   583 00000E2A EB0A                <1>     jmp short .exit
   584                              <1> .goToNextClusterFat32:
   585 00000E2C 81E6FFFFFF0F        <1>     and esi, 0FFFFFFFh  ;Zero upper nybble
   586 00000E32 89741320            <1>     mov dword [rbx + bufferHdr.dataarea + rdx], esi
   587                              <1> .exit:
   588 00000E36 E8DFFAFFFF          <1>     call markBufferDirty
   589 00000E3B F8                  <1>     clc
   590                              <1> .exitFail:
   591 00000E3C 5D                  <1>     pop rbp
   592 00000E3D 5F                  <1>     pop rdi
   593 00000E3E 5E                  <1>     pop rsi
   594 00000E3F 5A                  <1>     pop rdx
   595 00000E40 59                  <1>     pop rcx
   596 00000E41 5B                  <1>     pop rbx
