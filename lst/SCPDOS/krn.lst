   403 00007726 8805(00050000)      <1>     mov byte [primReqPkt + ioReqPkt.medesc], al ;Store medesc!
   404 0000772C 8A4501              <1>     mov al, byte [rbp + dpb.bUnitNumber]    ;Get the unit number
   405 0000772F 8805(F4040000)      <1>     mov byte [primReqPkt + ioReqPkt.unitnm], al ;Store the unit number
   406                              <1> primReqCommonExit:
   407                              <1> ;Returns in rbx the primary request header as these functions
   408                              <1> ; setup the request in the primary request header space
   409 00007735 58                  <1>     pop rax
   410 00007736 488D1D(F3040000)    <1>     lea rbx, primReqPkt ;Put in rbx the primary request header
   411                              <1>     return
