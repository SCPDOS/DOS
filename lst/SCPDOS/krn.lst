   246                              <1> testDirtyBufferForDrive:    ;External linkage
   247                              <1> ;Searches the buffer chain for a dirty buffer for a given drive letter.
   248                              <1> ;Input: al = Drive number (0 based)
   249                              <1> ;Output: CF=CY => Dirty buffer found, CF=NC => No dirty buffer found
   250                              <1> ;Consequently, ZF=NZ => Dirty buffer found, ZF=ZE => No dirty buffer found
   251 000008DB 53                  <1>     push rbx
   252 000008DC 488B1D(65000000)    <1>     mov rbx, qword [bufHeadPtr]
   253                              <1> .tdbfdCheckBuffer:
   254 000008E3 384308              <1>     cmp byte [rbx + bufferHdr.driveNumber], al
   255 000008E6 7509                <1>     jne .tdbfdGotoNextBuffer
   256 000008E8 F6430940            <1>     test byte [rbx + bufferHdr.bufferFlags], dirtyBuffer
   257 000008EC 7403                <1>     jz .tdbfdGotoNextBuffer ;Bit not set, goto next buffer
   258 000008EE F9                  <1>     stc ;Else dirty buffer found, set carry flag
   259                              <1> .tdbfdExit:
   260 000008EF 5B                  <1>     pop rbx
   261                              <1>     return
