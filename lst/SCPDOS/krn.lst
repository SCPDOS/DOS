   683                              <1> readFSInfoSector:
   684                              <1> ;Given a DPB, will attempt to read the FS Info sector. Destroys all regs.
   685                              <1> ;Input: rbp -> DPB pointer for FAT32 volume. Silently returns ok
   686                              <1> ;               if the DPB is not FAT32.
   687                              <1> ;       rsi -> BPB for the FAT32 volume.
   688                              <1> ;Output: rbp -> DPB dNextFreeClst and dNumberOfFreeCluster fields
   689                              <1> ;               correctly filled in from the FSInfo sector, if appropriate.
   690 00000F24 51                  <1>     push rcx
   691 00000F25 E850FBFFFF          <1>     call getFATtype
   692 00000F2A 81F902000000        <1>     cmp ecx, 2  ;Is the DPB a FAT32 DPB?
   693 00000F30 59                  <1>     pop rcx
   694 00000F31 7578                <1>     jne .exit
