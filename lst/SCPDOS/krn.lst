  1403                              <1> ; directory entry of the parent directory we are writing in. Double check
  1404                              <1> ; this actually is a directory.
  1405 0000448E F605(97060000)10    <1>     test byte [curDirCopy + fatDirEntry.attribute], dirDirectory
  1406 00004495 0F8451FFFFFF        <1>     jz .rimAccDen
