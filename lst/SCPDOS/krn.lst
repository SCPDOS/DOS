   340                              <1> getNextSectorOfFile:
   341                              <1> ;This function will return the next sector of a file in rax
   342                              <1> ;If the next sector to be read lives in the next cluster, it will update
   343                              <1> ; the vars appropriately
   344                              <1> ;
   345                              <1> ;Input: rbp = dpb pointer
   346                              <1> ;Output:
   347                              <1> ;       CF=NC => rax = Next sector to read into a memory buffer
   348                              <1> ;           If ZF=ZE => [currClustF] = Last Cluster of File.
   349                              <1> ;       CF=CY => Critical error occurred and was FAILed
   350                              <1> ;Read next sector. If at last sector in cluster, walk map, get
   351                              <1> ; next cluster and read first sector 
   352                              <1>     ;Check if we need to go to next cluster
   353 00000C8F 8A05(8D070000)      <1>     mov al, byte [currSectC]    ;Get current sector rel Cluster
   354 00000C95 3A4504              <1>     cmp al, byte [rbp + dpb.bMaxSectorInCluster]
   355 00000C98 741C                <1>     je .gotoNextCluster
   356                              <1>     ;Goto next sector in same cluster
   357 00000C9A FE05(8D070000)      <1>     inc byte [currSectC]    ;Goto next sector in cluster
   358 00000CA0 48FF05(8E070000)    <1>     inc qword [currSectD]  ;Goto next sector on Disk
   359 00000CA7 488B05(8E070000)    <1>     mov rax, qword [currSectD]
   360                              <1> .exit:
   361 00000CAE 50                  <1>     push rax
   362 00000CAF 31C0                <1>     xor eax, eax
   363 00000CB1 FFC0                <1>     inc eax ;Ensure ZF=NZ
   364 00000CB3 58                  <1>     pop rax
   365 00000CB4 F8                  <1>     clc     ;And CF=NC
   366                              <1>     return
    13                              <2> %%_ret:
    14 00000CB5 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   367                              <1> .gotoNextCluster:
   368 00000CB6 8B05(85070000)      <1>     mov eax, dword [currClustD] ;Get absolute cluster number
   369 00000CBC E88D000000          <1>     call readFAT
   370                              <1>     retc
