   262                              <1> .tdbfdGotoNextBuffer:
   263 000008E2 488B1B              <1>     mov rbx, qword [rbx + bufferHdr.nextBufPtr]
   264 000008E5 4881FBFFFFFFFF      <1>     cmp rbx, -1     ;If rbx points to -1, exit (Also clears CF)
   265 000008EC 74F2                <1>     je .tdbfdExit
   266 000008EE EBE4                <1>     jmp short .tdbfdCheckBuffer
