   103 00003258 488D3D(61060000)    <1>     lea rdi, dosffblock ;Set rdi to point to the dosffblock
   104 0000325F 31C0                <1>     xor eax, eax
   105 00003261 AC                  <1>     lodsb   ;Get the FCB drive letter
