   394                              <1> findLRUBuffer: ;Internal Linkage
   395                              <1> ;Finds first free or least recently used buffer, links it and returns ptr to it 
   396                              <1> ; in rdi and the currBuff variable
   397                              <1> ;Input: Nothing
   398                              <1> ;Output: rdi = Pointer to the buffer hdr to use
   399                              <1> ;       [currBuff] = Pointer to the buffer hdr to use
   400 000009DC 52                  <1>     push rdx
   401 000009DD 488B3D(65000000)    <1>     mov rdi, qword [bufHeadPtr]
   402 000009E4 807F08FF            <1>     cmp byte [rdi + bufferHdr.driveNumber], -1  ;Check if 1st entry is free
   403 000009E8 7436                <1>     je .flbExit 
   404 000009EA 48813FFFFFFFFF      <1>     cmp qword [rdi + bufferHdr.nextBufPtr], -1  ;Check if 1st entry is last
   405 000009F1 742D                <1>     je .flbExit
   406                              <1> .flbWalk:
   407 000009F3 4889FA              <1>     mov rdx, rdi    ;Save a ptr to the previous buffer header
   408 000009F6 488B3A              <1>     mov rdi, qword [rdx + bufferHdr.nextBufPtr] ;Get next buffer header ptr
   409 000009F9 807F08FF            <1>     cmp byte [rdi + bufferHdr.driveNumber], -1
   410 000009FD 742A                <1>     je .flbFreeLink ;If free, link to head, and xlink prev and next buffs
   411 000009FF 48813FFFFFFFFF      <1>     cmp qword [rdi + bufferHdr.nextBufPtr], -1 ;Check if at LRU buffer
   412 00000A06 75EB                <1>     jne .flbWalk   ;If not LRU, keep walking, else process
   413 00000A08 48C702FFFFFFFF      <1>     mov qword [rdx + bufferHdr.nextBufPtr], -1  ;Make prev node the LRU node
   414                              <1> .flbHeadLink:
   415 00000A0F 488B15(65000000)    <1>     mov rdx, qword [bufHeadPtr]    ;Now copy old MRU buffer ptr to rdx
   416 00000A16 48893D(65000000)    <1>     mov qword [bufHeadPtr], rdi    ;Sysvars to point to new buffer
   417 00000A1D 488917              <1>     mov qword [rdi + bufferHdr.nextBufPtr], rdx
   418                              <1> .flbExit:
   419 00000A20 5A                  <1>     pop rdx
   420 00000A21 48893D(6F070000)    <1>     mov qword [currBuff], rdi   ;Save in variable too
   421                              <1>     return
