   493 00007F6F 9D                  <1>     popfq
   494 00007F70 5E                  <1>     pop rsi
   495 00007F71 5B                  <1>     pop rbx
   496 00007F72 58                  <1>     pop rax
   497                              <1>     return
    13                              <2> %%_ret:
    14 00007F73 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
