   548                              <1>     ; root directories of FAT12/16 drives. Instead add manual offset from dpb
   549 0000243F 0FB71D(B4070000)    <1>     movzx ebx, word [dirSect]
   550 00002446 85C0                <1>     test eax, eax
   551 00002448 7407                <1>     jz .skipCluster
   552 0000244A E8B3E6FFFF          <1>     call getStartSectorOfCluster    ;Get sector number in rax
   553 0000244F EB1B                <1>     jmp short .skipOldFat
