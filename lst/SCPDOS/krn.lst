   298                              <1> getBuffer: ;Internal Linkage ONLY
   299                              <1> ;
   300                              <1> ;WHENEVER A DATA BUFFER IS NEEDED FOR SECTOR DATA, THIS IS THE FUNCTION
   301                              <1> ;TO CALL! WORKS ON THE WORKING DPB!
   302                              <1> ;Flushes if not in disk change mode. 
   303                              <1> ;If in disk change mode, will check to see if the selected buffer 
   304                              <1> ; has data referring a device using the same DPB as we are changing.
   305                              <1> ; If it is, skip flushing, if not, flush first!
   306                              <1> ;
   307                              <1> ;This function will return a pointer to the desired data sector OR 
   308                              <1> ; find the most appropriate buffer, flush and read the relevant data into the 
   309                              <1> ; buffer, again then returning a pointer to the sector buffer in rbx.
   310                              <1> ;Entry: rax = Sector to read
   311                              <1> ;        cl = Data type being read (DOS, FAT, DIR, Data)
   312                              <1> ;       rbp = DPB to use for transaction
   313                              <1> ;Exit:  CF=NC => 
   314                              <1> ;           Ptr to buffer header with valid data in buffer in rbx and [currBuf]
   315                              <1> ;       CF=CY => Critical Error returned Fail, rbx undefined
   316 00000939 8A5500              <1>     mov dl, byte [rbp + dpb.bDriveNumber]
   317 0000093C E80F010000          <1>     call findSectorInBuffer ;rax = sector to read, dl = drive number
   318 00000941 4881FFFFFFFFFF      <1>     cmp rdi, -1 ;Get in rdi the buffer ptr
   319 00000948 741B                <1>     je .rbReadNewSector
   320 0000094A 48893D(6F070000)    <1>     mov qword [pCurrBuff], rdi   ;Save the found buffer ptr in the variable
   321 00000951 E8E9FDFFFF          <1>     call makeBufferMostRecentlyUsed
   322 00000956 F8                  <1>     clc
   323                              <1> .rbExit:
   324 00000957 9C                  <1>     pushfq
   325 00000958 488B1D(6F070000)    <1>     mov rbx, qword [pCurrBuff]   ;Get current buffer
   326 0000095F 804B0920            <1>     or byte [rbx + bufferHdr.bufferFlags], refBuffer    ;Mark as referenced!
   327 00000963 9D                  <1>     popfq
   328                              <1>     return
    13                              <2> %%_ret:
    14 00000964 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   329                              <1> .rbReadNewSector:
   330 00000965 E88F000000          <1>     call findLRUBuffer  ;Get the LRU or first free buffer entry in rdi
   331                              <1> ;At this point, qword [pCurrBuff] has the same pointer as rdi.
   332 0000096A E8D1FEFFFF          <1>     call flushAndFreeBuffer ;Preserves all DOS regs.
   333 0000096F 72E6                <1>     jc .rbExit
   334                              <1> ;rdi points to bufferHdr that has been appropriately linked to the head of chain
   335                              <1> ;Thus we have a free buffer to work with.
   336 00000971 4889C2              <1>     mov rdx, rax    ;Move the sector number into rdx
   337 00000974 488D5F20            <1>     lea rbx, qword [rdi + bufferHdr.dataarea]
   338                              <1> ;Here, regs are setup for the function we call below.
   339 00000978 E839000000          <1>     call readSectorBuffer ;Carry the flag from the request
   340 0000097D 72D8                <1>     jc .rbExit
   341                              <1> ;Need to write the correct data into the buffer header if OK read.
   342 0000097F 488B3D(6F070000)    <1>     mov rdi, qword [pCurrBuff]   ;Get current buffer
   343 00000986 48896F17            <1>     mov qword [rdi + bufferHdr.driveDPBPtr], rbp
   344 0000098A 4889570A            <1>     mov qword [rdi + bufferHdr.bufferLBA], rdx
   345 0000098E 884F09              <1>     mov byte [rdi + bufferHdr.bufferFlags], cl
   346 00000991 0FB64500            <1>     movzx eax, byte [rbp + dpb.bDriveNumber]
   347 00000995 884708              <1>     mov byte [rdi + bufferHdr.driveNumber], al
   348                              <1> ;Now we do the FAT specific adjustments.
   349 00000998 31D2                <1>     xor edx, edx    ;FAT size
   350 0000099A 89D3                <1>     mov ebx, edx    
   351 0000099C FFC3                <1>     inc ebx         ;FAT copies
   352 0000099E 0FB64508            <1>     movzx eax, byte [rbp + dpb.bNumberOfFATs]
   353 000009A2 F6C102              <1>     test cl, fatBuffer
   354 000009A5 0F44C3              <1>     cmovz eax, ebx  ;If not fat buffer, set number of FATs to 1
   355 000009A8 894712              <1>     mov dword [rdi + bufferHdr.bufFATcopy], eax
   356 000009AB 8B4513              <1>     mov eax, dword [rbp + dpb.dFATlength]
   357 000009AE 0F44C2              <1>     cmovz eax, edx  ;If not FAT, store zero.
   358 000009B1 894713              <1>     mov dword [rdi + bufferHdr.bufFATsize], eax
   359 000009B4 EBA1                <1>     jmp short .rbExit   ;Jump preserving the carry flag
   360                              <1> 
   361                              <1> readSectorBuffer:   ;Internal Linkage
   362                              <1> ;Reads a sector into a buffer. 
   363                              <1> ;Entry: 
   364                              <1> ; rbx = qword ptr: Buffer area to read into.
   365                              <1> ; rcx = byte: Buffer flags.
   366                              <1> ; rdx = qword: Sector to read
   367                              <1> ; rbp = qword ptr: DPB pointer
