   106                              <1> criticalDOSError:   ;Int 2Fh, AX=1206h, Invoke Critical Error Function 
   107                              <1> ;Will swap stacks and enter int 24h safely and handle passing the right data 
   108                              <1> ; to the critical error handler.
   109                              <1> ; Called with rsi set as required by Int 24h (caller decides), ax, di
   110                              <1> ; and with Int24Bitfield set
   111                              <1> ;               AH = Critical Error Bitfield
   112                              <1> ;               Bit 7 = 0 - Disk Error, Bit 7 = 1 - Char Device Error
   113                              <1> ;               Bit 6 - Reserved
   114                              <1> ;               Bit 5 = 0 - IGNORE not allowed, Bit 5 = 1 - IGNORE allowed
   115                              <1> ;               Bit 4 = 0 - RETRY not allowed, Bit 4 = 1 - RETRY allowed
   116                              <1> ;               Bit 3 = 0 - FAIL not allowed, Bit 3 = 1 - FAIL allowed
   117                              <1> ;               Bits [2-1] = Affected Disk Error
   118                              <1> ;                     0 0   DOS area
   119                              <1> ;                     0 1   FAT area
   120                              <1> ;                     1 0   Directory area
   121                              <1> ;                     1 1   Data area
   122                              <1> ;               Bit 0 = 0 - Read Operation, Bit 0 = 1 - Write Operation
   123                              <1> ;               AL  = Failing drive number if AH[7] = 0
   124                              <1> ;               DIL = Error code for errorMsg
   125                              <1> ;               RSI = EA of Device Header for which device the error occured
   126                              <1> ;Return:
   127                              <1> ;               AL = 0 - Ignore the Error       (Ignore)
   128                              <1> ;                  = 1 - Retry the Operation    (Retry)
   129                              <1> ;               XXX= 2 - Terminate the Program  (Abort)XXX
   130                              <1> ;                  = 3 - Fail the DOS call      (Fail)
   131                              <1> ; Return response from int 24h in al
   132                              <1> ; Caller must preserve rsp, rbx, rcx, rdx if they wish to return to DOS
   133                              <1> ; This function will terminate the program if an abort was requested!
   134                              <1> ; This function also destroys RBP
   135 00006D59 F605(37040000)FF    <1>     test byte [critErrFlag], -1   ;If not zero, already in error. Auto FAIL
   136 00006D60 0F8581000000        <1>     jnz .setFail
   137 00006D66 488925(92040000)    <1>     mov qword [xInt24hRSP], rsp ;Save our critical error stack pointer
   138 00006D6D 66813D(6B070000)FF- <1>     cmp word  [currentNdx], -1  ;If this is -1, we are not opening a file
   138 00006D75 FF                  <1>
   139 00006D76 740C                <1>     je .notOpeningFile
   140 00006D78 57                  <1>     push rdi
   141 00006D79 488B3D(5B070000)    <1>     mov rdi, qword [curHdlPtr]  ;Get the pointer to the current handle entry
