   558                              <1> .net:
   559 000015A6 4889F7              <1>     mov rdi, rsi                ;Else, skip setting up vars for drive access
   560 000015A9 E994010000          <1>     jmp pathWalk.netEp          ;Still do all drive access using CDS, but over redir
