   157                              <1> extErrTbl:
   158                              <1> ;This table contains the default values for how to respond
   159                              <1> ; to particular errors. Fields with -1 need to be filled in before
   160                              <1> ; setting variables using this table.
   161                              <1> ;Each entry in the table is 4 bytes long, and are defined as follows:
   162                              <1> ; Byte 0: Extended Error Code as a byte
   163                              <1> ; Byte 1: Error Class
   164                              <1> ; Byte 2: Error Suggested Action
   165                              <1> ; Byte 3: Error Locus
   166                              <1> ;If a byte is -1, we dont set that variable (Thus allowing the caller to set)
   167                              <1> ;
   168                              <1> ;Error 01h: Invalid function number
   169 0000013D 010704FF            <1>     db errInvFnc, eClsAppFlt, eActAbt, -1   ;Locus set before call
   170                              <1> ;Error 02h: File not found
   171 00000141 02080302            <1>     db errFnf, eClsNotFnd, eActUsr, eLocDsk 
   172                              <1> ;Error 03h: Path not found
   173 00000145 03080302            <1>     db errPnf, eClsNotFnd, eActUsr, eLocDsk
   174                              <1> ;Error 04h: Too many open handles, and no handles are left
   175 00000149 04010401            <1>     db errNhl, eClsOoR, eActAbt, eLocUnk
   176                              <1> ;Error 05h: Access being denied
   177 0000014D 050303FF            <1>     db errAccDen, eClsAuth, eActUsr, -1
   178                              <1> ;Error 06h: Invalid File handle being provided
   179 00000151 06070401            <1>     db errBadHdl, eClsAppFlt, eActAbt, eLocUnk
   180                              <1> ;Error 07h: MCB chain destroyed
   181 00000155 07070505            <1>     db errMCBbad, eClsAppFlt, eActKil, eLocMem
   182                              <1> ;Error 08h: No Memory remaining
   183 00000159 08010405            <1>     db errNoMem, eClsOoR, eActAbt, eLocMem
   184                              <1> ;Error 09h: Invalid MCB block Address
   185 0000015D 09070405            <1>     db errMemAddr, eClsAppFlt, eActAbt, eLocMem
   186                              <1> ;Error 0Ah: Bad Environment block
   187 00000161 0A070405            <1>     db errBadEnv, eClsAppFlt, eActAbt, eLocMem
   188                              <1> ;Error 0Bh: Data provided in a bad format
   189 00000165 0B090301            <1>     db errBadFmt, eClsBadFmt, eActUsr, eLocUnk
   190                              <1> ;Error 0Ch: Access Code Invalid
   191 00000169 0C070401            <1>     db errAccCde, eClsAppFlt, eActAbt, eLocUnk
   192                              <1> ;Error 0Dh: Error due to Invalid Data provided
   193 0000016D 0D090401            <1>     db errInvDat, eClsBadFmt, eActAbt, eLocUnk
   194                              <1> ;Error 0Fh: Error due to a bad drive letter being provided
   195 00000171 0F080302            <1>     db errBadDrv, eClsNotFnd, eActUsr, eLocDsk
   196                              <1> ;Error 10h: Error due to attempting to delete the CWD
   197 00000175 10030302            <1>     db errDelCD, eClsAuth, eActUsr, eLocDsk
   198                              <1> ;Error 11h: Error due to a unknown device being used
   199 00000179 110D0302            <1>     db errDevUnk, eClsUnk, eActUsr, eLocDsk
   200                              <1> ;Error 12h: No more file handles available
   201 0000017D 12080302            <1>     db errNoFil, eClsNotFnd, eActUsr, eLocDsk
   202                              <1> ;Error 50h: File already exits
   203 00000181 500C0302            <1>     db errFilExist, eClsClash, eActUsr, eLocDsk
   204                              <1> ;Error 20h: Share Violation, Resource cannot be shared
   205 00000185 200A0202            <1>     db errShrVio, eClsLocked, eActDRet, eLocDsk
   206                              <1> ;Error 21h: File Lock Violation
   207 00000189 210A0202            <1>     db errLokVio, eClsLocked, eActDRet, eLocDsk
   208                              <1> ;Error 54h: Too many levels of redirection error
   209 0000018D 540104FF            <1>     db errRedir, eClsOoR, eActAbt, -1
   210                              <1> ;Error 56h: Bad resource password provided
   211 00000191 56030301            <1>     db errBadPass, eClsAuth, eActUsr, eLocUnk
   212                              <1> ;Error 52h: Directory already exists
   213 00000195 52010402            <1>     db errDirExist, eClsOoR, eActAbt, eLocDsk
   214                              <1> ;Error 32h: Network request not supported by DOS
   215 00000199 32090303            <1>     db errNetGeneric, eClsBadFmt, eActUsr, eLocNet
   216                              <1> ;Error 55h: Trying to duplicate a redirection for a resource
   217 0000019D 550C0303            <1>     db errDupRedir, eClsClash, eActUsr, eLocNet
   218                              <1> ;Error 57h: Bad parameter in request
   219 000001A1 57090301            <1>     db errBadParam, eClsBadFmt, eActUsr, eLocUnk
   220                              <1> ;Error 53h: Fail was returned from Int 24h
   221 000001A5 530D0401            <1>     db errFI24, eClsUnk, eActAbt, eLocUnk
   222                              <1> ;Error 24h: Sharing Buffer Full
   223 000001A9 24010405            <1>     db errShrFul, eClsOoR, eActAbt, eLocMem
   224                              <1> ;Error 26h: Handle reached EOF on handle that reports EOF
   225 000001AD 26010401            <1>     db errHdlEOF, eClsOoR, eActAbt, eLocUnk
   226                              <1> ;Error 27h: Handle reached a full disk condition and asked to report this
   227 000001B1 27010401            <1>     db errDskFul, eClsOoR, eActAbt, eLocUnk
   228                              <1> ;Error CBh: Environment variable not found
   229 000001B5 CB090305            <1>     db errEnvVarNotFnd, eClsBadFmt, eActUsr, eLocMem
   230                              <1> ;Error XXh: Catch all case
   231 000001B9 FFFFFFFF            <1>     dd -1
   232                              <1> 
   233                              <1> hardErrTbl:
   234                              <1> ;Same format as above, used for translating hard errors.
   235                              <1> ; Byte 0: Extended Error Code as a byte
   236                              <1> ; Byte 1: Error Class
   237                              <1> ; Byte 2: Error Suggested Action
   238                              <1> ; Byte 3: Error Locus
   239                              <1> ;If a byte is -1, we dont set that variable (Thus allowing the caller to set)
   240                              <1> ;
   241                              <1> ;DOS Error 19/Driver Error 0: Write Protect Error
   242 000001BD 130B0702            <1>     db errWpd, eClsMedia, eActRetUsr, eLocDsk
   243                              <1> ;DOS Error 20/Driver Error 1: Unknown Unit
   244 000001C1 14040501            <1>     db errUnkUnt, eClsInt, eActKil, eLocUnk
   245                              <1> ;DOS Error 21/Driver Error 2: Drive not ready
   246 000001C5 150507FF            <1>     db errDrvNR, eClsHrdFlt, eActRetUsr, -1
   247                              <1> ;DOS Error 22/Driver Error 3: Unknown command
   248 000001C9 16040501            <1>     db errUnkCmd, eClsInt, eActKil, eLocUnk
   249                              <1> ;DOS Error 23/Driver Error 4: CRC (data integrity) error
   250 000001CD 170B0402            <1>     db errCRCerr, eClsMedia, eActAbt, eLocDsk
   251                              <1> ;DOS Error 24/Driver Error 5: Bad request length 
   252 000001D1 18040501            <1>     db errBadRLn, eClsInt, eActKil, eLocUnk
   253                              <1> ;DOS Error 25/Driver Error 6: Seek error
   254 000001D5 19050102            <1>     db errSekErr, eClsHrdFlt, eActRet, eLocDsk
   255                              <1> ;DOS Error 26/Driver Error 7: Unknown (non-DOS) medium
   256 000001D9 1A0B0702            <1>     db errUnkMed, eClsMedia, eActRetUsr, eLocDsk
   257                              <1> ;DOS Error 27/Driver Error 8: Sector not found
   258 000001DD 1B0B0402            <1>     db errSecNF, eClsMedia, eActAbt, eLocDsk
   259                              <1> ;DOS Error 28/Driver Error 9: Printer (or device) out of paper
   260 000001E1 1C020704            <1>     db errNoPap, eClsTS, eActRetUsr, eLocChr
   261                              <1> ;DOS Error 29/Driver Error 10: Write failure
   262 000001E5 1D0504FF            <1>     db errWF, eClsHrdFlt, eActAbt, -1
   263                              <1> ;DOS Error 30/Driver Error 11: Read failure
   264 000001E9 1E0504FF            <1>     db errRF, eClsHrdFlt, eActAbt, -1
   265                              <1> ;DOS Error 31/Driver Error 12: General failure
   266 000001ED 1F0D04FF            <1>     db errGF, eClsUnk, eActAbt, -1
   267                              <1> ;DOS Error 32: Share Violation, Resource cannot be shared
   268 000001F1 200A0202            <1>     db errShrVio, eClsLocked, eActDRet, eLocDsk
   269                              <1> ;DOS Error 33: File Lock Violation
   270 000001F5 210A0202            <1>     db errLokVio, eClsLocked, eActDRet, eLocDsk
   271                              <1> ;DOS Error 50: Network request not supported
   272 000001F9 32090303            <1>     db errNetGeneric, eClsBadFmt, eActUsr, eLocNet
   273                              <1> ;DOS Error 35: FCB Unavailable
   274 000001FD 23070401            <1>     db errNoFCB, eClsAppFlt, eActAbt, eLocUnk
   275                              <1> ;DOS Error 36: Sharing buffer full, Can't share more files!
   276 00000201 24010405            <1>     db errShrFul, eClsOoR, eActAbt, eLocMem
   277                              <1> ;DOS Error XX: Catch all case for other hard errors
   278 00000205 FF0D05FF            <1>     db -1, eClsUnk, eActKil, -1
