   374                              <1> ;Update the new cluster and sector information
   375 00000CDB 8905(85070000)      <1>     mov dword [currClustD], eax ;Update disk location of next cluster
   376 00000CE1 FF05(81070000)      <1>     inc dword [currClustF]   ;Goto next file cluster
   377 00000CE7 E816FEFFFF          <1>     call getStartSectorOfCluster    ;Get start sector of Cluster
