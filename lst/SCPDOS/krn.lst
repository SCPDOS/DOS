   149 00007D3E C7474D00000000      <1>     mov dword [rdi + cds.dStartCluster], 0  ;Root dir
   150 00007D45 48C7475100000000    <1>     mov qword [rdi + cds.qIFSPtr], 0    ;Optional redir signature field
   151 00007D4D C7475900000000      <1>     mov dword [rdi + cds.dNetStore], 0   ;Optional storage/signature dword
   152 00007D54 66C7475D0200        <1>     mov word [rdi + cds.wBackslashOffset], 2    ;Skip letter and :
