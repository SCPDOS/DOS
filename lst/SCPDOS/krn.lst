   551                              <1> writeFAT:
   552                              <1> ;Given a cluster number to edit in eax and a number in ebx to store in 
   553                              <1> ; that FAT entry, this program will write ebx for cluster eax in the FAT.
   554                              <1> ;If the FAT is FAT 12, only the low 12 bits of eax and ebx will be used.
   555                              <1> ;If the FAT is FAT 16, only the low 16 bits of eax and ebx will be used.
   556                              <1> ;Input: esi = Cluster value, eax = Cluster to write at
   557 00000E22 53                  <1>     push rbx
   558 00000E23 51                  <1>     push rcx
   559 00000E24 52                  <1>     push rdx
   560 00000E25 56                  <1>     push rsi
   561 00000E26 57                  <1>     push rdi
   562 00000E27 55                  <1>     push rbp
   563 00000E28 89C7                <1>     mov edi, eax    ;Save cluster number in edi
   564 00000E2A E86AFCFFFF          <1>     call clust2FATEntry ;Returns sector in FAT in eax, offset in sector in edx
   565                              <1>     ;and FAT type in ecx
   566 00000E2F E825FCFFFF          <1>     call getBufForFat ;Buffer Header in ebx, first buffer being requested
   567 00000E34 7223                <1>     jc .exitFail
   568                              <1>     ;Check if FAT 12, 16, 32
   569 00000E36 85C9                <1>     test ecx, ecx
   570 00000E38 7426                <1>     jz .gotoNextClusterFat12    ;Handle FAT 12 separately
   571 00000E3A F7C101000000        <1>     test ecx, 1
   572 00000E40 7407                <1>     jz .goToNextClusterFat32
   573                              <1>     ;Here we handle FAT16
