   449 0000356F 7402                <1>     jz .skipDriveLetter
   450 00003571 8817                <1>     mov byte [rdi + fcb.driveNum], dl   ;Clear this for usage
   451                              <1> .skipDriveLetter:
   452 00003573 48FFC7              <1>     inc rdi ;Go past the drive letter field in the FCB
   453 00003576 B908000000          <1>     mov ecx, 8  ;Copy Filename
   454 0000357B A804                <1>     test al, 4  ;Do we copy the filename to the fcb field?
   455 0000357D 93                  <1>     xchg eax, ebx
   456 0000357E B020                <1>     mov al, " " ;Clear the field
   457 00003580 7405                <1>     jz .clearFilenameField
   458 00003582 4801CF              <1>     add rdi, rcx    ;Move to the extension field of the fcb
   459 00003585 31C9                <1>     xor ecx, ecx
   460                              <1> .clearFilenameField:
   461 00003587 F3AA                <1>     rep stosb
   462 00003589 B903000000          <1>     mov ecx, 3
   463 0000358E F6C308              <1>     test bl, 8  ;Skip clearing extension field?
   464 00003591 7405                <1>     jz .clearExtensionField
   465 00003593 4801CF              <1>     add rdi, rcx
   466 00003596 31C9                <1>     xor ecx, ecx
   467                              <1> .clearExtensionField:
   468 00003598 F3AA                <1>     rep stosb
   469 0000359A 91                  <1>     xchg eax, ecx
   470 0000359B AB                  <1>     stosd   ;Initialise curBlock and recordSize like DOS does in parseFilename
   471 0000359C 4881EF10000000      <1>     sub rdi, 10h    ;Go back to head of FCB
   472 000035A3 F6C301              <1>     test bl, 1  ;Skip scanning preceeding spaces
   473 000035A6 740F                <1>     jz .dontScanOffTerm
   474 000035A8 E89F000000          <1>     call skipSeparators ;Skip leading separators
   475 000035AD E837430000          <1>     call isCharTerminator   ;If first char is terminator, go past and keep skipping
   476 000035B2 7508                <1>     jnz .skipIfNotTerminator
   477 000035B4 48FFC6              <1>     inc rsi
   478                              <1> .dontScanOffTerm:
   479 000035B7 E890000000          <1>     call skipSeparators  ;Skip separators
   480                              <1> .skipIfNotTerminator:
   481 000035BC E800430000          <1>     call uppercaseCharAtPtr 
   482 000035C1 741E                <1>     jz .skipSettingDriveLetter  ;Skip if first char not a possible drive letter
   483 000035C3 803E3A              <1>     cmp byte [rsi], ":" ;Is the next char a drive separator?
   484 000035C6 7519                <1>     jne .skipSettingDriveLetter
   485 000035C8 48FFC6              <1>     inc rsi ;Goto next char
   486 000035CB 2C40                <1>     sub al, "@" ;Convert into a 1 based drive number
   487 000035CD 7609                <1>     jbe .invalidDriveLetter ;If less than 0 or 0, fail
   488 000035CF 50                  <1>     push rax    ;Save the 1 based drive letter
   489 000035D0 E8E4410000          <1>     call getCDSNotJoin   ;Verifies if this drive letter is valid
   490 000035D5 58                  <1>     pop rax
   491 000035D6 7302                <1>     jnc .validDriveLetter
