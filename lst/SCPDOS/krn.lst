    79 00007846 48C1E310            <1>     shl rbx, 10h    ;Push the high dword high
    80 0000784A 668B5806            <1>     mov bx, word [rax + 6]      ;Get bits 31...16
    81 0000784E 48C1E310            <1>     shl rbx, 10h    ;Push word 2 into posiiton
    82 00007852 668B18              <1>     mov bx, word [rax]          ;Get bits 15...0
    83 00007855 FB                  <1>     sti
