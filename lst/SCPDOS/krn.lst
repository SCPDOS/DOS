   149                              <1> ;----------------------
   150                              <1> ; Get Env String Block
   151                              <1> ;----------------------
   152                              <1> .getEnvStrings:
   153                              <1> ;Returns a valid, opaque copy of the environment.
   154                              <1> ;
   155                              <1> ;Output: CF=NC: rdx -> Environment pointer
   156                              <1> ;        CF=CY: eax = Error code (errMCBbad, errNoMem)
   157 00006AC3 E8A3160000          <1>     call dosCrit1Enter
   158 00006AC8 498B703E            <1>     mov rsi, qword [r8 + psp.envPtr]    ;Get the raw ptr!
   159 00006ACC E8BA030000          <1>     call checkEnvGood
   160 00006AD1 7423                <1>     jz .gesDefault
   161                              <1> ;Here rsi -> points to raw environment
   162 00006AD3 E8DD030000          <1>     call getSzOfEnv ;Get number of bytes in ecx
   163 00006AD8 51                  <1>     push rcx
   164 00006AD9 81C10F000000        <1>     add ecx, 0Fh
   165 00006ADF C1E904              <1>     shr ecx, 4      ;Turn into paragraphs to allocate
   166 00006AE2 E856030000          <1>     call allocEnvSig   ;Get the block ptr in rax (preserve rsi, rdi)
   167 00006AE7 59                  <1>     pop rcx         ;Get the byte count back
   168 00006AE8 721A                <1>     jc .gesExitBad
   169                              <1> ;rsi -> Raw environment
   170 00006AEA 4889C7              <1>     mov rdi, rax
   171 00006AED F3A4                <1>     rep movsb
   172 00006AEF E881160000          <1>     call dosCrit1Exit
   173 00006AF4 EBBF                <1>     jmp short .exitOk
   174                              <1> .gesDefault:
   175 00006AF6 BB06000000          <1>     mov ebx, 6
   176 00006AFB E83D030000          <1>     call allocEnvSig   ;Get in rax the allocated pointer
   177 00006B00 7202                <1>     jc .gesExitBad
   178 00006B02 EBB1                <1>     jmp short .exitOk
   179                              <1> .gesExitBad:
   180 00006B04 E86C160000          <1>     call dosCrit1Exit
   181 00006B09 E942FFFFFF          <1>     jmp .exitBad
   182                              <1> ;----------------------
   183                              <1> ; Set Env String Block
   184                              <1> ;----------------------
   185                              <1> .setEnvStrings:
   186                              <1> ;Gets a block of environment strings. This will replace the current
   187                              <1> ; environment. Also copies and maintains the additional strings after 
   188                              <1> ; the environment, if present. 
   189                              <1> ;The environment strings DONT have to be from a get strings block 
   190                              <1> ; that we provide, that would be limiting and absurd.
   191                              <1> ;
   192                              <1> ;Input: rdx -> Environment block to set
   193                              <1> ;Output: CF=NC: Environment updated with new set of strings
   194                              <1> ;        CF=CY: Error in update (errMCBbad, errMemAddr, errNoMem, errBadFmt)
   195 00006B0E E858160000          <1>     call dosCrit1Enter
   196 00006B13 4889D6              <1>     mov rsi, rdx
   197 00006B16 E870030000          <1>     call checkEnvGood   ;This needs input in rsi and preserves it
   198 00006B1B 7460                <1>     jz .sesExitBadEnv
   199 00006B1D E893030000          <1>     call getSzOfEnv ;Get in ecx the length of the env. Preserves rsi
   200 00006B22 51                  <1>     push rcx        ;Save the env size
   201 00006B23 89C8                <1>     mov eax, ecx    ;Tmp save count in eax
   202 00006B25 E89C030000          <1>     call getSzOfStrings ;Get raw block strings size. 
   203 00006B2A 85C9                <1>     test ecx, ecx
   204 00006B2C 744F                <1>     jz .sesExitBadEnv  ;If the strings have length 0, there was a booboo. Fail!
   205 00006B2E 51                  <1>     push rcx        ;Save the strings size
   206 00006B2F 01C1                <1>     add ecx, eax    ;Sum them for the full size to allocate
   207 00006B31 81C10F000000        <1>     add ecx, 0Fh   
   208 00006B37 C1E904              <1>     shr ecx, 4      ;Turn into paragraphs to allocate
   209 00006B3A E80B030000          <1>     call allocEnv   ;Get the block ptr in rax (preserve rsi, rdi)
   210 00006B3F 5B                  <1>     pop rbx         ;Get the strings size back
   211 00006B40 59                  <1>     pop rcx         ;Get the env size back
   212 00006B41 72C1                <1>     jc .gesExitBad
   213 00006B43 4889C7              <1>     mov rdi, rax    ;Write to the newly allocated block 
   214 00006B46 F3A4                <1>     rep movsb       ;Copy the environment over
   215                              <1> ;rdi points to the destination for the strings copy now
   216 00006B48 89D9                <1>     mov ecx, ebx    ;ebx has the string size
   217 00006B4A 498B703E            <1>     mov rsi, qword [r8 + psp.envPtr]    ;Source from the sole string block...
   218 00006B4E 4801CE              <1>     add rsi, rcx    ;... after the raw environment we are discarding.
   219 00006B51 F3A4                <1>     rep movsb
   220                              <1> ;We swap the environment pointer after freeing so that if the free of the
   221                              <1> ; old block fails we don't fail and also update/succeed. If we fail here, 
   222                              <1> ; we will try and free our newly allocated block too and if that fails as 
   223                              <1> ; well we just stop trying. 
   224 00006B53 50                  <1>     push rax        ;Save the new block
   225 00006B54 4150                <1>     push r8         ;Save the psp pointer
   226 00006B56 4D8B403E            <1>     mov r8, qword [r8 + psp.envPtr]     ;Free the old block :)
   227 00006B5A E8DEF1FFFF          <1>     call freeMemory ;Free the raw environment block, whoever owns it
   228 00006B5F 4158                <1>     pop r8
   229 00006B61 5B                  <1>     pop rbx         ;Put the new block ptr in rbx to preserve error code
   230 00006B62 720A                <1>     jc .sesBadFree
   231 00006B64 E80C160000          <1>     call dosCrit1Exit
   232 00006B69 E93A160000          <1>     jmp extGoodExit
   233                              <1> .sesBadFree:
   234 00006B6E 50                  <1>     push rax        ;Save the originally returned error code
   235 00006B6F 4989D8              <1>     mov r8, rbx     ;Try and free the newly allocated block. This should be ok.
   236 00006B72 E8C6F1FFFF          <1>     call freeMemory
   237 00006B77 58                  <1>     pop rax
   238 00006B78 E987FFFFFF          <1>     jmp .gesExitBad    ;Exit, bubbling the old error code.
   239                              <1> .sesExitBadEnv:
   240 00006B7D E8F3150000          <1>     call dosCrit1Exit
   241 00006B82 E9D5FEFFFF          <1>     jmp .exitBadEnv
   242                              <1> ;-----------------------
   243                              <1> ; Free Env String Block
   244                              <1> ;-----------------------
   245                              <1> .freeEnvStrings:
   246                              <1> ;This frees an opaque environment copy. 
   247                              <1> ; Only frees the block if WE allocated it.
   248                              <1> ;
   249                              <1> ;Input: rdx -> Envblock to free
   250                              <1> ;Output: CF=NC: Block freed
   251                              <1> ;        CF=CY: Block not freed (errMCBbad, errMemAddr, errBadFmt)
   252 00006B87 807A0D45            <1>     cmp byte [rdx + mcb.subSysMark], mcbSubEnv ;Correct type?
   253 00006B8B 0F85C4FEFFFF        <1>     jne .exitBadFmt
   254 00006B91 4989D0              <1>     mov r8, rdx     ;Set the register correctly
   255 00006B94 E9A4F1FFFF          <1>     jmp freeMemory  ;Exit through freeMemory
   256                              <1> ;------------------
   257                              <1> ;   Get Env Var
   258                              <1> ;------------------
   259                              <1> .getEnvVar:
   260                              <1> ;Returns the value of an environment variable.
   261                              <1> ;Input: rsi -> [In, optional]  LPCSTR lpName
   262                              <1> ;       rdi -> [Out, optional] LPSTR lpBuffer
   263                              <1> ;       ecx =  [In]            DWORD dSize
   264                              <1> ;Output: CF=NC: eax = Number of chars written. Fail if returning eax = 0. 
   265                              <1> ;        CF=CY: eax = Error code, errEnvVarNotFnd.
   266                              <1> ;
   267                              <1> ;lpName = The name of the environment variable to search for as a null
   268                              <1> ;           terminated string
   269                              <1> ;lpBuffer = A pointer to a buffer that receives the contents of the specified
   270                              <1> ;            environment variable as a null-terminated string. 
   271                              <1> ;dSize = The size of the buffer pointed to by the lpBuffer parameter, including 
   272                              <1> ;         the null-terminating character, in characters.
   273                              <1> ;
   274                              <1> ;Return value (eax):
   275                              <1> ;If the function succeeds, the return value is the number of characters stored 
   276                              <1> ; in the buffer pointed to by lpBuffer, not including the terminating null 
   277                              <1> ; character. If lpBuffer is not large enough to hold the data, the return 
   278                              <1> ; value is the buffer size, in characters, required to hold the string and its
   279                              <1> ; terminating null character and the contents of lpBuffer are undefined.
   280                              <1> ;
   281                              <1> ;If the function fails, the return value is zero. If the specified environment
   282                              <1> ; variable was not found in the environment block, GetExtendedError returns 
   283                              <1> ; errEnvVarNotFnd.
   284                              <1> 
   285                              <1> ;Put the input args on stack-based locals :)
   286                              <1>     %push
   287                              <1>     %stacksize flat64
   288                              <1>     %assign %$localsize 0
   289                              <1>     %local lpBuffer:qword, dSize:dword, dLenVal:dword
   290                              <1> 
   291 00006B99 E8CD150000          <1>     call dosCrit1Enter
   292 00006B9E C8180000            <1>     enter %$localsize, 0
   293 00006BA2 48897DF8            <1>     mov qword [lpBuffer], rdi
   294 00006BA6 894DF0              <1>     mov dword [dSize], ecx
   295 00006BA9 C745E800000000      <1>     mov dword [dLenVal], 0   ;Length of the value of the envvar
   296                              <1> ;First check the environment we are working on is good
   297 00006BB0 E8BC020000          <1>     call checkPSPEnvGood
   298 00006BB5 750B                <1>     jnz .gevEnvOk
   299 00006BB7 66C705(3B040000)0A- <1>     mov word [errorExCde], errBadEnv
   299 00006BBF 00                  <1>
   300 00006BC0 EB3E                <1>     jmp short .gevExitBad
   301                              <1> .gevEnvOk:
   302                              <1> ;Start by just making sure the input pointer is not bad.
   303 00006BC2 4885F6              <1>     test rsi, rsi   ;Is this null input string?
   304 00006BC5 7430                <1>     jz .getVarExitNoEnv
   305 00006BC7 E827020000          <1>     call searchForEnvVar    ;Search for the string in rsi
   306 00006BCC 7229                <1>     jc .getVarExitNoEnv     ;Var doesn't exist!
   307                              <1> ;Here rsi -> string in the env and ecx has length of the var name and the = 
   308 00006BCE 4801CE              <1>     add rsi, rcx    ;Go to the value portion of the env var
   309 00006BD1 E874120000          <1>     call strlen2    ;Get the length of the value string
   310 00006BD6 894DE8              <1>     mov dword [dLenVal], ecx    ;This is the len of the value of the envvar
   311 00006BD9 394DF0              <1>     cmp dword [dSize], ecx      ;Do we have enough space to store the length?
   312 00006BDC 720B                <1>     jb .getVarExit      ;If not, inform the caller how much space is needed
   313 00006BDE 488B7DF8            <1>     mov rdi, qword [lpBuffer]   ;Get buffer pointer back
