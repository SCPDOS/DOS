   152                              <1> flushAndFreeBuffer:    ;Int 2Fh AX=1209h 
   153                              <1> ;Flushes the data in a sector buffer to disk, then frees it!
   154                              <1> ;Entry: rdi = Pointer to buffer header for this buffer
   155                              <1> ;Exit:  CF=NC : Success
   156                              <1> ;       CF=CY : Fail, terminate the request
   157 00000840 50                  <1>     push rax
   158 00000841 53                  <1>     push rbx
   159 00000842 51                  <1>     push rcx
   160 00000843 52                  <1>     push rdx
   161 00000844 56                  <1>     push rsi
   162 00000845 57                  <1>     push rdi
   163 00000846 55                  <1>     push rbp
   164                              <1> ;If the buffer is freed, empty or on an erroring disk, skip flushing
   165 00000847 B8FF000000          <1>     mov eax, freeBuffer
   166 0000084C 66874708            <1>     xchg ax, word [rdi + bufferHdr.wDrvNumFlg] ;Get flags and drive number
   167                              <1>     ;ah = Flags, al = Drive number
   168 00000850 3CFF                <1>     cmp al, -1  ;-1 means free buffer
   169 00000852 7421                <1>     je .fbExit  ;If it was free, exit
   170 00000854 F6C440              <1>     test ah, dirtyBuffer    ;Data modified?
   171 00000857 741C                <1>     jz .fbExit  ;Skip write to disk if data not modified since last write
   172 00000859 3A05(39040000)      <1>     cmp al, byte [errorDrv] ;Was this drive the error drive?
   173 0000085F 7414                <1>     je .fbExit  ;Skip write if this disk has caused an in-process error
   174                              <1> ;Now setup the error bitfields for this request.
   175 00000861 0FB6CC              <1>     movzx ecx, ah   ;Get the buffer flags here
   176 00000864 488D5F20            <1>     lea rbx, qword [rdi + bufferHdr.dataarea]
   177 00000868 488B570A            <1>     mov rdx, qword [rdi + bufferHdr.bufferLBA]
   178 0000086C 488B6F17            <1>     mov rbp, qword [rdi + bufferHdr.driveDPBPtr]
   179 00000870 E808000000          <1>     call writeSectorBuffer
   180                              <1> .fbExit:
   181 00000875 5D                  <1>     pop rbp
   182 00000876 5F                  <1>     pop rdi
   183 00000877 5E                  <1>     pop rsi
   184 00000878 5A                  <1>     pop rdx
   185 00000879 59                  <1>     pop rcx
   186 0000087A 5B                  <1>     pop rbx
   187 0000087B 58                  <1>     pop rax
   188                              <1>     return
