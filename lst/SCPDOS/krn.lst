    97 00000B34 53                  <1>     push rbx
    98                              <1> .lp:
    99 00000B35 89C3                <1>     mov ebx, eax
   100 00000B37 E821020000          <1>     call readFAT
   101 00000B3C 7209                <1>     jc .exit
