   361                              <1> ; rdi = qword ptr: Free buffer header for buffer.
   362                              <1> ; rbp = qword ptr: DPB pointer
   363                              <1> ;Exit:  CF=NC : Success
   364                              <1> ;               rdx = Sector actually read in.
   365                              <1> ;       CF=CY : Fail, terminate the request
   366                              <1> ;       All other regs except rax preserved.
