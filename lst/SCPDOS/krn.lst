   234                              <1> .wsHardError:
   235                              <1> ;Request failed, call hard error handler. If the user aborts, data NOT lost.
   236                              <1> ;At this point, ax = Error code, rbp -> DPB, cl = Buffer flags
   237 000008D0 E829690000          <1>     call diskIOError ;Returns al = Action code. Other regs preserved.
   238 000008D5 3C01                <1>     cmp al, critRetry
   239 000008D7 74A4                <1>     je writeSectorBuffer    ;Needed regs are preserved so go again.
   240                              <1> ;Else, check if we have to write any more sectors. In all cases, except FAT
   241                              <1> ; this propagates FAIL. In the case of a first FAT, this will force an attempt
   242                              <1> ; at writing the subsequent FATs. If even one of them passes, then we convert
   243                              <1> ; the fail into a success.
   244 000008D9 EBDB                <1>     jmp short .wsCheckNext  
