  2943 00005400 8B05(98070000)      <1>     mov eax, dword [currByteF]  ;Get current byte in file
  2944 00005406 0FB75D02            <1>     movzx ebx, word [rbp + dpb.wBytesPerSector] ;Get bytes per sector
