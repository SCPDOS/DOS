   190                              <1> writeSectorBuffer:  ;Internal Linkage
   191                              <1> ;Writes a sector from a buffer.
   192                              <1> ;Input: 
   193                              <1> ; rbx = qword ptr: Buffer area to write from.
   194                              <1> ; rcx = byte: Buffer flags
   195                              <1> ; rdx = qword: Sector to write
   196                              <1> ; rbp = qword ptr: DPB pointer
   197                              <1> ;Exit:  CF=NC : Success (at least one write succeeded)
   198                              <1> ;               rdx = Sector actually read in.
   199                              <1> ;       CF=CY : Fail, all writes failed. Terminate the request
   200                              <1> ;               rdi = Nmuber of successful writes.
   201                              <1> ;       All other regs except rax, rsi and rdi preserved.
   202 0000086E 488B35(6F070000)    <1>     mov rsi, qword [pCurrBuff]
   203 00000875 0FB67612            <1>     movzx esi, byte [rsi + bufferHdr.bufFATcopy]
   204 00000879 C605(9A040000)18    <1>     mov byte [bI24OkBtfld], critRetryOK | critFailOK
   205 00000880 F6C108              <1>     test cl, dataBuffer
   206 00000883 7407                <1>     jz .wsWriteSetup
   207 00000885 800D(9A040000)20    <1>     or byte [bI24OkBtfld], critIgnorOK
   208                              <1> .wsWriteSetup:
   209 0000088C 31FF                <1>     xor edi, edi    ;Successful write count
   210                              <1> .wsWriteDisk:
   211 0000088E 53                  <1>     push rbx    ;# copies to write
   212 0000088F 51                  <1>     push rcx    ;Buffer flags
   213 00000890 52                  <1>     push rdx    ;The LBA of the buffer that we are writing
   214 00000891 B901000000          <1>     mov ecx, 1  ;One sector to write
   215 00000896 E88C6D0000          <1>     call primReqWriteSetup      ;Setup request (preserves setup registers)
   216 0000089B E88E6B0000          <1>     call absDiskDriverCall      ;Make Driver Request. Always returns CF=NC.
   217 000008A0 5A                  <1>     pop rdx
   218 000008A1 59                  <1>     pop rcx
   219 000008A2 5B                  <1>     pop rbx
   220 000008A3 751C                <1>     jnz .wsHardError
   221 000008A5 FFC7                <1>     inc edi         ;One successful write!
   222                              <1> .wsCheckNext:
   223 000008A7 56                  <1>     push rsi
   224 000008A8 488B35(6F070000)    <1>     mov rsi, qword [pCurrBuff]
   225 000008AF 8B4613              <1>     mov eax, dword [rsi + bufferHdr.bufFATsize]
   226 000008B2 4801C2              <1>     add rdx, rax    ;Add offset to the next copy to write (FAT only) 
   227 000008B5 5E                  <1>     pop rsi
   228 000008B6 FFCE                <1>     dec esi         ;One less copy to write
   229 000008B8 75D4                <1>     jnz .wsWriteDisk ;Jump if we gotta write another copy!
   230 000008BA 85FF                <1>     test edi, edi   ;Return CF=NC if we had any successful writes.
   231                              <1>     retnz
