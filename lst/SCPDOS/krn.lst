   102                              <1>     ;rsi points to drive letter
   103 00003281 488D3D(61060000)    <1>     lea rdi, dosffblock ;Set rdi to point to the dosffblock
   104 00003288 31C0                <1>     xor eax, eax
   105 0000328A AC                  <1>     lodsb   ;Get the FCB drive letter
   106 0000328B 50                  <1>     push rax    ;Push drive letter on the stack
   107 0000328C 8A4614              <1>     mov al, byte [rsi + 20] ;Get the byte I left at the end of the ffblock copy
   108 0000328F AA                  <1>     stosb   ;Store this as the search drive in the ffblock
   109 00003290 B905000000          <1>     mov ecx, 5
   110 00003295 F3A5                <1>     rep movsd   ;Copy 20 bytes now to the ffblock
   111 00003297 FF35(47040000)      <1>     push qword [currentDTA] ;Save original currentDTA
   112 0000329D 488D3D(61060000)    <1>     lea rdi, dosffblock
