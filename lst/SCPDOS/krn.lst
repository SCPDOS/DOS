  1043 000019C0 E834640000          <1>     call swapPathSeparator
  1044 000019C5 7409                <1>     jz .cpsStore
  1045 000019C7 E8BB650000          <1>     call checkCharValid ;If this is ZF=ZE => Terminator
  1046 000019CC 75ED                <1>     jnz short .cpsFindTerminator   ;Ensure we skip any extra chars
  1047                              <1>     ;If we encounter a terminator, convert to 0
  1048 000019CE 30C0                <1>     xor al, al
