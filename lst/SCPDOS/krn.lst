   252 0000311F 488D3D43CFFFFF      <1>     lea rdi, qword [monthsTbl + 1]  ;Get second entry in table (Feb is month 2)
   253 00003126 AA                  <1>     stosb   ;Store the word in rdi
   254 00003127 5F                  <1>     pop rdi
   255 00003128 59                  <1>     pop rcx
   256                              <1>     return
