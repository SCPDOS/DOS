   484 000035BB E890000000          <1>     call skipSeparators  ;Skip separators
   485                              <1> .skipIfNotTerminator:
   486 000035C0 E8A3430000          <1>     call uppercaseCharAtPtr 
   487 000035C5 741E                <1>     jz .skipSettingDriveLetter  ;Skip if first char not a possible drive letter
   488 000035C7 803E3A              <1>     cmp byte [rsi], ":" ;Is the next char a drive separator?
   489 000035CA 7519                <1>     jne .skipSettingDriveLetter
   490 000035CC 48FFC6              <1>     inc rsi ;Goto next char
   491 000035CF 2C40                <1>     sub al, "@" ;Convert into a 1 based drive number
   492 000035D1 7609                <1>     jbe .invalidDriveLetter ;If less than 0 or 0, fail
   493 000035D3 50                  <1>     push rax    ;Save the 1 based drive letter
   494 000035D4 E887420000          <1>     call getCDSNotJoin   ;Verifies if this drive letter is valid
   495 000035D9 58                  <1>     pop rax
   496 000035DA 7302                <1>     jnc .validDriveLetter
