   382 000009C5 E8686C0000          <1>     call primReqReadSetup   ;Setup request (preserves setup registers)
   383 000009CA E85F6A0000          <1>     call absDiskDriverCall  ;Make Driver Request (rsi preserved)
   384 000009CF 5F                  <1>     pop rdi
