    33 00008505 53                  <1>     push rbx
    34 00008506 FF15(07010000)      <1>     call qword [shCheckRegionLock]
    35 0000850C 5B                  <1>     pop rbx
    36                              <1>     retnc   ;Return if CF=NC (i.e. region not locked [anymore])
