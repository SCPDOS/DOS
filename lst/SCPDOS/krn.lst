   692                              <1> readFSInfoSector:
   693                              <1> ;Given a DPB, will attempt to read the FS Info sector. Destroys all regs.
   694                              <1> ;Input: rbp -> DPB pointer for FAT32 volume. Silently returns ok
   695                              <1> ;               if the DPB is not FAT32.
   696                              <1> ;       rsi -> BPB for the FAT32 volume.
   697                              <1> ;Output: rbp -> DPB dNextFreeClst and dNumberOfFreeCluster fields
   698                              <1> ;               correctly filled in from the FSInfo sector, if appropriate.
   699 00000F03 51                  <1>     push rcx
   700 00000F04 E88EFBFFFF          <1>     call getFATtype
   701 00000F09 81F902000000        <1>     cmp ecx, 2  ;Is the DPB a FAT32 DPB?
   702 00000F0F 59                  <1>     pop rcx
   703 00000F10 7578                <1>     jne .exit
   704                              <1> ;Only read the FSinfo sector if the drive has never been accessed before!
   705 00000F12 F64524FF            <1>     test byte [rbp + dpb.bAccessFlag], -1
   706 00000F16 7472                <1>     jz .exit
   707 00000F18 0FB74625            <1>     movzx eax, word [rsi + bpb32.FSinfo]    ;Get the FSInfo sector number
   708 00000F1C 85C0                <1>     test eax, eax   ;0 is an invalid value for this 
   709                              <1>     retz
