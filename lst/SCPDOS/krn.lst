   669                              <1> allocEnv:
   670                              <1> ;Wraps the allocation call, preserving registers and rax on caller stack.
   671                              <1> ;It also adds a signature in the reserved bytes of the MCB header and
   672                              <1> ; memsets the block to 0.
   673                              <1> ;Input: ebx = Number of paragraphs to allocate
   674                              <1> ;Return: CF=NC: rax -> Memory block to use.
   675                              <1> ;        CF=CY: eax has error code (errMCBbad, errNoMem).
   676 00006E4A 51                  <1>     push rcx
   677 00006E4B 56                  <1>     push rsi
   678 00006E4C 57                  <1>     push rdi
   679 00006E4D E8860E0000          <1>     call getUserRegs
   680 00006E52 FF36                <1>     push qword [rsi + callerFrame.rax]  ;Save caller rax
   681 00006E54 56                  <1>     push rsi    ;Save pointer to the frame
   682 00006E55 E8DFECFFFF          <1>     call allocateMemory
   683 00006E5A 720E                <1>     jc .exit
   684                              <1> ;Zero the newly allocate memory block.
   685 00006E5C 50                  <1>     push rax
   686 00006E5D 4889C7              <1>     mov rdi, rax    ;Point to the block
   687 00006E60 89D9                <1>     mov ecx, ebx    ;Get number of paragraphs
   688 00006E62 C1E104              <1>     shl ecx, 4      ;Turn to bytes
   689 00006E65 31C0                <1>     xor eax, eax    ;Store zeros
   690 00006E67 F3AA                <1>     rep stosb
   691 00006E69 58                  <1>     pop rax
   692                              <1> .exit:
   693 00006E6A 5E                  <1>     pop rsi     ;Get back pointer frame
   694 00006E6B 8F06                <1>     pop qword [rsi + callerFrame.rax]  ;Return caller original rax 
   695 00006E6D 5F                  <1>     pop rdi
   696 00006E6E 5E                  <1>     pop rsi
   697 00006E6F 59                  <1>     pop rcx
   698                              <1>     return
    13                              <2> %%_ret:
    14 00006E70 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
