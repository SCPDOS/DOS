   557 00002459 0FB705(B4070000)    <1>     movzx eax, word [dirSect]
   558 00002460 8B5D17              <1>     mov ebx, dword [rbp + dpb.dFirstUnitOfRootDir]
   559                              <1>     ;If dirSect is greater than wNumberRootDirEntries, then ret fail
   560 00002463 663B4509            <1>     cmp ax, word [rbp + dpb.wNumberRootDirEntries]
   561 00002467 5D                  <1>     pop rbp
   562 00002468 7202                <1>     jb .skipOldFat
   563 0000246A F9                  <1>     stc
   564                              <1>     return
