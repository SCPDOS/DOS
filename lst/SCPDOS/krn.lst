   924 00003F54 66813D(BC070000)10- <1>     cmp word [wEOActions], eoActCreate  ;Do we create if one doesnt exist?
   924 00003F5C 00                  <1>
   925 00003F5D 7524                <1>     jne .notCreateNew
   926                              <1> ;----DO NEW CREATE HERE----
   927                              <1> ;cx = File attributes (same as search attributes for find first)
   928                              <1> ;rdx = Ptr to ASCIZ filename to create
   929 00003F5F E8B3FDFFFF          <1>     call createNewFile
   930 00003F64 0F82CC3D0000        <1>     jc extErrExit
   931 00003F6A 66813D(BA070000)00- <1>     cmp word [wEOFlags], 0  ;Cleared by Network drives
   931 00003F72 00                  <1>
   932 00003F73 0F84AF3D0000        <1>     jz extGoodExit  ;Exit immediately, vars set by Network drive
   933 00003F79 B902000000          <1>     mov ecx, eoRetActCreate
   934 00003F7E E99D000000          <1>     jmp .localGoodExit
   935                              <1> .notCreateNew:
