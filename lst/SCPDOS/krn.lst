   901 00003EE0 668915(BC070000)    <1>     mov word [wEOActions], dx   ;Save these bit for later
   902 00003EE7 488935(C2070000)    <1>     mov qword [pszEOfile], rsi  ;Save filename ptr
   903                              <1> ;Now we sanity check that what we have is meaningful
   904 00003EEE 84C0                <1>     test al, al
   905 00003EF0 740A                <1>     jz .okStart
