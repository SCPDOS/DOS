    15                              <2> %assign retOff %%_ret-$$
    35                                  %include "./src/dos/Kernel/FAT/fat.asm"
     1                              <1> ;-----------------------------------:
     2                              <1> ;       File System routines        :
     3                              <1> ;-----------------------------------:
     4                              <1> getFATtype:
     5                              <1> ;Gets a pointer to a DPB and returns the FAT type on the drive
     6                              <1> ;Entry: rbp = DPB to ascertain FAT
     7                              <1> ;Exit: ecx = 0 => FAT 12, ecx = 1 => FAT 16, ecx = 2 => FAT 32
     8 00000A97 53                  <1>     push rbx
     9 00000A98 8B5D0F              <1>     mov ebx, dword [rbp + dpb.dMaxClusterAddr]
    10 00000A9B B902000000          <1>     mov ecx, 2  ;FAT 32 marker
    11 00000AA0 81FBF5FF0000        <1>     cmp ebx, fat16MaxClustCnt
    12 00000AA6 730C                <1>     jae .exit
    13 00000AA8 FFC9                <1>     dec ecx     ;FAT 16 marker
    14 00000AAA 81FBF50F0000        <1>     cmp ebx, fat12MaxClustCnt
    15 00000AB0 7302                <1>     jae .exit
    16 00000AB2 FFC9                <1>     dec ecx     ;FAT 12 marker
    17                              <1> .exit:
    18 00000AB4 5B                  <1>     pop rbx
    19                              <1>     return
    13                              <2> %%_ret:
    14 00000AB5 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
    20                              <1> 
    21                              <1> clust2FATEntry:
    22                              <1> ;Converts a cluster number to a offset in the FAT
    23                              <1> ;Entry:  Uses the workingDPB to convert cluster number
    24                              <1> ;        eax = Cluster number to look for
    25                              <1> ;Exit:   eax = Sector on disk of FAT 
    26                              <1> ;        ecx = 0 => FAT12, 1 => FAT16, 2 => FAT32
    27                              <1> ;        edx = 1.5Byte/Word/DWord in sector of entry
    28 00000AB6 53                  <1>     push rbx
    29 00000AB7 55                  <1>     push rbp
    30 00000AB8 488B2D(3B070000)    <1>     mov rbp, qword [workingDPB]
    31 00000ABF 8B5D0F              <1>     mov ebx, dword [rbp + dpb.dMaxClusterAddr]
    32 00000AC2 81FBF5FF0000        <1>     cmp ebx, fat16MaxClustCnt
    33 00000AC8 731E                <1>     jae .fat32
    34 00000ACA 81FBF50F0000        <1>     cmp ebx, fat12MaxClustCnt
    35 00000AD0 7209                <1>     jb .fat12
    36                              <1> ;FAT16
    37 00000AD2 D1E0                <1>     shl eax, 1  ;Multiply cluster number by 2
    38 00000AD4 6801000000          <1>     push qword 1
    39 00000AD9 EB15                <1>     jmp short .common
    40                              <1> .fat12:
    41 00000ADB 89C1                <1>     mov ecx, eax    ;ecx = eax
    42 00000ADD D1E9                <1>     shr ecx, 1      ;ecx = ecx / 2
    43 00000ADF 01C8                <1>     add eax, ecx    ;eax = eax + ecx    (eax * 1.5)
    44 00000AE1 6800000000          <1>     push qword 0
    45 00000AE6 EB08                <1>     jmp short .common
    46                              <1> .fat32:
    47 00000AE8 6802000000          <1>     push qword 2
    48 00000AED C1E002              <1>     shl eax, 2  ;Multiply cluster number by 4
    49                              <1> .common:
    50                              <1> ;eax has the FAToffset
    51 00000AF0 0FB74D02            <1>     movzx ecx, word [rbp + dpb.wBytesPerSector]
    52 00000AF4 31D2                <1>     xor edx, edx    ;edx = 0
    53 00000AF6 F7F1                <1>     div ecx         ;Divide by bytes per sector (0:eax / ecx)
    54 00000AF8 0FB75D06            <1>     movzx ebx, word [rbp + dpb.wFAToffset]   ;Add the offset to the first FAT
    55 00000AFC 01D8                <1>     add eax, ebx
    56 00000AFE 59                  <1>     pop rcx ;Pop the FAT type back into rcx
    57 00000AFF 5D                  <1>     pop rbp
    58 00000B00 5B                  <1>     pop rbx
    59                              <1>     return
    13                              <2> %%_ret:
    14 00000B01 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
    60                              <1> 
    61                              <1> getStartSectorOfCluster:
    62                              <1> ;Input: eax = Cluster Number
    63                              <1> ;       rbp = dpb pointer
    64                              <1> ;Output: rax = Starting Sector number for cluster
    65                              <1> ;Gives the data sector we are at in the current cluster
    66                              <1> ;Start Sector = (ClusterNumber - 2)*SecPerClust + DataAreaStartSector
    67 00000B02 51                  <1>     push rcx
    68 00000B03 09C0                <1>     or eax, eax ;Zero upper dword
    69 00000B05 7416                <1>     jz .rootDir ;If eax is zero, that is an alias for Root Directory
    70                              <1> .fat32Root:
    71 00000B07 482D02000000        <1>     sub rax, 2
    72 00000B0D 8A4D05              <1>     mov cl, byte [rbp + dpb.bSecPerClustShift]
    73 00000B10 48D3E0              <1>     shl rax, cl
    74 00000B13 31C9                <1>     xor ecx, ecx
    75 00000B15 8B4D0B              <1>     mov ecx, dword [rbp + dpb.dClusterHeapOffset]
    76 00000B18 4801C8              <1>     add rax, rcx
    77                              <1>     ;rax now has the first sector of the current cluster
    78 00000B1B 59                  <1>     pop rcx
    79                              <1>     return
    13                              <2> %%_ret:
    14 00000B1C C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
    80                              <1> .rootDir:
    81 00000B1D 8B4517              <1>     mov eax, dword [rbp + dpb.dFirstUnitOfRootDir]
    82 00000B20 E872FFFFFF          <1>     call getFATtype
    83 00000B25 81F902000000        <1>     cmp ecx, 2
    84 00000B2B 74DA                <1>     je .fat32Root   ;If FAT32, eax now has zero extended 1st cluster of Root Dir
    85                              <1>     ;Else rax has the first sector of the Root Dir
    86 00000B2D 59                  <1>     pop rcx
    87                              <1>     return
    13                              <2> %%_ret:
    14 00000B2E C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
