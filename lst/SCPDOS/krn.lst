    98 0000860D 51                  <1>     push rcx
    99 0000860E E874FFFFFF          <1>     call openShareCallWrapper
   100 00008613 59                  <1>     pop rcx
   101 00008614 7310                <1>     jnc .exit   ;If all good, exit! (a record has now been made by SHARE.EXE)
   102 00008616 E897FFFFFF          <1>     call shareRetryCountdown
   103 0000861B FFC9                <1>     dec ecx
   104 0000861D 75E3                <1>     jnz .keepLooping
   105 0000861F E842000000          <1>     call shareCriticalError
   106 00008624 73D5                <1>     jnc .reloadCounter  ;If user selected retry, we retry
   107                              <1> .exit:
   108 00008626 59                  <1>     pop rcx
   109                              <1>     return
