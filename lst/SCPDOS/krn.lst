   590                              <1> .gotoNextClusterFat12:
   591                              <1> ;FAT12 might need two FAT sectors read so we always read two sectors
   592                              <1> ;eax has the sector number of the FAT
   593                              <1> ;edx has byte offset into the sector
   594                              <1> ;edi has current cluster number
