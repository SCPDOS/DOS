   438                              <1> findSectorInBuffer:     ;Internal linkage
   439                              <1> ;Finds the Buffer for a sector belonging to a particular dpb device
   440                              <1> ;If the sector is not in a buffer, returns with a -1
   441                              <1> ;Input: rax = Sector number
   442                              <1> ;       dl = Drive number
   443                              <1> ;Output: rdi = Buffer hdr pointer or -1
   444 00000A50 488B3D(65000000)    <1>     mov rdi, qword [bufHeadPtr]
   445                              <1> .fsiCheckBuffer:
   446 00000A57 385708              <1>     cmp byte [rdi + bufferHdr.driveNumber], dl
   447 00000A5A 7507                <1>     jne .fsiGotoNextBuffer
   448 00000A5C 4839470A            <1>     cmp qword [rdi + bufferHdr.bufferLBA], rax
   449 00000A60 7501                <1>     jne .fsiGotoNextBuffer
   450                              <1> .fsiExit:
   451                              <1>     return
    13                              <2> %%_ret:
    14 00000A62 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   452                              <1> .fsiGotoNextBuffer:
   453 00000A63 488B3F              <1>     mov rdi, qword [rdi + bufferHdr.nextBufPtr]
   454 00000A66 4881FFFFFFFFFF      <1>     cmp rdi, -1     ;If rdi points to -1, exit
   455 00000A6D 74F3                <1>     je .fsiExit
   456 00000A6F EBE6                <1>     jmp short .fsiCheckBuffer
   457                              <1> 
   458                              <1> ;-----------------------------------------------------------------------------
   459                              <1> ;SPECIAL BUFFER FUNCTIONS
   460                              <1> ;Buffer functions for sectors associated to file handles and specific purposes
   461                              <1> ; ALL sector types need to setup [workingDPB] to make the transfer
   462                              <1> ;-----------------------------------------------------------------------------
   463                              <1> getBufForDOS:
   464                              <1> ;Returns a buffer to use for DOS sector(s) in rbx
   465                              <1> ;Input: [workingDPB] = DPB to transact on
   466                              <1> ;       rax = Sector to transfer
   467                              <1> ;Output: rbx = Buffer to use or if CF=CY, error rbx = Undefined
   468 00000A71 51                  <1>     push rcx
   469 00000A72 B101                <1>     mov cl, dosBuffer
   470 00000A74 EB0D                <1>     jmp short getBufCommon
   471                              <1> getBufForFat:
   472                              <1> ;Returns a buffer to use for fat data in rbx
   473                              <1> ;Input: [workingDPB] = DPB to transact on
   474                              <1> ;       rax = Sector to transfer
   475                              <1> ;Output: rbx = Buffer to use or if CF=CY, error rbx = Undefined
   476 00000A76 51                  <1>     push rcx
   477 00000A77 B102                <1>     mov cl, fatBuffer
   478 00000A79 EB08                <1>     jmp short getBufCommon
   479                              <1> getBufForDir:
   480                              <1> ;Returns a buffer to use for disk directory data in rbx
   481                              <1> ;Input: [workingDPB] = File to manipulate
   482                              <1> ;       rax = Sector to transfer
   483                              <1> ;Output: rbx = Buffer to use or if CF=CY, error rbx = Undefined
   484 00000A7B 51                  <1>     push rcx
   485 00000A7C B104                <1>     mov cl, dirBuffer
   486 00000A7E EB03                <1>     jmp short getBufCommon
   487                              <1> getBufForData:
   488                              <1> ;Returns a buffer to use for disk data in rbx
   489                              <1> ;Requires a File Handle.
   490                              <1> ;Input: [workingDPB] = File to manipulate
   491                              <1> ;       rax = Sector to transfer
   492                              <1> ;Output: rbx = Buffer to use or if CF=CY, error rbx = Undefined
   493 00000A80 51                  <1>     push rcx
   494 00000A81 B108                <1>     mov cl, dataBuffer
   495                              <1> getBufCommon:
   496 00000A83 52                  <1>     push rdx
   497 00000A84 57                  <1>     push rdi
   498 00000A85 55                  <1>     push rbp
   499 00000A86 488B2D(3B070000)    <1>     mov rbp, qword [workingDPB] ;Get working DPB 
   500 00000A8D E8A7FEFFFF          <1>     call getBuffer  ;Gives the buffer ptr in rbx
   501 00000A92 5D                  <1>     pop rbp
   502 00000A93 5F                  <1>     pop rdi
   503 00000A94 5A                  <1>     pop rdx
   504 00000A95 59                  <1>     pop rcx
   505                              <1>     return
