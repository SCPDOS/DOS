   630                              <1> growDirectory:
   631                              <1> ;Input: dword [dirClustPar] must have the first cluster number of the directory
   632                              <1> ;Output: CF=NC => All ok, directory grew by 1 sector
   633                              <1> ;                 eax = New Cluster number
   634                              <1> ;               TWO NON CF ERROR CASES.
   635                              <1> ;               If eax = -1 => disk full!
   636                              <1> ;               If eax = 0 => Trying to grow FAT12/16 root dir. Bad.
   637                              <1> ;        CF=CY => Something went wrong. Rip. 
   638 0000251E 53                  <1>     push rbx
   639 0000251F 51                  <1>     push rcx
   640 00002520 57                  <1>     push rdi
   641 00002521 8B05(AC070000)      <1>     mov eax, dword [dirClustPar]    ;Get first cluster for directory
   642 00002527 85C0                <1>     test eax, eax
   643 00002529 742B                <1>     jz .exit
   644 0000252B E80BE6FFFF          <1>     call getLastClusterInChain  ;Get last cluster in chain in eax
   645 00002530 89C3                <1>     mov ebx, eax    ;Setup last cluster value in ebx
   646 00002532 B901000000          <1>     mov ecx, 1  ;Allocate one more cluster
   647 00002537 E87EE6FFFF          <1>     call allocateClusters   ;ebx has last cluster value
   648 0000253C 7218                <1>     jc .exit
   649 0000253E 3DFFFFFFFF          <1>     cmp eax, -1 ;Disk full?
   650 00002543 7411                <1>     je .exit
   651 00002545 89D8                <1>     mov eax, ebx    ;Walk this next cluster value to get new cluster value
   652 00002547 E853E8FFFF          <1>     call readFAT
   653 0000254C 7208                <1>     jc .exit
   654 0000254E E807000000          <1>     call sanitiseCluster    ;Preserves all regs, sanitises the cluster for use
   655 00002553 7201                <1>     jc .exit
   656 00002555 F8                  <1>     clc
   657                              <1> .exit:
   658 00002556 5F                  <1>     pop rdi
   659 00002557 59                  <1>     pop rcx
   660 00002558 5B                  <1>     pop rbx
   661                              <1>     return   
    13                              <2> %%_ret:
    14 00002559 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   662                              <1> sanitiseCluster:
   663                              <1> ;Sanitises the cluster in eax to all zeros
   664                              <1> ;Does not move file pointers
   665                              <1> ;Currently, is only called to sanitise subdirectory clusters
   666                              <1> ;Input: eax = Cluster number
   667                              <1> ;       qword [workingDPB] = DPB of drive whose cluster we are sanitising
   668                              <1> ;Output: If CF=NC => eax = Sanitised Cluster number
   669                              <1> ;        If CF=CY => Error, exit
   670 0000255A 50                  <1>     push rax
   671 0000255B 53                  <1>     push rbx
   672 0000255C 51                  <1>     push rcx
   673 0000255D 52                  <1>     push rdx
   674 0000255E 56                  <1>     push rsi
   675 0000255F 55                  <1>     push rbp
   676 00002560 488B2D(3B070000)    <1>     mov rbp, qword [workingDPB]
   677 00002567 E8A2E5FFFF          <1>     call getStartSectorOfCluster    ;Needs DPB in rbp
   678 0000256C 0FB65504            <1>     movzx edx, byte [rbp + dpb.bMaxSectorInCluster] 
   679 00002570 FFC2                <1>     inc edx ;Make it a count of sectors
   680                              <1> .getSectorInCluster:
   681 00002572 E812E5FFFF          <1>     call getBufForDir  ;Get a generic data buffer in rbx
   682 00002577 721E                <1>     jc .exitBad
   683 00002579 488D7B20            <1>     lea rdi, qword [rbx + bufferHdr.dataarea]
   684 0000257D 0FB74D02            <1>     movzx ecx, word [rbp + dpb.wBytesPerSector]
   685 00002581 31C0                <1>     xor eax, eax
   686 00002583 F3AA                <1>     rep stosb   ;Store one sectorful of zeros
   687 00002585 E898E3FFFF          <1>     call markBufferDirty ;We wrote to this buffer
   688                              <1> 
   689 0000258A FFCA                <1>     dec edx     ;One less sector in the cluster to sanitise!
   690 0000258C 740A                <1>     jz .exit    ;Jump if we done
   691 0000258E 488B430A            <1>     mov rax, qword [rbx + bufferHdr.bufferLBA] ;Get current sector number
   692 00002592 48FFC0              <1>     inc rax ;Goto next sector in cluster
   693 00002595 EBDB                <1>     jmp short .getSectorInCluster
   694                              <1> .exitBad:
   695 00002597 F9                  <1>     stc
   696                              <1> .exit:
   697 00002598 5D                  <1>     pop rbp
   698 00002599 5E                  <1>     pop rsi
   699 0000259A 5A                  <1>     pop rdx
   700 0000259B 59                  <1>     pop rcx
   701 0000259C 5B                  <1>     pop rbx
   702 0000259D 58                  <1>     pop rax
   703                              <1>     return
