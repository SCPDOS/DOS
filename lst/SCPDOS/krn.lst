   285                              <1> findFreeClusterData:
   286                              <1> ;Walks the FAT to find a free cluster and returns the 
   287                              <1> ;   zero extended cluster number in eax (-1 means no free cluster)
   288                              <1> ; Also finds NumberOfFreeClusters, if it is unknown. 
   289                              <1> ; Both fields get filled in the workingDPB
   290                              <1> ;Works on the workingDPB
   291                              <1> ;If returns with CF=CY => Fail set, return immediately to caller
   292 00000C24 53                  <1>     push rbx
   293 00000C25 51                  <1>     push rcx
   294 00000C26 52                  <1>     push rdx
   295 00000C27 55                  <1>     push rbp
   296 00000C28 488B2D(3B070000)    <1>     mov rbp, qword [workingDPB]
   297 00000C2F E863FEFFFF          <1>     call getFATtype
   298 00000C34 81F902000000        <1>     cmp ecx, 2  ;If not FAT32, always get afresh
   299 00000C3A 7512                <1>     jne .getNew
   300                              <1>     ;Else, if either entry is unknown, get both!
   301 00000C3C 817D31FFFFFFFF      <1>     cmp dword [rbp + dpb.dFreeClustCnt], -1
   302 00000C43 7409                <1>     je .getNew
   303 00000C45 817D2DFFFFFFFF      <1>     cmp dword [rbp + dpb.dNextFreeClst], -1
   304 00000C4C 7542                <1>     jne .exit
   305                              <1> .getNew:
   306                              <1>     ;Reset this data. Get first free cluster
   307 00000C4E C7452DFFFFFFFF      <1>     mov dword [rbp + dpb.dNextFreeClst], -1
   308 00000C55 C74531FFFFFFFF      <1>     mov dword [rbp + dpb.dFreeClustCnt], -1
   309 00000C5C E863FFFFFF          <1>     call findFreeCluster
   310 00000C61 7236                <1>     jc .exitFail
   311 00000C63 C7453100000000      <1>     mov dword [rbp + dpb.dFreeClustCnt], 0  ;Set to 0 for new count
   312 00000C6A 3DFFFFFFFF          <1>     cmp eax, -1 ;First free cluster = -1 means disk full!
   313 00000C6F 741F                <1>     je .exit
   314                              <1>     ;Else, eax has the first free cluster. Keep reading FAT
   315 00000C71 89C3                <1>     mov ebx, eax    ;Save the cluster number
   316 00000C73 EB0D                <1>     jmp short .incGo
   317                              <1> .lp:
   318 00000C75 89C3                <1>     mov ebx, eax    ;Save the cluster number
   319 00000C77 E8E1000000          <1>     call readFAT    ;Get dereferenced value in eax
   320 00000C7C 721B                <1>     jc .exitFail
   321 00000C7E 85C0                <1>     test eax, eax
   322 00000C80 7505                <1>     jnz .notFree
   323                              <1> .incGo:
   324 00000C82 E85E020000          <1>     call incrementFreeClusterCount  ;Increment the count!
   325                              <1> .notFree:
   326 00000C87 678D4301            <1>     lea eax, dword [ebx + 1]    ;Get the next consecutive cluster
   327 00000C8B 3B450F              <1>     cmp eax, dword [rbp + dpb.dMaxClusterAddr]
   328 00000C8E 76E5                <1>     jbe .lp
   329                              <1> .exit:
   330 00000C90 8B452D              <1>     mov eax, dword [rbp + dpb.dNextFreeClst]  ;Get first free cluster in eax
   331 00000C93 E8F4020000          <1>     call writeFSInfoSector
   332 00000C98 F8                  <1>     clc
   333                              <1> .exitFail:      ;Keep carry flag
   334 00000C99 5D                  <1>     pop rbp
   335 00000C9A 5A                  <1>     pop rdx
   336 00000C9B 59                  <1>     pop rcx
   337 00000C9C 5B                  <1>     pop rbx
   338                              <1>     return
    13                              <2> %%_ret:
    14 00000C9D C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
