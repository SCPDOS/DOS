   334                              <1> .setEnvVar:
   335                              <1> ;Sets an environment variable.
   336                              <1> ;Input: rsi -> [In]             LPCSTR lpName
   337                              <1> ;       rdx -> [In, optional]   LPCSTR lpValue
   338                              <1> ;lpName = The name of the environment variable. DOS creates the 
   339                              <1> ; environment variable if it does not exist and lpValue is not NULL.
   340                              <1> ;lpValue = The contents of the environment variable. If the pointer
   341                              <1> ; is null or the string is empty, we delete the variable.
   342                              <1> ;
   343                              <1> ;Output: CF=NC: eax = Number of chars written to environment. 
   344                              <1> ;               If eax = 0, error, no chars written. Get error code.
   345                              <1> 
   346                              <1>     %push
   347                              <1>     %stacksize flat64
   348                              <1>     %assign %$localsize 0
   349                              <1>     %local lpName:qword, lpValue:qword, bAction:byte, dVarLen:dword
   350                              <1> ;Get the PSP lock. No other threads of this process 
   351                              <1> ; can enter this critical section.
