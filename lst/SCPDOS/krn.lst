   539                              <1> ;----------------------------------------------------------------------------
   540                              <1> ;     Environment local functions
   541                              <1> ;----------------------------------------------------------------------------
   542                              <1> ;List of functions:
   543                              <1> ; freeEnvVar -> Deletes an environment variable and compactifies
   544                              <1> ;               the environment.
   545                              <1> ; searchForEnvVar -> Looks in the raw environment for a variable
   546                              <1> ; allocEnvSig -> Same as below but adds a signature to the block
   547                              <1> ; allocEnv -> Returns an allocation 
   548                              <1> ; checkPSPEnvGood -> Check if the env in the psp is good.
   549                              <1> ; checkEnvGood -> Check if an env is good.
   550                              <1> ; getPtrToEndOfEnvBlk -> Returns in rdi ptr to second null
   551                              <1> ; getSzOfEnv     -> Return in ecx the number of bytes used in the environment
   552                              <1> ; getSzOfStrings -> Return in ecx the number of bytes used in the optional 
   553                              <1> ;                   strings after the environment, if present
   554                              <1> ; getSzOfEnvAndStrings -> Sums the output of both
   555                              <1> ; getFreeSpaceInEnvBlk -> Gets the number of bytes free in the environment block
   556                              <1> ;----------------------------------------------------------------------------
   557                              <1> 
   558                              <1> freeEnvVar:
   559                              <1> ;Frees a variable from the environment, pulls the strings behind it up
   560                              <1> ; zeros the rest of the environment, and returns a pointer to the first
   561                              <1> ; free byte of the environment!
   562                              <1> ;Input: rsi -> Variable to free.
   563                              <1> ;Output: rdi -> First byte to write new env var in
   564                              <1> ;        ecx = Number of free bytes in env
   565 00006DA8 4889F7              <1>     mov rdi, rsi
   566 00006DAB 31C0                <1>     xor eax, eax
   567                              <1> .freeLp:
   568 00006DAD 803F00              <1>     cmp byte [rdi], 0
   569 00006DB0 7403                <1>     je .exitLp
   570 00006DB2 AA                  <1>     stosb
   571 00006DB3 EBF8                <1>     jmp short .freeLp
   572                              <1> .exitLp:
   573                              <1> ;rdi points to the terminating null of the var we just deleted
   574                              <1> ;rsi points to the start of the free space
   575 00006DB5 4887F7              <1>     xchg rsi, rdi   ;Swap em!
   576 00006DB8 66813E0000          <1>     cmp word [rsi], 0   ;If we are already at the terminating null, dont advance!
   577 00006DBD 7504                <1>     jne .prepPullup
   578 00006DBF 31C0                <1>     xor eax, eax
   579 00006DC1 EB0E                <1>     jmp short .pullStrings
   580                              <1> .prepPullup:
   581 00006DC3 48FFC6              <1>     inc rsi         ;Go past the terminating null!
   582                              <1> .pullUp:
   583 00006DC6 AC                  <1>     lodsb
   584 00006DC7 AA                  <1>     stosb
   585 00006DC8 84C0                <1>     test al, al ;Did we pick up a zero
   586 00006DCA 75FA                <1>     jne .pullUp ;If not, keep copying
   587 00006DCC 803E00              <1>     cmp byte [rsi], 0   ;Is this the famous second byte?
   588 00006DCF 75F5                <1>     jne .pullUp
   589                              <1> ;We are at the end of the copy!
   590                              <1> .pullStrings:
   591 00006DD1 AA                  <1>     stosb   ;Store the second null, incrementing rdi
   592                              <1> ;Now we pull the strings, if there are any
   593 00006DD2 66813E0000          <1>     cmp word [rsi], 0
   594 00006DD7 740B                <1>     je .goClean
   595 00006DD9 E8E8000000          <1>     call getSzOfStrings
   596 00006DDE 85C9                <1>     test ecx, ecx
   597 00006DE0 7402                <1>     jz .goClean
   598 00006DE2 F3A4                <1>     rep movsb
   599                              <1> .goClean:
   600 00006DE4 48FFCF              <1>     dec rdi ;Point back to the second null!
   601 00006DE7 E839010000          <1>     call getFreeSpaceInEnvBlk
   602 00006DEC 31C0                <1>     xor eax, eax
   603 00006DEE 51                  <1>     push rcx
   604 00006DEF F3AA                <1>     rep stosb       ;Now zero the remaining space of the env!
   605 00006DF1 59                  <1>     pop rcx
   606                              <1>     return
    13                              <2> %%_ret:
    14 00006DF2 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   607                              <1> 
   608                              <1> searchForEnvVar:
   609                              <1> ;Gets the environment, and scans it for a string with the var specified.
   610                              <1> ;Input: rsi -> Null terminated var name to look for.
   611                              <1> ;Returns: CF=NC: rsi -> Env var in env. ecx = len of <varName>= string
   612                              <1> ;         CF=CY: Var not found.
   613 00006DF3 57                  <1>     push rdi
   614 00006DF4 4889F2              <1>     mov rdx, rsi        ;Save the search pointer!
   615 00006DF7 498B703E            <1>     mov rsi, qword [r8 + psp.envPtr]
   616                              <1> .varLp:
   617 00006DFB 4889D7              <1>     mov rdi, rdx        ;Reset the pointer for searching
   618 00006DFE E81A000000          <1>     call .cmpEnvVar      ;Checks if these two environment vars are equal
   619 00006E03 7416                <1>     je .varFound
   620 00006E05 31C0                <1>     xor eax, eax        ;Search for a null
   621 00006E07 4889F7              <1>     mov rdi, rsi        ;Scan the environment
   622 00006E0A B9FF7F0000          <1>     mov ecx, ENV_MAX    ;Just keep searching
   623 00006E0F F2AE                <1>     repne scasb         ;Now scan for the terminating null
   624 00006E11 3807                <1>     cmp byte [rdi], al  ;Now check the second char
   625 00006E13 7405                <1>     je .varNotFound     ;If second null, no more env to search!
   626 00006E15 4889FE              <1>     mov rsi, rdi        ;Now move to rsi the start of the next env var
   627 00006E18 EBE1                <1>     jmp short .varLp    ;And scan again!
   628                              <1> .varNotFound:
   629 00006E1A F9                  <1>     stc
   630                              <1> .varFound:
   631 00006E1B 5F                  <1>     pop rdi
   632                              <1>     return
    13                              <2> %%_ret:
    14 00006E1C C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   633                              <1> .cmpEnvVar:
   634                              <1> ;Checks that we have found the environment variable we are looking for.
   635                              <1> ;Input: rsi -> Candidate var in the environment
   636                              <1> ;       rdi -> Null terminated supplied var name to compare against
   637                              <1> ;Output: ZF=ZE: Equal. ecx = Length of var name
   638                              <1> ;        ZF=NZ: Not equal.
   639 00006E1D 56                  <1>     push rsi
   640 00006E1E 57                  <1>     push rdi
   641 00006E1F 4887F7              <1>     xchg rsi, rdi       ;Swap Env and user ptrs. 
   642                              <1> ;rdi -> env ptr. rsi -> lpcstr, given by caller and null terminated.
   643 00006E22 31C9                <1>     xor ecx, ecx        ;Clear the counter
   644                              <1> .cevLp:
   645 00006E24 AC                  <1>     lodsb               ;Pick up from caller string
   646 00006E25 84C0                <1>     test al, al
   647 00006E27 740C                <1>     jz .cevFinalCheck   ;End of string reached. Check if envvar is over too.
   648 00006E29 E8D70F0000          <1>     call uppercaseChar  ;Upper case it!
   649 00006E2E AE                  <1>     scasb               ;Compare al to *rdi and inc rdi
   650 00006E2F 7509                <1>     jne .cevExit        ;If this char isn't equal, clearly not the same var
   651 00006E31 FFC1                <1>     inc ecx             ;Else, one more char in the name!
   652 00006E33 EBEF                <1>     jmp short .cevLp
   653                              <1> .cevFinalCheck:
   654                              <1> ;We just read a null, meaning the env equivalent string must be an =
   655 00006E35 FFC1                <1>     inc ecx             ;Add terminator to the count
   656 00006E37 803F3D              <1>     cmp byte [rdi], "=" ;Now check if env var is ended too
   657                              <1> .cevExit:
   658 00006E3A 5F                  <1>     pop rdi
   659 00006E3B 5E                  <1>     pop rsi
   660                              <1>     return
    13                              <2> %%_ret:
    14 00006E3C C3                  <2>  ret
