   153                              <1> 
   154                              <1> startNewChain:
   155                              <1> ;Working dpb must be set
   156                              <1> ;Returns: eax = First cluster new chain or -1=> Disk full
   157                              <1> ;If CF=CY, hard error
   158 00000B3A 53                  <1>     push rbx
   159 00000B3B 56                  <1>     push rsi
   160 00000B3C E874000000          <1>     call findFreeCluster    ;Get a free cluster in eax
   161 00000B41 7223                <1>     jc .exit    ;Disk read error?
   162 00000B43 3DFFFFFFFF          <1>     cmp eax, -1 ;Disk full?
   163 00000B48 7415                <1>     je .exit2   ;Exit synching disk full status
   164 00000B4A BEFFFFFFFF          <1>     mov esi, -1 ;Value to write at eax is EOF
   165 00000B4F 89C3                <1>     mov ebx, eax
   166 00000B51 E8AF020000          <1>     call writeFAT
   167 00000B56 720E                <1>     jc .exit 
   168 00000B58 89D8                <1>     mov eax, ebx
   169 00000B5A E886030000          <1>     call decrementFreeClusterCount
   170                              <1> .exit2:
   171 00000B5F 50                  <1>     push rax
   172 00000B60 E818040000          <1>     call writeFSInfoSector
   173 00000B65 58                  <1>     pop rax
   174                              <1> .exit:
   175 00000B66 5E                  <1>     pop rsi
   176 00000B67 5B                  <1>     pop rbx
   177                              <1>     return
    13                              <2> %%_ret:
    14 00000B68 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   178                              <1> 
   179                              <1> allocateClusters:
   180                              <1> ;Working dpb must be set. 
   181                              <1> ;Input: ecx = Number of clusters to allocate in a chain
   182                              <1> ;       ebx = Cluster to link to the new cluster
   183                              <1> ;Output:    
   184                              <1> ;   ecx = Number of allocated clusters
   185                              <1> ;   CF=NC => Complete.
   186                              <1> ;   If eax = -1, then no more free clusters. 
   187                              <1> ;   CF=CY => Hard error, exit
   188 00000B69 F8                  <1>     clc ;Always clear the flags before starting
   189 00000B6A 53                  <1>     push rbx
   190 00000B6B 56                  <1>     push rsi
   191 00000B6C 51                  <1>     push rcx    ;Save tfr count on stack
   192 00000B6D 67E332              <1>     jecxz .exit ;Allocating nothing? Exit
   193                              <1> .allocateLoop:
   194 00000B70 E840000000          <1>     call findFreeCluster
   195 00000B75 722B                <1>     jc .exit
   196 00000B77 3DFFFFFFFF          <1>     cmp eax, -1 ;No more free clusters?
   197 00000B7C 7424                <1>     je .exit    ;If the cluster number is -1, return immediately
   198                              <1>     ;eax has first free cluster value to use
   199                              <1>     ;First we link the previous cluster to this cluster
   200 00000B7E BEFFFFFFFF          <1>     mov esi, -1 ;EOC marker
   201 00000B83 50                  <1>     push rax
   202 00000B84 E87C020000          <1>     call writeFAT   ;Allocate this cluster first
   203 00000B89 58                  <1>     pop rax
   204 00000B8A 7216                <1>     jc .exit    ;Errors don't get flushed to disk so this is safe
   205 00000B8C E854030000          <1>     call decrementFreeClusterCount
   206                              <1>     ;eax points to this allocated cluster
   207                              <1>     ;ebx points to the previous last cluster
   208 00000B91 89C6                <1>     mov esi, eax    ;New cluster as "value"
   209 00000B93 89D8                <1>     mov eax, ebx    ;Previous cluster to allocate at
   210 00000B95 E86B020000          <1>     call writeFAT   ;Now link previous EOC to this new EOC
   211 00000B9A 7206                <1>     jc .exit
   212 00000B9C 89F3                <1>     mov ebx, esi    ;Move new cluster as the value to be linked to a new cluster
   213 00000B9E FFC9                <1>     dec ecx ;One less cluster allocated
   214 00000BA0 75CE                <1>     jnz .allocateLoop
   215                              <1> .exit:
   216 00000BA2 5E                  <1>     pop rsi ;Pop the tfr count into esi
   217 00000BA3 9C                  <1>     pushfq
   218 00000BA4 F7D9                <1>     neg ecx
   219 00000BA6 01F1                <1>     add ecx, esi
   220 00000BA8 50                  <1>     push rax
   221 00000BA9 51                  <1>     push rcx
   222 00000BAA E8CE030000          <1>     call writeFSInfoSector
   223 00000BAF 59                  <1>     pop rcx
   224 00000BB0 58                  <1>     pop rax
   225 00000BB1 9D                  <1>     popfq
   226 00000BB2 5E                  <1>     pop rsi
   227 00000BB3 5B                  <1>     pop rbx
   228                              <1>     return
    13                              <2> %%_ret:
    14 00000BB4 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   229                              <1> 
   230                              <1> findFreeCluster:
   231                              <1> ;Walks the FAT to find a free cluster and returns the 
   232                              <1> ;   zero extended cluster number in eax (-1 means no free cluster)
   233                              <1> ;Starts from the pervious first free cluster and wraps around if 
   234                              <1> ; we hit the max disk size and keeps searching until we get back
   235                              <1> ; to the starting cluster value. 
   236                              <1> ;If the first free cluster is unknown, we start from 2. If we hit the 
   237                              <1> ; max disk size in that case, we fail.
   238                              <1> ;Works on the workingDPB.
   239                              <1> ;If returns with CF=CY => Fail set, return immediately to caller.
   240 00000BB5 53                  <1>     push rbx
   241 00000BB6 52                  <1>     push rdx
   242 00000BB7 55                  <1>     push rbp
   243 00000BB8 488B2D(3B070000)    <1>     mov rbp, qword [workingDPB]
   244 00000BBF 8B452D              <1>     mov eax, dword [rbp + dpb.dNextFreeClst]
   245 00000BC2 3DFFFFFFFF          <1>     cmp eax, -1     ;Do we have a good starting free cluster? 
   246 00000BC7 7511                <1>     jne .lp
   247                              <1>     ;Check if the count of free clusters is 0. If so, we are full!
   248 00000BC9 817D3100000000      <1>     cmp dword [rbp + dpb.dFreeClustCnt], 0
   249 00000BD0 742D                <1>     je .diskFull
   250                              <1>     ;Else, we just have unreliable metadata. Start search from 2!
   251 00000BD2 B802000000          <1>     mov eax, 2      ;If not, start searching from 2.
   252 00000BD7 89452D              <1>     mov dword [rbp + dpb.dNextFreeClst], eax    ;Start searching here!
   253                              <1> .lp:
   254 00000BDA 89C3                <1>     mov ebx, eax
   255 00000BDC E86D010000          <1>     call readFAT    ;Deref the cluster value of ebx into eax
   256 00000BE1 722E                <1>     jc .exitFast
   257 00000BE3 85C0                <1>     test eax, eax   ;Now eax = DATA [ebx]. If 0, this is free!
   258 00000BE5 7424                <1>     jz .freeFnd
   259 00000BE7 678D4301            <1>     lea eax, dword [ebx + 1]    ;Else, get sequentially the next cluster
   260                              <1>     ;If these are equal, we've gone through the whole FAT. Disk full!
   261 00000BEB 3B452D              <1>     cmp eax, dword [rbp + dpb.dNextFreeClst]
   262 00000BEE 740F                <1>     je .diskFull    
   263                              <1>     ;Are we past the max cluster address?
   264 00000BF0 3B450F              <1>     cmp eax, dword [rbp + dpb.dMaxClusterAddr]
   265 00000BF3 76E5                <1>     jbe .lp ;If not, use this next cluster value!
   266                              <1> ;Else, we are past end of the disk. Start from 2 again or disk full?
   267 00000BF5 B802000000          <1>     mov eax, 2  ;Default to search from 2 again
   268                              <1>     ;If the firstfreecluster = 2, then we've searched everything. Fail.
   269 00000BFA 39452D              <1>     cmp dword [rbp + dpb.dNextFreeClst], eax    
   270 00000BFD 75DB                <1>     jne .lp
   271                              <1> .diskFull:
   272                              <1> ;Set free cluster count to 0 and first free cluster to -1
   273 00000BFF C7453100000000      <1>     mov dword [rbp + dpb.dFreeClustCnt], 0  ;Set the free clusters
   274 00000C06 BBFFFFFFFF          <1>     mov ebx, -1     ;Set cluster value to -1
   275                              <1> .freeFnd:
   276 00000C0B 89D8                <1>     mov eax, ebx    ;Get the free cluster value into eax
   277 00000C0D 89452D              <1>     mov dword [rbp + dpb.dNextFreeClst], eax    ;Save first free cluster!
   278 00000C10 F8                  <1>     clc
   279                              <1> .exitFast:
   280 00000C11 5D                  <1>     pop rbp
   281 00000C12 5A                  <1>     pop rdx
   282 00000C13 5B                  <1>     pop rbx
   283                              <1>     return
    13                              <2> %%_ret:
    14 00000C14 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   284                              <1> 
   285                              <1> findFreeClusterData:
   286                              <1> ;Walks the FAT to find a free cluster and returns the 
   287                              <1> ;   zero extended cluster number in eax (-1 means no free cluster)
   288                              <1> ; Also finds NumberOfFreeClusters, if it is unknown. 
   289                              <1> ; Both fields get filled in the workingDPB
   290                              <1> ;Works on the workingDPB
   291                              <1> ;If returns with CF=CY => Fail set, return immediately to caller
   292 00000C15 53                  <1>     push rbx
   293 00000C16 51                  <1>     push rcx
   294 00000C17 52                  <1>     push rdx
   295 00000C18 55                  <1>     push rbp
   296 00000C19 488B2D(3B070000)    <1>     mov rbp, qword [workingDPB]
   297 00000C20 E863FEFFFF          <1>     call getFATtype
   298 00000C25 81F902000000        <1>     cmp ecx, 2  ;If not FAT32, always get afresh
   299 00000C2B 7512                <1>     jne .getNew
   300                              <1>     ;Else, if either entry is unknown, get both!
   301 00000C2D 817D31FFFFFFFF      <1>     cmp dword [rbp + dpb.dFreeClustCnt], -1
   302 00000C34 7409                <1>     je .getNew
   303 00000C36 817D2DFFFFFFFF      <1>     cmp dword [rbp + dpb.dNextFreeClst], -1
   304 00000C3D 7542                <1>     jne .exit
   305                              <1> .getNew:
   306                              <1>     ;Reset this data. Get first free cluster
   307 00000C3F C7452DFFFFFFFF      <1>     mov dword [rbp + dpb.dNextFreeClst], -1
   308 00000C46 C74531FFFFFFFF      <1>     mov dword [rbp + dpb.dFreeClustCnt], -1
   309 00000C4D E863FFFFFF          <1>     call findFreeCluster
   310 00000C52 7236                <1>     jc .exitFail
   311 00000C54 C7453100000000      <1>     mov dword [rbp + dpb.dFreeClustCnt], 0  ;Set to 0 for new count
   312 00000C5B 3DFFFFFFFF          <1>     cmp eax, -1 ;First free cluster = -1 means disk full!
   313 00000C60 741F                <1>     je .exit
   314                              <1>     ;Else, eax has the first free cluster. Keep reading FAT
