   264 000008F4 4881FBFFFFFFFF      <1>     cmp rbx, -1     ;If rbx points to -1, exit (Also clears CF)
   265 000008FB 74F2                <1>     je .tdbfdExit
   266 000008FD EBE4                <1>     jmp short .tdbfdCheckBuffer
