    29 0000319B 4889D6              <1>     mov rsi, rdx
    30 0000319E 803EFF              <1>     cmp byte [rsi], -1
    31 000031A1 7507                <1>     jne .notExt1
    32 000031A3 4881C607000000      <1>     add rsi, exFcb.driveNum
    33                              <1> .notExt1:
    34 000031AA 0FB606              <1>     movzx eax, byte [rsi]
    35 000031AD 50                  <1>     push rax    ;Push on stack the drive number
    36 000031AE 488D3D(50050000)    <1>     lea rdi, buffer1    ;Use buffer 1 to build path in
    37 000031B5 E837030000          <1>     call fcbInitRoutine ;Build path and canonicaliseFilename
    38 000031BA 7306                <1>     jnc .fcbOk
    39 000031BC 5B                  <1>     pop rbx ;Just pop into next reg to preserve error code
    40 000031BD E9544B0000          <1>     jmp fcbErrExit
    41                              <1> .fcbOk:
    42 000031C2 488D3D(50050000)    <1>     lea rdi, buffer1
    43 000031C9 E837E4FFFF          <1>     call getFilePathNoCanon ;Now hit disk for this file
    44 000031CE 7306                <1>     jnc .fileFound
    45 000031D0 5B                  <1>     pop rbx
    46 000031D1 E9404B0000          <1>     jmp fcbErrExit
    47                              <1> .fileFound:
    48                              <1> ;Now we build an FFBlock internally
    49 000031D6 488D3D(61060000)    <1>     lea rdi, dosffblock
    50 000031DD 57                  <1>     push rdi
    51 000031DE E8C8E2FFFF          <1>     call setupFFBlock
    52 000031E3 5E                  <1>     pop rsi
    53                              <1> ;Now we use the provided FCB to store the created FFblock, to be used by us only
    54 000031E4 488B3D(4B070000)    <1>     mov rdi, qword [workingFCB]
    55 000031EB F605(2D070000)FF    <1>     test byte [extFCBFlag], -1
    56 000031F2 7407                <1>     jz .notExt2
    57 000031F4 4881C707000000      <1>     add rdi, exFcb.driveNum ;Go to the drive number 
    58                              <1> .notExt2:
    59 000031FB 5B                  <1>     pop rbx ;Get back the drive number in bl
    60 000031FC 85DB                <1>     test ebx, ebx
