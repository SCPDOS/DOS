   366                              <1> .sevGo:
   367 00006C30 803E00              <1>     cmp byte [rsi], 0       ;Can't create/delete a null string var!
   368 00006C33 74F1                <1>     je .sevBadParam
   369                              <1> ;Name cannot contain the equals sign unless it is the first character
   370 00006C35 488D7E01            <1>     lea rdi, qword [rsi + 1]    ;This char is part of the string
   371 00006C39 E817120000          <1>     call strlen
   372 00006C3E B03D                <1>     mov al, "="
   373 00006C40 F2AE                <1>     repne scasb
   374 00006C42 74E2                <1>     je .sevBadParam ;If we find an = in the name, fail!
   375                              <1> ;Now figure out what the user wanted to do with this variable
   376 00006C44 31C0                <1>     xor eax, eax    ;0 means Update
   377 00006C46 89C3                <1>     mov ebx, eax
   378 00006C48 FFC3                <1>     inc ebx         ;1 means Delete
   379 00006C4A 4885D2              <1>     test rdx, rdx   ;Is the pointer null?
   380 00006C4D 0F44C3              <1>     cmovz eax, ebx
   381 00006C50 7406                <1>     jz .sev1        ;And skip the next check as ptr is invalid!
   382 00006C52 803A00              <1>     cmp byte [rdx], 0   ;Is the string empty?
   383 00006C55 0F44C3              <1>     cmove eax, ebx
