   551                              <1> writeFAT:
   552                              <1> ;Given a cluster number to edit in eax and a number in ebx to store in 
   553                              <1> ; that FAT entry, this program will write ebx for cluster eax in the FAT.
   554                              <1> ;If the FAT is FAT 12, only the low 12 bits of eax and ebx will be used.
   555                              <1> ;If the FAT is FAT 16, only the low 16 bits of eax and ebx will be used.
   556                              <1> ;Input: esi = Cluster value, eax = Cluster to write at
   557 00000E4B 53                  <1>     push rbx
   558 00000E4C 51                  <1>     push rcx
   559 00000E4D 52                  <1>     push rdx
   560 00000E4E 56                  <1>     push rsi
   561 00000E4F 57                  <1>     push rdi
   562 00000E50 55                  <1>     push rbp
   563 00000E51 89C7                <1>     mov edi, eax    ;Save cluster number in edi
   564 00000E53 E86AFCFFFF          <1>     call clust2FATEntry ;Returns sector in FAT in eax, offset in sector in edx
   565                              <1>     ;and FAT type in ecx
   566 00000E58 E827FCFFFF          <1>     call getBufForFat ;Buffer Header in ebx, first buffer being requested
   567 00000E5D 7223                <1>     jc .exitFail
   568                              <1>     ;Check if FAT 12, 16, 32
   569 00000E5F 85C9                <1>     test ecx, ecx
   570 00000E61 7426                <1>     jz .gotoNextClusterFat12    ;Handle FAT 12 separately
   571 00000E63 F7C101000000        <1>     test ecx, 1
   572 00000E69 7407                <1>     jz .goToNextClusterFat32
   573                              <1>     ;Here we handle FAT16
   574 00000E6B 6689741320          <1>     mov word [rbx + bufferHdr.dataarea + rdx], si ;Store the value
   575 00000E70 EB0A                <1>     jmp short .exit
   576                              <1> .goToNextClusterFat32:
   577 00000E72 81E6FFFFFF0F        <1>     and esi, 0FFFFFFFh  ;Zero upper nybble
   578 00000E78 89741320            <1>     mov dword [rbx + bufferHdr.dataarea + rdx], esi
   579                              <1> .exit:
   580 00000E7C E8A1FAFFFF          <1>     call markBufferDirty
   581 00000E81 F8                  <1>     clc
   582                              <1> .exitFail:
   583 00000E82 5D                  <1>     pop rbp
   584 00000E83 5F                  <1>     pop rdi
   585 00000E84 5E                  <1>     pop rsi
   586 00000E85 5A                  <1>     pop rdx
   587 00000E86 59                  <1>     pop rcx
   588 00000E87 5B                  <1>     pop rbx
   589                              <1>     return
