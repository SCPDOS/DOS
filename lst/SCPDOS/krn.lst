   151                              <1> 
   152                              <1> startNewChain:
   153                              <1> ;Working dpb must be set
   154                              <1> ;Returns: eax = First cluster new chain or -1=> Disk full
   155                              <1> ;If CF=CY, hard error
   156 00000B62 53                  <1>     push rbx
   157 00000B63 56                  <1>     push rsi
   158 00000B64 E874000000          <1>     call findFreeCluster    ;Get a free cluster in eax
   159 00000B69 7223                <1>     jc .exit    ;Disk read error?
   160 00000B6B 3DFFFFFFFF          <1>     cmp eax, -1 ;Disk full?
   161 00000B70 7415                <1>     je .exit2   ;Exit synching disk full status
   162 00000B72 BEFFFFFFFF          <1>     mov esi, -1 ;Value to write at eax is EOF
   163 00000B77 89C3                <1>     mov ebx, eax
   164 00000B79 E8A4020000          <1>     call writeFAT
   165 00000B7E 720E                <1>     jc .exit 
   166 00000B80 89D8                <1>     mov eax, ebx
   167 00000B82 E87B030000          <1>     call decrementFreeClusterCount
   168                              <1> .exit2:
   169 00000B87 50                  <1>     push rax
   170 00000B88 E820040000          <1>     call writeFSInfoSector
   171 00000B8D 58                  <1>     pop rax
   172                              <1> .exit:
   173 00000B8E 5E                  <1>     pop rsi
   174 00000B8F 5B                  <1>     pop rbx
   175                              <1>     return
    13                              <2> %%_ret:
    14 00000B90 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   176                              <1> 
   177                              <1> allocateClusters:
   178                              <1> ;Working dpb must be set. 
   179                              <1> ;Input: ecx = Number of clusters to allocate in a chain
   180                              <1> ;       ebx = Cluster to link to the new cluster
   181                              <1> ;Output:    
   182                              <1> ;   ecx = Number of allocated clusters
   183                              <1> ;   CF=NC => Complete.
   184                              <1> ;   If eax = -1, then no more free clusters. 
   185                              <1> ;   CF=CY => Hard error, exit
   186 00000B91 F8                  <1>     clc ;Always clear the flags before starting
   187 00000B92 53                  <1>     push rbx
   188 00000B93 56                  <1>     push rsi
   189 00000B94 51                  <1>     push rcx    ;Save tfr count on stack
   190 00000B95 67E332              <1>     jecxz .exit ;Allocating nothing? Exit
   191                              <1> .allocateLoop:
   192 00000B98 E840000000          <1>     call findFreeCluster
   193 00000B9D 722B                <1>     jc .exit
   194 00000B9F 3DFFFFFFFF          <1>     cmp eax, -1 ;No more free clusters?
   195 00000BA4 7424                <1>     je .exit    ;If the cluster number is -1, return immediately
   196                              <1>     ;eax has first free cluster value to use
   197                              <1>     ;First we link the previous cluster to this cluster
   198 00000BA6 BEFFFFFFFF          <1>     mov esi, -1 ;EOC marker
   199 00000BAB 50                  <1>     push rax
   200 00000BAC E871020000          <1>     call writeFAT   ;Allocate this cluster first
   201 00000BB1 58                  <1>     pop rax
   202 00000BB2 7216                <1>     jc .exit    ;Errors don't get flushed to disk so this is safe
   203 00000BB4 E849030000          <1>     call decrementFreeClusterCount
   204                              <1>     ;eax points to this allocated cluster
   205                              <1>     ;ebx points to the previous last cluster
   206 00000BB9 89C6                <1>     mov esi, eax    ;New cluster as "value"
   207 00000BBB 89D8                <1>     mov eax, ebx    ;Previous cluster to allocate at
   208 00000BBD E860020000          <1>     call writeFAT   ;Now link previous EOC to this new EOC
   209 00000BC2 7206                <1>     jc .exit
   210 00000BC4 89F3                <1>     mov ebx, esi    ;Move new cluster as the value to be linked to a new cluster
   211 00000BC6 FFC9                <1>     dec ecx ;One less cluster allocated
   212 00000BC8 75CE                <1>     jnz .allocateLoop
   213                              <1> .exit:
   214 00000BCA 5E                  <1>     pop rsi ;Pop the tfr count into esi
   215 00000BCB 9C                  <1>     pushfq
   216 00000BCC F7D9                <1>     neg ecx
   217 00000BCE 01F1                <1>     add ecx, esi
   218 00000BD0 50                  <1>     push rax
   219 00000BD1 51                  <1>     push rcx
   220 00000BD2 E8D6030000          <1>     call writeFSInfoSector
   221 00000BD7 59                  <1>     pop rcx
   222 00000BD8 58                  <1>     pop rax
   223 00000BD9 9D                  <1>     popfq
   224 00000BDA 5E                  <1>     pop rsi
   225 00000BDB 5B                  <1>     pop rbx
   226                              <1>     return
    13                              <2> %%_ret:
    14 00000BDC C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
   227                              <1> 
   228                              <1> findFreeCluster:
   229                              <1> ;Walks the FAT to find a free cluster and returns the 
   230                              <1> ;   zero extended cluster number in eax (-1 means no free cluster)
   231                              <1> ;Starts from the pervious first free cluster and wraps around if 
   232                              <1> ; we hit the max disk size and keeps searching until we get back
   233                              <1> ; to the starting cluster value. 
   234                              <1> ;If the first free cluster is unknown, we start from 2. If we hit the 
   235                              <1> ; max disk size in that case, we fail.
   236                              <1> ;Works on the workingDPB.
   237                              <1> ;If returns with CF=CY => Fail set, return immediately to caller.
   238 00000BDD 53                  <1>     push rbx
   239 00000BDE 52                  <1>     push rdx
   240 00000BDF 55                  <1>     push rbp
   241 00000BE0 488B2D(3B070000)    <1>     mov rbp, qword [workingDPB]
   242 00000BE7 8B452D              <1>     mov eax, dword [rbp + dpb.dNextFreeClst]
   243 00000BEA 3DFFFFFFFF          <1>     cmp eax, -1     ;Do we have a good starting free cluster? 
   244 00000BEF 7511                <1>     jne .lp
   245                              <1>     ;Check if the count of free clusters is 0. If so, we are full!
   246 00000BF1 817D3100000000      <1>     cmp dword [rbp + dpb.dFreeClustCnt], 0
   247 00000BF8 742D                <1>     je .diskFull
   248                              <1>     ;Else, we just have unreliable metadata. Start search from 2!
   249 00000BFA B802000000          <1>     mov eax, 2      ;If not, start searching from 2.
   250 00000BFF 89452D              <1>     mov dword [rbp + dpb.dNextFreeClst], eax    ;Start searching here!
   251                              <1> .lp:
   252 00000C02 89C3                <1>     mov ebx, eax
   253 00000C04 E86D010000          <1>     call readFAT    ;Deref the cluster value of ebx into eax
   254 00000C09 722E                <1>     jc .exitFast
   255 00000C0B 85C0                <1>     test eax, eax   ;Now eax = DATA [ebx]. If 0, this is free!
   256 00000C0D 7424                <1>     jz .freeFnd
   257 00000C0F 678D4301            <1>     lea eax, dword [ebx + 1]    ;Else, get sequentially the next cluster
   258                              <1>     ;If these are equal, we've gone through the whole FAT. Disk full!
   259 00000C13 3B452D              <1>     cmp eax, dword [rbp + dpb.dNextFreeClst]
   260 00000C16 740F                <1>     je .diskFull    
   261                              <1>     ;Are we past the max cluster address?
   262 00000C18 3B450F              <1>     cmp eax, dword [rbp + dpb.dMaxClusterAddr]
   263 00000C1B 76E5                <1>     jbe .lp ;If not, use this next cluster value!
   264                              <1> ;Else, we are past end of the disk. Start from 2 again or disk full?
   265 00000C1D B802000000          <1>     mov eax, 2  ;Default to search from 2 again
   266                              <1>     ;If the firstfreecluster = 2, then we've searched everything. Fail.
   267 00000C22 39452D              <1>     cmp dword [rbp + dpb.dNextFreeClst], eax    
   268 00000C25 75DB                <1>     jne .lp
   269                              <1> .diskFull:
   270                              <1> ;Set free cluster count to 0 and first free cluster to -1
   271 00000C27 C7453100000000      <1>     mov dword [rbp + dpb.dFreeClustCnt], 0  ;Set the free clusters
   272 00000C2E BBFFFFFFFF          <1>     mov ebx, -1     ;Set cluster value to -1
   273                              <1> .freeFnd:
