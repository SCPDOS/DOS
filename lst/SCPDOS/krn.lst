   325 0000349F 7518                <1>     jnz .okToGo ;If the file is a char dev, its always ok for FileIO
   326 000034A1 E81E430000          <1>     call testCDSNet ;If CF=CY => Net CDS (with and without CDS)
   327 000034A6 7218                <1>     jc .exit
   328                              <1>     ;rdi has cds ptr now
   329 000034A8 488B6F45            <1>     mov rbp, qword [rdi + cds.qDPBPtr]  ;Get dpb ptr in rbp
   330 000034AC E8F2D5FFFF          <1>     call getFATtype
   331 000034B1 81F901000000        <1>     cmp ecx, 1  ;0 = FAT12, 1 = FAT16
   332 000034B7 7707                <1>     ja .exit
   333                              <1> .okToGo:
   334 000034B9 C605(2B070000)00    <1>     mov byte [volIncmpFCB], 0   ;Clear this to permit usage
   335                              <1> .exit:
