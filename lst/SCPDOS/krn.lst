    40 000084A5 B801000000          <1>     mov eax, errInvFnc
    41 000084AA C605(3A040000)01    <1>     mov byte [errorLocus], eLocUnk
    42 000084B1 804C241001          <1>     or byte [rsp + 8h*2], 1 ;Set CF
    43                              <1> .exit:
    44 000084B6 48CF                <1>     iretq
