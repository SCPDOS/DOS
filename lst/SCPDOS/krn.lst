   265 00006C25 B809000000          <1>     mov eax, 9  ;Number of bytes to save as having had been written
   266                              <1> .copyTable:
   267                              <1> ;Come here with eax = full copy len, ebx = codepage value, ecx = bytes to xfr
   268 00006C2A F3A4                <1>     rep movsb   ;Copy the rest of the bytes
   269 00006C2C E80B0C0000          <1>     call getUserRegs
   270 00006C31 894610              <1>     mov dword [rsi + callerFrame.rcx], eax    ;Store in ecx # of bytes
   271                              <1>     ;Undocumented, if success, ax contains the requested codepage
   272                              <1>     ; value. This is undocumented and should not be relied upon.
   273 00006C34 89D8                <1>     mov eax, ebx    
   274 00006C36 E9D1100000          <1>     jmp extGoodExit
   275                              <1> .getExtCtryTbl:
   276                              <1> ;ecx has length of caller buffer
   277 00006C3B 81E903000000        <1>     sub ecx, 3  ;Remove the byte from the count and the length we will store
