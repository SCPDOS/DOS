  1392                              <1> .renFindDirSpace:
  1393                              <1> ;Searches for directory space based on the data in the current dir copy.
  1394                              <1> ; If the file is a dir then start searching in the parent cluster 
  1395 0000445B 8B05(AC070000)      <1>     mov eax, dword [dirClustPar]    ;Get the parent cluster
