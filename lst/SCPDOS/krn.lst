   269 00007D5E 0FB6CC              <1>     movzx ecx, ah   ;Get the number of bytes to check left into ecx
   270                              <1> .mainSearch:
   271 00007D61 AC                  <1>     lodsb   ;Get one byte into al
   272 00007D62 38C3                <1>     cmp bl, al  ;Check against the error code
   273 00007D64 7407                <1>     je .skipXlat    ;If the error code is found, we can skip xlat
   274 00007D66 FFC9                <1>     dec ecx ;Avoid loop for the zoomies
   275 00007D68 75F7                <1>     jnz .mainSearch ;Whilst ecx is not zero, keep searching
   276                              <1>     ;Here only if ecx is zero, i.e present error code needs translating
   277 00007D6A 0FB6D8              <1>     movzx ebx, al ;Move the xLat error code into ebx
