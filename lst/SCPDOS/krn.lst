   458                              <1> ;-----------------------------------------------------------------------------
   459                              <1> ;SPECIAL BUFFER FUNCTIONS
   460                              <1> ;Buffer functions for sectors associated to file handles and specific purposes
   461                              <1> ; ALL sector types need to setup [workingDPB] to make the transfer
   462                              <1> ;-----------------------------------------------------------------------------
   463                              <1> getBufForDOS:
   464                              <1> ;Returns a buffer to use for DOS sector(s) in rbx
   465                              <1> ;Input: [workingDPB] = DPB to transact on
   466                              <1> ;       rax = Sector to transfer
   467                              <1> ;Output: rbx = Buffer to use or if CF=CY, error rbx = Undefined
   468 00000A62 51                  <1>     push rcx
   469 00000A63 B101                <1>     mov cl, dosBuffer
   470 00000A65 EB0D                <1>     jmp short getBufCommon
   471                              <1> getBufForFat:
   472                              <1> ;Returns a buffer to use for fat data in rbx
   473                              <1> ;Input: [workingDPB] = DPB to transact on
   474                              <1> ;       rax = Sector to transfer
   475                              <1> ;Output: rbx = Buffer to use or if CF=CY, error rbx = Undefined
   476 00000A67 51                  <1>     push rcx
   477 00000A68 B102                <1>     mov cl, fatBuffer
   478 00000A6A EB08                <1>     jmp short getBufCommon
   479                              <1> getBufForDir:
   480                              <1> ;Returns a buffer to use for disk directory data in rbx
   481                              <1> ;Input: [workingDPB] = File to manipulate
   482                              <1> ;       rax = Sector to transfer
   483                              <1> ;Output: rbx = Buffer to use or if CF=CY, error rbx = Undefined
   484 00000A6C 51                  <1>     push rcx
   485 00000A6D B104                <1>     mov cl, dirBuffer
   486 00000A6F EB03                <1>     jmp short getBufCommon
   487                              <1> getBufForData:
   488                              <1> ;Returns a buffer to use for disk data in rbx
   489                              <1> ;Requires a File Handle.
   490                              <1> ;Input: [workingDPB] = File to manipulate
   491                              <1> ;       rax = Sector to transfer
   492                              <1> ;Output: rbx = Buffer to use or if CF=CY, error rbx = Undefined
   493 00000A71 51                  <1>     push rcx
   494 00000A72 B108                <1>     mov cl, dataBuffer
   495                              <1> getBufCommon:
   496 00000A74 52                  <1>     push rdx
   497 00000A75 57                  <1>     push rdi
   498 00000A76 55                  <1>     push rbp
   499 00000A77 488B2D(3B070000)    <1>     mov rbp, qword [workingDPB] ;Get working DPB 
   500 00000A7E E8A7FEFFFF          <1>     call getBuffer  ;Gives the buffer ptr in rbx
   501 00000A83 5D                  <1>     pop rbp
   502 00000A84 5F                  <1>     pop rdi
   503 00000A85 5A                  <1>     pop rdx
   504 00000A86 59                  <1>     pop rcx
   505                              <1>     return
    13                              <2> %%_ret:
    14 00000A87 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
    35                                  %include "./src/dos/Kernel/FAT/fat.asm"
     1                              <1> ;-----------------------------------:
     2                              <1> ;       File System routines        :
     3                              <1> ;-----------------------------------:
     4                              <1> getFATtype:
     5                              <1> ;Gets a pointer to a DPB and returns the FAT type on the drive
     6                              <1> ;Entry: rbp = DPB to ascertain FAT
     7                              <1> ;Exit: ecx = 0 => FAT 12, ecx = 1 => FAT 16, ecx = 2 => FAT 32
     8 00000A88 53                  <1>     push rbx
     9 00000A89 8B5D0F              <1>     mov ebx, dword [rbp + dpb.dMaxClusterAddr]
    10 00000A8C B902000000          <1>     mov ecx, 2  ;FAT 32 marker
    11 00000A91 81FBF5FF0000        <1>     cmp ebx, fat16MaxClustCnt
    12 00000A97 730C                <1>     jae .exit
    13 00000A99 FFC9                <1>     dec ecx     ;FAT 16 marker
    14 00000A9B 81FBF50F0000        <1>     cmp ebx, fat12MaxClustCnt
    15 00000AA1 7302                <1>     jae .exit
    16 00000AA3 FFC9                <1>     dec ecx     ;FAT 12 marker
    17                              <1> .exit:
    18 00000AA5 5B                  <1>     pop rbx
    19                              <1>     return
    13                              <2> %%_ret:
    14 00000AA6 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
    20                              <1> 
    21                              <1> clust2FATEntry:
    22                              <1> ;Converts a cluster number to a offset in the FAT
    23                              <1> ;Entry:  Uses the workingDPB to convert cluster number
    24                              <1> ;        eax = Cluster number to look for
    25                              <1> ;Exit:   eax = Sector on disk of FAT 
    26                              <1> ;        ecx = 0 => FAT12, 1 => FAT16, 2 => FAT32
    27                              <1> ;        edx = 1.5Byte/Word/DWord in sector of entry
    28 00000AA7 53                  <1>     push rbx
    29 00000AA8 55                  <1>     push rbp
    30 00000AA9 488B2D(3B070000)    <1>     mov rbp, qword [workingDPB]
    31 00000AB0 8B5D0F              <1>     mov ebx, dword [rbp + dpb.dMaxClusterAddr]
    32 00000AB3 81FBF5FF0000        <1>     cmp ebx, fat16MaxClustCnt
    33 00000AB9 731E                <1>     jae .fat32
    34 00000ABB 81FBF50F0000        <1>     cmp ebx, fat12MaxClustCnt
    35 00000AC1 7209                <1>     jb .fat12
    36                              <1> ;FAT16
    37 00000AC3 D1E0                <1>     shl eax, 1  ;Multiply cluster number by 2
    38 00000AC5 6801000000          <1>     push qword 1
    39 00000ACA EB15                <1>     jmp short .common
    40                              <1> .fat12:
    41 00000ACC 89C1                <1>     mov ecx, eax    ;ecx = eax
    42 00000ACE D1E9                <1>     shr ecx, 1      ;ecx = ecx / 2
    43 00000AD0 01C8                <1>     add eax, ecx    ;eax = eax + ecx    (eax * 1.5)
    44 00000AD2 6800000000          <1>     push qword 0
    45 00000AD7 EB08                <1>     jmp short .common
    46                              <1> .fat32:
    47 00000AD9 6802000000          <1>     push qword 2
    48 00000ADE C1E002              <1>     shl eax, 2  ;Multiply cluster number by 4
    49                              <1> .common:
    50                              <1> ;eax has the FAToffset
    51 00000AE1 0FB74D02            <1>     movzx ecx, word [rbp + dpb.wBytesPerSector]
    52 00000AE5 31D2                <1>     xor edx, edx    ;edx = 0
    53 00000AE7 F7F1                <1>     div ecx         ;Divide by bytes per sector (0:eax / ecx)
    54 00000AE9 0FB75D06            <1>     movzx ebx, word [rbp + dpb.wFAToffset]   ;Add the offset to the first FAT
    55 00000AED 01D8                <1>     add eax, ebx
    56 00000AEF 59                  <1>     pop rcx ;Pop the FAT type back into rcx
    57 00000AF0 5D                  <1>     pop rbp
    58 00000AF1 5B                  <1>     pop rbx
    59                              <1>     return
    13                              <2> %%_ret:
    14 00000AF2 C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
    60                              <1> 
    61                              <1> getStartSectorOfCluster:
    62                              <1> ;Input: eax = Cluster Number
    63                              <1> ;       rbp = dpb pointer
    64                              <1> ;Output: rax = Starting Sector number for cluster
    65                              <1> ;Gives the data sector we are at in the current cluster
    66                              <1> ;Start Sector = (ClusterNumber - 2)*SecPerClust + DataAreaStartSector
    67 00000AF3 51                  <1>     push rcx
    68 00000AF4 09C0                <1>     or eax, eax ;Zero upper dword
    69 00000AF6 7416                <1>     jz .rootDir ;If eax is zero, that is an alias for Root Directory
    70                              <1> .fat32Root:
    71 00000AF8 482D02000000        <1>     sub rax, 2
    72 00000AFE 8A4D05              <1>     mov cl, byte [rbp + dpb.bSecPerClustShift]
    73 00000B01 48D3E0              <1>     shl rax, cl
    74 00000B04 31C9                <1>     xor ecx, ecx
    75 00000B06 8B4D0B              <1>     mov ecx, dword [rbp + dpb.dClusterHeapOffset]
    76 00000B09 4801C8              <1>     add rax, rcx
    77                              <1>     ;rax now has the first sector of the current cluster
    78 00000B0C 59                  <1>     pop rcx
    79                              <1>     return
    13                              <2> %%_ret:
    14 00000B0D C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
    80                              <1> .rootDir:
    81 00000B0E 8B4517              <1>     mov eax, dword [rbp + dpb.dFirstUnitOfRootDir]
    82 00000B11 E872FFFFFF          <1>     call getFATtype
    83 00000B16 81F902000000        <1>     cmp ecx, 2
    84 00000B1C 74DA                <1>     je .fat32Root   ;If FAT32, eax now has zero extended 1st cluster of Root Dir
    85                              <1>     ;Else rax has the first sector of the Root Dir
    86 00000B1E 59                  <1>     pop rcx
    87                              <1>     return
    13                              <2> %%_ret:
    14 00000B1F C3                  <2>  ret
    15                              <2> %assign retOff %%_ret-$$
    88                              <1> 
    89                              <1> 
    90                              <1> getLastClusterInChain:
    91                              <1> ;Given a cluster value in eax, returns in eax the last cluster in the chain
    92                              <1> ;Input: eax = Cluster to start searching at
    93                              <1> ;Output: eax = Last cluster in chain
    94                              <1> ;If input eax = 0, output eax = 0
    95 00000B20 85C0                <1>     test eax, eax   ;If eax = 0, then just exit
    96                              <1>     retz
    41                              <2> cret z
