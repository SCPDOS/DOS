   776                              <1> ;        If ecx is zero it means there is no strings block!
   777 00006EC6 52                  <1>     push rdx
   778 00006EC7 56                  <1>     push rsi
   779 00006EC8 57                  <1>     push rdi
   780 00006EC9 498B703E            <1>     mov rsi, qword [r8 + psp.envPtr]
   781 00006ECD E8CAFFFFFF          <1>     call getPtrToEndOfEnvBlk   ;Move rdi past the end of the environment
   782 00006ED2 BE02000000          <1>     mov esi, 2              ;Set the counter to the argc default value
   783 00006ED7 0FB717              <1>     movzx edx, word [rdi]   ;Get the number of additional strings to copy 
   784 00006EDA 85D2                <1>     test edx, edx
   785 00006EDC 0F44CE              <1>     cmovz ecx, esi          ;Set ecx with the return value and exit 
   786 00006EDF 742B                <1>     jz .exit
   787 00006EE1 81FAFE3F0000        <1>     cmp edx, (ENV_MAX-2)/2  
   788 00006EE7 7727                <1>     ja .err
   789 00006EE9 4801F7              <1>     add rdi, rsi            ;Move rdi past the argc count
   790                              <1> .lp:
   791 00006EEC E8640F0000          <1>     call strlen     ;Get the length of the string in ecx
   792 00006EF1 01CE                <1>     add esi, ecx    ;Add this string to the sum too
   793 00006EF3 81FEFF7F0000        <1>     cmp esi, ENV_MAX    ;The sum cannot grow so large
   794 00006EF9 7715                <1>     ja .err
   795 00006EFB 4801CF              <1>     add rdi, rcx    ;And move rdi to the next string
   796 00006EFE FFCA                <1>     dec edx         ;Drop one from count
   797 00006F00 75EA                <1>     jnz .lp         ;Go again if still have strings to handle
   798 00006F02 89F1                <1>     mov ecx, esi    ;Return value in ecx
   799 00006F04 66F747FFFFFF        <1>     test word [rdi - 1], -1 ;Check if the final word is zero...
   800 00006F0A 7504                <1>     jnz .err        ;Set value to 0, if not (i.e. we have garbage)
   801                              <1> .exit:
   802 00006F0C 5F                  <1>     pop rdi
   803 00006F0D 5E                  <1>     pop rsi
   804 00006F0E 5A                  <1>     pop rdx
   805                              <1>     return
