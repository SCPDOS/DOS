   152                              <1> flushAndFreeBuffer:    ;Int 2Fh AX=1209h 
   153                              <1> ;Flushes the data in a sector buffer to disk, then frees it!
   154                              <1> ;Entry: rdi = Pointer to buffer header for this buffer
   155                              <1> ;Exit:  CF=NC : Success
   156                              <1> ;       CF=CY : Fail, terminate the request
   157 00000831 50                  <1>     push rax
   158 00000832 53                  <1>     push rbx
   159 00000833 51                  <1>     push rcx
   160 00000834 52                  <1>     push rdx
   161 00000835 56                  <1>     push rsi
   162 00000836 57                  <1>     push rdi
   163 00000837 55                  <1>     push rbp
   164                              <1> ;If the buffer is freed, empty or on an erroring disk, skip flushing
   165 00000838 B8FF000000          <1>     mov eax, freeBuffer
   166 0000083D 66874708            <1>     xchg ax, word [rdi + bufferHdr.wDrvNumFlg] ;Get flags and drive number
   167                              <1>     ;ah = Flags, al = Drive number
   168 00000841 3CFF                <1>     cmp al, -1  ;-1 means free buffer
   169 00000843 7421                <1>     je .fbExit  ;If it was free, exit
   170 00000845 F6C440              <1>     test ah, dirtyBuffer    ;Data modified?
