   562                              <1> 
   563                              <1> buffersDefault  equ 30
   564                              <1> filesDefault    equ 20
   565                              <1> fcbsDefault     equ 4
   566                              <1> safeFcbsDeflt   equ 0
   567                              <1> lastDriveDeflt  equ 5   
