   380 00000010 ????????????????    <1>     .newSFTVal      dq ?
   381 00000018 ????????????????    <1>     .newFCBSVal     dq ?
   382 00000020 ????????????????    <1>     .newProtFCBSVal dq ?    ;Number of protected FCBS
   383 00000028 ????????????????    <1>     .newLastdrive   dq ?
   384 00000030 ????????????????    <1>     .newStacks      dq ?    ;Ignored for now
   385 00000038 ????????????????    <1>     .newStackSize   dq ?    ;Ignored for now
   386 00000040 ????????????????    <1>     .cfgHandle      dq ?    ;CONFIG.SYS handle
   387 00000048 ????????????????    <1>     .lastLine       dq ?    ;Set if the last line is current
