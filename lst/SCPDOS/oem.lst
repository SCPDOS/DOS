   510                              <1> ;Critical Error AH bitfield equates
   511                              <1> critRead    equ 0h
   512                              <1> critWrite   equ 1h
   513                              <1> critDOS     equ 0h
   514                              <1> critFAT     equ 2h
   515                              <1> critDir     equ 4h
   516                              <1> critData    equ 6h
   517                              <1> critFailOK  equ 8h
   518                              <1> critRetryOK equ 10h
   519                              <1> critIgnorOK equ 20h
   520                              <1> critCharDev equ 80h
   521                              <1> 
   522                              <1> critIgnore  equ 0
   523                              <1> critRetry   equ 1
   524                              <1> critAbort   equ 2
   525                              <1> critFail    equ 3
